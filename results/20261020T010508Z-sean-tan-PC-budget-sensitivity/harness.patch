+component BudgetStudySelection {
+	var salt = 0u64;
+	// Per sweep, reset by the harness.
+	var cuts = 0;                // cuts checked
+	var truncatedCuts = 0;       // cuts whose distinct images outnumbered the budget
+	var randomCuts = 0;          // cuts where at least one checked image was a random draw
+	var randomImages = 0L;       // checked images that were random draws
+	var maxExtremes = 0;         // the most extremes any over-budget cut had
+	// Set by search() for the cut in hand: how many of its images are extremes
+	// (all of them when the cut is enumerated completely).
+	var lastExtremes = 0;
+	// At the failing cut, if any: its extremes, and the failing image's index (1-based).
+	var failExtremes = -1;
+	var failIndex = -1;
+
+	def reset() {
+		cuts = 0;
+		truncatedCuts = 0;
+		randomCuts = 0;
+		randomImages = 0L;
+		maxExtremes = 0;
+		lastExtremes = 0;
+		failExtremes = -1;
+		failIndex = -1;
+	}
+
+	def noteCut(truncated: bool, checked: int, failed: bool) {
+		cuts++;
