// Abstract interface for transaction storage backends
// Supports multiple implementations: volatile memory, file-backed mmap, PMEM, etc.
//
// This abstraction allows PWRegion (block-based memory manager) to work with
// different storage backends without platform-specific code:
//
// 1. VolatileBackend:          Generic in-memory storage (Array-backed)
// 2. PmemMmapBackend:          PMEM-style mapped storage with cache-line flush
// 3. FileMmapBackend:          Shared file mapping with msync durability
//
// The backend is responsible for:
// - Creating/destroying regions
// - Preparing changed data for a later durability barrier
// - Persisting specific ranges synchronously when callers need explicit ordering

// A memory region created by a backend
class BackendRegion {
	def range: Range<byte>;  // The actual bytes of the region
	def backend: TxnRegionBackend;  // Reference to the backend that created this
// Mapping exists only on certain targets
//	var mapping: Mapping;  // Keeps the Mapping alive so GC finalizer doesn't unmap prematurely
	
	new(range, backend) { }
	
	// Mark ordinary data bytes as already changed. The backend must prepare
	// these bytes for durability at the next persistChanges().
	def markDirty(offset: u64, size: u64) -> bool {
		return backend.markDirty(this, offset, size);
	}

	// Synchronously persist a specific range. This is intended for ordered WAL
	// log/header writes.
	def persistRange(offset: u64, size: u64) -> bool {
		return backend.persistRange(this, offset, size);
	}

	// Complete persistence for all prior markDirty() calls on this region.
	def persistChanges() -> bool {
		return backend.persistChanges(this);
	}
}

// Backend interface that all storage implementations must provide
class TxnRegionBackend {
	// Create a region of the given size with specified protection
	def create(size: u64, prot: int) -> BackendRegion;
	
	// Destroy a previously created region
	def destroy(region: BackendRegion);
	
	// Mark ordinary data bytes as already changed. Implementations may use any
	// backend-specific preparation needed before persistChanges().
	def markDirty(region: BackendRegion, offset: u64, size: u64) -> bool;

	// Synchronously persist a specific range. This is intended for WAL bytes
	// where the caller needs an explicit durability boundary.
	def persistRange(region: BackendRegion, offset: u64, size: u64) -> bool;

	// Complete persistence for all prior markDirty() calls on this region.
	def persistChanges(region: BackendRegion) -> bool;
	
	// Check if this backend provides persistence
	def isPersistent() -> bool;
	
	// Get the name of this backend (for debugging)
	def name() -> string;
}

// Protection flags (mirror Linux mmap flags)
enum BackendProt(mask: int) {
	NONE(0),
	READ(1),
	WRITE(2),
	EXEC(4)
}

// Platform-independent volatile memory backend using simple Array allocation
class VolatileBackend extends TxnRegionBackend {
	
	def create(size: u64, prot: int) -> BackendRegion {
		// Create a byte array-backed region
		var data = Array<byte>.new(int.!(size));
		var range = data[0 ..+ data.length];
		return BackendRegion.new(range, this);
	}
	
	def destroy(region: BackendRegion) {
		// Array will be garbage collected automatically
		// No explicit cleanup needed
	}
	
	def markDirty(region: BackendRegion, offset: u64, size: u64) -> bool {
		// No-op for volatile memory
		return true;
	}

	def persistRange(region: BackendRegion, offset: u64, size: u64) -> bool {
		// No-op for volatile memory
		return true;
	}

	def persistChanges(region: BackendRegion) -> bool {
		return true;
	}
	
	def isPersistent() -> bool {
		return false;
	}
	
	def name() -> string {
		return "volatile";
	}
}

