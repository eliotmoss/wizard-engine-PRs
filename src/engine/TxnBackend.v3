// Abstract interface for transaction storage backends
// Supports multiple implementations: volatile memory, file-backed mmap, PMEM, etc.
//
// This abstraction allows PWRegion (block-based memory manager) to work with
// different storage backends without platform-specific code:
//
// 1. VolatileBackend:          Generic in-memory storage (Array-backed)
// 2. PmemMmapBackend:          PMEM-style mapped storage with cache-line flush
// 3. FileMmapBackend:          Shared file mapping with msync durability
//
// The backend is responsible for creating regions and reporting capabilities.
// Region objects own their own lifecycle and persistence behavior.

// Relative cost class of a checkpoint() on a backend, used to tune the WAL's
// checkpoint thresholds. Checkpoint cost is strongly backend-asymmetric:
//   FREE      volatile  -- reclaim only, no syncs
//   CHEAP     PMEM      -- a couple of store fences
//   EXPENSIVE file      -- fdatasync of region data + superblock msync
enum CheckpointCost {
	FREE,
	CHEAP,
	EXPENSIVE
}

// A memory region created by a backend
class BackendRegion {
	def range: Range<byte>;  // The actual bytes of the region

	new(range) { }

	// Destroy this region and release any resources it owns.
	def destroy();

	// Relative cost of a checkpoint() on this backend. The WAL uses it to choose
	// how aggressively to checkpoint: a free backend can checkpoint on nearly
	// every commit, while an expensive backend checkpoints lazily. Conservative
	// default for unknown backends is EXPENSIVE.
	def checkpointCost() -> CheckpointCost {
		return CheckpointCost.EXPENSIVE;
	}

	// Ordinary data bytes have already changed; prepare them for durability at
	// the next persistChanges().
	def prepareChangedRange(offset: u64, size: u64) -> bool;

	// Complete persistence for all prior prepareChangedRange() calls.
	def persistChanges() -> bool;

	// Synchronously persist a specific range. This is intended for ordered WAL
	// log/header writes.
	def persistRange(offset: u64, size: u64) -> bool;
}

// Backend interface that all storage implementations must provide
// TODO: maybe call it a RegionManager
class TxnRegionBackend {
	// Create a region of the given size with specified protection
	def create(size: u64, prot: int) -> BackendRegion;
	
	// Check if this backend provides persistence
	def isPersistent() -> bool;
	
	// Get the name of this backend (for debugging)
	def name() -> string;
}

// Protection flags (mirror Linux mmap flags)
enum BackendProt(mask: int) {
	NONE(0),
	READ(1),
	WRITE(2),
	EXEC(4)
}

class VolatileRegion extends BackendRegion {
	new(range: Range<byte>) super(range) { }

	def destroy() {
		// Array storage is garbage collected automatically.
	}

	def checkpointCost() -> CheckpointCost {
		return CheckpointCost.FREE;
	}

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		return true;
	}

	def persistChanges() -> bool {
		return true;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		return true;
	}
}

// Platform-independent volatile memory backend using simple Array allocation
class VolatileBackend extends TxnRegionBackend {
	
	def create(size: u64, prot: int) -> BackendRegion {
		// Create a byte array-backed region
		var data = Array<byte>.new(int.!(size));
		var range = data[0 ..+ data.length];
		return VolatileRegion.new(range);
	}
	
	def isPersistent() -> bool {
		return false;
	}
	
	def name() -> string {
		return "volatile";
	}
}

// Global instances of platform-independent backends
component Backends {
	private var volatileBackend: VolatileBackend;
	
	def getVolatile() -> TxnRegionBackend {
		if (volatileBackend == null) {
			volatileBackend = VolatileBackend.new();
		}
		return volatileBackend;
	}
	
	def getMmap() -> TxnRegionBackend;
}
