// x86-64 specific transaction backend implementations

class MappedBackendRegion extends BackendRegion {
	def var mapping: Mapping;

	new(backend: TxnRegionBackend, mapping: Mapping)
		super(CiRuntime.forgeRange<byte>(mapping.range.start, int.!(mapping.range.size())), backend) { }
}

class FdMappedBackendRegion extends MappedBackendRegion {
	def var fd: int;

	new(backend: TxnRegionBackend, mapping: Mapping, fd: int) super(backend, mapping) { }
}

// Maybe call it FilePersistentBackendRegion?
class MappedFileBackendRegion extends FdMappedBackendRegion {
	def var hasDirtyRange = false;
	def var dirtyStart: u64 = 0;
	def var dirtyEnd: u64 = 0;

	new(backend: TxnRegionBackend, mapping: Mapping, fd: int) super(backend, mapping, fd) { }
}

class MappedRegionBackend extends TxnRegionBackend {
	def makeRegion(newMapping: Mapping) -> MappedBackendRegion {
		if (newMapping == null) return null;
		return MappedBackendRegion.new(this, newMapping);
	}

	def destroy(region: BackendRegion) {
		var mapped = asMappedRegion(region);
		if (mapped != null && mapped.mapping != null) {
			mapped.mapping.range.unmap();
			mapped.mapping = null;
		}
		cleanup(region);
	}

	def cleanup(region: BackendRegion) { }

	def asMappedRegion(region: BackendRegion) -> MappedBackendRegion {
		if (!MappedBackendRegion.?(region)) return null;
		return MappedBackendRegion.!(region);
	}

	def asFdRegion(region: BackendRegion) -> FdMappedBackendRegion {
		if (!FdMappedBackendRegion.?(region)) return null;
		return FdMappedBackendRegion.!(region);
	}

	def closeFdRegion(region: BackendRegion) {
		def fdRegion = asFdRegion(region);
		if (fdRegion == null) return;
		if (fdRegion.fd >= 0) {
			RegionFileIO.close(fdRegion.fd);
			fdRegion.fd = -1;
		}
	}

	def convertProt(prot: int) -> int {
		var mmapProt = Mmap.PROT_NONE;
		if ((prot & BackendProt.READ.mask) != 0) mmapProt |= Mmap.PROT_READ;
		if ((prot & BackendProt.WRITE.mask) != 0) mmapProt |= Mmap.PROT_WRITE;
		if ((prot & BackendProt.EXEC.mask) != 0) mmapProt |= Mmap.PROT_EXEC;
		return mmapProt;
	}
}

// Persistent memory backend using mmap with MAP_SYNC (for PMEM/DAX)
class MmapPersistentBackend extends MappedRegionBackend {
	def path: string;  // Path to PMEM device or DAX file

	new(path) { }

	def create(size: u64, prot: int) -> BackendRegion {
		def fd = RegionFileIO.openOrCreate(path);
		if (fd < 0) return null;
		if (!RegionFileIO.ensureSize(fd, size)) {
			RegionFileIO.close(fd);
			return null;
		}

		var mmapProt = convertProt(prot);
		def mapping = Mmap.map(size, mmapProt, Mmap.MAP_SHARED_VALIDATE | Mmap.MAP_SYNC, fd, 0);
		def region = makePersistentRegion(mapping, fd);
		if (region == null) {
			RegionFileIO.close(fd);
			return null;
		}
		return region;
	}

	def makePersistentRegion(newMapping: Mapping, fd: int) -> FdMappedBackendRegion {
		if (newMapping == null) return null;
		return FdMappedBackendRegion.new(this, newMapping, fd);
	}
	
	def flush(region: BackendRegion, offset: u64, size: u64) -> bool {
		if (region == null) return false;
		def regionSize = u64.!(region.range.length);
		if (offset > regionSize || size > regionSize - offset) return false;
		if (size == 0) return true;
		// Flush cache lines to PMEM
		// CLWB (Cache Line Write Back) is the preferred instruction
		// Falls back to CLFLUSHOPT or CLFLUSH on older CPUs
		var start = Pointer.atElement(region.range, 0) + i64.view(offset);
		var end = start + i64.view(size);
		def cacheLineSize = 64u64; // x86-64 cache line size
		
		// Flush each cache line
		var addr = u64.view(start);
		def endAddr = u64.view(end);
		addr = addr - (addr % cacheLineSize);
		while (addr < endAddr) {
			flushCacheLine(PWRegionUtils.pointerFromU64(addr));
			addr = addr + cacheLineSize;
		}
		return true;
	}
	
	def fence(region: BackendRegion) -> bool {
		if (region == null) return false;
		// SFENCE ensures all cache line flushes complete before continuing
		storeFence();
		return true;
	}

	def persistAll(region: BackendRegion) -> bool {
		if (region == null) return false;
		return flush(region, 0, u64.!(region.range.length)) && fence(region);
	}
	
	def isPersistent() -> bool {
		return true;
	}
	
	def name() -> string {
		return "mmap-pmem";
	}

	def cleanup(region: BackendRegion) {
		closeFdRegion(region);
	}
	
	// Platform-specific cache flush (requires compiler intrinsic or inline asm)
	private def flushCacheLine(addr: Pointer) {
		// TODO: This needs compiler support for inline assembly
		// Ideally: __builtin_ia32_clwb(addr) or asm volatile("clwb (%0)" :: "r"(addr))
		// For now, this is a placeholder that would need to be implemented
		// with proper x86-64 CLWB/CLFLUSHOPT/CLFLUSH instruction
	}
	
	// Platform-specific store fence
	private def storeFence() {
		// TODO: This needs compiler support for inline assembly
		// Ideally: __builtin_ia32_sfence() or asm volatile("sfence")
		// For now, this is a placeholder
	}
}

class MappedFileRegionBackend extends MappedRegionBackend {
	def path: string;

	new(path) { }

	def create(size: u64, prot: int) -> BackendRegion {
		def fd = RegionFileIO.openOrCreate(path);
		if (fd < 0) return null;
		if (!RegionFileIO.ensureSize(fd, size)) {
			RegionFileIO.close(fd);
			return null;
		}

		def mmapProt = convertProt(prot);
		def mapping = Mmap.map(size, mmapProt, Mmap.MAP_SHARED, fd, 0);
		def region = makeFileRegion(mapping, fd);
		if (region == null) {
			RegionFileIO.close(fd);
			return null;
		}
		return region;
	}

	def makeFileRegion(newMapping: Mapping, fd: int) -> MappedFileBackendRegion {
		if (newMapping == null) return null;
		return MappedFileBackendRegion.new(this, newMapping, fd);
	}

	def flush(region: BackendRegion, offset: u64, size: u64) -> bool {
		def fileRegion = asFileRegion(region);
		if (fileRegion == null || fileRegion.mapping == null) return false;
		def regionSize = u64.!(fileRegion.range.length);
		if (offset > regionSize || size > regionSize - offset) return false;
		if (size == 0) return true;
		def end = offset + size;
		if (!fileRegion.hasDirtyRange) {
			fileRegion.dirtyStart = offset;
			fileRegion.dirtyEnd = end;
			fileRegion.hasDirtyRange = true;
			return true;
		}
		if (offset < fileRegion.dirtyStart) fileRegion.dirtyStart = offset;
		if (end > fileRegion.dirtyEnd) fileRegion.dirtyEnd = end;
		return true;
	}

	def fence(region: BackendRegion) -> bool {
		def fileRegion = asFileRegion(region);
		if (fileRegion == null || fileRegion.mapping == null) return false;
		if (!fileRegion.hasDirtyRange) return true;

		// TODO: define this somewhere else as a constant
		def pageSize = 4096u64;
		def syncStart = fileRegion.dirtyStart - (fileRegion.dirtyStart % pageSize);
		def syncEnd = ((fileRegion.dirtyEnd + pageSize - 1u64) / pageSize) * pageSize;
		if (!Mmap.sync(fileRegion.mapping.range.start + i64.view(syncStart), syncEnd - syncStart, Mmap.MS_SYNC)) return false;

		fileRegion.hasDirtyRange = false;
		fileRegion.dirtyStart = fileRegion.dirtyEnd = 0;
		return true;
	}

	def persistAll(region: BackendRegion) -> bool {
		def fileRegion = asFileRegion(region);
		if (fileRegion == null || fileRegion.mapping == null || fileRegion.fd < 0) return false;
		if (!RegionFileIO.fdatasync(fileRegion.fd)) return false;
		fileRegion.hasDirtyRange = false;
		fileRegion.dirtyStart = fileRegion.dirtyEnd = 0;
		return true;
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "mmap-file";
	}

	def cleanup(region: BackendRegion) {
		def fileRegion = asFileRegion(region);
		if (fileRegion == null) return;
		fileRegion.hasDirtyRange = false;
		fileRegion.dirtyStart = fileRegion.dirtyEnd = 0;
		closeFdRegion(region);
	}

	def asFileRegion(region: BackendRegion) -> MappedFileBackendRegion {
		if (!MappedFileBackendRegion.?(region)) return null;
		return MappedFileBackendRegion.!(region);
	}
}

component RegionFileIO {
	def FILE_MODE = 420;	// 0644 octal

	def openOrCreate(path: string) -> int {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		var r = Linux.syscall(LinuxConst.SYS_open,
			(Pointer.atElement(pathBuf, 0), LinuxConst.O_RDWR | LinuxConst.O_CREAT, FILE_MODE));
		return int.!(r.0);
	}

	def ensureSize(fd: int, size: u64) -> bool {
		def fileSize = Linux.syscall(LinuxConst.SYS_lseek, (fd, 0, LinuxConst.SEEK_END)).0;
		if (fileSize == i64.view(size)) return true;
		if (Linux.syscall(LinuxConst.SYS_ftruncate, (fd, size)).0 != 0) return false;
		return Linux.syscall(LinuxConst.SYS_fsync, fd).0 == 0;
	}

	def fdatasync(fd: int) -> bool {
		return Linux.syscall(LinuxConst.SYS_fdatasync, fd).0 == 0;
	}

	def close(fd: int) {
		Linux.syscall(LinuxConst.SYS_close, fd);
	}

	def unlink(path: string) {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		Linux.syscall(LinuxConst.SYS_unlink, Pointer.atElement(pathBuf, 0));
	}
}

// Factory for creating backend instances
component X86_64Backends {
	// Use platform-independent backends by default
	def getVolatile() -> TxnRegionBackend {
		return Backends.getVolatile();
	}
	
	// Get mmap-based backend (delegates to platform-independent version)
	def getMmap() -> TxnRegionBackend {
		return Backends.getMmap();
	}
	
	// Get PMEM backend (x86-64 specific with cache flush instructions)
	def getPersistent(path: string) -> TxnRegionBackend {
		return MmapPersistentBackend.new(path);
	}

	def getFileMapped(path: string) -> TxnRegionBackend {
		return MappedFileRegionBackend.new(path);
	}
}
