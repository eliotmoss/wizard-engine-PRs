// x86-64 specific transaction backend implementations

class FdMmapRegion extends BackendRegion {
	def var mapping: Mapping;
	def var fd: int;

	new(mapping: Mapping, fd: int)
		super(CiRuntime.forgeRange<byte>(mapping.range.start, int.!(mapping.range.size()))) { }

	def validRange(offset: u64, size: u64) -> bool {
		def regionSize = u64.!(range.length);
		return offset <= regionSize && size <= regionSize - offset;
	}

	def cleanupBeforeDestroy() { }

	def destroy() {
		cleanupBeforeDestroy();
		if (mapping != null) {
			mapping.range.unmap();
			mapping = null;
		}
		closeFd();
	}

	def closeFd() {
		if (fd >= 0) {
			RegionFileIO.close(fd);
			fd = -1;
		}
	}

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		return false;
	}

	def persistChanges() -> bool {
		return false;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		return false;
	}
}

component MmapRegionUtils {
	def convertProt(prot: int) -> int {
		var mmapProt = Mmap.PROT_NONE;
		if ((prot & BackendProt.READ.mask) != 0) mmapProt |= Mmap.PROT_READ;
		if ((prot & BackendProt.WRITE.mask) != 0) mmapProt |= Mmap.PROT_WRITE;
		if ((prot & BackendProt.EXEC.mask) != 0) mmapProt |= Mmap.PROT_EXEC;
		return mmapProt;
	}

	def pageAlignedSyncRange(region: FdMmapRegion, offset: u64, size: u64) -> bool {
		if (!region.validRange(offset, size)) return false;
		if (size == 0) return true;
		// TODO: define this somewhere else as a constant
		def pageSize = 4096u64;
		def syncStart = offset - (offset % pageSize);
		def rangeEnd = offset + size;
		def syncEnd = ((rangeEnd + pageSize - 1u64) / pageSize) * pageSize;
		return Mmap.sync(region.mapping.range.start + i64.view(syncStart), syncEnd - syncStart, Mmap.MS_SYNC);
	}

	def flushRange(region: FdMmapRegion, offset: u64, size: u64) -> bool {
		if (!region.validRange(offset, size)) return false;
		if (size == 0) return true;
		// Flush cache lines to PMEM
		// CLWB (Cache Line Write Back) is the preferred instruction
		// Falls back to CLFLUSHOPT or CLFLUSH on older CPUs
		var start = Pointer.atElement(region.range, 0) + i64.view(offset);
		var end = start + i64.view(size);
		def cacheLineSize = 64u64; // x86-64 cache line size

		// Flush each cache line
		var addr = u64.view(start);
		def endAddr = u64.view(end);
		addr = addr - (addr % cacheLineSize);
		while (addr < endAddr) {
			flushCacheLine(PWRegionUtils.pointerFromU64(addr));
			addr = addr + cacheLineSize;
		}
		return true;
	}

	// Platform-specific cache flush (requires compiler intrinsic or inline asm)
	private def flushCacheLine(addr: Pointer) {
		// TODO: This needs compiler support for inline assembly
		// Ideally: __builtin_ia32_clwb(addr) or asm volatile("clwb (%0)" :: "r"(addr))
		// For now, this is a placeholder that would need to be implemented
		// with proper x86-64 CLWB/CLFLUSHOPT/CLFLUSH instruction
	}

	// Platform-specific store fence
	def storeFence() {
		// TODO: This needs compiler support for inline assembly
		// Ideally: __builtin_ia32_sfence() or asm volatile("sfence")
		// For now, this is a placeholder
	}
}

class FileMmapRegion extends FdMmapRegion {
	def var hasDirtyChanges = false;

	new(mapping: Mapping, fd: int) super(mapping, fd) { }

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		if (!validRange(offset, size)) return false;
		if (size != 0) hasDirtyChanges = true;
		return true;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		return MmapRegionUtils.pageAlignedSyncRange(this, offset, size);
	}

	def persistChanges() -> bool {
		if (mapping == null || fd < 0) return false;
		if (!hasDirtyChanges) return true;
		if (!RegionFileIO.fdatasync(fd)) return false;

		hasDirtyChanges = false;
		return true;
	}

	def cleanupBeforeDestroy() {
		hasDirtyChanges = false;
	}
}

class PmemMmapRegion extends FdMmapRegion {
	def var hasPendingWriteback = false;

	new(mapping: Mapping, fd: int) super(mapping, fd) { }

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		if (!MmapRegionUtils.flushRange(this, offset, size)) return false;
		if (size != 0) hasPendingWriteback = true;
		return true;
	}

	def persistChanges() -> bool {
		if (mapping == null) return false;
		if (!hasPendingWriteback) return true;
		MmapRegionUtils.storeFence();
		hasPendingWriteback = false;
		return true;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		if (!validRange(offset, size)) return false;
		if (size == 0) return true;
		if (!MmapRegionUtils.flushRange(this, offset, size)) return false;
		MmapRegionUtils.storeFence();
		return true;
	}

	def cleanupBeforeDestroy() {
		hasPendingWriteback = false;
	}
}

// Persistent memory backend using mmap with MAP_SYNC (for PMEM/DAX)
class PmemMmapBackend extends TxnRegionBackend {
	def path: string;  // Path to PMEM device or DAX file

	// TODO: think about whether we want a single path to be able to used to create multiple regions
	new(path) { }

	def create(size: u64, prot: int) -> BackendRegion {
		// TODO: opening an old file and creating a new file should be done with separate methods,
		// because creating a new file would need to populate the file with initial values
		def fd = RegionFileIO.openOrCreate(path);
		if (fd < 0) return null;
		if (!RegionFileIO.ensureSize(fd, size)) {
			RegionFileIO.close(fd);
			return null;
		}

		var mmapProt = MmapRegionUtils.convertProt(prot);
		def mapping = Mmap.map(size, mmapProt, Mmap.MAP_SHARED_VALIDATE | Mmap.MAP_SYNC, fd, 0);
		def region = makePersistentRegion(mapping, fd);
		if (region == null) {
			RegionFileIO.close(fd);
			return null;
		}
		return region;
	}

	def makePersistentRegion(newMapping: Mapping, fd: int) -> PmemMmapRegion {
		if (newMapping == null) return null;
		return PmemMmapRegion.new(newMapping, fd);
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "mmap-pmem";
	}
}

class FileMmapBackend extends TxnRegionBackend {
	def path: string;

	new(path) { }

	def create(size: u64, prot: int) -> BackendRegion {
		def fd = RegionFileIO.openOrCreate(path);
		if (fd < 0) return null;
		if (!RegionFileIO.ensureSize(fd, size)) {
			RegionFileIO.close(fd);
			return null;
		}

		def mmapProt = MmapRegionUtils.convertProt(prot);
		def mapping = Mmap.map(size, mmapProt, Mmap.MAP_SHARED, fd, 0);
		def region = makeFileRegion(mapping, fd);
		if (region == null) {
			RegionFileIO.close(fd);
			return null;
		}
		return region;
	}

	def makeFileRegion(newMapping: Mapping, fd: int) -> FileMmapRegion {
		if (newMapping == null) return null;
		return FileMmapRegion.new(newMapping, fd);
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "mmap-file";
	}
}

component RegionFileIO {
	def FILE_MODE = 420;	// 0644 octal

	def openOrCreate(path: string) -> int {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		var r = Linux.syscall(LinuxConst.SYS_open,
			(Pointer.atElement(pathBuf, 0), LinuxConst.O_RDWR | LinuxConst.O_CREAT, FILE_MODE));
		return int.!(r.0);
	}

	def ensureSize(fd: int, size: u64) -> bool {
		def fileSize = Linux.syscall(LinuxConst.SYS_lseek, (fd, 0, LinuxConst.SEEK_END)).0;
		if (fileSize == i64.view(size)) return true;
		if (Linux.syscall(LinuxConst.SYS_ftruncate, (fd, size)).0 != 0) return false;
		return Linux.syscall(LinuxConst.SYS_fsync, fd).0 == 0;
	}

	def fdatasync(fd: int) -> bool {
		return Linux.syscall(LinuxConst.SYS_fdatasync, fd).0 == 0;
	}

	def close(fd: int) {
		Linux.syscall(LinuxConst.SYS_close, fd);
	}

	def unlink(path: string) {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		Linux.syscall(LinuxConst.SYS_unlink, Pointer.atElement(pathBuf, 0));
	}
}

// Factory for creating backend instances
component X86_64Backends {
	// Use platform-independent backends by default
	def getVolatile() -> TxnRegionBackend {
		return Backends.getVolatile();
	}
	
	// Get mmap-based backend (delegates to platform-independent version)
	def getMmap() -> TxnRegionBackend {
		return Backends.getMmap();
	}
	
	// Get PMEM backend (x86-64 specific with cache flush instructions)
	def getPersistent(path: string) -> TxnRegionBackend {
		return PmemMmapBackend.new(path);
	}

	def getFileMapped(path: string) -> TxnRegionBackend {
		return FileMmapBackend.new(path);
	}
}
