// x86-64 specific transaction backend implementations

class FdMmapRegion extends BackendRegion {
	def var mapping: Mapping;
	def var fd: int;

	new(mapping: Mapping, fd: int)
		super(CiRuntime.forgeRange<byte>(mapping.range.start, int.!(mapping.range.size()))) {
		setPersistentOperations(X86_64PersistentOperations.new(range));
	}

	def validRange(offset: u64, size: u64) -> bool {
		def regionSize = u64.!(range.length);
		return offset <= regionSize && size <= regionSize - offset;
	}

	def cleanupBeforeDestroy() { }

	def destroy() {
		cleanupBeforeDestroy();
		if (mapping != null) {
			mapping.range.unmap();
			mapping = null;
		}
		closeFd();
	}

	def closeFd() {
		if (fd >= 0) {
			RegionFileIO.close(fd);
			fd = -1;
		}
	}

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		return false;
	}

	def persistChanges() -> bool {
		return false;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		return false;
	}
}

component MmapRegionUtils {
	def CACHE_LINE_SIZE = 64u64;
	def PAGE_SIZE = 4096u64;
	private def WRITEBACK_UNSELECTED = 0;
	private def WRITEBACK_CLWB = 1;
	private def WRITEBACK_CLFLUSHOPT = 2;
	private def WRITEBACK_CLFLUSH = 3;
	private def WRITEBACK_UNSUPPORTED = -1;
	private var selectedWriteback = WRITEBACK_UNSELECTED;

	def convertProt(prot: int) -> int {
		var mmapProt = Mmap.PROT_NONE;
		if ((prot & BackendProt.READ.mask) != 0) mmapProt |= Mmap.PROT_READ;
		if ((prot & BackendProt.WRITE.mask) != 0) mmapProt |= Mmap.PROT_WRITE;
		if ((prot & BackendProt.EXEC.mask) != 0) mmapProt |= Mmap.PROT_EXEC;
		return mmapProt;
	}

	def flushRange(region: FdMmapRegion, offset: u64, size: u64) -> bool {
		if (!region.validRange(offset, size)) return false;
		if (size == 0) return true;
		// Flush cache lines to PMEM
		// CLWB (Cache Line Write Back) is the preferred instruction
		// Falls back to CLFLUSHOPT or CLFLUSH on older CPUs
		def end = offset + size;
		var cacheLine = offset - (offset % CACHE_LINE_SIZE);

		// Flush each cache line in ascending region-relative order.
		while (cacheLine < end) {
			region.persistentOperations().clwb(cacheLine);
			cacheLine += CACHE_LINE_SIZE;
		}
		return true;
	}

	// Write one cache line back. CLWB is preferred because the architecture
	// allows it to leave the line cached, which CLFLUSHOPT and CLFLUSH do not;
	// whether it does is the core's choice. Measured (docs/persistent-backends.md):
	// on Cascade Lake it evicts exactly as CLFLUSHOPT does, and on Raptor Lake a
	// re-load after it costs ~12-14 ns against ~53 ns after CLFLUSHOPT. So a
	// store into a line just written back may miss either way, which is why a
	// transaction's after-images are all stored before any line is written back.
	// Falls back to CLFLUSHOPT, then CLFLUSH, on processors without CLWB.
	def flushCacheLine(addr: Pointer) {
		def rawAddr = addr - Pointer.NULL;
		def instruction = writebackInstruction();
		if (instruction == WRITEBACK_CLWB) {
			Target.clwb(rawAddr);
		} else if (instruction == WRITEBACK_CLFLUSHOPT) {
			Target.clflushOpt(rawAddr);
		} else if (instruction == WRITEBACK_CLFLUSH) {
			Target.clflush(rawAddr);
		} else {
			System.error("PersistentOperationError", "no supported cache-line writeback instruction");
		}
	}

	// CPU features cannot change while the process is running. Cache the choice
	// so a large range does not execute CPUID once per cache line.
	private def writebackInstruction() -> int {
		if (selectedWriteback != WRITEBACK_UNSELECTED) return selectedWriteback;
		if (Target.supportsClwb()) {
			selectedWriteback = WRITEBACK_CLWB;
		} else if (Target.supportsClflushOpt()) {
			selectedWriteback = WRITEBACK_CLFLUSHOPT;
		} else if (Target.supportsClflush()) {
			selectedWriteback = WRITEBACK_CLFLUSH;
		} else {
			selectedWriteback = WRITEBACK_UNSUPPORTED;
		}
		return selectedWriteback;
	}

	// Platform-specific store fence
	def storeFence() {
		Target.sfence();
	}
}

// How a FileMmapRegion's fence reaches the file. FDATASYNC and MSYNC both make
// the region a restriction of the PMEM crash model: one fdatasync() of the whole
// file whenever a page is marked, or one msync(MS_SYNC) per run of marked pages.
// LEGACY is the boundary used until 2026-10-13 -- a flag set by
// prepareChangedRange(), an fdatasync() if it is set, and an msync() of a
// persistRange()'s own pages only -- whose trace has no CLWB, so the crash model
// says nothing about it. It is selectable only for the old-against-new
// comparison (pwbench, pwsievebench and pwopsbench boundary=), as is MSYNC for
// the choice of fence; remove both once those comparisons are recorded.
enum FileBoundary(arg: string) {
	FDATASYNC("fdatasync"),
	MSYNC("msync"),
	LEGACY("legacy")
}

// A MAP_SHARED mapping of a regular file. On block storage the region lives in
// the page cache: the kernel owns writeback, may write any dirty page at any
// time, and keeps dirty pages across the death of the process. On a DAX mount
// there is no page cache, and stores reach the media through the CPU cache.
//
// The boundary methods mirror PmemMmapRegion's, as DirectIoRegion's do:
// prepareChangedRange() issues one clwb() per 64-byte line through the
// provider, persistChanges() and persistRange() one sfence(), so a recorded
// trace is the PMEM backend's for the same history. The provider is the direct
// backend's DirectIoOperations, which marks the line's 4 KiB page instead of
// executing CLWB, and every fence syncs the marked pages before it returns, as
// SFENCE completes every outstanding CLWB. A provider whose clwb() does nothing
// (ElidedWritebackOperations) therefore marks nothing, and its fences sync
// nothing: the mutant, as on the direct backend.
//
// What a crash can leave is argued in docs/pmem-crash-model.md ("The file
// backend is a restriction of the PMEM model"): under the assumptions stated
// there, for block storage and for DAX, every durable image is one the PMEM
// model admits for the same trace. A crash inside a fence's sync corresponds to
// the cut just before that fence's SFENCE.
class FileMmapRegion extends FdMmapRegion {
	def var dirty: DirectIoDirtyUnits;
	// Set by preparing a nonzero range, cleared by a successful
	// persistChanges(): PmemMmapRegion's hasPendingWriteback, so the recorded
	// fences match.
	def var hasDirtyChanges = false;
	def var boundary = FileBoundary.FDATASYNC;

	new(mapping: Mapping, fd: int) super(mapping, fd) {
		// Built here rather than in a field initializer: Virgil runs field
		// initializers before super(), when {range} is not yet set.
		def page = MmapRegionUtils.PAGE_SIZE;
		dirty = DirectIoDirtyUnits.new(page, (u64.!(range.length) + page - 1u64) / page);
		wrapProvider(DirectIoStagingOperations.new(range));
	}

	// Install {inner} beneath the page-marking provider. Only before the
	// region reaches PWRegion, which captures the provider at construction.
	def wrapProvider(inner: PersistentOperations) {
		setPersistentOperations(DirectIoOperations.new(inner, dirty));
	}

	// Benchmark-only, with FileMmapBackend.boundary: choose the fence, before
	// the region reaches PWRegion. LEGACY also restores the provider the region
	// had before 2026-10-13, which marks nothing.
	def selectBoundary(b: FileBoundary) {
		boundary = b;
		if (b == FileBoundary.LEGACY) setPersistentOperations(X86_64PersistentOperations.new(range));
	}

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		if (boundary == FileBoundary.LEGACY) {
			if (!validRange(offset, size)) return false;
		} else if (!MmapRegionUtils.flushRange(this, offset, size)) {
			return false;
		}
		if (size != 0) hasDirtyChanges = true;
		onRangePrepared(offset, size);
		return true;
	}

	// Observation hook paired with syncFileData() below. The default backend is
	// intentionally silent; integration tests override it to trace ordering
	// without reimplementing dirty-state transitions.
	def onRangePrepared(offset: u64, size: u64) { }

	// Syncs every marked page, not only this range's: the fence that ends a
	// PMEM persistRange() completes every outstanding CLWB, and the crash
	// model's images depend on that. The pending flag is left as
	// PmemMmapRegion leaves it, so the recorded fences match.
	def persistRange(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		if (!validRange(offset, size)) return false;
		if (size == 0) return true;
		if (boundary == FileBoundary.LEGACY) {
			def pageSize = MmapRegionUtils.PAGE_SIZE;
			def syncStart = offset - (offset % pageSize);
			def rangeEnd = offset + size;
			def syncEnd = ((rangeEnd + pageSize - 1u64) / pageSize) * pageSize;
			return syncMappedRange(syncStart, syncEnd - syncStart);
		}
		if (fd < 0) return false;
		if (!MmapRegionUtils.flushRange(this, offset, size)) return false;
		persistentOperations().sfence();
		return syncMarked();
	}

	// Like syncFileData(), keep the actual range-sync syscall behind a narrow
	// seam. Inputs are validated, page-aligned offsets and sizes computed by
	// syncMarked() (or by a LEGACY persistRange()), so tests can observe the
	// exact translation or inject a syscall failure without duplicating that
	// logic.
	def syncMappedRange(offset: u64, size: u64) -> bool {
		return Mmap.sync(mapping.range.start + i64.view(offset), size, Mmap.MS_SYNC);
	}

	def persistChanges() -> bool {
		if (mapping == null || fd < 0) return false;
		if (!hasDirtyChanges) return true;
		if (boundary == FileBoundary.LEGACY) {
			if (!syncFileData()) return false;
		} else {
			persistentOperations().sfence();
			if (!syncMarked()) return false;
		}

		hasDirtyChanges = false;
		return true;
	}

	// The fence's write-back: make every marked page durable, then forget the
	// marks. fdatasync() also writes any other dirty page of the file, which is
	// a page the kernel could have written back at any time; the model's
	// background eviction admits it. Nothing marked, nothing synced.
	def syncMarked() -> bool {
		if (dirty.isEmpty()) return true;
		if (boundary != FileBoundary.MSYNC) {
			if (!syncFileData()) return false;
		} else {
			def page = MmapRegionUtils.PAGE_SIZE;
			def length = u64.!(range.length);
			def hi = dirty.hi;
			var u = dirty.lo;
			while (u < hi) {
				if (!dirty.isMarked(u)) {
					u++;
					continue;
				}
				var end = u + 1u64;
				while (end < hi && dirty.isMarked(end)) end++;
				var size = (end - u) * page;
				if (u * page + size > length) size = length - u * page;
				if (!syncMappedRange(u * page, size)) return false;
				u = end;
			}
		}
		dirty.clear();
		return true;
	}

	// Keep the syscall behind a narrow virtual seam so backend integration tests
	// can observe its ordering and inject failures without replacing the
	// FileMmapRegion persistence state machine.
	def syncFileData() -> bool {
		return RegionFileIO.fdatasync(fd);
	}

	// Nothing is synced on destroy: the page cache keeps what was not, and the
	// WAL's close() is the clean path.
	def cleanupBeforeDestroy() {
		hasDirtyChanges = false;
		if (dirty != null) dirty.clear();
	}

	// fdatasync of region data plus a superblock msync per checkpoint.
	def checkpointCost() -> CheckpointCost {
		return CheckpointCost.EXPENSIVE;
	}
}

class PmemMmapRegion extends FdMmapRegion {
	def var hasPendingWriteback = false;

	new(mapping: Mapping, fd: int) super(mapping, fd) { }

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		if (!MmapRegionUtils.flushRange(this, offset, size)) return false;
		if (size != 0) hasPendingWriteback = true;
		return true;
	}

	def persistChanges() -> bool {
		if (mapping == null) return false;
		if (!hasPendingWriteback) return true;
		persistentOperations().sfence();
		hasPendingWriteback = false;
		return true;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		if (!validRange(offset, size)) return false;
		if (size == 0) return true;
		if (!MmapRegionUtils.flushRange(this, offset, size)) return false;
		persistentOperations().sfence();
		return true;
	}

	def cleanupBeforeDestroy() {
		hasPendingWriteback = false;
	}

	// Only store fences on the persist path, so checkpoints are cheap here.
	def checkpointCost() -> CheckpointCost {
		return CheckpointCost.CHEAP;
	}
}

// Persistent memory backend using mmap with MAP_SYNC (for PMEM/DAX)
class PmemMmapBackend extends TxnRegionBackend {
	def path: string;  // Path to PMEM device or DAX file

	// TODO: think about whether we want a single path to be able to used to create multiple regions
	new(path) { }

	def create(size: u64, prot: int, fresh: bool) -> BackendRegion {
		def fd = RegionFileIO.openBacking(path, fresh);
		if (fd < 0) return null;
		if (!RegionFileIO.ensureSize(fd, size)) {
			RegionFileIO.close(fd);
			return null;
		}

		var mmapProt = MmapRegionUtils.convertProt(prot);
		def mapping = Mmap.map(size, mmapProt, Mmap.MAP_SHARED_VALIDATE | Mmap.MAP_SYNC, fd, 0);
		def region = makePersistentRegion(mapping, fd);
		if (region == null) {
			RegionFileIO.close(fd);
			return null;
		}
		return region;
	}

	def makePersistentRegion(newMapping: Mapping, fd: int) -> PmemMmapRegion {
		if (newMapping == null) return null;
		return PmemMmapRegion.new(newMapping, fd);
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "mmap-pmem";
	}
}

class FileMmapBackend extends TxnRegionBackend {
	def path: string;
	// Benchmark-only: the fence every region this backend creates uses (see
	// FileBoundary).
	def var boundary = FileBoundary.FDATASYNC;

	new(path) { }

	def create(size: u64, prot: int, fresh: bool) -> BackendRegion {
		def fd = RegionFileIO.openBacking(path, fresh);
		if (fd < 0) return null;
		if (!RegionFileIO.ensureSize(fd, size)) {
			RegionFileIO.close(fd);
			return null;
		}

		def mmapProt = MmapRegionUtils.convertProt(prot);
		def mapping = Mmap.map(size, mmapProt, Mmap.MAP_SHARED, fd, 0);
		def region = makeFileRegion(mapping, fd);
		if (region == null) {
			RegionFileIO.close(fd);
			return null;
		}
		if (boundary != FileBoundary.FDATASYNC) region.selectBoundary(boundary);
		return region;
	}

	def makeFileRegion(newMapping: Mapping, fd: int) -> FileMmapRegion {
		if (newMapping == null) return null;
		return FileMmapRegion.new(newMapping, fd);
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "mmap-file";
	}
}

component RegionFileIO {
	def FILE_MODE = 420;	// 0644 octal
	def PRIVATE_FILE_MODE = 384;	// 0600 octal

	// Build a null-terminated C string for the given path.
	private def toCPath(path: string) -> Array<byte> {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		return pathBuf;
	}

	// Open an existing region file for read/write. Does not create it: returns a
	// negative value (-errno, e.g. -ENOENT) if the file does not exist.
	def open(path: string) -> int {
		var pathBuf = toCPath(path);
		var r = Linux.syscall(LinuxConst.SYS_open,
			(Pointer.atElement(pathBuf, 0), LinuxConst.O_RDWR, FILE_MODE));
		return int.!(r.0);
	}

	// Create (or re-create) a fresh region file for read/write. O_TRUNC clears any
	// stale content to length 0; the subsequent ensureSize()->ftruncate() extension
	// is zero-filled by the kernel, so the resulting region is zero-initialised.
	def create(path: string) -> int {
		var pathBuf = toCPath(path);
		var r = Linux.syscall(LinuxConst.SYS_open,
			(Pointer.atElement(pathBuf, 0), LinuxConst.O_RDWR | LinuxConst.O_CREAT | LinuxConst.O_TRUNC, FILE_MODE));
		return int.!(r.0);
	}

	// Atomically reserve a new private file without following or replacing an
	// existing name. Used by shared-machine integration runners before they hand
	// a generated path to a backend whose fresh-format contract includes O_TRUNC.
	def createExclusive(path: string) -> int {
		var pathBuf = toCPath(path);
		var r = Linux.syscall(LinuxConst.SYS_open,
			(Pointer.atElement(pathBuf, 0),
			 LinuxConst.O_RDWR | LinuxConst.O_CREAT | LinuxConst.O_EXCL,
			 PRIVATE_FILE_MODE));
		return int.!(r.0);
	}

	// Obtain a backing fd for a region: a fresh format re-creates the file (zeroed),
	// otherwise attach to the existing file, creating it zeroed if it is missing.
	def openBacking(path: string, fresh: bool) -> int {
		if (fresh) return create(path);
		var fd = open(path);
		if (fd < 0) fd = create(path);  // missing -> fresh, zeroed
		return fd;
	}

	def ensureSize(fd: int, size: u64) -> bool {
		def fileSize = Linux.syscall(LinuxConst.SYS_lseek, (fd, 0, LinuxConst.SEEK_END)).0;
		if (fileSize == i64.view(size)) return true;
		if (Linux.syscall(LinuxConst.SYS_ftruncate, (fd, size)).0 != 0) return false;
		return Linux.syscall(LinuxConst.SYS_fsync, fd).0 == 0;
	}

	def fdatasync(fd: int) -> bool {
		return Linux.syscall(LinuxConst.SYS_fdatasync, fd).0 == 0;
	}

	def close(fd: int) {
		Linux.syscall(LinuxConst.SYS_close, fd);
	}

	// NOTE: intentionally inlines the C-string construction rather than calling
	// toCPath(). Routing this through toCPath() (a third caller) shifts Virgil's
	// inlining/stackmap layout enough to trip a latent precise-GC bug that crashes
	// unrelated interpreter GC tests (e.g. int:force_gc1). Keep this inline.
	def unlink(path: string) -> bool {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		return Linux.syscall(LinuxConst.SYS_unlink, Pointer.atElement(pathBuf, 0)).0 == 0;
	}
}

// Factory for creating backend instances
component X86_64Backends {
	// Use platform-independent backends by default
	def getVolatile() -> TxnRegionBackend {
		return Backends.getVolatile();
	}
	
	// Get mmap-based backend (delegates to platform-independent version)
	def getMmap() -> TxnRegionBackend {
		return Backends.getMmap();
	}
	
	// Get PMEM backend (x86-64 specific with cache flush instructions)
	def getPersistent(path: string) -> TxnRegionBackend {
		return PmemMmapBackend.new(path);
	}

	def getFileMapped(path: string) -> TxnRegionBackend {
		return FileMmapBackend.new(path);
	}
}
