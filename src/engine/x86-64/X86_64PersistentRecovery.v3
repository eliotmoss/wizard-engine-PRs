// Production recovery over an enumerated durable image.
//
// Milestone 5 of docs/pmem-crash-model.md. The explorer produces the byte
// images a crash can leave; this layer mounts one and runs the real
// DualTxnWal recovery path over it, so a property is checked against the
// program rather than against a second model of it. Reimplementing recovery
// inside the checker could only prove that a correct model of an incorrect
// program agrees with itself.
//
// The run is self-contained: the image is copied into a fresh region, a WAL is
// opened over it WITHOUT fresh initialization (this is a remount, not a
// format), recover() runs, and the resulting bytes are frozen back into an
// image before the region is released.
//
// Mounting an image is done through PersistentImageMounts, which offers the two
// containers deliberately rather than by accident:
//
//   - openArray() is a plain region in an anonymous mapping (AnonMappedRegion).
//     Its persistence boundaries succeed without reaching the writeback/fence
//     hooks, which is exactly right when only recovery's effect on bytes
//     matters -- the simulator, not the backend, already decided which bytes
//     survived. Until 2026-10-19 it was a byte array on Virgil's heap (hence
//     the name), which the collector can move under the mounted code (see
//     AnonMappedRegion); a mapping costs an mmap and a munmap per image.
//     openFailing() is the same container with boundaries that fail once, at
//     a chosen call (InjectedFailureRegion).
//   - openMapped() is a PmemMmapRegion, so its boundaries translate into
//     cache-line writebacks and fences on the region's provider. With a
//     recording provider installed, recovery's own stores, CLWBs and fences are
//     captured as a trace, which is the input to a bounded second crash DURING
//     recovery (milestone 7). Recording through the production PMEM region
//     rather than a copy of its translation is what keeps that trace evidence
//     about the real seam.

// What production recovery did with one durable image, and the bytes it left.
// {left} is those bytes as the mount's snapshot() gave them: a durable image
// when the mount held concrete bytes, and a lazy snapshot when it was one of a
// lazy search's mounts (X86_64PersistentLazyExplorer.v3), whose bytes recovery
// neither stored nor loaded may still stand for undecided crash-image bytes.
// {recovered} is the same bytes as a durable image, and null for a lazy run.
class PersistentRecoveryRun(recovery: DualWalRecovery, requiresRecovery: bool,
	nextTxnSeq: u64, lastCommittedSeq: u64, dataDurableSeq: u64,
	left: PersistentImageView) {

	def recovered: PersistentDurableImage = if(PersistentDurableImage.?(left),
		PersistentDurableImage.!(left), null);

	def render(buf: StringBuilder) -> StringBuilder {
		buf.put1("recovery=%s", recovery.name);
		buf.put1(" requiresRecovery=%z", requiresRecovery);
		buf.put3(" nextTxnSeq=%d lastCommittedSeq=%d dataDurableSeq=%d",
			nextTxnSeq, lastCommittedSeq, dataDurableSeq);
		return buf;
	}
}

// One durable image, mounted as a region. {recorder} is non-null only for a
// mount that records what the code under test does to it.
class PersistentImageMount(region: BackendRegion, recorder: RecordingPersistentOperations) {

	// The bytes as they stand now, frozen into an image. A raw copy, outside
	// the load seam on purpose: it runs after the code under test has
	// finished, and properties read the frozen copy, so it is not a load
	// recovery makes and no load observer should see it. The same holds for
	// the copies taken after an allocator check below.
	def freeze() -> PersistentDurableImage {
		def after = Array<byte>.new(region.range.length);
		for (i < after.length) after[i] = region.range[i];
		return PersistentDurableImage.new(after);
	}

	// The bytes as a property may read them afterwards. Here the frozen copy;
	// a lazy search's mount returns a snapshot that keeps the bytes the code
	// under test neither stored nor loaded as marks, so that freezing a mount
	// decides nothing (PersistentLazyMount).
	def snapshot() -> PersistentImageView {
		return freeze();
	}

	def regionStart() -> u64 {
		return u64.view(Pointer.atElement(region.range, 0));
	}

	def close() {
		region.destroy();
	}
}

// How a property mounts the images it is handed. A property written against a
// mounter, rather than against PersistentImageMounts directly, runs unchanged
// in an eager check, where every image is a PersistentDurableImage mounted in a
// fresh mapping, and in the lazy search, whose mounter hands out mounts of the
// crash image it is materialising (PersistentLazySearch). Returns null if the
// host refused a mapping.
class PersistentImageMounter {
	def mount(image: PersistentImageView) -> PersistentImageMount;
}

// The eager mounter: a mapped PMEM container per image, as runDualWal() has
// always mounted one. With {record} set every mount records its stores,
// writebacks, fences and loads, kept in {logs} in mount order, so a run can be
// compared with another run of the same code.
class PersistentEagerMounter(record: bool) extends PersistentImageMounter {
	def logs = Vector<PersistentMountLog>.new();

	def mount(image: PersistentImageView) -> PersistentImageMount {
		if (!PersistentDurableImage.?(image)) {
			System.error("PersistentMountError", "an eager mount needs a durable image, not a lazy view");
		}
		def m = PersistentImageMounts.openMapped(PersistentDurableImage.!(image), record);
		if (m != null && record) logs.put(PersistentMountLog.new(m.recorder, m.recorder.recordLoads()));
		return m;
	}
}

component PersistentImageMounters {
	// What every eager property check mounts through.
	def EAGER = PersistentEagerMounter.new(false);
}

// What one recorded mount did: its stores, writebacks and fences, and its
// loads, in their recorded order.
class PersistentMountLog(stores: RecordingPersistentOperations, loads: RecordingLoadObserver) {

	// The first way {that} differs from this mount, or null.
	def difference(that: PersistentMountLog) -> string {
		def x = stores.events, y = that.stores.events;
		if (x.length != y.length) {
			return Strings.format2("%d persistent operations against %d", x.length, y.length);
		}
		for (i < x.length) {
			def a = x[i], b = y[i];
			if (a.seq != b.seq || a.kind != b.kind || a.offset != b.offset
				|| a.width != b.width || a.value != b.value) {
				return a.render(Strings.builderOf("persistent operation differs: ")).puts(" against ")
					.puts(b.render(StringBuilder.new()).toString()).toString();
			}
		}
		def p = loads.loads, q = that.loads.loads;
		if (p.length != q.length) return Strings.format2("%d loads against %d", p.length, q.length);
		for (i < p.length) {
			if (!p[i].same(q[i])) {
				return p[i].render(Strings.builderOf("load differs: ")).puts(" against ")
					.puts(q[i].render(StringBuilder.new()).toString()).toString();
			}
		}
		return null;
	}
}

// A region in an anonymous mapping whose persistence boundaries succeed
// without reaching the writeback/fence hooks, as VolatileRegion's do. A byte
// array on Virgil's heap would not do: the semispace collector moves it, and
// PWRegion and DualTxnWal keep the region's start as a raw address and forge
// every handle from it, so after a collection they read the old copy while
// their stores, which go through the region's range, reach the moved one, and
// the next collection reuses the old copy's memory. A mapping does not move.
// The region holds the Mapping, so the mapping's finalizer cannot unmap it
// while the region is in use; destroy() unmaps it.
class AnonMappedRegion extends VolatileRegion {
	var mapping: Mapping;

	new(m: Mapping) super(CiRuntime.forgeRange<byte>(m.range.start, int.!(m.range.size()))) {
		mapping = m;
	}

	def destroy() {
		if (mapping != null) {
			mapping.range.unmap();
			mapping = null;
		}
	}
}

component PersistentImageMounts {
	// Plain container (AnonMappedRegion): persistence boundaries succeed
	// without reaching the writeback/fence hooks. Use this when only the effect
	// of the mounted code on the bytes matters. Named for the heap byte array
	// it used until 2026-10-19. Returns null if the host refused a mapping.
	def openArray(image: PersistentDurableImage) -> PersistentImageMount {
		def mapping = Mmap.reserve(u64.!(image.size()), Mmap.PROT_READ | Mmap.PROT_WRITE);
		if (mapping == null) return null;
		def region = AnonMappedRegion.new(mapping);
		for (i < image.size()) region.range[i] = image.bytes[i];
		return PersistentImageMount.new(region, null);
	}

	// The plain container with persistence boundaries that fail once, at call
	// {failAtBoundary} (InjectedFailureRegion). Returns null if the host
	// refused a mapping.
	def openFailing(image: PersistentDurableImage, failAtBoundary: int) -> PersistentImageMount {
		def mapping = Mmap.reserve(u64.!(image.size()), Mmap.PROT_READ | Mmap.PROT_WRITE);
		if (mapping == null) return null;
		def region = InjectedFailureRegion.new(mapping, failAtBoundary);
		for (i < image.size()) region.range[i] = image.bytes[i];
		return PersistentImageMount.new(region, null);
	}

	// Mapped PMEM container, whose boundaries translate into writebacks and
	// fences on the region's provider. With {record} set, those -- and every
	// persistent store -- are captured, so the mounted run can itself be
	// explored for a further crash. Returns null if the host refused a mapping.
	def openMapped(image: PersistentDurableImage, record: bool) -> PersistentImageMount {
		def mapping = Mmap.reserve(u64.!(image.size()), Mmap.PROT_READ | Mmap.PROT_WRITE);
		if (mapping == null) return null;
		def region = PmemMmapRegion.new(mapping, -1);
		for (i < image.size()) region.range[i] = image.bytes[i];
		var recorder: RecordingPersistentOperations;
		if (record) {
			recorder = RecordingPersistentOperations.new(region.range);
			region.setPersistentOperations(recorder);
		}
		return PersistentImageMount.new(region, recorder);
	}
}

// The plain container (AnonMappedRegion) with persistence boundaries that fail
// once, at a chosen call. The plain mount cannot otherwise express a failed
// persist, and a failed persist during recovery is precisely the case where an
// acknowledged transaction could be lost if the WAL reclaimed a record it had
// not durably replayed. Until 2026-10-19 it was over a heap byte array.
class InjectedFailureRegion extends AnonMappedRegion {
	def failAtBoundary: int;	// 1 = the first boundary, 0 = never fail
	var boundaries = 0;

	new(mapping: Mapping, failAtBoundary) super(mapping) { }

	def persistRange(offset: u64, size: u64) -> bool {
		return boundary();
	}

	def persistChanges() -> bool {
		return boundary();
	}

	private def boundary() -> bool {
		boundaries++;
		return boundaries != failAtBoundary;
	}
}

// A backend that hands out one already-prepared region, so a PWRegion can be
// mounted over a container the caller chose -- a recording one, or one that
// injects a persistence failure.
class PreparedRegionBackend(prepared: BackendRegion) extends TxnRegionBackend {
	def create(size: u64, prot: int, fresh: bool) -> BackendRegion {
		if (prepared == null || u64.!(prepared.range.length) < size) return null;
		return prepared;
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "prepared-region";
	}
}

// A recovery run together with the trace of what recovery itself made durable.
// The trace's starting durable image is the image recovery was handed, so
// exploring it is exploring a second crash during recovery.
class PersistentRecoveryRecording(run: PersistentRecoveryRun, trace: PersistentTrace) { }

// The same for an allocator mount: what the mount produced, plus the trace of
// what it made durable.
class PersistentRegionRecording(run: PersistentRegionRun, trace: PersistentTrace) { }

component PersistentRecoveries {
	// Mount {image} and run the production two-slot WAL recovery over it.
	// Returns null only when the host could not provide a region.
	def runDualWal(image: PersistentDurableImage, logChunkOffset: u64,
		logChunkSize: u64) -> PersistentRecoveryRun {

		return runDualWalOn(PersistentImageMounters.EAGER, image, logChunkOffset, logChunkSize);
	}

	// The same run over a mount {mounter} provides: the eager mounter's fresh
	// mapping, or the lazy search's mapping of the crash image it is deciding.
	// The run's {left} is the mount's snapshot().
	def runDualWalOn(mounter: PersistentImageMounter, image: PersistentImageView,
		logChunkOffset: u64, logChunkSize: u64) -> PersistentRecoveryRun {

		def mount = mounter.mount(image);
		if (mount == null) return null;
		def run = recoverOn(mount, logChunkOffset, logChunkSize);
		mount.close();
		return run;
	}

	// The same run, recorded: every store, cache-line writeback and fence
	// recovery performs is captured, so a crash DURING recovery can be explored
	// with the same machinery as a crash during normal operation.
	def recordDualWalRecovery(image: PersistentDurableImage, logChunkOffset: u64,
		logChunkSize: u64, name: string) -> PersistentRecoveryRecording {

		def mount = PersistentImageMounts.openMapped(image, true);
		if (mount == null) return null;
		def run = recoverOn(mount, logChunkOffset, logChunkSize);
		def trace = mount.recorder.snapshot(name);
		mount.close();
		return PersistentRecoveryRecording.new(run, trace);
	}

	private def recoverOn(mount: PersistentImageMount, logChunkOffset: u64,
		logChunkSize: u64) -> PersistentRecoveryRun {

		def base = mount.regionStart();
		def wal = DualTxnWal.new(base, base + logChunkOffset, logChunkSize, mount.region, false);
		def result = wal.recover();
		return PersistentRecoveryRun.new(result, wal.requiresRecovery(), wal.nextTxnSeq,
			wal.lastCommittedSeq, wal.dataDurableSeq, mount.snapshot());
	}

	// The same recovery, with one persistence boundary failed. The WAL must
	// latch rather than claim a durability it did not reach, and the bytes left
	// behind must still be recoverable by a later mount. Returns null only when
	// the host could not provide a region.
	def runDualWalWithFailure(image: PersistentDurableImage, logChunkOffset: u64,
		logChunkSize: u64, failAtBoundary: int) -> PersistentRecoveryRun {

		def mount = PersistentImageMounts.openFailing(image, failAtBoundary);
		if (mount == null) return null;
		def run = recoverOn(mount, logChunkOffset, logChunkSize);
		mount.close();
		return run;
	}

	// Mount {image} as an allocator through a recording container, so the whole
	// mount -- WAL recovery plus whatever the allocator publishes -- is captured
	// as a trace that a second crash can be explored over.
	def recordPWRegionRecovery(image: PersistentDurableImage, numBlocks: u64,
		blockSize: u64, name: string) -> PersistentRegionRecording {

		def mount = PersistentImageMounts.openMapped(image, true);
		if (mount == null) return null;
		def region = PWRegion.new(PreparedRegionBackend.new(mount.region), numBlocks,
			Array<Ref<MetaDataDesc>>.new(0), blockSize, false);
		if (region.backendRegion == null) {
			mount.close();
			return null;
		}
		def violation = PersistentAllocatorInvariants.check(region);
		def run = PersistentRegionRun.new(true, region.requiresRecovery(), violation, mount.freeze());
		def trace = mount.recorder.snapshot(name);
		region.deallocate();
		return PersistentRegionRecording.new(run, trace);
	}

	// Mount {image} as an allocator with one persistence boundary failed.
	def runPWRegionWithFailure(image: PersistentDurableImage, numBlocks: u64,
		blockSize: u64, failAtBoundary: int) -> PersistentRegionRun {

		def mount = PersistentImageMounts.openFailing(image, failAtBoundary);
		if (mount == null) {
			return PersistentRegionRun.new(false, false, "could not map a region for the durable image", null);
		}
		def region = PWRegion.new(PreparedRegionBackend.new(mount.region), numBlocks,
			Array<Ref<MetaDataDesc>>.new(0), blockSize, false);
		if (region.backendRegion == null) {
			mount.close();
			return PersistentRegionRun.new(false, false, "region did not mount", null);
		}
		def violation = PersistentAllocatorInvariants.checkStructure(region);
		def after = Array<byte>.new(region.rng.length);
		for (i < after.length) after[i] = region.rng[i];
		def run = PersistentRegionRun.new(true, region.requiresRecovery(), violation,
			PersistentDurableImage.new(after));
		region.deallocate();
		return run;
	}

	// Every durable image a SECOND crash, during recovery from {image}, can
	// leave must still satisfy {property}: the log record has not been scrubbed,
	// and replay is idempotent, so a remount must reach the same state.
	// Bounded to two crashes in total, matching the recovery profile in
	// docs/pmem-crash-model.md.
	def checkCrashDuringRecovery(image: PersistentDurableImage, logChunkOffset: u64,
		logChunkSize: u64, budget: int, property: PersistentImageProperty) -> PersistentCheckResult {

		def recording = recordDualWalRecovery(image, logChunkOffset, logChunkSize, "dual_wal_recovery");
		if (recording == null) return null;
		return PersistentExplorer.checkAllCuts(recording.trace, image.bytes, budget, property);
	}
}

// The acknowledgement contract, as a property the explorer can check over every
// image a crash cut permits.
//
// Every image must mount and recover without leaving the mount unusable, and
// recovery must be idempotent -- recovering the bytes recovery just produced
// must not change the after-image again.
//
// {mustSurvive} distinguishes the two halves of the contract:
//
//   - true: the transaction was acknowledged before this cut, so its
//     after-image MUST be present after recovery on every schedule;
//   - false: it was not acknowledged, so it may be absent or may replay if a
//     complete valid record reached durability -- but it must never produce a
//     value that was never committed, which is what a torn record replayed as
//     valid would look like.
class PersistentWalRecoveryProperty(logChunkOffset: u64, logChunkSize: u64,
	offset: u64, width: int, value: u64, mustSurvive: bool) {

	// One entry is a history of length one, so the contract has a single
	// implementation rather than two that must be kept saying the same thing.
	private def history = PersistentWalHistoryProperty.new(logChunkOffset, logChunkSize,
		[PersistentWalAfterImage.new(offset, width, value, mustSurvive)]);

	def check(image: PersistentDurableImage) -> string {
		return history.check(image);
	}

	def property(name: string) -> PersistentImageProperty {
		return PersistentImageProperty.new(name, offset, 16, check);
	}

	// The same check for the lazy search (PersistentLazyExplorer).
	def lazy(name: string) -> PersistentLazyProperty {
		return history.lazy(name, offset, 16);
	}
}

// One after-image a recorded scenario wrote, and whether the transaction
// carrying it was already acknowledged at the crash cut being checked.
class PersistentWalAfterImage(offset: u64, width: int, value: u64, mustSurvive: bool) { }

// The same contract over a history of transactions rather than a single one.
//
// A multi-transaction scenario is where the contract has content beyond one
// commit: with only two record slots, transaction N+2 reclaims transaction N's
// slot, so the record that proved N is destroyed while the WAL is still
// running. What must then hold is that N's after-image is durable DATA by the
// time its record goes -- the overwrite guard's whole claim -- and that is a
// statement about several after-images at once, not about the one the current
// transaction is writing.
//
// One mount checks them all: a sweep already mounts every image the cut permits
// and a per-after-image property would multiply that by the length of the
// history.
class PersistentWalHistoryProperty(logChunkOffset: u64, logChunkSize: u64,
	afterImages: Array<PersistentWalAfterImage>) {

	def check(image: PersistentDurableImage) -> string {
		return checkOn(image, PersistentImageMounters.EAGER);
	}

	// The contract itself, over whatever {mounter} mounts: the eager check
	// above and the lazy search run this one body. It is lazy-safe because
	// every byte it depends on is either loaded by recovery through the
	// region's reader or read from a run's {left} with read(), which decides
	// the bytes it reads, and the idempotence run mounts {left} through the
	// same mounter.
	def checkOn(image: PersistentImageView, mounter: PersistentImageMounter) -> string {
		def run = PersistentRecoveries.runDualWalOn(mounter, image, logChunkOffset, logChunkSize);
		if (run == null) return "could not map a region for the durable image";
		if (run.recovery == DualWalRecovery.PERSIST_FAILED) {
			return detail("recovery reported PERSIST_FAILED", run, null);
		}
		if (run.requiresRecovery) {
			return detail("recovery left the mount recovery-required", run, null);
		}

		for (i < afterImages.length) {
			def a = afterImages[i];
			def got = run.left.read(a.offset, a.width);
			if (a.mustSurvive) {
				if (got != a.value) {
					return detail("acknowledged after-image absent after recovery", run, a);
				}
			} else if (got != 0u64 && got != a.value) {
				return detail("recovery produced a value that was never committed", run, a);
			}
		}

		// Recovery is idempotent: replaying the image recovery just produced
		// must not change any after-image or fail.
		def again = PersistentRecoveries.runDualWalOn(mounter, run.left, logChunkOffset, logChunkSize);
		if (again == null) return "could not map a region for the recovered image";
		if (again.recovery == DualWalRecovery.PERSIST_FAILED || again.requiresRecovery) {
			return detail("second recovery over the recovered image failed", again, null);
		}
		for (i < afterImages.length) {
			def a = afterImages[i];
			if (again.left.read(a.offset, a.width) != run.left.read(a.offset, a.width)) {
				return detail("recovery is not idempotent", again, a);
			}
		}
		return null;
	}

	def property(name: string, windowOffset: u64, windowLength: int) -> PersistentImageProperty {
		return PersistentImageProperty.new(name, windowOffset, windowLength, check);
	}

	// The same contract for the lazy search (PersistentLazyExplorer).
	def lazy(name: string, windowOffset: u64, windowLength: int) -> PersistentLazyProperty {
		return PersistentLazyProperty.new(name, windowOffset, windowLength, checkOn);
	}

	private def detail(text: string, run: PersistentRecoveryRun,
		a: PersistentWalAfterImage) -> string {

		def buf = StringBuilder.new().put1("%s: ", text);
		run.render(buf);
		if (a != null) {
			buf.put1(" offset=%d", a.offset);
			buf.puts(" durable=0x").putx_64(run.left.read(a.offset, a.width));
		}
		return buf.toString();
	}
}

// Recovery that cannot persist what it replayed. A failed boundary must latch
// the mount rather than let it claim a durability it did not reach, and -- the
// property that matters -- the bytes such an attempt leaves behind must still
// be recoverable by a later mount. A recovery that reclaimed or scrubbed a
// record it had not durably replayed would fail this even though its own
// return value looked honest.
class PersistentRecoveryFailureProperty(logChunkOffset: u64, logChunkSize: u64,
	offset: u64, width: int, value: u64, mustSurvive: bool, failAtBoundary: int) {

	def check(image: PersistentDurableImage) -> string {
		def failed = PersistentRecoveries.runDualWalWithFailure(image, logChunkOffset,
			logChunkSize, failAtBoundary);
		if (failed == null) return "could not mount the durable image";
		if (failed.recovery == DualWalRecovery.PERSIST_FAILED && !failed.requiresRecovery) {
			return "recovery reported PERSIST_FAILED without latching the mount";
		}
		if (failed.requiresRecovery && failed.recovery != DualWalRecovery.PERSIST_FAILED) {
			return "recovery latched the mount without reporting PERSIST_FAILED";
		}
		return PersistentWalRecoveryProperty.new(logChunkOffset, logChunkSize, offset,
			width, value, mustSurvive).check(failed.recovered);
	}

	def property(name: string) -> PersistentImageProperty {
		return PersistentImageProperty.new(name, offset, 16, check);
	}
}

// A backend that hands a PWRegion one durable image to mount. `fresh` is
// ignored: the point of this backend is that the bytes are the crash image, not
// a fresh format.
class PersistentImageBackend(image: PersistentDurableImage) extends TxnRegionBackend {

	def create(size: u64, prot: int, fresh: bool) -> BackendRegion {
		if (u64.!(image.size()) < size) return null;
		// The plain container: a sweep mounts thousands of images and only the
		// bytes recovery leaves behind are examined. See PersistentImageMounts.
		// Null if the host refused a mapping, which PWRegion reports as a
		// region that did not mount.
		def mount = PersistentImageMounts.openArray(image);
		if (mount == null) return null;
		return mount.region;
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "persistent-image";
	}
}

// What mounting one durable image as an allocator produced.
class PersistentRegionRun(mounted: bool, requiresRecovery: bool, violation: string,
	recovered: PersistentDurableImage) { }

// Structural check of a mounted allocator, as a first-violation string rather
// than as assertions, so the same walk serves a unit test and a crash-model
// property. The rules are the allocator's own invariants: the memory-order
// chain is acyclic, index-increasing and doubly linked, ending at the region
// marker; a free extent is classified by its actual span and appears exactly
// once on the matching free list; free extents are never adjacent; and a used
// entry is on no list at all.
component PersistentAllocatorInvariants {
	// Structure plus mount state. This is what a mount that completed its
	// recovery must satisfy.
	def check(region: PWRegion) -> string {
		def bad = checkStructure(region);
		if (bad != null) return bad;
		if (region.requiresRecovery()) return "mount is recovery-required after recovery";
		if (region.txn.isDirty()) return "mount left buffered writes in the transaction";
		return null;
	}

	// Structure alone. A mount whose persistence failed is *expected* to be
	// recovery-required, but its on-region structure must still be walkable --
	// a latched mount is not a licence to leave a broken chain behind.
	def checkStructure(region: PWRegion) -> string {
		if (region == null || region.backendRegion == null) return "region did not mount";
		// Every load goes through the region's reader, so a load observer
		// sees the entries this walk visits.
		def r = region.reader();
		def entryCount = int.!(region.numBlocks + 1u64);
		def memorySeen = Array<bool>.new(entryCount);
		def freeByIndex = Array<bool>.new(entryCount);
		def listed = Array<bool>.new(entryCount);

		var previous = BlockEntryHandle(0u64);
		var current = region.blockTableHandle[0u64];
		var reachedEnd = false;
		var steps = 0;
		while (!current.isNull()) {
			if (steps >= entryCount) return "memory-order cycle detected";
			if (!isBlockTableEntry(region, current)) return "memory-order link points outside block table";

			def index = region.blockIndexOf(current);
			def arrayIndex = int.!(index);
			if (memorySeen[arrayIndex]) return at("block appears twice in memory order", index);
			memorySeen[arrayIndex] = true;
			if (previous.addr != current.getPrev(r).addr) return at("memory-order back link is wrong", index);

			def next = current.getNext(r);
			if (index == region.numBlocks) {
				if (!current.getUsed(r)) return "region marker is not marked used";
				if (current.getListNum(r) != ListKind.NONE.code) return "region marker is on a free list";
				if (!next.isNull() || !current.getListPrev(r).isNull() || !current.getListNext(r).isNull()) {
					return "region marker has non-null links";
				}
				reachedEnd = true;
				break;
			}
			if (!isBlockTableEntry(region, next)) return at("memory-order chain ends before region marker", index);

			def nextIndex = region.blockIndexOf(next);
			if (nextIndex <= index) return at("memory-order block indices are not increasing", index);
			if (current.addr != next.getPrev(r).addr) return at("memory-order forward link is not mirrored", index);

			if (current.getUsed(r)) {
				def kind = current.getListNum(r);
				if (kind != ListKind.NONE.code && kind != ListKind.METADATA.code) {
					return at("used block carries a free-list kind", index);
				}
				if (!current.getListPrev(r).isNull() || !current.getListNext(r).isNull()) {
					return at("used block is linked into a free list", index);
				}
			} else {
				def extentBlocks = nextIndex - index;
				def expected = if(extentBlocks == 1u64, ListKind.SMALL_FREE.code, ListKind.LARGE_FREE.code);
				if (current.getListNum(r) != expected) return at("free block is on the wrong free list", index);
				if (!previous.isNull() && !previous.getUsed(r)) {
					return at("adjacent free extents were not coalesced", index);
				}
				freeByIndex[arrayIndex] = true;
			}

			previous = current;
			current = next;
			steps++;
		}
		if (!reachedEnd) return "memory-order chain does not reach the region marker";

		var bad = walkFreeList(region, region.smallSentinel, ListKind.SMALL_FREE, listed);
		if (bad != null) return bad;
		bad = walkFreeList(region, region.largeSentinel, ListKind.LARGE_FREE, listed);
		if (bad != null) return bad;
		for (i < entryCount) {
			if (freeByIndex[i] != listed[i]) {
				return at("free block is missing from or extra on the free lists", u64.!(i));
			}
		}

		return null;
	}

	private def walkFreeList(region: PWRegion, sentinel: BlockEntryHandle, kind: ListKind,
		listed: Array<bool>) -> string {

		def r = region.reader();
		var previous = sentinel;
		var current = sentinel.getListNext(r);
		var steps = 0;
		while (!current.isNull()) {
			if (steps > int.!(region.numBlocks)) return "free-list cycle detected";
			if (!isBlockTableEntry(region, current)) return "free list points outside block table";

			def index = region.blockIndexOf(current);
			def arrayIndex = int.!(index);
			if (listed[arrayIndex]) return at("block appears more than once on the free lists", index);
			listed[arrayIndex] = true;
			if (current.getListNum(r) != kind.code) return at("free block is on the wrong list", index);
			if (current.getUsed(r)) return at("used block appears on a free list", index);
			if (previous.addr != current.getListPrev(r).addr) return at("free-list back link is wrong", index);

			previous = current;
			current = current.getListNext(r);
			steps++;
		}
		return null;
	}

	private def isBlockTableEntry(region: PWRegion, entry: BlockEntryHandle) -> bool {
		if (entry.isNull()) return false;
		if (entry.addr < region.blockTableHandle.addr) return false;
		def delta = entry.addr - region.blockTableHandle.addr;
		if (delta % u64.!(BlockEntry.size) != 0) return false;
		return delta / u64.!(BlockEntry.size) <= region.numBlocks;
	}

	private def at(text: string, index: u64) -> string {
		return StringBuilder.new().put2("%s (block %d)", text, index).toString();
	}
}

// An allocator mount whose recovery cannot persist. A latched mount must still
// leave a walkable structure, and -- the claim that matters -- the bytes it
// leaves behind must mount cleanly and consistently afterwards. A mount that
// half-applied a replayed transaction and then failed its boundary would break
// the second half even though refusing further work looks correct.
class PersistentAllocatorFailureProperty(numBlocks: u64, blockSize: u64, failAtBoundary: int) {

	def check(image: PersistentDurableImage) -> string {
		def failed = PersistentRecoveries.runPWRegionWithFailure(image, numBlocks, blockSize,
			failAtBoundary);
		if (!failed.mounted) return "durable image did not mount as an allocator";
		if (failed.violation != null) {
			return StringBuilder.new().put1("latched mount left a broken structure: %s",
				failed.violation).toString();
		}
		// Reopen without injection: the surviving bytes must be a consistent
		// allocator, whether or not the failed attempt got as far as replaying.
		return PersistentAllocatorProperty.new(numBlocks, blockSize).check(failed.recovered);
	}

	def property(name: string) -> PersistentImageProperty {
		return PersistentImageProperty.new(name, 0u64, 0, check);
	}
}

// Mount a durable image as an allocator and check what production recovery left
// behind. Every image a crash can produce must mount into an internally
// consistent allocator: checking only whether a later allocation succeeds is too
// weak, since a broken chain can still satisfy one request.
class PersistentAllocatorProperty(numBlocks: u64, blockSize: u64) {

	def run(image: PersistentDurableImage) -> PersistentRegionRun {
		def backend = PersistentImageBackend.new(image);
		def region = PWRegion.new(backend, numBlocks, Array<Ref<MetaDataDesc>>.new(0), blockSize, false);
		if (region.backendRegion == null) {
			return PersistentRegionRun.new(false, false, "region did not mount", null);
		}
		def violation = PersistentAllocatorInvariants.check(region);
		def after = Array<byte>.new(region.rng.length);
		for (i < after.length) after[i] = region.rng[i];
		def run = PersistentRegionRun.new(true, region.requiresRecovery(), violation,
			PersistentDurableImage.new(after));
		region.deallocate();
		return run;
	}

	def check(image: PersistentDurableImage) -> string {
		def result = run(image);
		if (!result.mounted) return "durable image did not mount as an allocator";
		return result.violation;
	}

	def property(name: string, windowOffset: u64, windowLength: int) -> PersistentImageProperty {
		return PersistentImageProperty.new(name, windowOffset, windowLength, check);
	}
}
