// x86-64 storage regions over a file descriptor: the PMEM region (a MAP_SYNC
// mapping of a DAX file) and the mapped file (a shared mapping of a regular
// file), their backends, and the backing-file I/O the direct-I/O backend
// shares (X86_64DirectIoBackend.v3).

class FileBackedRegion extends StorageRegion {
	def var mapping: Mapping;
	def var fd: int;

	new(mapping: Mapping, fd: int)
		super(CiRuntime.forgeRange<byte>(mapping.range.start, int.!(mapping.range.size()))) {
		setProvider(NativeProvider.new(range));
	}

	def validRange(offset: u64, size: u64) -> bool {
		def regionSize = u64.!(range.length);
		return offset <= regionSize && size <= regionSize - offset;
	}

	def cleanupBeforeClose() { }

	def close() {
		cleanupBeforeClose();
		if (mapping != null) {
			mapping.range.unmap();
			mapping = null;
		}
		closeFd();
	}

	def closeFd() {
		if (fd >= 0) {
			BackingFile.close(fd);
			fd = -1;
		}
	}

	def writeBack(offset: u64, size: u64) -> bool {
		return false;
	}

	def drain() -> bool {
		return false;
	}

	def persist(offset: u64, size: u64) -> bool {
		return false;
	}
}

// Splitting a region-relative range into 64-byte lines for the provider.
component CacheLines {
	def CACHE_LINE_SIZE = 64u64;

	// Write back every line that overlaps [offset, offset + size), one
	// writeBackLine() each through the region's provider, in ascending
	// region-relative order.
	def writeBackLines(region: FileBackedRegion, offset: u64, size: u64) -> bool {
		if (!region.validRange(offset, size)) return false;
		if (size == 0) return true;
		def end = offset + size;
		var line = offset - (offset % CACHE_LINE_SIZE);
		while (line < end) {
			region.provider().writeBackLine(line);
			line += CACHE_LINE_SIZE;
		}
		return true;
	}
}

// Mapping a region: the page size and the translation of BackendProt masks.
component RegionMapping {
	def PAGE_SIZE = 4096u64;

	def convertProt(prot: int) -> int {
		var mmapProt = Mmap.PROT_NONE;
		if ((prot & BackendProt.READ.mask) != 0) mmapProt |= Mmap.PROT_READ;
		if ((prot & BackendProt.WRITE.mask) != 0) mmapProt |= Mmap.PROT_WRITE;
		if ((prot & BackendProt.EXEC.mask) != 0) mmapProt |= Mmap.PROT_EXEC;
		return mmapProt;
	}
}

// How a MappedFileRegion's fence reaches the file. FDATASYNC_ONCE and
// MSYNC_PER_RUN both make the region a restriction of the PMEM crash model:
// one fdatasync() of the whole file whenever a page is marked, or one
// msync(MS_SYNC) per run of marked pages. LEGACY_RANGE_MSYNC is the sync used
// until 2026-10-13 -- a flag set by writeBack(), an fdatasync() if it is set,
// and an msync() of a persist()'s own pages only -- whose trace has no CLWB,
// so the crash model says nothing about it. It is selectable only for the
// old-against-new comparison (pwbench, pwsievebench and pwopsbench
// boundary=), as is MSYNC_PER_RUN for the choice of fence; remove both once
// those comparisons are recorded. {arg} is the value boundary= takes.
enum MappedFileSync(arg: string) {
	FDATASYNC_ONCE("fdatasync"),
	MSYNC_PER_RUN("msync"),
	LEGACY_RANGE_MSYNC("legacy")
}

// A MAP_SHARED mapping of a regular file. On block storage the region lives in
// the page cache: the kernel owns writeback, may write any dirty page at any
// time, and keeps dirty pages across the death of the process. On a DAX mount
// there is no page cache, and stores reach the media through the CPU cache.
//
// The persistence calls mirror PmemRegion's, as DirectIoRegion's do:
// writeBack() issues one writeBackLine() per 64-byte line through the
// provider, drain() and persist() one fence(), so a recorded trace is the PMEM
// backend's for the same history. The provider is the direct backend's
// MarkingProvider, which marks the line's 4 KiB page instead of executing
// CLWB, and every fence syncs the marked pages before it returns, as SFENCE
// completes every outstanding CLWB. A provider whose writeBackLine() does
// nothing (ElidedWriteBackProvider) therefore marks nothing, and its fences
// sync nothing: the mutant, as on the direct backend.
//
// What a crash can leave is argued in docs/pmem-crash-model.md ("The file
// backend is a restriction of the PMEM model"): under the assumptions stated
// there, for block storage and for DAX, every durable image is one the PMEM
// model admits for the same trace. A crash inside a fence's sync corresponds to
// the cut just before that fence's SFENCE.
class MappedFileRegion extends FileBackedRegion {
	def var dirty: DirtyUnits;
	// Set by writing back a nonzero range, cleared by a successful
	// drain(): PmemRegion's hasPendingWriteback, so the recorded
	// fences match.
	def var hasDirtyChanges = false;
	def var sync = MappedFileSync.FDATASYNC_ONCE;

	new(mapping: Mapping, fd: int) super(mapping, fd) {
		// Built here rather than in a field initializer: Virgil runs field
		// initializers before super(), when {range} is not yet set.
		def page = RegionMapping.PAGE_SIZE;
		dirty = DirtyUnits.new(page, (u64.!(range.length) + page - 1u64) / page);
		setInnerProvider(StoreOnlyProvider.new(range));
	}

	// Install {inner} beneath the page-marking provider. Only before the region
	// reaches RegionAllocator, which captures the provider at construction.
	def setInnerProvider(inner: PersistenceProvider) {
		setProvider(MarkingProvider.new(inner, dirty));
	}

	// Benchmark-only, with MappedFileBackend.sync: choose the fence, before the
	// region reaches RegionAllocator. LEGACY_RANGE_MSYNC also restores the
	// provider the region had before 2026-10-13, which marks nothing.
	def selectSync(b: MappedFileSync) {
		sync = b;
		if (b == MappedFileSync.LEGACY_RANGE_MSYNC) setProvider(NativeProvider.new(range));
	}

	def writeBack(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		if (sync == MappedFileSync.LEGACY_RANGE_MSYNC) {
			if (!validRange(offset, size)) return false;
		} else if (!CacheLines.writeBackLines(this, offset, size)) {
			return false;
		}
		if (size != 0) hasDirtyChanges = true;
		onWriteBack(offset, size);
		return true;
	}

	// Observation hook paired with syncFileData() below. The default backend is
	// intentionally silent; integration tests override it to trace ordering
	// without reimplementing dirty-state transitions.
	def onWriteBack(offset: u64, size: u64) { }

	// Syncs every marked page, not only this range's: the fence that ends a
	// PMEM persist() completes every outstanding CLWB, and the crash
	// model's images depend on that. The pending flag is left as
	// PmemRegion leaves it, so the recorded fences match.
	def persist(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		if (!validRange(offset, size)) return false;
		if (size == 0) return true;
		if (sync == MappedFileSync.LEGACY_RANGE_MSYNC) {
			def pageSize = RegionMapping.PAGE_SIZE;
			def syncStart = offset - (offset % pageSize);
			def rangeEnd = offset + size;
			def syncEnd = ((rangeEnd + pageSize - 1u64) / pageSize) * pageSize;
			return syncMappedRange(syncStart, syncEnd - syncStart);
		}
		if (fd < 0) return false;
		if (!CacheLines.writeBackLines(this, offset, size)) return false;
		provider().fence();
		return syncMarked();
	}

	// Like syncFileData(), keep the actual range-sync syscall behind a narrow
	// seam. Inputs are validated, page-aligned offsets and sizes computed by
	// syncMarked() (or by a LEGACY_RANGE_MSYNC persist()), so tests can observe the
	// exact translation or inject a syscall failure without duplicating that
	// logic.
	def syncMappedRange(offset: u64, size: u64) -> bool {
		return Mmap.sync(mapping.range.start + i64.view(offset), size, Mmap.MS_SYNC);
	}

	def drain() -> bool {
		if (mapping == null || fd < 0) return false;
		if (!hasDirtyChanges) return true;
		if (sync == MappedFileSync.LEGACY_RANGE_MSYNC) {
			if (!syncFileData()) return false;
		} else {
			provider().fence();
			if (!syncMarked()) return false;
		}

		hasDirtyChanges = false;
		return true;
	}

	// The fence's write-back: make every marked page durable, then forget the
	// marks. fdatasync() also writes any other dirty page of the file, which is
	// a page the kernel could have written back at any time; the model's
	// background eviction admits it. Nothing marked, nothing synced.
	def syncMarked() -> bool {
		if (dirty.isEmpty()) return true;
		if (sync != MappedFileSync.MSYNC_PER_RUN) {
			if (!syncFileData()) return false;
		} else {
			def page = RegionMapping.PAGE_SIZE;
			def length = u64.!(range.length);
			def hi = dirty.hi;
			var u = dirty.lo;
			while (u < hi) {
				if (!dirty.isMarked(u)) {
					u++;
					continue;
				}
				var end = u + 1u64;
				while (end < hi && dirty.isMarked(end)) end++;
				var size = (end - u) * page;
				if (u * page + size > length) size = length - u * page;
				if (!syncMappedRange(u * page, size)) return false;
				u = end;
			}
		}
		dirty.clear();
		return true;
	}

	// Keep the syscall behind a narrow virtual seam so backend integration tests
	// can observe its ordering and inject failures without replacing the
	// MappedFileRegion persistence state machine.
	def syncFileData() -> bool {
		return BackingFile.fdatasync(fd);
	}

	// Nothing is synced on close: the page cache keeps what was not, and the
	// WAL's close() is the clean path.
	def cleanupBeforeClose() {
		hasDirtyChanges = false;
		if (dirty != null) dirty.clear();
	}

	// fdatasync of region data plus a superblock msync per checkpoint.
	def checkpointCost() -> CheckpointCost {
		return CheckpointCost.EXPENSIVE;
	}
}

class PmemRegion extends FileBackedRegion {
	def var hasPendingWriteback = false;

	new(mapping: Mapping, fd: int) super(mapping, fd) { }

	def writeBack(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		if (!CacheLines.writeBackLines(this, offset, size)) return false;
		if (size != 0) hasPendingWriteback = true;
		return true;
	}

	def drain() -> bool {
		if (mapping == null) return false;
		if (!hasPendingWriteback) return true;
		provider().fence();
		hasPendingWriteback = false;
		return true;
	}

	def persist(offset: u64, size: u64) -> bool {
		if (mapping == null) return false;
		if (!validRange(offset, size)) return false;
		if (size == 0) return true;
		if (!CacheLines.writeBackLines(this, offset, size)) return false;
		provider().fence();
		return true;
	}

	def cleanupBeforeClose() {
		hasPendingWriteback = false;
	}

	// Only store fences on the persist path, so checkpoints are cheap here.
	def checkpointCost() -> CheckpointCost {
		return CheckpointCost.CHEAP;
	}
}

// Persistent memory backend using mmap with MAP_SYNC (for PMEM/DAX)
class PmemBackend extends StorageBackend {
	def path: string;  // Path to PMEM device or DAX file

	// TODO: think about whether we want a single path to be able to used to create multiple regions
	new(path) { }

	def open(size: u64, access: int, mode: OpenMode) -> StorageRegion {
		def fd = BackingFile.openBacking(path, mode);
		if (fd < 0) return null;
		def err = BackingFile.sizeBacking(fd, size);
		if (err != null) {
			Trace.OUT.puts(err).ln();
			BackingFile.close(fd);
			return null;
		}

		var mmapProt = RegionMapping.convertProt(access);
		def mapping = Mmap.map(size, mmapProt, Mmap.MAP_SHARED_VALIDATE | Mmap.MAP_SYNC, fd, 0);
		def region = makePmemRegion(mapping, fd);
		if (region == null) {
			BackingFile.close(fd);
			return null;
		}
		return region;
	}

	def makePmemRegion(newMapping: Mapping, fd: int) -> PmemRegion {
		if (newMapping == null) return null;
		return PmemRegion.new(newMapping, fd);
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "mmap-pmem";
	}
}

class MappedFileBackend extends StorageBackend {
	def path: string;
	// Benchmark-only: the fence every region this backend creates uses (see
	// MappedFileSync).
	var sync = MappedFileSync.FDATASYNC_ONCE;

	new(path) { }

	def open(size: u64, access: int, mode: OpenMode) -> StorageRegion {
		def fd = BackingFile.openBacking(path, mode);
		if (fd < 0) return null;
		def err = BackingFile.sizeBacking(fd, size);
		if (err != null) {
			Trace.OUT.puts(err).ln();
			BackingFile.close(fd);
			return null;
		}

		def mmapProt = RegionMapping.convertProt(access);
		def mapping = Mmap.map(size, mmapProt, Mmap.MAP_SHARED, fd, 0);
		def region = makeMappedFileRegion(mapping, fd);
		if (region == null) {
			BackingFile.close(fd);
			return null;
		}
		if (sync != MappedFileSync.FDATASYNC_ONCE) region.selectSync(sync);
		return region;
	}

	def makeMappedFileRegion(newMapping: Mapping, fd: int) -> MappedFileRegion {
		if (newMapping == null) return null;
		return MappedFileRegion.new(newMapping, fd);
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "mmap-file";
	}
}

component BackingFile {
	def FILE_MODE = 420;	// 0644 octal
	def PRIVATE_FILE_MODE = 384;	// 0600 octal

	// Build a null-terminated C string for the given path.
	private def toCPath(path: string) -> Array<byte> {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		return pathBuf;
	}

	// Open an existing region file for read/write. Does not create it: returns a
	// negative value (-errno, e.g. -ENOENT) if the file does not exist.
	def open(path: string) -> int {
		var pathBuf = toCPath(path);
		var r = Linux.syscall(LinuxConst.SYS_open,
			(Pointer.atElement(pathBuf, 0), LinuxConst.O_RDWR, FILE_MODE));
		return int.!(r.0);
	}

	// Create (or re-create) a fresh region file for read/write. O_TRUNC clears any
	// stale content to length 0; the subsequent sizeBacking()->ftruncate() extension
	// is zero-filled by the kernel, so the resulting region is zero-initialised.
	def create(path: string) -> int {
		var pathBuf = toCPath(path);
		var r = Linux.syscall(LinuxConst.SYS_open,
			(Pointer.atElement(pathBuf, 0), LinuxConst.O_RDWR | LinuxConst.O_CREAT | LinuxConst.O_TRUNC, FILE_MODE));
		return int.!(r.0);
	}

	// Atomically reserve a new private file without following or replacing an
	// existing name. Used by shared-machine integration runners before they hand
	// a generated path to a backend whose fresh-format contract includes O_TRUNC.
	def createExclusive(path: string) -> int {
		var pathBuf = toCPath(path);
		var r = Linux.syscall(LinuxConst.SYS_open,
			(Pointer.atElement(pathBuf, 0),
			 LinuxConst.O_RDWR | LinuxConst.O_CREAT | LinuxConst.O_EXCL,
			 PRIVATE_FILE_MODE));
		return int.!(r.0);
	}

	// Obtain a backing fd for a region: FORMAT re-creates the file (zeroed),
	// ATTACH opens the existing file, creating it zeroed if it is missing.
	def openBacking(path: string, mode: OpenMode) -> int {
		if (mode == OpenMode.FORMAT) return create(path);
		var fd = open(path);
		if (fd < 0) fd = create(path);  // missing -> fresh, zeroed
		return fd;
	}

	// Size the file openBacking() returned for a region of {size} bytes: null,
	// or why it cannot back one. An empty file -- new, missing, or emptied by
	// a fresh format's O_TRUNC -- is extended to {size}, zero-filled. A
	// non-empty file is never resized: one of another size is refused,
	// unchanged, before anything maps or reads it, since the caller has not yet
	// seen its header. Until 2026-10-21 any file was truncated or extended to
	// {size} here, so a mount that asked for the wrong geometry cut or grew an
	// existing region before RegionAllocator refused it.
	def sizeBacking(fd: int, size: u64) -> string {
		def fileSize = Linux.syscall(LinuxConst.SYS_lseek, (fd, 0, LinuxConst.SEEK_END)).0;
		if (fileSize < 0) return "could not read the size of the region file";
		if (fileSize == i64.view(size)) return null;
		if (fileSize != 0) {
			return StringBuilder.new()
				.put2("the region file has %d bytes, not the %d requested: refusing to resize it without a fresh format",
					fileSize, size)
				.toString();
		}
		if (Linux.syscall(LinuxConst.SYS_ftruncate, (fd, size)).0 != 0) return "could not size the region file";
		if (Linux.syscall(LinuxConst.SYS_fsync, fd).0 != 0) return "could not sync the size of the region file";
		return null;
	}

	def fdatasync(fd: int) -> bool {
		return Linux.syscall(LinuxConst.SYS_fdatasync, fd).0 == 0;
	}

	def close(fd: int) {
		Linux.syscall(LinuxConst.SYS_close, fd);
	}

	// NOTE: intentionally inlines the C-string construction rather than calling
	// toCPath(). Routing this through toCPath() (a third caller) shifts Virgil's
	// inlining/stackmap layout enough to trip a latent precise-GC bug that crashes
	// unrelated interpreter GC tests (e.g. int:force_gc1). Keep this inline.
	def unlink(path: string) -> bool {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		return Linux.syscall(LinuxConst.SYS_unlink, Pointer.atElement(pathBuf, 0)).0 == 0;
	}
}

// Factory for creating backend instances
component X86_64Backends {
	// Use platform-independent backends by default
	def volatile() -> StorageBackend {
		return Backends.volatile();
	}
	
	// Get mmap-based backend (delegates to platform-independent version)
	def getMmap() -> StorageBackend {
		return Backends.getMmap();
	}
	
	// Get PMEM backend (x86-64 specific with cache flush instructions)
	def pmem(path: string) -> StorageBackend {
		return PmemBackend.new(path);
	}

	def mappedFile(path: string) -> StorageBackend {
		return MappedFileBackend.new(path);
	}
}
