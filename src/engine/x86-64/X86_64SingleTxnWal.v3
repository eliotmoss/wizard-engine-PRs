// SingleTxnWal -- the original single-transaction, in-region redo WAL.
//
// SUPERSEDED and no longer wired in: RegionAllocator / TransactionCache now drive the
// multi-transaction ring log (RingWal, X86_64RingWal.v3). This class is
// retained as a reference point for comparing the single-transaction design
// against the multi-transaction ring. See docs/wal-comparison.md.
//
// Design: the log lives in block 1 of the mapped region. A single LogHeader
// (numEntries / status / checksum) precedes a flat WalEntry[] array. commit()
// persists the entries, then sets status=1; recovery replays the entries when
// status==1 and the checksum matches, then clears status. Only one in-flight
// transaction -- there is no ring, epoch, superblock, or checkpoint machinery.
// All I/O is via Pointer.store/Pointer.load + StorageRegion-provided flush/fence.

class SingleTxnWal {
        def regionStart: u64;              // absolute address of region byte 0
        def logBlockAddr: u64;             // absolute address of the log block (block 1)
        def backendRegion: StorageRegion;

        // Log header and entry base (derived from logBlockAddr)
        def var header: Ref<LogHeader>;
        def var entryBase: u64;
        def var maxEntries: u32;

        // Local counter for the current transaction
        def var currentEntryIndex: u32 = 0;

        new(regionStart, logBlockAddr, blockSize: u64, backendRegion) {
                header = Ref<LogHeader>.of(CiRuntime.forgeRange<byte>(RegionUtils.pointerFromU64(logBlockAddr), LogHeader.size));
                entryBase = logBlockAddr + u64.!(LogHeader.size);
                maxEntries = u32.!((blockSize - u64.!(LogHeader.size)) / u64.!(WalEntry.size));
        }

        // --- WAL operations ---

        def append(offset: u64, value: u64, width: u8) {
                if (currentEntryIndex >= maxEntries) {
                        // Log block is full; cannot record this entry.
                        // TODO: return error instead of silently dropping
                        return;
                }
                def entryAddr = entryBase + u64.view(currentEntryIndex * u32.!(WalEntry.size));
                var entry = Ref<WalEntry>.of(CiRuntime.forgeRange<byte>(RegionUtils.pointerFromU64(entryAddr), WalEntry.size));

                entry.offset = offset;
                entry.value = value;
                entry.width = width;

                currentEntryIndex++;
        }

        def commit() {
                header.numEntries = currentEntryIndex;
                header.checksum = RegionUtils.calculateLogChecksum(entryBase, currentEntryIndex);

                // Flush log entries to persistent storage
                if (backendRegion != null) {
                        def entryBytes = u64.view(currentEntryIndex) * u64.!(WalEntry.size);
                        backendRegion.persist(entryBase - regionStart, entryBytes);
                }

                header.status = 1;

                // Flush the header
                if (backendRegion != null) {
                        backendRegion.persist(logBlockAddr - regionStart, u64.!(LogHeader.size));
                }
        }

        def clear() {
                header.numEntries = 0u32;
                header.status = 0;
                header.checksum = 0u64;
                if (backendRegion != null) {
                        backendRegion.persist(logBlockAddr - regionStart, u64.!(LogHeader.size));
                }
                currentEntryIndex = 0;
        }

        // --- Data application ---

        def applyAfterImage(offset: u64, value: u64, width: u8) {
                def addr = RegionUtils.pointerFromU64(regionStart + offset);
                match (width) {
                        1 => addr.store<u8>(u8.view(value));
                        2 => addr.store<u16>(u16.view(value));
                        4 => addr.store<u32>(u32.view(value));
                        8 => addr.store<u64>(value);
                        _ => ;
                }
                if (backendRegion != null) {
                        backendRegion.writeBack(offset, u64.view(width));
                }
        }

        def fenceAppliedUpdates() {
                if (backendRegion != null) {
                        backendRegion.drain();
                }
        }

        // --- Read (cache-miss fallthrough) ---

        def readU8(offset: u64) -> u8 {
                return RegionUtils.pointerFromU64(regionStart + offset).load<u8>();
        }

        def readI16(offset: u64) -> i16 {
                return RegionUtils.pointerFromU64(regionStart + offset).load<i16>();
        }

        def readU64(offset: u64) -> u64 {
                return RegionUtils.pointerFromU64(regionStart + offset).load<u64>();
        }

        def readI64(offset: u64) -> i64 {
                return RegionUtils.pointerFromU64(regionStart + offset).load<i64>();
        }

        // --- Recovery ---

        def recover() -> bool {
                if (header.status != 1) return false;

                def expected = header.checksum;
                def actual = RegionUtils.calculateLogChecksum(entryBase, header.numEntries);

                if (expected != actual) {
                        // Checksum mismatch -- clear the committed bit so future mounts
                        // do not retry a corrupt log.
                        header.status = 0;
                        if (backendRegion != null) {
                                backendRegion.persist(logBlockAddr - regionStart, u64.!(LogHeader.size));
                        }
                        return false;
                }

                var entryAddr = entryBase;
                for (i < header.numEntries) {
                        def entry = Ref<WalEntry>.of(CiRuntime.forgeRange<byte>(RegionUtils.pointerFromU64(entryAddr), WalEntry.size));
                        applyAfterImage(entry.offset, entry.value, entry.width);
                        entryAddr = entryAddr + u64.!(WalEntry.size);
                }

                fenceAppliedUpdates();

                header.status = 0;
                if (backendRegion != null) {
                        backendRegion.persist(logBlockAddr - regionStart, u64.!(LogHeader.size));
                }
                return true;
        }

        // --- Lifecycle ---

        def close() {
                // No-op: memory is managed by StorageRegion
        }
}
