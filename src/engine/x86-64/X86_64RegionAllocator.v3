// =============================================================================
// Section 1: Configuration and Constants
// =============================================================================

component RegionFormat {
        // The header's magic word: the "PWASM" tag in its low 5 bytes, bytes
        // 5 and 6 zero, and the format version in its top byte. The version
        // lives in the magic rather than in a field of its own because a new
        // field would move the sentinels that follow the header. Version 0 is
        // every region formatted before the version existed: its magic is the
        // bare tag, and its header may be the 80-byte one, whose sentinels lie
        // where this header's userRoot is.
        def MAGIC_TAG = 0x50_57_41_53_4Du64; // "PWASM" in hex
        def TAG_MASK = 0x00FF_FFFF_FFFF_FFFFu64; // the tag and the two zero bytes above it
        def FORMAT_VERSION: u8 = 1;
        def MAGIC = MAGIC_TAG | (u64.!(FORMAT_VERSION) << 56);
        def blockSize: u64 = 256u64 * 1024u64;
        def sanitize = false;

        // True if {magic} is some format version's magic, this one's or not.
        def isTagged(magic: u64) -> bool {
                return (magic & TAG_MASK) == MAGIC_TAG;
        }
        // The format version a tagged magic carries.
        def versionOf(magic: u64) -> u8 {
                return u8.!(magic >> 56);
        }
}

component FreeLists {
        def MAX_LISTS = 8;      // maximum number of lists == number of list sentinels
                                // METADATA, etc., do not have sentinels and not part of this count
}


// =============================================================================
// Section 2: On-Memory Layouts (raw data structures)
// =============================================================================

layout RegionHeader {
        +0      blockTable:     u64;    // relative offset to the block table
        +8      sentinels:      u64;    // offset of the sentinels (whatever type are!)
        +16     numBlocks:      u64;
        +24     numBytes:       u64;
        +32     numDescs:       u64;
        +40     metadata:       u64;    // relative offset to the metadata area
        +48     metadataDescriptors:  u64;    // relative offset to the metadata descriptors
        +56     magic:          u64;    // "PWASM" tag (bytes 0-4), zero (bytes 5-6), format version (byte 7)
        +64     blockSize:      u64;    // block size this region was formatted with
        +72     logBlock:       u64;    // region-relative offset of the WAL log block
        +80     userRoot:       u64;    // region-relative offset of the caller's root object (0 = none)
        =88;
}

layout BlockTableEntry {
        +0      listNum:        i16;    // which list is this entry part of
        +2      used:           u1;     // is this block in use? // TODO: Use bool after the compiler is fixed
                                        // gap
        +8      prev:           i64;    // prev entry in memory;
        +16     next:           i64;    // next entry in memory order
        +24     listPrev:       i64;    // prev entry on same list
        +32     listNext:       i64;    // next entry on same list
        =40;
}

layout ChunkHeader {
        +0      offset:         u64;    // offset in chunk for next allocation
        +8      limit:          u64;    // offset just beyond last available byte in chunk
        +16     chunk_limit:    u64;    // offset just beyond end of the chunk
        +24     linemarks:      u64;    // region-relative offset to first line mark of the chunk
        =32;                            // size of chunk header
}

layout MetadataDescriptor {
        +0      kind:           u64;    // unique code, identifying the kind of metadata
        +8      fixedBytes:     u32;    // single-copy data at beginning of metadata block
        +12     unitSize:       u32;    // number of bytes of data space per metadata item
        +16     bytesPerUnit:   u32;    // size of each metadata item, in bytes
                                        // gap
        +24     offset:         u64;    // offset in region of the actual metadata
        =32;
}

layout LineMark {
        +0      mark:           u8;     // line mark info
        =1;
}

layout LogHeader {
        +0      numEntries:     u32;    // Number of valid entries in this transaction
        +4      status:         u8;     // 0 = Invalid, 1 = Committed
        +8      checksum:       u64;    // Optional: Simple checksum for integrity
        =32;                            // Pad to 32 bytes
}


// =============================================================================
// Section 3: Enumerations
// =============================================================================

enum FreeListKind(code: i16) {
        METADATA(-1),
        NONE(-2),
        USED(-3),
        SMALL_FREE(0),
        LARGE_FREE(1)
}


// =============================================================================
// Section 4: Utilities
// =============================================================================

component RegionUtils {
        def pointerFromU64(n: u64) -> Pointer {
                return Pointer.NULL + i64.view(n);
        }

        def pointerFromI64(n: i64) -> Pointer {
                return Pointer.NULL + n;
        }

        // Shared checksum for WAL log entries. Used during WAL commit
        // and recovery to ensure integrity.
        def calculateLogChecksum(base: u64, count: u32) -> u64 {
                var h: u64 = 0xCAFE_BABE_DEAD_BEEF_u64;
                var ptr = base;
                for (i < count) {
                        var entry = Ref<WalEntry>.of(CiRuntime.forgeRange<byte>(pointerFromU64(ptr), WalEntry.size));
                        h = (h << 13) | (h >> 51);
                        h = h ^ entry.offset;
                        h = h ^ entry.value;
                        h = h ^ u64.view(entry.width);
                        ptr = ptr + u64.!(WalEntry.size);
                }
                return h;
        }
}


// =============================================================================
// Section 5: Handle Types (wrappers around layouts for convenient access)
// =============================================================================

def NULL_BLOCK_ENTRY = BlockTableEntryHandle(0);
def NULL_CHUNK = ChunkHandle(0);

type BlockTableHandle(addr: u64, size: u64) #unboxed {
        def [n: u64] -> BlockTableEntryHandle {
                return if(
                        n < size,
                        BlockTableEntryHandle(addr + (n * u64.!(BlockTableEntry.size))),
                        NULL_BLOCK_ENTRY
                );
        }
}

type BlockTableEntryHandle(addr: u64) #unboxed {
        def isNull() -> bool {
                return addr == 0;
        }

        def toHandle(offset: i64) -> BlockTableEntryHandle {
                if (offset == 0) return NULL_BLOCK_ENTRY;
                return BlockTableEntryHandle(u64.view(i64.view(addr) + offset));
        }

        def toOffset(other: BlockTableEntryHandle) -> i64 {
                if (other.isNull()) return 0;
                return i64.view(other.addr) - i64.view(this.addr);
        }

        // Direct getters take the region's reader as the direct setters take
        // its writer, so every load from the block table is observable.
        def getRef(r: RegionReader) -> Ref<BlockTableEntry> {
                return r.forgeBlockTableEntry(addr);
        }

        def getListNumInRegion(r: RegionReader) -> i16 {
                return r.loadI16(addr + u64.view(BlockTableEntry.listNum.offset));
        }

        def getUsedInRegion(r: RegionReader) -> bool {
                return r.loadU8(addr + u64.view(BlockTableEntry.used.offset)) == 1u8;
        }

        def getPrevInRegion(r: RegionReader) -> BlockTableEntryHandle {
                return toHandle(r.loadI64(addr + u64.view(BlockTableEntry.prev.offset)));
        }

        def getNextInRegion(r: RegionReader) -> BlockTableEntryHandle {
                return toHandle(r.loadI64(addr + u64.view(BlockTableEntry.next.offset)));
        }

        def getListPrevInRegion(r: RegionReader) -> BlockTableEntryHandle {
                return toHandle(r.loadI64(addr + u64.view(BlockTableEntry.listPrev.offset)));
        }

        def getListNextInRegion(r: RegionReader) -> BlockTableEntryHandle {
                return toHandle(r.loadI64(addr + u64.view(BlockTableEntry.listNext.offset)));
        }

        def getListNum(cache: TransactionCache) -> i16 {
                return cache.readI16(addr + u64.view(BlockTableEntry.listNum.offset));
        }

        def getUsed(cache: TransactionCache) -> bool {
                def used = cache.readU8(addr + u64.view(BlockTableEntry.used.offset));
                return used == 1;
        }

        def getPrev(cache: TransactionCache) -> BlockTableEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockTableEntry.prev.offset)));
        }

        def getNext(cache: TransactionCache) -> BlockTableEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockTableEntry.next.offset)));
        }

        def getListPrev(cache: TransactionCache) -> BlockTableEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockTableEntry.listPrev.offset)));
        }

        def getListNext(cache: TransactionCache) -> BlockTableEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockTableEntry.listNext.offset)));
        }

        def setListNumUnlogged(w: UnloggedWriter, v: i16) {
                w.writeI16(addr + u64.view(BlockTableEntry.listNum.offset), v);
        }

        def setUsedUnlogged(w: UnloggedWriter, v: bool) {
                w.writeU8(addr + u64.view(BlockTableEntry.used.offset), if(v, 1u8, 0u8));
        }

        def setPrevUnlogged(w: UnloggedWriter, v: BlockTableEntryHandle) {
                w.writeI64(addr + u64.view(BlockTableEntry.prev.offset), toOffset(v));
        }

        def setNextUnlogged(w: UnloggedWriter, v: BlockTableEntryHandle) {
                w.writeI64(addr + u64.view(BlockTableEntry.next.offset), toOffset(v));
        }

        def setListPrevUnlogged(w: UnloggedWriter, v: BlockTableEntryHandle) {
                w.writeI64(addr + u64.view(BlockTableEntry.listPrev.offset), toOffset(v));
        }

        def setListNextUnlogged(w: UnloggedWriter, v: BlockTableEntryHandle) {
                w.writeI64(addr + u64.view(BlockTableEntry.listNext.offset), toOffset(v));
        }

        def setListNum(cache: TransactionCache, v: i16) {
                cache.writeI16(addr + u64.view(BlockTableEntry.listNum.offset), v);
        }

        def setUsed(cache: TransactionCache, v: bool) {
                def num: u8 = if(v, 1, 0);
                cache.writeU8(addr + u64.view(BlockTableEntry.used.offset), num);
        }

        def setPrev(cache: TransactionCache, v: BlockTableEntryHandle) {
                cache.writeI64(addr + u64.view(BlockTableEntry.prev.offset), toOffset(v));
        }

        def setNext(cache: TransactionCache, v: BlockTableEntryHandle) {
                cache.writeI64(addr + u64.view(BlockTableEntry.next.offset), toOffset(v));
        }

        def setListPrev(cache: TransactionCache, v: BlockTableEntryHandle) {
                cache.writeI64(addr + u64.view(BlockTableEntry.listPrev.offset), toOffset(v));
        }

        def setListNext(cache: TransactionCache, v: BlockTableEntryHandle) {
                cache.writeI64(addr + u64.view(BlockTableEntry.listNext.offset), toOffset(v));
        }
}

type ChunkHandle(addr: u64) #unboxed {
        def isNull() -> bool {
                return addr == 0;
        }

        def getRef(r: RegionReader) -> Ref<ChunkHeader> {
                return r.forgeChunkHeader(addr);
        }

        // One field each, rather than through getRef(), so a reader's
        // observer sees the eight bytes loaded and not the whole header.
        def getOffsetInRegion(r: RegionReader) -> u64 {
                return r.loadU64(addr + u64.view(ChunkHeader.offset.offset));
        }

        def getLimitInRegion(r: RegionReader) -> u64 {
                return r.loadU64(addr + u64.view(ChunkHeader.limit.offset));
        }

        def getChunkLimitInRegion(r: RegionReader) -> u64 {
                return r.loadU64(addr + u64.view(ChunkHeader.chunk_limit.offset));
        }

        def getLinemarksInRegion(r: RegionReader) -> u64 {
                return r.loadU64(addr + u64.view(ChunkHeader.linemarks.offset));
        }

        def setOffsetUnlogged(w: UnloggedWriter, v: u64) {
                w.writeU64(addr + u64.view(ChunkHeader.offset.offset), v);
        }

        def setLimitUnlogged(w: UnloggedWriter, v: u64) {
                w.writeU64(addr + u64.view(ChunkHeader.limit.offset), v);
        }

        def setChunkLimitUnlogged(w: UnloggedWriter, v: u64) {
                w.writeU64(addr + u64.view(ChunkHeader.chunk_limit.offset), v);
        }

        def setLinemarksUnlogged(w: UnloggedWriter, v: u64) {
                w.writeU64(addr + u64.view(ChunkHeader.linemarks.offset), v);
        }

        def setOffset(cache: TransactionCache, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.offset.offset), v);
        }

        def setLimit(cache: TransactionCache, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.limit.offset), v);
        }

        def setChunkLimit(cache: TransactionCache, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.chunk_limit.offset), v);
        }

        def setLinemarks(cache: TransactionCache, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.linemarks.offset), v);
        }
}

type LineMarkTableHandle(addr: u64, size: u64) #unboxed {
        def [n: u64] -> LineMarkHandle {
                return if(
                        n < size,
                        LineMarkHandle(addr + n * u64.!(LineMark.size)),
                        LineMarkHandle(0)
                );
        }
}

type LineMarkHandle(addr: u64) #unboxed {
        def getRef(r: RegionReader) -> Ref<LineMark> {
                return r.forgeLineMark(addr);
        }

        def getMarkInRegion(r: RegionReader) -> u8 {
                return r.loadU8(addr + u64.view(LineMark.mark.offset));
        }

        def setMarkUnlogged(w: UnloggedWriter, v: u8) {
                w.writeU8(addr + u64.view(LineMark.mark.offset), v);
        }
}


// =============================================================================
// Section 6: WAL Infrastructure (write-behind cache and write-ahead log)
// =============================================================================

// Wrapper ADT to store the cached value and its width (size)
type CachedUpdate(value: u64, size: u8) #unboxed { }

// Direct, non-transactional writes to the persistent image through the traced
// PersistenceProvider seam. Legal only where no WAL transaction protects the
// bytes: format() builds the whole region before the WAL exists, persists it,
// and only then stores and persists the magic that publishes it; ImmixRegionAllocator's
// line marks are transient GC state, for which no writeback or fence is issued.
// Steady-state allocator mutations must use TransactionCache (the *Cached
// setters) instead.
//
// The method names deliberately mirror TransactionCache's write* family so a
// direct setter and its *Cached twin read as line-for-line counterparts, and
// so that bypassing the WAL by accident stays visible at the call site.
//
// Addresses are absolute; the seam takes region-relative offsets, so the
// translation lives here rather than at every call site.
class UnloggedWriter {
        private def ops: PersistenceProvider;
        def regionStart: u64;

        new(ops, regionStart) { }

        // Write BlockTableEntry.used (u1/bool stored as u8), LineMark.mark
        def writeU8(addr: u64, val: u8) {
                ops.storeU8(addr - regionStart, val);
        }

        // Write BlockTableEntry.listNum
        def writeI16(addr: u64, val: i16) {
                ops.storeU16(addr - regionStart, u16.view(val));
        }

        // Write ChunkHeader.offset, limit
        def writeU64(addr: u64, val: u64) {
                ops.storeU64(addr - regionStart, val);
        }

        // Write BlockTableEntry.prev, next, listPrev, listNext
        def writeI64(addr: u64, val: i64) {
                ops.storeU64(addr - regionStart, u64.view(val));
        }

        // Region-relative forms, for header and descriptor fields whose offsets
        // already are (mirrors TwoSlotWal's headerStore*/recordStore* split).
        def writeOffsetU32(offset: u64, val: u32) {
                ops.storeU32(offset, val);
        }

        def writeOffsetU64(offset: u64, val: u64) {
                ops.storeU64(offset, val);
        }
}

// Direct loads from the persistent image, the counterpart of
// UnloggedWriter. A load is the same Pointer.load it always was; when the
// region's provider carries a LoadObserver, the reader first reports
// the bytes it is about to load, region-relative, and the observer may rewrite
// them (see LoadObserver). In production the observer is null, and
// a load costs reading that field and a branch that is never taken.
//
// Every load the allocator, the WAL and the workloads make from a region goes
// through a reader, including reads of bytes the same run stored itself; a
// load that does not is invisible to a crash search that branches on what is
// read. Refs are forged through the per-layout forge* helpers, which observe
// the whole layout once, so a Ref's fields may then be read directly.
//
// Addresses are absolute, as UnloggedWriter's are; the observer takes
// region-relative offsets, so the translation lives here.
class RegionReader {
        private def ops: PersistenceProvider;
        def regionStart: u64;

        new(ops, regionStart) { }

        def loadU8(addr: u64) -> u8 {
                def o = ops.loadObserver;
                if (o != null) o.beforeLoad(addr - regionStart, 1u64);
                return RegionUtils.pointerFromU64(addr).load<u8>();
        }

        def loadU16(addr: u64) -> u16 {
                def o = ops.loadObserver;
                if (o != null) o.beforeLoad(addr - regionStart, 2u64);
                return RegionUtils.pointerFromU64(addr).load<u16>();
        }

        def loadU32(addr: u64) -> u32 {
                def o = ops.loadObserver;
                if (o != null) o.beforeLoad(addr - regionStart, 4u64);
                return RegionUtils.pointerFromU64(addr).load<u32>();
        }

        def loadU64(addr: u64) -> u64 {
                def o = ops.loadObserver;
                if (o != null) o.beforeLoad(addr - regionStart, 8u64);
                return RegionUtils.pointerFromU64(addr).load<u64>();
        }

        // Read BlockTableEntry.listNum
        def loadI16(addr: u64) -> i16 {
                def o = ops.loadObserver;
                if (o != null) o.beforeLoad(addr - regionStart, 2u64);
                return RegionUtils.pointerFromU64(addr).load<i16>();
        }

        // Read BlockTableEntry.prev, next, listPrev, listNext
        def loadI64(addr: u64) -> i64 {
                def o = ops.loadObserver;
                if (o != null) o.beforeLoad(addr - regionStart, 8u64);
                return RegionUtils.pointerFromU64(addr).load<i64>();
        }

        // Region-relative form, for header fields whose offsets already are
        // (mirrors writeOffsetU64).
        def loadOffsetU64(offset: u64) -> u64 {
                return loadU64(regionStart + offset);
        }

        // Report [addr, addr + length) before a loop loads it byte by byte.
        def beforeLoad(addr: u64, length: u64) {
                if (length != 0u64) note(addr, length);
        }

        def forgeBlockTableEntry(addr: u64) -> Ref<BlockTableEntry> {
                return Ref<BlockTableEntry>.of(forge(addr, BlockTableEntry.size));
        }

        def forgeChunkHeader(addr: u64) -> Ref<ChunkHeader> {
                return Ref<ChunkHeader>.of(forge(addr, ChunkHeader.size));
        }

        def forgeLineMark(addr: u64) -> Ref<LineMark> {
                return Ref<LineMark>.of(forge(addr, LineMark.size));
        }

        def forgeMetadataDescriptor(addr: u64) -> Ref<MetadataDescriptor> {
                return Ref<MetadataDescriptor>.of(forge(addr, MetadataDescriptor.size));
        }

        def forgeWalHeader(addr: u64) -> Ref<WalHeader> {
                return Ref<WalHeader>.of(forge(addr, WalHeader.size));
        }

        def forgeRecordHeader(addr: u64) -> Ref<WalRecordHeader> {
                return Ref<WalRecordHeader>.of(forge(addr, WalRecordHeader.size));
        }

        def forgeRecordTrailer(addr: u64) -> Ref<WalRecordTrailer> {
                return Ref<WalRecordTrailer>.of(forge(addr, WalRecordTrailer.size));
        }

        def forgeWalEntry(addr: u64) -> Ref<WalEntry> {
                return Ref<WalEntry>.of(forge(addr, WalEntry.size));
        }

        private def forge(addr: u64, size: int) -> Range<byte> {
                note(addr, u64.!(size));
                return CiRuntime.forgeRange<byte>(RegionUtils.pointerFromU64(addr), size);
        }

        private def note(addr: u64, length: u64) {
                def o = ops.loadObserver;
                if (o != null) o.beforeLoad(addr - regionStart, length);
        }
}

// A transaction facade over the write-behind cache and redo log.
// This component buffers writes in DRAM, then commits them through TwoSlotWal.
//
// CONSTRAINT: ALIGNED ACCESS ONLY
// This implementation uses a HashMap to store updates. It does not support spatial
// queries or overlapping intervals. Consequently:
// 1. Reads must match the exact address of previous writes.
// 2. Mixed-width accesses (e.g., writing 8 bytes at 0x10, then reading 1 byte at 0x11)
//    will result in a cache miss, returning stale data.
class TransactionCache {
        private var cache: HashMap<u64, CachedUpdate>;
        private def addrs = Vector<u64>.new();
        private def wal: TwoSlotWal;
        def regionStart: u64;

        new(wal, regionStart) {
                cache = HashMap<u64, CachedUpdate>.new(hash, u64.==);
        }

        def isDirty() -> bool {
                return addrs.length != 0;
        }

        // Persistence failures leave the durable outcome indeterminate. The
        // current WAL instance cannot safely accept more work; callers must
        // abandon this mount, reopen it, and recover the durable image.
        def requiresRecovery() -> bool {
                return wal.requiresRecovery();
        }

        // Phase B commit: one persistence boundary in steady state.
        // wal.commit() persists the record together with the *previous*
        // transaction's applied after-images (the piggybacked boundary); this
        // transaction's own after-images are applied write-behind afterwards
        // and ride the next commit's boundary, an explicit flush(), or the
        // WAL's close(). Until then the durable record keeps them
        // recoverable, and the WAL's overwrite guard protects the slot.
        def commit() -> bool {
                if (requiresRecovery()) return false;
                if (!isDirty()) return true;
                appendToWal();
                def txnSeq = wal.commit();
                if (txnSeq == 0u64) return false;
                if (!applyToRegion()) return false;
                clear();
                return true;
        }

        // Explicit boundary for idle/unmount: complete durability for applied
        // after-images that have not yet ridden a later commit's boundary.
        def flush() -> bool {
                return wal.persistAfterImages();
        }

        def recover() -> WalRecovery {
                return wal.recover();
        }

        private def clear() {
                // Empty the map in place rather than reallocating it: {addrs} holds exactly
                // the set of keys present in {cache}, and HashMap.remove retains the backing
                // table, so this reuses both structures' storage across commits.
                for (i < addrs.length) cache.remove(addrs[i]);
                addrs.clear();
        }

        def readU8(addr: u64) -> u8 {
                if (cache.has(addr)) return u8.view(cache[addr].value);
                return wal.readU8(addr - regionStart);
        }

        def readI16(addr: u64) -> i16 {
                if (cache.has(addr)) return i16.view(cache[addr].value);
                return wal.readI16(addr - regionStart);
        }

        def readU64(addr: u64) -> u64 {
                if (cache.has(addr)) return u64.view(cache[addr].value);
                return wal.readU64(addr - regionStart);
        }

        def readI64(addr: u64) -> i64 {
                if (cache.has(addr)) return i64.view(cache[addr].value);
                return wal.readI64(addr - regionStart);
        }

        // Write BlockTableEntry.used (u1/bool stored as u8)
        def writeU8(addr: u64, val: u8) {
                writeHelper(addr, 1, u64.view(val));
        }

        // Write BlockTableEntry.listNum
        def writeI16(addr: u64, val: i16) {
                writeHelper(addr, 2, u64.view(u16.view(val)));
        }

        // Write ChunkHeader.offset, limit
        def writeU64(addr: u64, val: u64) {
                writeHelper(addr, 8, val);
        }

        // Write BlockTableEntry.prev, next, listPrev, listNext
        def writeI64(addr: u64, val: i64) {
                writeHelper(addr, 8, u64.view(val));
        }

        private def writeHelper(addr: u64, size: u8, val: u64) {
                if (!cache.has(addr)) {
                        addrs.put(addr);
                }
                cache[addr] = CachedUpdate(val, size);
        }

        private def appendToWal() {
                addrs.apply(
                        fun (addr: u64) {
                                def c: CachedUpdate = cache[addr];
                                wal.append(addr - regionStart, c.value, c.size);
                        }
                );
        }

        // Store every after-image, then prepare their lines once each. On PMEM
        // a preparation is a CLWB, and on Cascade Lake a CLWB evicts the line,
        // so preparing each after-image as it is stored made the next store
        // into the same line miss to the medium. Preparing here, rather than
        // at the next boundary, keeps a whole record construction between each
        // writeback and both the fence and the next store to its line.
        private def applyToRegion() -> bool {
                for (i < addrs.length) {
                        def addr = addrs[i];
                        def c: CachedUpdate = cache[addr];
                        def offset = addr - regionStart;
                        if (!wal.storeAfterImage(offset, c.value, c.size)) return false;
                }
                return wal.writeBackAfterImages();
        }

        // Hash function: Convert u64 -> i32
        private def hash(addr: u64) => i32.view(addr ^ (addr >> 32));
}



// =============================================================================
// Section 7: Core Region Implementation
// =============================================================================

// Generic block-based region manager with an in-region WAL.
class RegionAllocator {
        def var backendRegion: StorageRegion;
        def var rng: Range<byte>;  // the actual bytes of the region
        def numBlocks: u64;
        def blockSize: u64;  // Size of each block
        def metadataDescriptors: Range<Ref<MetadataDescriptor>>;
        def var sentinels: BlockTableHandle;
        def var smallSentinel: BlockTableEntryHandle;
        def var largeSentinel: BlockTableEntryHandle;
        def blankChunkHandle = NULL_CHUNK;
        def var blockTableHandle: BlockTableHandle;
        def var logBlock: ChunkHandle;
        private var wal: TwoSlotWal;
        def var regionStart: u64;
        def var txn: TransactionCache;
        // Outcome of the WAL recovery this mount performed; CLEAN on a region
        // that was formatted rather than mounted. Exposed so a crash-restart
        // harness can report how often a restart actually replayed a record
        // instead of finding a clean log -- the difference between killing a
        // writer at an interesting moment and killing it while idle.
        def var lastRecovery = WalRecovery.CLEAN;
        private var writer: UnloggedWriter;
        private var regionReader: RegionReader;

        new(backend: StorageBackend, numBlocks, metadataDescriptors, blockSize: u64, mode: OpenMode) {
                var size = numBlocks * blockSize;
                var access = BackendProt.READ.mask | BackendProt.WRITE.mask;
                backendRegion = backend.open(size, access, mode);
                if (backendRegion == null) {
                        // Creation failed, or the backend refused an existing
                        // file of another size without changing it. Either way
                        // txn stays null, as for the refusals in init().
                        return;
                }
                rng = backendRegion.range;
                regionStart = u64.view(Pointer.atElement(rng, 0));
                if (!validGeometry(blockSize)) {
                        Trace.OUT.put2("RegionAllocator geometry unsupported: %d blocks of %d bytes",
                                numBlocks, blockSize).ln();
                        backendRegion.close();
                        backendRegion = null;
                        return;
                }
                // Resolve before init(): format() writes the header, sentinels,
                // block table and descriptors through this writer well before
                // ensureWal() constructs the WAL and its own provider reference.
                def ops = NativeProviders.installIfAbsent(backendRegion);
                writer = UnloggedWriter.new(ops, regionStart);
                // The reader shares the provider, so an observer installed on
                // it before this constructor sees init()'s first load.
                regionReader = RegionReader.new(ops, regionStart);
                init(blockSize, mode);
        }

        // The persistent-operation seam contracts naturally aligned 1/2/4/8-byte
        // stores and rejects anything else by aborting (System.error), so a
        // geometry that would misalign a formatted structure must be refused
        // here rather than reaching the provider. Every structure format()
        // writes -- the 8-aligned header, 40-byte block entries anchored at the
        // region end, and 32-byte descriptors -- is naturally aligned exactly
        // when the region size is a multiple of 8, since 40 % 8 == 0 and
        // 32 % 8 == 0.
        private def validGeometry(blockSize: u64) -> bool {
                if (numBlocks == 0 || blockSize == 0) return false;
                if (blockSize % 8 != 0) return false;
                def size = numBlocks * blockSize;
                // '>' not '!=': an mmap backing store may round the mapping up.
                if (size > u64.!(rng.length)) return false;
                def fixed = u64.!(RegionHeader.size)
                        + u64.!(FreeLists.MAX_LISTS) * u64.!(BlockTableEntry.size)
                        + (numBlocks + 1) * u64.!(BlockTableEntry.size)
                        + u64.!(metadataDescriptors.length * MetadataDescriptor.size);
                return fixed <= size;
        }

        private def sanitizeOffset(offset: u64) {
                if (RegionFormat.sanitize) {
                        def addr = u64.view(Pointer.atElement(rng, 0));
                        if (offset < rng.length) {
                                Trace.OUT.put3("offset %d is good for region at 0x%x of length %d",
                                        offset, addr, rng.length).ln();
                        } else {
                                Trace.OUT.put3("offset %d is bad for region at 0x%x of length %d",
                                        offset, addr, rng.length).ln();
                        }
                }
        }

        private def sanitizeAddress(addr: u64) {
                if (RegionFormat.sanitize) {
                        def delta: long = i64.view(addr) - i64.view(Pointer.atElement(rng, 0));
                        def baseAddr = u64.view(Pointer.atElement(rng, 0));
                        if (delta < 0 || delta >= rng.length) {
                                Trace.OUT.put3("address 0x%x is bad for region at 0x%x of length %d",
                                        addr, baseAddr, rng.length).ln();
                        } else {
                                Trace.OUT.put3("address 0x%x is good for region at 0x%x of length %d",
                                        addr, baseAddr, rng.length).ln();
                        }
                }
        }

        def offsetInRegion(addr: u64) -> u64 {
                return addr - regionStart;
        }

        def blockOfOffset(offset: u64) -> u64 {
                return offset / blockSize;
        }

        def blockIndexOf(blk: BlockTableEntryHandle) -> u64 {
                return (blk.addr - blockTableHandle.addr) / u64.!(BlockTableEntry.size);
        }

        def blockTableEntryToChunk(blk: BlockTableEntryHandle) -> ChunkHandle {
                return ChunkHandle(regionStart + (blockSize * blockIndexOf(blk)));
        }

        def chunkToBlockTableEntry(chunk: ChunkHandle) -> BlockTableEntryHandle {
                var index = blockOfOffset(offsetInRegion(chunk.addr));
                return blockTableHandle[index];
        }

        // Mounts a region carrying this format version's magic and formats one
        // carrying no RegionAllocator magic at all. A region tagged with another
        // version is refused as mount() refuses a geometry mismatch: nothing
        // is written, and txn stays null. Formatting it instead would erase
        // the caller's data, and mounting it would trust a layout this build
        // may not share; it must be reformatted with OpenMode.FORMAT.
        private def init(blockSize: u64, mode: OpenMode) {
                if (mode == OpenMode.FORMAT) {
                        format(blockSize);
                        return;
                }
                def magic = headerGetU64(RegionHeader.magic.offset);
                if (magic == RegionFormat.MAGIC) {
                        mount(blockSize);
                } else if (RegionFormat.isTagged(magic)) {
                        Trace.OUT.put2("format version mismatch: supported %d, stored %d",
                                RegionFormat.FORMAT_VERSION, RegionFormat.versionOf(magic)).ln();
                } else {
                        format(blockSize);
                }
        }

        private def ensureWal(logBlockAddr: u64, blockSize: u64, mode: OpenMode) {
                if (wal == null) {
                        wal = TwoSlotWal.new(regionStart, logBlockAddr, blockSize, backendRegion, mode);
                }
                if (txn == null) {
                        txn = TransactionCache.new(wal, regionStart);
                }
        }

        // Mounts an existing, fully formatted region. The header is read one
        // field at a time through the reader, so a load observer sees exactly
        // the fields a mount depends on.
        private def mount(blockSize: u64) {
                def storedBlockSize = headerGetU64(RegionHeader.blockSize.offset);
                if (blockSize != storedBlockSize) {
                        Trace.OUT.put2("blockSize mismatch: requested %d, stored %d",
                                blockSize, storedBlockSize).ln();
                        return;
                }

                def storedNumBlocks = headerGetU64(RegionHeader.numBlocks.offset);
                if (this.numBlocks != storedNumBlocks) {
                        Trace.OUT.put2("numBlocks mismatch: requested %d, stored %d",
                                this.numBlocks, storedNumBlocks).ln();
                        return;
                }

                sentinels = BlockTableHandle(u64.view(Pointer.atElement(rng, int.!(headerGetU64(RegionHeader.sentinels.offset)))), u64.!(FreeLists.MAX_LISTS));
                smallSentinel = sentinels[u64.!(FreeListKind.SMALL_FREE.code)];
                largeSentinel = sentinels[u64.!(FreeListKind.LARGE_FREE.code)];

                def numBlockTableEntries = storedNumBlocks + 1;
                def blockTableSize = numBlockTableEntries * u64.!(BlockTableEntry.size);

                blockTableHandle = BlockTableHandle(u64.view(Pointer.atElement(rng, int.!(headerGetU64(RegionHeader.blockTable.offset)))), numBlockTableEntries);

                var logBlockOffset = headerGetU64(RegionHeader.logBlock.offset);
                if (logBlockOffset == 0) logBlockOffset = blockSize; // defensive: field unset -> block 1
                logBlock = ChunkHandle(regionStart + logBlockOffset);
                ensureWal(logBlock.addr, blockSize, OpenMode.ATTACH);

                lastRecovery = txn.recover();
                match (lastRecovery) {
                        CORRUPT => Trace.OUT.puts("WAL corrupt on mount: log records ignored").ln();
                        PERSIST_FAILED => Trace.OUT.puts("WAL recovery replay could not be persisted; records retained for the next mount").ln();
                        _ => ;
                }
        }

        // Reset all fields of a block entry to their default (empty) state
        private def clearBlockTableEntry(entry: BlockTableEntryHandle) {
                entry.setListNumUnlogged(writer, 0);
                entry.setUsedUnlogged(writer, false);
                entry.setPrevUnlogged(writer, NULL_BLOCK_ENTRY);
                entry.setNextUnlogged(writer, NULL_BLOCK_ENTRY);
                entry.setListPrevUnlogged(writer, NULL_BLOCK_ENTRY);
                entry.setListNextUnlogged(writer, NULL_BLOCK_ENTRY);
        }

        // Initialize list sentinels just after the region header
        private def headerSetU64(offset: int, value: u64) {
                writer.writeOffsetU64(u64.view(offset), value);
        }

        private def headerGetU64(offset: int) -> u64 {
                return regionReader.loadOffsetU64(u64.view(offset));
        }

        private def formatSentinels() {
                def sentinelOffset = u64.!(RegionHeader.size);
                headerSetU64(RegionHeader.sentinels.offset, sentinelOffset);
                sentinels = BlockTableHandle(regionStart + sentinelOffset, u64.!(FreeLists.MAX_LISTS));
                sanitizeOffset(sentinelOffset);
                sanitizeOffset(sentinelOffset + u64.!(sentinels.size));
                for (i < u64.!(FreeLists.MAX_LISTS)) {
                        clearBlockTableEntry(sentinels[i]);
                }
        }

        // Allocate block table space from the end of the region
        private def formatBlockTable(currentRegionEnd: u64) -> u64 {
                def numBlockTableEntries = numBlocks + 1;
                def blockTableSize = numBlockTableEntries * u64.!(BlockTableEntry.size);
                var end = currentRegionEnd - blockTableSize;
                headerSetU64(RegionHeader.blockTable.offset, end);
                sanitizeOffset(end);
                blockTableHandle = BlockTableHandle(regionStart + end, numBlockTableEntries);

                for (i < numBlockTableEntries) {
                        clearBlockTableEntry(blockTableHandle[i]);
                }
                return end;
        }

        // Allocate metadata descriptor and metadata space from the end of the region
        private def formatMetadata(size: u64, currentRegionEnd: u64) -> u64 {
                def metadataDescriptorsSize = u64.!(metadataDescriptors.length * MetadataDescriptor.size);
                // {end} walks downward as each descriptor's metadata is carved off,
                // so the descriptor table's own base must be captured separately.
                def descsOffset = currentRegionEnd - metadataDescriptorsSize;
                var end = descsOffset;
                sanitizeOffset(end);
                headerSetU64(RegionHeader.metadataDescriptors.offset, end);
                headerSetU64(RegionHeader.numDescs.offset, u64.!(metadataDescriptors.length));

                for (i < metadataDescriptors.length) {
                        var desc = metadataDescriptors[i];
                        var metadataSize = u64.!(desc.fixedBytes);
                        var numUnits = (size + desc.unitSize - 1) / desc.unitSize;
                        metadataSize += numUnits * desc.bytesPerUnit;
                        end -= metadataSize;
                        sanitizeOffset(end);

                        // Written field-by-field through the seam rather than through
                        // a Ref<MetadataDescriptor>, so every descriptor store appears in the
                        // trace. Note the widths differ: kind/offset are u64, the three
                        // sizing fields are u32. Bytes +20..+23 are layout padding and
                        // stay at their zero-initialized value.
                        def descOffset = descsOffset + u64.!(i * MetadataDescriptor.size);
                        writer.writeOffsetU64(descOffset + u64.view(MetadataDescriptor.kind.offset), desc.kind);
                        writer.writeOffsetU32(descOffset + u64.view(MetadataDescriptor.fixedBytes.offset), desc.fixedBytes);
                        writer.writeOffsetU32(descOffset + u64.view(MetadataDescriptor.unitSize.offset), desc.unitSize);
                        writer.writeOffsetU32(descOffset + u64.view(MetadataDescriptor.bytesPerUnit.offset), desc.bytesPerUnit);
                        writer.writeOffsetU64(descOffset + u64.view(MetadataDescriptor.offset.offset), end);
                }
                return end;
        }

        // Formats a completely uninitialized region of memory
        private def format(blockSize: u64) {
                def size = numBlocks * blockSize;

                headerSetU64(RegionHeader.numBlocks.offset, this.numBlocks);
                headerSetU64(RegionHeader.numBytes.offset, size);
                headerSetU64(RegionHeader.blockSize.offset, blockSize);
                // Written explicitly rather than left at its zero-initialized
                // value: a fresh region must publish "no root" as a store the
                // trace can see, and a reformat over an old image must clear a
                // stale root instead of inheriting it.
                headerSetU64(RegionHeader.userRoot.offset, 0);

                formatSentinels();
                var currentRegionEnd = formatBlockTable(size);
                currentRegionEnd = formatMetadata(size, currentRegionEnd);
                def blockTableOffset = blockTableHandle.addr - regionStart;
                def sentinelOffset = u64.!(RegionHeader.size);

                var metadataBytes = u64.!(rng.length) - currentRegionEnd;
                var metadataBlocks = (metadataBytes + (blockSize - 1)) / blockSize;
                // Block 0 (header), block 1 (WAL log block), at least one free block,
                // and the metadata blocks must all fit. Without this check the
                // unsigned subtraction below underflows, blockTableHandle[] returns
                // NULL_BLOCK_ENTRY, and the linkage stores below target address 0.
                // Returning here leaves the magic unstamped, so a later mount() sees
                // the mismatch and reformats rather than trusting a partial image.
                if (numBlocks < metadataBlocks + 3u64) {
                        Trace.OUT.put2("region too small to format: %d blocks of %d bytes",
                                numBlocks, blockSize).ln();
                        return;
                }
                var userDataBlocks = numBlocks - (metadataBlocks + 1);

                // Set up block list linkage
                var headerBlockHandle = blockTableHandle[0];
                var logBlockHandle = blockTableHandle[1];
                var firstFreeBlockHandle = blockTableHandle[2];
                smallSentinel = sentinels[u64.!(FreeListKind.SMALL_FREE.code)];
                largeSentinel = sentinels[u64.!(FreeListKind.LARGE_FREE.code)];
                var metaHandle = blockTableHandle[u64.!(userDataBlocks + 1)];
                var lastHandle = blockTableHandle[u64.!(numBlocks)];

                // Block 0: region header (METADATA, used)
                sanitizeAddress(headerBlockHandle.addr);
                headerBlockHandle.setListNumUnlogged(writer, FreeListKind.METADATA.code);
                headerBlockHandle.setUsedUnlogged(writer, true);
                headerBlockHandle.setNextUnlogged(writer, logBlockHandle);
                sanitizeOffset(blockTableOffset + u64.!(BlockTableEntry.size));

                // Block 1: WAL log block (METADATA, used)
                sanitizeAddress(logBlockHandle.addr);
                logBlockHandle.setListNumUnlogged(writer, FreeListKind.METADATA.code);
                logBlockHandle.setUsedUnlogged(writer, true);
                logBlockHandle.setPrevUnlogged(writer, headerBlockHandle);
                logBlockHandle.setNextUnlogged(writer, firstFreeBlockHandle);
                sanitizeOffset(blockTableOffset + 2u64 * u64.!(BlockTableEntry.size));

                logBlock = blockTableEntryToChunk(logBlockHandle);
                headerSetU64(RegionHeader.logBlock.offset, offsetInRegion(logBlock.addr));
                ensureWal(logBlock.addr, blockSize, OpenMode.FORMAT);

                // Block 2: first free block (LARGE_FREE)
                sanitizeAddress(firstFreeBlockHandle.addr);
                firstFreeBlockHandle.setListNumUnlogged(writer, FreeListKind.LARGE_FREE.code);
                firstFreeBlockHandle.setNextUnlogged(writer, metaHandle);
                firstFreeBlockHandle.setPrevUnlogged(writer, logBlockHandle);
                firstFreeBlockHandle.setListPrevUnlogged(writer, largeSentinel);
                firstFreeBlockHandle.setListNextUnlogged(writer, NULL_BLOCK_ENTRY);
                sanitizeOffset(blockTableOffset + (userDataBlocks + 1) * u64.!(BlockTableEntry.size));
                sanitizeOffset(blockTableOffset);
                sanitizeOffset(sentinelOffset + u64.!(FreeListKind.LARGE_FREE.code * i64.!(BlockTableEntry.size)));

                // Sentinels: small starts empty, large points to firstFreeBlock
                sanitizeAddress(smallSentinel.addr);
                smallSentinel.setListNextUnlogged(writer, NULL_BLOCK_ENTRY);
                sanitizeOffset(blockTableOffset);

                sanitizeAddress(largeSentinel.addr);
                largeSentinel.setListNextUnlogged(writer, firstFreeBlockHandle);
                sanitizeOffset(blockTableOffset + u64.!(BlockTableEntry.size));

                // Metadata block (METADATA, used)
                sanitizeAddress(metaHandle.addr);
                metaHandle.setListNumUnlogged(writer, FreeListKind.METADATA.code);
                metaHandle.setUsedUnlogged(writer, true);
                metaHandle.setNextUnlogged(writer, lastHandle);
                metaHandle.setPrevUnlogged(writer, firstFreeBlockHandle);
                metaHandle.setListPrevUnlogged(writer, NULL_BLOCK_ENTRY);
                metaHandle.setListNextUnlogged(writer, NULL_BLOCK_ENTRY);
                sanitizeOffset(blockTableOffset + numBlocks * u64.!(BlockTableEntry.size));
                sanitizeOffset(blockTableOffset + u64.!(BlockTableEntry.size));

                // End-of-region marker (NONE, used)
                sanitizeAddress(lastHandle.addr);
                lastHandle.setListNumUnlogged(writer, FreeListKind.NONE.code);
                lastHandle.setUsedUnlogged(writer, true);
                lastHandle.setPrevUnlogged(writer, metaHandle);
                sanitizeOffset(blockTableOffset + (userDataBlocks + 1) * u64.!(BlockTableEntry.size));

                // Publish in two steps. init() mounts any region whose header
                // carries the magic, and a crash may make a line durable before
                // lines stored ahead of it (docs/pmem-crash-model.md), so a magic
                // made durable by the same persist as the block table could
                // reach the medium before the table does. Everything else is
                // made durable first; only then is the magic stored, and its
                // line persisted under a fence of its own.
                backendRegion.persist(0, u64.!(rng.length));
                headerSetU64(RegionHeader.magic.offset, RegionFormat.MAGIC);
                backendRegion.persist(u64.view(RegionHeader.magic.offset), 8u64);
        }

        // The region's direct reader. Loads through it bypass the transaction's
        // write-behind cache, as the raw getters always did.
        def reader() -> RegionReader {
                return regionReader;
        }

        // A copy of the whole header, observed as one load.
        def getHeader() -> Ref<RegionHeader> {
                var copy = Array<byte>.new(RegionHeader.size);
                regionReader.beforeLoad(regionStart, u64.!(RegionHeader.size));
                def base = RegionUtils.pointerFromU64(regionStart);
                for (i < RegionHeader.size) {
                        copy[i] = (base + i).load<byte>();
                }
                return Ref<RegionHeader>.of(copy[0 ..+ copy.length]);
        }

        def getMetadataDescriptor(i: u64) -> Ref<MetadataDescriptor> {
                def descs = headerGetU64(RegionHeader.metadataDescriptors.offset);
                return regionReader.forgeMetadataDescriptor(regionStart + descs + i * u64.!(MetadataDescriptor.size));
        }

        def blockTableEntryAt(offset: u64) -> Ref<BlockTableEntry> {
                return regionReader.forgeBlockTableEntry(regionStart + offset);
        }

        def createChunk(startEntry: BlockTableEntryHandle, numBlocks: u32) -> ChunkHandle {
                var chunk = ChunkHandle(regionStart + blockIndexOf(startEntry) * blockSize);

                chunk.setOffset(txn, u64.!(ChunkHeader.size));
                chunk.setLimit(txn, u64.!(numBlocks) * blockSize);
                chunk.setChunkLimit(txn, u64.!(numBlocks) * blockSize);
                linkChunkLineMarks(chunk);
                return chunk;
        }

        // Extension hook for allocators with per-chunk line metadata.
        def linkChunkLineMarks(chunk: ChunkHandle) { }

        def allocChunk(numBlocks: u32) -> ChunkHandle {
                if (requiresRecovery()) return blankChunkHandle;
                if (numBlocks == 0) return blankChunkHandle;
                if (numBlocks == 1) {
                        // Try the small free block list
                        var firstHandle = smallSentinel.getListNext(txn);
                        if (!firstHandle.isNull()) {
                                removeFromList(firstHandle);
                                firstHandle.setUsed(txn, true);
                                var chunk = createChunk(firstHandle, 1);
                                if (!performCommit()) return blankChunkHandle;
                                return chunk;
                        }
                }
                var thisHandle = largeSentinel.getListNext(txn);
                while (!thisHandle.isNull()) {
                        var thisIndex = blockIndexOf(thisHandle);
                        var nextHandle = thisHandle.getNext(txn);
                        if (nextHandle.isNull()) return blankChunkHandle;
                        var nextIndex = blockIndexOf(nextHandle);
                        var chunkBlocks = nextIndex - thisIndex;
                        if (numBlocks > chunkBlocks) {
                                thisHandle = thisHandle.getListNext(txn);
                                continue;
                        }
                        if (numBlocks == chunkBlocks) {
                                removeFromList(thisHandle);
                                thisHandle.setUsed(txn, true);
                                var chunk = createChunk(thisHandle, numBlocks);
                                if (!performCommit()) return blankChunkHandle;
                                return chunk;
                        }

                        // Split: allocate numBlocks from front, remainder stays free
                        var remIndex = thisIndex + numBlocks;
                        var remHandle = blockTableHandle[remIndex];
                        var remBlocks = nextIndex - remIndex;

                        // Set remainder's memory-order links
                        remHandle.setUsed(txn, false);
                        remHandle.setPrev(txn, thisHandle);
                        remHandle.setNext(txn, nextHandle);

                        // Update neighbors' memory-order links
                        thisHandle.setNext(txn, remHandle);
                        nextHandle.setPrev(txn, remHandle);

                        // Remove thisHandle from free list
                        removeFromList(thisHandle);

                        // Insert remainder into the correct free list
                        if (remBlocks == 1) {
                                insertAfter(smallSentinel, remHandle, FreeListKind.SMALL_FREE);
                        } else {
                                insertAfter(largeSentinel, remHandle, FreeListKind.LARGE_FREE);
                        }

                        // Mark allocated block as used
                        thisHandle.setUsed(txn, true);
                        var chunk = createChunk(thisHandle, numBlocks);
                        if (!performCommit()) return blankChunkHandle;
                        return chunk;
                }
                return blankChunkHandle;
        }

        def freeChunk(chunk: ChunkHandle) -> bool {
                if (requiresRecovery()) return false;
                if (chunk.isNull()) return false;

                // Reject handles that cannot name the start of a block in this
                // region before converting the address into a block-table index.
                // In particular, subtraction in chunkToBlockTableEntry() would
                // otherwise underflow for a handle owned by another region.
                if (chunk.addr < regionStart) return false;
                def chunkOffset = chunk.addr - regionStart;
                if (chunkOffset >= numBlocks * blockSize) return false;
                if (chunkOffset % blockSize != 0) return false;

                var entry = chunkToBlockTableEntry(chunk);
                if (entry.isNull()) return false;
                if (entry.getListNum(txn) != FreeListKind.NONE.code) return false;
                if (!entry.getUsed(txn)) return false;

                entry.setUsed(txn, false);

                // Coalesce Left
                def prev = entry.getPrev(txn);
                if (!prev.isNull() && !prev.getUsed(txn)) {
                        removeFromList(prev);
                        def next = entry.getNext(txn);
                        prev.setNext(txn, next);
                        if (!next.isNull()) {
                                next.setPrev(txn, prev);
                        }
                        entry = prev;
                }

                // Coalesce Right
                def next = entry.getNext(txn);
                if (!next.isNull() && !next.getUsed(txn)) {
                        removeFromList(next);
                        def nextNext = next.getNext(txn);
                        entry.setNext(txn, nextNext);
                        if (!nextNext.isNull()) {
                                nextNext.setPrev(txn, entry);
                        }
                }

                // Insert into the appropriate free list based on coalesced size
                def startIndex = blockIndexOf(entry);
                def nextNeighbor = entry.getNext(txn);
                def endIndex = if (nextNeighbor.isNull(), numBlocks, blockIndexOf(nextNeighbor));
                def newSize = endIndex - startIndex;

                if (newSize == 1) {
                        insertAfter(smallSentinel, entry, FreeListKind.SMALL_FREE);
                } else {
                        insertAfter(largeSentinel, entry, FreeListKind.LARGE_FREE);
                }
                return performCommit();
        }

        // The durable root. A mounted region is otherwise opaque to its caller:
        // the block table records which extents are in use, but not which of
        // them the caller wants to reach after a remount. The root is a single
        // region-relative offset the caller publishes transactionally, so a
        // program that stops and restarts can find its own data again instead
        // of hardcoding an offset.
        //
        // 0 means "no root". Offset 0 is the region header, which is never
        // allocatable, so the sentinel cannot collide with a real target.
        def getUserRoot() -> u64 {
                if (txn == null) return 0;
                return txn.readU64(regionStart + u64.view(RegionHeader.userRoot.offset));
        }

        // Publishes {offset} as the root in its own transaction. Returns false
        // for a rejected value or a failed commit; use requiresRecovery() to
        // tell an out-of-range argument from a persistence failure.
        //
        // The root is published by a separate transaction from the allocation
        // it names, so a crash between the two leaks the allocated extent: it
        // stays marked used but nothing reaches it. That is a space leak, not
        // an inconsistency, and it is the direct consequence of allocChunk()
        // committing on its own (see docs/CRITIQUE.md #1). A caller that must
        // not leak should publish first and allocate into a root-reachable
        // free list of its own.
        def setUserRoot(offset: u64) -> bool {
                if (requiresRecovery()) return false;
                if (txn == null) return false;
                // Reject an offset that cannot name a byte in this region.
                // Without this, a remount would hand the caller back a wild
                // address derived from regionStart.
                if (offset >= numBlocks * blockSize) return false;
                txn.writeU64(regionStart + u64.view(RegionHeader.userRoot.offset), offset);
                return performCommit();
        }

        // Distinguish an ordinary allocator rejection (for example, no fitting
        // chunk or an oversized WAL record) from a persistence failure that
        // makes this mounted instance unsafe to continue using.
        def requiresRecovery() -> bool {
                return txn != null && txn.requiresRecovery();
        }

        // Insert entry into list immediately after sentinel (head insertion)
        def insertAfter(sentinel: BlockTableEntryHandle, entry: BlockTableEntryHandle, kind: FreeListKind) {
                entry.setListNum(txn, kind.code);
                var listNext = sentinel.getListNext(txn);

                // Link: sentinel -> entry -> listNext
                sentinel.setListNext(txn, entry);
                entry.setListPrev(txn, sentinel);
                entry.setListNext(txn, listNext);

                if (!listNext.isNull()) {
                        listNext.setListPrev(txn, entry);
                }
        }

        def removeFromList(blk: BlockTableEntryHandle) {
                var listPrev = blk.getListPrev(txn);
                var listNext = blk.getListNext(txn);

                if (!listPrev.isNull()) {
                        listPrev.setListNext(txn, listNext);
                }
                if (!listNext.isNull()) {
                        listNext.setListPrev(txn, listPrev);
                }

                blk.setListPrev(txn, NULL_BLOCK_ENTRY);
                blk.setListNext(txn, NULL_BLOCK_ENTRY);
                blk.setListNum(txn, FreeListKind.NONE.code);
        }

        // Deallocate this region
        def deallocate() {
                if (wal != null) {
                        wal.close();
                        wal = null;
                }
                // The writer's provider holds a range over memory that close()
                // is about to unmap; drop it so a stale direct store fails
                // deterministically instead of writing into unmapped pages. The
                // reader likewise, for a stale direct load.
                writer = null;
                regionReader = null;
                if (backendRegion != null) {
                        backendRegion.close();
                        backendRegion = null;
                }
        }

        private def performCommit() -> bool {
                return txn.commit();
        }

        private def recover() -> WalRecovery {
                return txn.recover();
        }
}


// =============================================================================
// Section 8: Immix Extensions
// =============================================================================

class ImmixRegionAllocator extends RegionAllocator {
        new(backend: StorageBackend, numBlocks: u64, metadataDescriptors: Range<Ref<MetadataDescriptor>>, blockSize: u64, mode: OpenMode)
                super(backend, numBlocks, metadataDescriptors, blockSize, mode) {
                // Backend creation can fail (for example, MAP_SYNC on a non-DAX
                // filesystem, or an existing region file of another size), and
                // init() can leave a mapped region unopened: another format
                // version, a stored geometry that does not match, or a region
                // too small to format. Each way txn stays null. Leave the Immix view empty then, as
                // RegionAllocator leaves the region unopened: a refused region's
                // descriptors follow a layout this build has not validated, and
                // with no line marks resetAllLineMarks() writes nothing.
                if (txn != null) lineMarks = getLineMarks();
        }

        // Line mark definitions
        def var lineMarks: LineMarkTableHandle;
        def var numLineMarks: u64;
        def var lineSize: u64;

        private def getLineMarks() -> LineMarkTableHandle {
                def numDescs = reader().loadOffsetU64(u64.view(RegionHeader.numDescs.offset));
                for (i < numDescs) {
                        var r = getMetadataDescriptor(u64.!(i));
                        if (r.kind == ImmixLineMarks.ImmixLineMarkMetaKind) {
                                lineSize = u64.!(r.unitSize);
                                var spaceSize = numBlocks * blockSize;
                                numLineMarks = (spaceSize + lineSize - 1) / lineSize;
                                // fixedBytes is a descriptor-owned prefix; per-unit
                                // line marks begin immediately after it.
                                def lineMarksOffset = r.offset + u64.!(r.fixedBytes);
                                var lmrng = this.rng[lineMarksOffset ..+ numLineMarks * u64.!(LineMark.size)];
                                return LineMarkTableHandle(u64.view(Pointer.atElement(lmrng, 0) - Pointer.NULL), numLineMarks);
                        }
                }
                return LineMarkTableHandle(0, 0);
        }

        def linkChunkLineMarks(chunk: ChunkHandle) {
                if (lineMarks.addr == 0 || lineMarks.size == 0) {
                        chunk.setLinemarks(txn, 0);
                        return;
                }
                def lineIndex = offsetInRegion(chunk.addr) / lineSize;
                chunk.setLinemarks(txn, lineMarks[lineIndex].addr - regionStart);
        }

        // The region's non-transactional writer, exposed for line marks only:
        // setMarkUnlogged() takes it explicitly, like the other direct setters, so a
        // store that bypasses the WAL stays visible at the call site.
        def lineMarkWriter() -> UnloggedWriter {
                return writer;
        }

        def resetAllLineMarks() {
                // Line marks are transient GC state. They deliberately bypass the
                // allocator transaction/WAL and must be rebuilt after a crash.
                // Their stores cross the persistence seam like every other
                // allocator store, but no writeback or fence is issued for them.
                for (index < numLineMarks) {
                        lineMarks[index].setMarkUnlogged(writer, ImmixLineMarks.ImmixLineMarkResetValue);
                }
        }
}

component ImmixLineMarks {
        def ImmixLineMarkMetaKind = 0x0000_0001_0000_0000u64;
        def ImmixLineMarkResetValue = 0u8;
        def DefaultImmixLineSize = 256u32;

        // Line mark states (matching original Immix paper)
        // Lines are either free (unmarked) or contain live objects (marked)
        def LINE_FREE: u8 = 0;    // unmarked - line is available for allocation
        def LINE_MARKED: u8 = 1;  // marked - line contains live objects
}


component RegionDefaults {
        def defaultMetadataDescriptors = Array<byte>.new(MetadataDescriptor.size * 1);
        def lineMarkDescRef = Ref<MetadataDescriptor>.at(defaultMetadataDescriptors, 0);
        def BlockSize = 512u64 * 1024u64;
        new() {
                var r = lineMarkDescRef;
                r.kind = ImmixLineMarks.ImmixLineMarkMetaKind;
                r.fixedBytes = 0;
                r.unitSize = ImmixLineMarks.DefaultImmixLineSize;
                r.bytesPerUnit = u32.!(LineMark.size);
                // leave offset unset (i.e., 0)
        }
}
