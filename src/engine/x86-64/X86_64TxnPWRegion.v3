// =============================================================================
// Section 1: Configuration and Constants
// =============================================================================

component PWRegions {
        def MAGIC = 0x50_57_41_53_4Du64; // "PWASM" in hex
        def blockSize: u64 = 256u64 * 1024u64;
        def sanitize = false;
}

component BlockLists {
        def MAX_LISTS = 8;      // maximum number of lists == number of list sentinels
                                // METADATA, etc., do not have sentinels and not part of this count
}


// =============================================================================
// Section 2: On-Memory Layouts (raw data structures)
// =============================================================================

layout PWRegionHeader {
        +0      blockTable:     u64;    // relative offset to the block table
        +8      sentinels:      u64;    // offset of the sentinels (whatever type are!)
        +16     numBlocks:      u64;
        +24     numBytes:       u64;
        +32     numDescs:       u64;
        +40     metaData:       u64;    // relative offset to the metadata area
        +48     metaDataDescs:  u64;    // relative offset to the metadata descriptors
        +56     magic:          u64;    // identifier to confirm region is formatted
        +64     blockSize:      u64;    // block size this region was formatted with
        // TODO: maybe add pointer to log chunk, because this will be needed for recovery
        =72;
}

layout BlockEntry {
        +0      listNum:        i16;    // which list is this entry part of
        +2      used:           u1;     // is this block in use? // TODO: Use bool after the compiler is fixed
                                        // gap
        +8      prev:           i64;    // prev entry in memory;
        +16     next:           i64;    // next entry in memory order
        +24     listPrev:       i64;    // prev entry on same list
        +32     listNext:       i64;    // next entry on same list
        =40;
}

layout ChunkHeader {
        +0      offset:         u64;    // offset in chunk for next allocation
        +8      limit:          u64;    // offset just beyond last available byte in chunk
        +16     chunk_limit:    u64;    // offset just beyond end of the chunk
        +24     linemarks:      u64;    // offset to first link mark of the chunk
        =32;                            // size of chunk header
}

layout MetaDataDesc {
        +0      kind:           u64;    // unique code, identifying the kind of metadata
        +8      fixedBytes:     u32;    // single-copy data at beginning of metadata block
        +12     unitSize:       u32;    // number of bytes of data space per metadata item
        +16     bytesPerUnit:   u32;    // size of each metadata item, in bytes
                                        // gap
        +24     offset:         u64;    // offset in region of the actual metadata
        =32;
}

layout LineMark {
        +0      mark:           u8;     // line mark info
        =1;
}

layout LogHeader {
        +0      numEntries:     u32;    // Number of valid entries in this transaction
        +4      status:         u8;     // 0 = Invalid, 1 = Committed
        +8      checksum:       u64;    // Optional: Simple checksum for integrity
        =32;                            // Pad to 32 bytes
}

layout LogEntry {
        +0      offset:         u64;    // Relative offset of first changed byte, from the start of the Region
        +8      value:          u64;    // The data to be written
        +16     width:          u8;     // number of bytes being changed (1, 2, 4, 8)
        =32;
}


// =============================================================================
// Section 3: Enumerations
// =============================================================================

enum ListKind(code: i16) {
        METADATA(-1),
        NONE(-2),
        USED(-3),
        SMALL_FREE(0),
        LARGE_FREE(1)
}


// =============================================================================
// Section 4: Utilities
// =============================================================================

component PWRegionUtils {
        def pointerFromU64(n: u64) -> Pointer {
                return Pointer.NULL + i64.view(n);
        }

        def pointerFromI64(n: i64) -> Pointer {
                return Pointer.NULL + n;
        }

        // Shared checksum for WAL log entries. Used during WAL commit
        // and recovery to ensure integrity.
        def calculateLogChecksum(base: u64, count: u32) -> u64 {
                var h: u64 = 0xCAFE_BABE_DEAD_BEEF_u64;
                var ptr = base;
                for (i < count) {
                        var entry = Ref<LogEntry>.of(CiRuntime.forgeRange<byte>(pointerFromU64(ptr), LogEntry.size));
                        h = (h << 13) | (h >> 51);
                        h = h ^ entry.offset;
                        h = h ^ entry.value;
                        h = h ^ u64.view(entry.width);
                        ptr = ptr + u64.!(LogEntry.size);
                }
                return h;
        }
}


// =============================================================================
// Section 5: Handle Types (wrappers around layouts for convenient access)
// =============================================================================

def NULL_BLOCK_ENTRY = BlockEntryHandle(0);
def NULL_CHUNK = ChunkHandle(0);

type BlockTableHandle(addr: u64, size: u64) #unboxed {
        def [n: u64] -> BlockEntryHandle {
                return if(
                        n < size,
                        BlockEntryHandle(addr + (n * u64.!(BlockEntry.size))),
                        NULL_BLOCK_ENTRY
                );
        }
}

type BlockEntryHandle(addr: u64) #unboxed {
        def isNull() -> bool {
                return addr == 0;
        }

        def toHandle(offset: i64) -> BlockEntryHandle {
                if (offset == 0) return NULL_BLOCK_ENTRY;
                return BlockEntryHandle(u64.view(i64.view(addr) + offset));
        }

        def toOffset(other: BlockEntryHandle) -> i64 {
                if (other.isNull()) return 0;
                return i64.view(other.addr) - i64.view(this.addr);
        }

        def getRef() -> Ref<BlockEntry> {
                return Ref<BlockEntry>.of(CiRuntime.forgeRange<byte>(PWRegionUtils.pointerFromU64(addr), BlockEntry.size));
        }

        def getListNum() -> i16 {
                return getRef().listNum;
        }

        def getUsed() -> bool {
                return getRef().used == 1u1;
        }

        def getPrev() -> BlockEntryHandle {
                return toHandle(getRef().prev);
        }

        def getNext() -> BlockEntryHandle {
                return toHandle(getRef().next);
        }

        def getListPrev() -> BlockEntryHandle {
                return toHandle(getRef().listPrev);
        }

        def getListNext() -> BlockEntryHandle {
                return toHandle(getRef().listNext);
        }

        def getListNumCached(cache: RegionTransaction) -> i16 {
                return cache.readI16(addr + u64.view(BlockEntry.listNum.offset));
        }

        def getUsedCached(cache: RegionTransaction) -> bool {
                def used = cache.readU8(addr + u64.view(BlockEntry.used.offset));
                return used == 1;
        }

        def getPrevCached(cache: RegionTransaction) -> BlockEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockEntry.prev.offset)));
        }

        def getNextCached(cache: RegionTransaction) -> BlockEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockEntry.next.offset)));
        }

        def getListPrevCached(cache: RegionTransaction) -> BlockEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockEntry.listPrev.offset)));
        }

        def getListNextCached(cache: RegionTransaction) -> BlockEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockEntry.listNext.offset)));
        }

        def setListNum(v: i16) {
                getRef().listNum = v;
        }

        def setUsed(v: bool) {
                getRef().used = if(v, 1u1, 0u1);
        }

        def setPrev(v: BlockEntryHandle) {
                getRef().prev = toOffset(v);
        }

        def setNext(v: BlockEntryHandle) {
                getRef().next = toOffset(v);
        }

        def setListPrev(v: BlockEntryHandle) {
                getRef().listPrev = toOffset(v);
        }

        def setListNext(v: BlockEntryHandle) {
                getRef().listNext = toOffset(v);
        }

        def setListNumCached(cache: RegionTransaction, v: i16) {
                cache.writeI16(addr + u64.view(BlockEntry.listNum.offset), v);
        }

        def setUsedCached(cache: RegionTransaction, v: bool) {
                def num: u8 = if(v, 1, 0);
                cache.writeU8(addr + u64.view(BlockEntry.used.offset), num);
        }

        def setPrevCached(cache: RegionTransaction, v: BlockEntryHandle) {
                cache.writeI64(addr + u64.view(BlockEntry.prev.offset), toOffset(v));
        }

        def setNextCached(cache: RegionTransaction, v: BlockEntryHandle) {
                cache.writeI64(addr + u64.view(BlockEntry.next.offset), toOffset(v));
        }

        def setListPrevCached(cache: RegionTransaction, v: BlockEntryHandle) {
                cache.writeI64(addr + u64.view(BlockEntry.listPrev.offset), toOffset(v));
        }

        def setListNextCached(cache: RegionTransaction, v: BlockEntryHandle) {
                cache.writeI64(addr + u64.view(BlockEntry.listNext.offset), toOffset(v));
        }
}

type ChunkHandle(addr: u64) #unboxed {
        def isNull() -> bool {
                return addr == 0;
        }

        def getRef() -> Ref<ChunkHeader> {
                return Ref<ChunkHeader>.of(CiRuntime.forgeRange<byte>(PWRegionUtils.pointerFromU64(addr), ChunkHeader.size));
        }

        def getOffset() -> u64 {
                return getRef().offset;
        }

        def getLimit() -> u64 {
                return getRef().limit;
        }

        def getChunkLimit() -> u64 {
                return getRef().chunk_limit;
        }

        def getLinemarks() -> u64 {
                return getRef().linemarks;
        }

        def setOffset(v: u64) {
                getRef().offset = v;
        }

        def setLimit(v: u64) {
                getRef().limit = v;
        }

        def setChunkLimit(v: u64) {
                getRef().chunk_limit = v;
        }

        def setLinemarks(v: u64) {
                getRef().linemarks = v;
        }

        def setOffsetCached(cache: RegionTransaction, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.offset.offset), v);
        }

        def setLimitCached(cache: RegionTransaction, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.limit.offset), v);
        }

        def setChunkLimitCached(cache: RegionTransaction, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.chunk_limit.offset), v);
        }

        def setLinemarksCached(cache: RegionTransaction, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.linemarks.offset), v);
        }
}

type LineMarkTableHandle(addr: u64, size: u64) #unboxed {
        def [n: u64] -> LineMarkHandle {
                return if(
                        n < size,
                        LineMarkHandle(addr + n * u64.!(LineMark.size)),
                        LineMarkHandle(0)
                );
        }
}

type LineMarkHandle(addr: u64) #unboxed {
        def getRef() -> Ref<LineMark> {
                return Ref<LineMark>.of(CiRuntime.forgeRange<byte>(PWRegionUtils.pointerFromU64(addr), LineMark.size));
        }

        def getMark() -> u8 {
                return getRef().mark;
        }

        def setMark(v: u8) {
                getRef().mark = v;
        }
}

type LogEntryHandle(addr: u64) { }


// =============================================================================
// Section 6: WAL Infrastructure (write-behind cache and write-ahead log)
// =============================================================================

// Wrapper ADT to store the cached value and its width (size)
type CachedUpdate(value: u64, size: u8) #unboxed { }

// A transaction facade over the write-behind cache and redo log.
// This component buffers writes in DRAM, then commits them through RegionWal.
//
// CONSTRAINT: ALIGNED ACCESS ONLY
// This implementation uses a HashMap to store updates. It does not support spatial
// queries or overlapping intervals. Consequently:
// 1. Reads must match the exact address of previous writes.
// 2. Mixed-width accesses (e.g., writing 8 bytes at 0x10, then reading 1 byte at 0x11)
//    will result in a cache miss, returning stale data.
class RegionTransaction {
        private var cache: HashMap<u64, CachedUpdate>;
        private def addrs = Vector<u64>.new();
        private def wal: RegionWal;
        def regionStart: u64;

        new(wal, regionStart) {
                cache = HashMap<u64, CachedUpdate>.new(hash, u64.==);
        }

        def isDirty() -> bool {
                return addrs.length != 0;
        }

        def commit() {
                if (!isDirty()) return;
                appendToWal();
                wal.commit();
                applyToRegion();
                wal.fenceAppliedUpdates();
                wal.clear();
                clear();
        }

        def recover() -> bool {
                return wal.recover();
        }

        private def clear() {
                cache = HashMap<u64, CachedUpdate>.new(hash, u64.==);
                addrs.clear();
        }

        def readU8(addr: u64) -> u8 {
                if (cache.has(addr)) return u8.view(cache[addr].value);
                return wal.readU8(addr - regionStart);
        }

        def readI16(addr: u64) -> i16 {
                if (cache.has(addr)) return i16.view(cache[addr].value);
                return wal.readI16(addr - regionStart);
        }

        def readU64(addr: u64) -> u64 {
                if (cache.has(addr)) return u64.view(cache[addr].value);
                return wal.readU64(addr - regionStart);
        }

        def readI64(addr: u64) -> i64 {
                if (cache.has(addr)) return i64.view(cache[addr].value);
                return wal.readI64(addr - regionStart);
        }

        // Write BlockEntry.used (u1/bool stored as u8)
        def writeU8(addr: u64, val: u8) {
                writeHelper(addr, 1, u64.view(val));
        }

        // Write BlockEntry.listNum
        def writeI16(addr: u64, val: i16) {
                writeHelper(addr, 2, u64.view(u16.view(val)));
        }

        // Write ChunkHeader.offset, limit
        def writeU64(addr: u64, val: u64) {
                writeHelper(addr, 8, val);
        }

        // Write BlockEntry.prev, next, listPrev, listNext
        def writeI64(addr: u64, val: i64) {
                writeHelper(addr, 8, u64.view(val));
        }

        private def writeHelper(addr: u64, size: u8, val: u64) {
                if (!cache.has(addr)) {
                        addrs.put(addr);
                }
                cache[addr] = CachedUpdate(val, size);
        }

        private def appendToWal() {
                addrs.apply(
                        fun (addr: u64) {
                                def c: CachedUpdate = cache[addr];
                                wal.append(addr - regionStart, c.value, c.size);
                        }
                );
        }

        private def applyToRegion() {
                addrs.apply(
                        fun (addr: u64) {
                                def c: CachedUpdate = cache[addr];
                                wal.applyUpdate(addr - regionStart, c.value, c.size);
                        }
                );
        }

        // Hash function: Convert u64 -> i32
        private def hash(addr: u64) => i32.view(addr ^ (addr >> 32));
}



// =============================================================================
// Section 7: Core Region Implementation
// =============================================================================

// Generic block-based region manager with an in-region WAL.
class PWRegion {
        def var backendRegion: BackendRegion;
        def var rng: Range<byte>;  // the actual bytes of the region
        def numBlocks: u64;
        def blockSize: u64;  // Size of each block
        def metaDataDescs: Range<Ref<MetaDataDesc>>;
        def var sentinels: BlockTableHandle;
        def var smallSentinel: BlockEntryHandle;
        def var largeSentinel: BlockEntryHandle;
        def blankChunkHandle = NULL_CHUNK;
        def var blockTableHandle: BlockTableHandle;
        def var logChunk: ChunkHandle;
        private var wal: RegionWal;
        def var regionStart: u64;
        def var txn: RegionTransaction;

        new(backend: TxnRegionBackend, numBlocks, metaDataDescs, blockSize: u64, forceFormat: bool) {
                var size = numBlocks * blockSize;
                var prot = BackendProt.READ.mask | BackendProt.WRITE.mask;
                backendRegion = backend.create(size, prot);
                if (backendRegion == null) {
                        // Creation failed
                        return;
                }
                rng = backendRegion.range;
                regionStart = u64.view(Pointer.atElement(rng, 0));
                init(blockSize, forceFormat);
        }

        private def sanitizeOffset(offset: u64) {
                if (PWRegions.sanitize) {
                        def addr = u64.view(Pointer.atElement(rng, 0));
                        if (offset < rng.length) {
                                Trace.OUT.put3("offset %d is good for region at 0x%x of length %d",
                                        offset, addr, rng.length).ln();
                        } else {
                                Trace.OUT.put3("offset %d is bad for region at 0x%x of length %d",
                                        offset, addr, rng.length).ln();
                        }
                }
        }

        private def sanitizeAddress(addr: u64) {
                if (PWRegions.sanitize) {
                        def delta: long = i64.view(addr) - i64.view(Pointer.atElement(rng, 0));
                        def baseAddr = u64.view(Pointer.atElement(rng, 0));
                        if (delta < 0 || delta >= rng.length) {
                                Trace.OUT.put3("address 0x%x is bad for region at 0x%x of length %d",
                                        addr, baseAddr, rng.length).ln();
                        } else {
                                Trace.OUT.put3("address 0x%x is good for region at 0x%x of length %d",
                                        addr, baseAddr, rng.length).ln();
                        }
                }
        }

        def offsetInRegion(addr: u64) -> u64 {
                return addr - u64.view((Pointer.atElement(rng, 0) - Pointer.NULL));
        }

        def blockOfOffset(offset: u64) -> u64 {
                return offset / blockSize;
        }

        def blockIndexOf(blk: BlockEntryHandle) -> u64 {
                return (blk.addr - blockTableHandle.addr) / u64.!(BlockEntry.size);
        }

        def blockEntryToChunk(blk: BlockEntryHandle) -> ChunkHandle {
                return ChunkHandle(u64.view(Pointer.atElement(rng, 0)) + (blockSize * blockIndexOf(blk)));
        }

        def chunkToBlockEntry(chunk: ChunkHandle) -> BlockEntryHandle {
                var index = blockOfOffset(offsetInRegion(chunk.addr));
                return blockTableHandle[index];
        }

        private def init(blockSize: u64, forceFormat: bool) {
                var hdr = getHeader();
                if (!forceFormat && hdr.magic == PWRegions.MAGIC) {
                        mount(blockSize);
                } else {
                        format(blockSize);
                }
        }

        private def ensureWal(logChunkAddr: u64, blockSize: u64) {
                if (wal == null) {
                        wal = RegionWal.new(regionStart, logChunkAddr, blockSize, backendRegion);
                }
                if (txn == null) {
                        txn = RegionTransaction.new(wal, regionStart);
                }
        }

        // Mounts an existing, fully formatted region
        private def mount(blockSize: u64) {
                def hdr = getHeader();

                if (blockSize != hdr.blockSize) {
                        Trace.OUT.put2("blockSize mismatch: requested %d, stored %d",
                                blockSize, hdr.blockSize).ln();
                        return;
                }

                if (this.numBlocks != hdr.numBlocks) {
                        Trace.OUT.put2("numBlocks mismatch: requested %d, stored %d",
                                this.numBlocks, hdr.numBlocks).ln();
                        return;
                }

                sentinels = BlockTableHandle(u64.view(Pointer.atElement(rng, int.!(hdr.sentinels))), u64.!(BlockLists.MAX_LISTS));
                smallSentinel = sentinels[u64.!(ListKind.SMALL_FREE.code)];
                largeSentinel = sentinels[u64.!(ListKind.LARGE_FREE.code)];

                def numBlockTableEntries = hdr.numBlocks + 1;
                def blockTableSize = numBlockTableEntries * u64.!(BlockEntry.size);

                blockTableHandle = BlockTableHandle(u64.view(Pointer.atElement(rng, int.!(hdr.blockTable))), numBlockTableEntries);

                def logBlockHandle = blockTableHandle[1];
                logChunk = blockEntryToChunk(logBlockHandle);
                ensureWal(logChunk.addr, blockSize);

                txn.recover();
        }

        // Reset all fields of a block entry to their default (empty) state
        private def clearBlockEntry(entry: BlockEntryHandle) {
                entry.setListNum(0);
                entry.setUsed(false);
                entry.setPrev(NULL_BLOCK_ENTRY);
                entry.setNext(NULL_BLOCK_ENTRY);
                entry.setListPrev(NULL_BLOCK_ENTRY);
                entry.setListNext(NULL_BLOCK_ENTRY);
        }

        // Initialize list sentinels just after the region header
        private def formatSentinels(hdr: Ref<PWRegionHeader>) {
                hdr.sentinels = u64.!(PWRegionHeader.size);
                sentinels = BlockTableHandle(u64.view(Pointer.atElement(rng, int.!(hdr.sentinels))), u64.!(BlockLists.MAX_LISTS));
                sanitizeOffset(hdr.sentinels);
                sanitizeOffset(hdr.sentinels + u64.!(sentinels.size));
                for (i < u64.!(BlockLists.MAX_LISTS)) {
                        clearBlockEntry(sentinels[i]);
                }
        }

        // Allocate block table space from the end of the region
        private def formatBlockTable(hdr: Ref<PWRegionHeader>, currentRegionEnd: u64) -> u64 {
                def numBlockTableEntries = numBlocks + 1;
                def blockTableSize = numBlockTableEntries * u64.!(BlockEntry.size);
                var end = currentRegionEnd - blockTableSize;
                hdr.blockTable = end;
                sanitizeOffset(end);
                blockTableHandle = BlockTableHandle(u64.view(Pointer.atElement(rng, int.!(end))), numBlockTableEntries);

                for (i < numBlockTableEntries) {
                        clearBlockEntry(blockTableHandle[i]);
                }
                return end;
        }

        // Allocate metadata descriptor and metadata space from the end of the region
        private def formatMetaData(hdr: Ref<PWRegionHeader>, size: u64, currentRegionEnd: u64) -> u64 {
                def metaDataDescsSize = u64.!(metaDataDescs.length * MetaDataDesc.size);
                var end = currentRegionEnd - metaDataDescsSize;
                sanitizeOffset(end);
                hdr.metaDataDescs = end;
                hdr.numDescs = u64.!(metaDataDescs.length);

                for (i < metaDataDescs.length) {
                        var desc = metaDataDescs[i];
                        var metaDataSize = u64.!(desc.fixedBytes);
                        var numUnits = (size + desc.unitSize - 1) / desc.unitSize;
                        metaDataSize += numUnits * desc.bytesPerUnit;
                        end -= metaDataSize;
                        sanitizeOffset(end);

                        var newDesc = getMetaDataDesc(u64.!(i));
                        newDesc.kind = desc.kind;
                        newDesc.fixedBytes = desc.fixedBytes;
                        newDesc.unitSize = desc.unitSize;
                        newDesc.bytesPerUnit = desc.bytesPerUnit;
                        newDesc.offset = end;
                }
                return end;
        }

        // Formats a completely uninitialized region of memory
        private def format(blockSize: u64) {
                def size = numBlocks * blockSize;
                def hdr = getHeader();
                sanitizeAddress(u64.view(Pointer.atRef(hdr)));

                hdr.numBlocks = this.numBlocks;
                hdr.numBytes = size;
                hdr.blockSize = blockSize;

                formatSentinels(hdr);
                var currentRegionEnd = formatBlockTable(hdr, size);
                currentRegionEnd = formatMetaData(hdr, size, currentRegionEnd);

                var metaDataBytes = u64.!(rng.length) - currentRegionEnd;
                var metaDataBlocks = (metaDataBytes + (blockSize - 1)) / blockSize;
                var userDataBlocks = numBlocks - (metaDataBlocks + 1);

                // Set up block list linkage
                var headerBlockHandle = blockTableHandle[0];
                var logBlockHandle = blockTableHandle[1];
                var firstFreeBlockHandle = blockTableHandle[2];
                smallSentinel = sentinels[u64.!(ListKind.SMALL_FREE.code)];
                largeSentinel = sentinels[u64.!(ListKind.LARGE_FREE.code)];
                var metaHandle = blockTableHandle[u64.!(userDataBlocks + 1)];
                var lastHandle = blockTableHandle[u64.!(numBlocks)];

                // Block 0: region header (METADATA, used)
                sanitizeAddress(headerBlockHandle.addr);
                headerBlockHandle.setListNum(ListKind.METADATA.code);
                headerBlockHandle.setUsed(true);
                headerBlockHandle.setNext(logBlockHandle);
                sanitizeOffset(hdr.blockTable + u64.!(BlockEntry.size));

                // Block 1: WAL log chunk (METADATA, used)
                sanitizeAddress(logBlockHandle.addr);
                logBlockHandle.setListNum(ListKind.METADATA.code);
                logBlockHandle.setUsed(true);
                logBlockHandle.setPrev(headerBlockHandle);
                logBlockHandle.setNext(firstFreeBlockHandle);
                sanitizeOffset(hdr.blockTable + 2u64 * u64.!(BlockEntry.size));

                logChunk = blockEntryToChunk(logBlockHandle);
                ensureWal(logChunk.addr, blockSize);

                // Block 2: first free block (LARGE_FREE)
                sanitizeAddress(firstFreeBlockHandle.addr);
                firstFreeBlockHandle.setListNum(ListKind.LARGE_FREE.code);
                firstFreeBlockHandle.setNext(metaHandle);
                firstFreeBlockHandle.setPrev(logBlockHandle);
                firstFreeBlockHandle.setListPrev(largeSentinel);
                firstFreeBlockHandle.setListNext(NULL_BLOCK_ENTRY);
                sanitizeOffset(hdr.blockTable + (userDataBlocks + 1) * u64.!(BlockEntry.size));
                sanitizeOffset(hdr.blockTable);
                sanitizeOffset(hdr.sentinels + u64.!(ListKind.LARGE_FREE.code * i64.!(BlockEntry.size)));

                // Sentinels: small starts empty, large points to firstFreeBlock
                sanitizeAddress(smallSentinel.addr);
                smallSentinel.setListNext(NULL_BLOCK_ENTRY);
                sanitizeOffset(hdr.blockTable);

                sanitizeAddress(largeSentinel.addr);
                largeSentinel.setListNext(firstFreeBlockHandle);
                sanitizeOffset(hdr.blockTable + u64.!(BlockEntry.size));

                // Metadata block (METADATA, used)
                sanitizeAddress(metaHandle.addr);
                metaHandle.setListNum(ListKind.METADATA.code);
                metaHandle.setUsed(true);
                metaHandle.setNext(lastHandle);
                metaHandle.setPrev(firstFreeBlockHandle);
                metaHandle.setListPrev(NULL_BLOCK_ENTRY);
                metaHandle.setListNext(NULL_BLOCK_ENTRY);
                sanitizeOffset(hdr.blockTable + numBlocks * u64.!(BlockEntry.size));
                sanitizeOffset(hdr.blockTable + u64.!(BlockEntry.size));

                // End-of-region marker (NONE, used)
                sanitizeAddress(lastHandle.addr);
                lastHandle.setListNum(ListKind.NONE.code);
                lastHandle.setUsed(true);
                lastHandle.setPrev(metaHandle);
                sanitizeOffset(hdr.blockTable + (userDataBlocks + 1) * u64.!(BlockEntry.size));

                hdr.magic = PWRegions.MAGIC;

                // Persist the freshly formatted region image before exposing it.
                backendRegion.persistRange(0, u64.!(rng.length));
        }

        def getHeader() -> Ref<PWRegionHeader> {
                return Ref<PWRegionHeader>.of(rng[0 ..+ PWRegionHeader.size]);
        }

        def getMetaDataDesc(i: u64) -> Ref<MetaDataDesc> {
                var hdr = getHeader();
                return Ref<MetaDataDesc>.of(rng[hdr.metaDataDescs + i * u64.!(MetaDataDesc.size) ..+ MetaDataDesc.size]);
        }

        def blockEntryAt(offset: u64) -> Ref<BlockEntry> {
                return Ref<BlockEntry>.of(rng[offset ..+ BlockEntry.size]);
        }

        def createChunk(startEntry: BlockEntryHandle, numBlocks: u32) -> ChunkHandle {
                var chunk = ChunkHandle(u64.view(Pointer.atElement(rng, 0)) + blockIndexOf(startEntry) * blockSize);

                chunk.setOffsetCached(txn, u64.!(ChunkHeader.size));
                chunk.setLimitCached(txn, u64.!(numBlocks) * blockSize);
                chunk.setChunkLimitCached(txn, u64.!(numBlocks) * blockSize);

                // TODO link mark field
                return chunk;
        }

        def allocChunk(numBlocks: u32) -> ChunkHandle {
                if (numBlocks == 1) {
                        // Try the small free block list
                        var firstHandle = smallSentinel.getListNextCached(txn);
                        if (!firstHandle.isNull()) {
                                removeFromList(firstHandle);
                                firstHandle.setUsedCached(txn, true);
                                var chunk = createChunk(firstHandle, 1);
                                performCommit();
                                return chunk;
                        }
                }
                var thisHandle = largeSentinel.getListNextCached(txn);
                while (!thisHandle.isNull()) {
                        var thisIndex = blockIndexOf(thisHandle);
                        var nextHandle = thisHandle.getNextCached(txn);
                        if (nextHandle.isNull()) return blankChunkHandle;
                        var nextIndex = blockIndexOf(nextHandle);
                        var chunkBlocks = nextIndex - thisIndex;
                        if (numBlocks > chunkBlocks) {
                                thisHandle = thisHandle.getListNextCached(txn);
                                continue;
                        }
                        if (numBlocks == chunkBlocks) {
                                removeFromList(thisHandle);
                                thisHandle.setUsedCached(txn, true);
                                var chunk = createChunk(thisHandle, numBlocks);
                                performCommit();
                                return chunk;
                        }

                        // Split: allocate numBlocks from front, remainder stays free
                        var remIndex = thisIndex + numBlocks;
                        var remHandle = blockTableHandle[remIndex];
                        var remBlocks = nextIndex - remIndex;

                        // Set remainder's memory-order links
                        remHandle.setUsedCached(txn, false);
                        remHandle.setPrevCached(txn, thisHandle);
                        remHandle.setNextCached(txn, nextHandle);

                        // Update neighbors' memory-order links
                        thisHandle.setNextCached(txn, remHandle);
                        nextHandle.setPrevCached(txn, remHandle);

                        // Remove thisHandle from free list
                        removeFromList(thisHandle);

                        // Insert remainder into the correct free list
                        if (remBlocks == 1) {
                                insertAfter(smallSentinel, remHandle, ListKind.SMALL_FREE);
                        } else {
                                insertAfter(largeSentinel, remHandle, ListKind.LARGE_FREE);
                        }

                        // Mark allocated block as used
                        thisHandle.setUsedCached(txn, true);
                        var chunk = createChunk(thisHandle, numBlocks);
                        performCommit();
                        return chunk;
                }
                return blankChunkHandle;
        }

        def freeChunk(chunk: ChunkHandle) {
                if (chunk.isNull()) return;

                var entry = chunkToBlockEntry(chunk);
                if (entry.isNull()) return;
                if (!entry.getUsedCached(txn)) return;

                entry.setUsedCached(txn, false);

                // Coalesce Left
                def prev = entry.getPrevCached(txn);
                if (!prev.isNull() && !prev.getUsedCached(txn)) {
                        removeFromList(prev);
                        def next = entry.getNextCached(txn);
                        prev.setNextCached(txn, next);
                        if (!next.isNull()) {
                                next.setPrevCached(txn, prev);
                        }
                        entry = prev;
                }

                // Coalesce Right
                def next = entry.getNextCached(txn);
                if (!next.isNull() && !next.getUsedCached(txn)) {
                        removeFromList(next);
                        def nextNext = next.getNextCached(txn);
                        entry.setNextCached(txn, nextNext);
                        if (!nextNext.isNull()) {
                                nextNext.setPrevCached(txn, entry);
                        }
                }

                // Insert into the appropriate free list based on coalesced size
                def startIndex = blockIndexOf(entry);
                def nextNeighbor = entry.getNextCached(txn);
                def endIndex = if (nextNeighbor.isNull(), numBlocks, blockIndexOf(nextNeighbor));
                def newSize = endIndex - startIndex;

                if (newSize == 1) {
                        insertAfter(smallSentinel, entry, ListKind.SMALL_FREE);
                } else {
                        insertAfter(largeSentinel, entry, ListKind.LARGE_FREE);
                }
                performCommit();
        }

        // Insert entry into list immediately after sentinel (head insertion)
        def insertAfter(sentinel: BlockEntryHandle, entry: BlockEntryHandle, kind: ListKind) {
                entry.setListNumCached(txn, kind.code);
                var listNext = sentinel.getListNextCached(txn);

                // Link: sentinel -> entry -> listNext
                sentinel.setListNextCached(txn, entry);
                entry.setListPrevCached(txn, sentinel);
                entry.setListNextCached(txn, listNext);

                if (!listNext.isNull()) {
                        listNext.setListPrevCached(txn, entry);
                }
        }

        def removeFromList(blk: BlockEntryHandle) {
                var listPrev = blk.getListPrevCached(txn);
                var listNext = blk.getListNextCached(txn);

                if (!listPrev.isNull()) {
                        listPrev.setListNextCached(txn, listNext);
                }
                if (!listNext.isNull()) {
                        listNext.setListPrevCached(txn, listPrev);
                }

                blk.setListPrevCached(txn, NULL_BLOCK_ENTRY);
                blk.setListNextCached(txn, NULL_BLOCK_ENTRY);
                blk.setListNumCached(txn, ListKind.NONE.code);
        }

        // Deallocate this region
        def deallocate() {
                if (wal != null) {
                        wal.close();
                        wal = null;
                }
                if (backendRegion != null) {
                        backendRegion.destroy();
                        backendRegion = null;
                }
        }

        private def performCommit() {
                txn.commit();
        }

        private def recover() {
                txn.recover();
        }
}


// =============================================================================
// Section 8: Immix Extensions
// =============================================================================

class ImmixPWRegion extends PWRegion {
        new(backend: TxnRegionBackend, numBlocks: u64, metaDataDescs: Range<Ref<MetaDataDesc>>, blockSize: u64, forceFormat: bool)
                super(backend, numBlocks, metaDataDescs, blockSize, forceFormat) {
                lineMarks = getLineMarks();
        }

        // Line mark definitions
        def var lineMarks: LineMarkTableHandle;
        def var numLineMarks: u64;

        private def getLineMarks() -> LineMarkTableHandle {
                var hdr = getHeader();
                for (i < hdr.numDescs) {
                        var r = getMetaDataDesc(u64.!(i));
                        if (r.kind == ImmixPWRegions.ImmixLineMarkMetaKind) {
                                var spaceSize = numBlocks * blockSize;
                                numLineMarks = spaceSize / u64.!(ImmixPWRegions.ImmixLineSize);
                                var lmrng = this.rng[r.offset ..+ numLineMarks * u64.!(LineMark.size)];
                                return LineMarkTableHandle(u64.view(Pointer.atElement(lmrng, 0) - Pointer.NULL), numLineMarks);
                        }
                }
                return LineMarkTableHandle(0, 0);
        }

        def resetAllLineMarks() {
                var lineSize = u64.!(ImmixPWRegions.ImmixLineSize);
                for (index < numLineMarks) {
                        lineMarks[index].getRef().mark = ImmixPWRegions.ImmixLineMarkResetValue;
                }
        }
}

component ImmixPWRegions {
        def ImmixLineMarkMetaKind = 0x0000_0001_0000_0000u64;
        def ImmixLineMarkResetValue = 0u8;
        def ImmixLineSize = 256;  // sample - needs to be done using the metadata descriptior

        // Line mark states (matching original Immix paper)
        // Lines are either free (unmarked) or contain live objects (marked)
        def LINE_FREE: u8 = 0;    // unmarked - line is available for allocation
        def LINE_MARKED: u8 = 1;  // marked - line contains live objects
}


component MemRegions {
        def defaultMetaDataDescs = Array<byte>.new(MetaDataDesc.size * 1);
        def lineMarkDescRef = Ref<MetaDataDesc>.at(defaultMetaDataDescs, 0);
        def BlockSize = 512u64 * 1024u64;
        new() {
                var r = lineMarkDescRef;
                r.kind = ImmixPWRegions.ImmixLineMarkMetaKind;
                r.fixedBytes = 0;
                r.unitSize = u32.!(ImmixPWRegions.ImmixLineSize);
                r.bytesPerUnit = u32.!(LineMark.size);
                // leave offset unset (i.e., 0)
        }
}
