// =============================================================================
// Section 1: Configuration and Constants
// =============================================================================

component PWRegions {
        def MAGIC = 0x50_57_41_53_4Du64; // "PWASM" in hex
        def blockSize: u64 = 256u64 * 1024u64;
        def sanitize = false;
}

component BlockLists {
        def MAX_LISTS = 8;      // maximum number of lists == number of list sentinels
                                // METADATA, etc., do not have sentinels and not part of this count
}


// =============================================================================
// Section 2: On-Memory Layouts (raw data structures)
// =============================================================================

layout PWRegionHeader {
        +0      blockTable:     u64;    // relative offset to the block table
        +8      sentinels:      u64;    // offset of the sentinels (whatever type are!)
        +16     numBlocks:      u64;
        +24     numBytes:       u64;
        +32     numDescs:       u64;
        +40     metaData:       u64;    // relative offset to the metadata area
        +48     metaDataDescs:  u64;    // relative offset to the metadata descriptors
        +56     magic:          u64;    // identifier to confirm region is formatted
        +64     blockSize:      u64;    // block size this region was formatted with
        +72     logChunk:       u64;    // region-relative offset of the WAL log chunk
        +80     userRoot:       u64;    // region-relative offset of the caller's root object (0 = none)
        =88;
}

layout BlockEntry {
        +0      listNum:        i16;    // which list is this entry part of
        +2      used:           u1;     // is this block in use? // TODO: Use bool after the compiler is fixed
                                        // gap
        +8      prev:           i64;    // prev entry in memory;
        +16     next:           i64;    // next entry in memory order
        +24     listPrev:       i64;    // prev entry on same list
        +32     listNext:       i64;    // next entry on same list
        =40;
}

layout ChunkHeader {
        +0      offset:         u64;    // offset in chunk for next allocation
        +8      limit:          u64;    // offset just beyond last available byte in chunk
        +16     chunk_limit:    u64;    // offset just beyond end of the chunk
        +24     linemarks:      u64;    // region-relative offset to first line mark of the chunk
        =32;                            // size of chunk header
}

layout MetaDataDesc {
        +0      kind:           u64;    // unique code, identifying the kind of metadata
        +8      fixedBytes:     u32;    // single-copy data at beginning of metadata block
        +12     unitSize:       u32;    // number of bytes of data space per metadata item
        +16     bytesPerUnit:   u32;    // size of each metadata item, in bytes
                                        // gap
        +24     offset:         u64;    // offset in region of the actual metadata
        =32;
}

layout LineMark {
        +0      mark:           u8;     // line mark info
        =1;
}

layout LogHeader {
        +0      numEntries:     u32;    // Number of valid entries in this transaction
        +4      status:         u8;     // 0 = Invalid, 1 = Committed
        +8      checksum:       u64;    // Optional: Simple checksum for integrity
        =32;                            // Pad to 32 bytes
}

layout LogEntry {
        +0      offset:         u64;    // Relative offset of first changed byte, from the start of the Region
        +8      value:          u64;    // The data to be written
        +16     width:          u8;     // number of bytes being changed (1, 2, 4, 8)
        =32;
}


// =============================================================================
// Section 3: Enumerations
// =============================================================================

enum ListKind(code: i16) {
        METADATA(-1),
        NONE(-2),
        USED(-3),
        SMALL_FREE(0),
        LARGE_FREE(1)
}


// =============================================================================
// Section 4: Utilities
// =============================================================================

component PWRegionUtils {
        def pointerFromU64(n: u64) -> Pointer {
                return Pointer.NULL + i64.view(n);
        }

        def pointerFromI64(n: i64) -> Pointer {
                return Pointer.NULL + n;
        }

        // Shared checksum for WAL log entries. Used during WAL commit
        // and recovery to ensure integrity.
        def calculateLogChecksum(base: u64, count: u32) -> u64 {
                var h: u64 = 0xCAFE_BABE_DEAD_BEEF_u64;
                var ptr = base;
                for (i < count) {
                        var entry = Ref<LogEntry>.of(CiRuntime.forgeRange<byte>(pointerFromU64(ptr), LogEntry.size));
                        h = (h << 13) | (h >> 51);
                        h = h ^ entry.offset;
                        h = h ^ entry.value;
                        h = h ^ u64.view(entry.width);
                        ptr = ptr + u64.!(LogEntry.size);
                }
                return h;
        }
}


// =============================================================================
// Section 5: Handle Types (wrappers around layouts for convenient access)
// =============================================================================

def NULL_BLOCK_ENTRY = BlockEntryHandle(0);
def NULL_CHUNK = ChunkHandle(0);

type BlockTableHandle(addr: u64, size: u64) #unboxed {
        def [n: u64] -> BlockEntryHandle {
                return if(
                        n < size,
                        BlockEntryHandle(addr + (n * u64.!(BlockEntry.size))),
                        NULL_BLOCK_ENTRY
                );
        }
}

type BlockEntryHandle(addr: u64) #unboxed {
        def isNull() -> bool {
                return addr == 0;
        }

        def toHandle(offset: i64) -> BlockEntryHandle {
                if (offset == 0) return NULL_BLOCK_ENTRY;
                return BlockEntryHandle(u64.view(i64.view(addr) + offset));
        }

        def toOffset(other: BlockEntryHandle) -> i64 {
                if (other.isNull()) return 0;
                return i64.view(other.addr) - i64.view(this.addr);
        }

        def getRef() -> Ref<BlockEntry> {
                return Ref<BlockEntry>.of(CiRuntime.forgeRange<byte>(PWRegionUtils.pointerFromU64(addr), BlockEntry.size));
        }

        def getListNum() -> i16 {
                return PWRegionUtils.pointerFromU64(addr + u64.view(BlockEntry.listNum.offset)).load<i16>();
        }

        def getUsed() -> bool {
                return PWRegionUtils.pointerFromU64(addr + u64.view(BlockEntry.used.offset)).load<u8>() == 1u8;
        }

        def getPrev() -> BlockEntryHandle {
                return toHandle(PWRegionUtils.pointerFromU64(addr + u64.view(BlockEntry.prev.offset)).load<i64>());
        }

        def getNext() -> BlockEntryHandle {
                return toHandle(PWRegionUtils.pointerFromU64(addr + u64.view(BlockEntry.next.offset)).load<i64>());
        }

        def getListPrev() -> BlockEntryHandle {
                return toHandle(PWRegionUtils.pointerFromU64(addr + u64.view(BlockEntry.listPrev.offset)).load<i64>());
        }

        def getListNext() -> BlockEntryHandle {
                return toHandle(PWRegionUtils.pointerFromU64(addr + u64.view(BlockEntry.listNext.offset)).load<i64>());
        }

        def getListNumCached(cache: RegionTransaction) -> i16 {
                return cache.readI16(addr + u64.view(BlockEntry.listNum.offset));
        }

        def getUsedCached(cache: RegionTransaction) -> bool {
                def used = cache.readU8(addr + u64.view(BlockEntry.used.offset));
                return used == 1;
        }

        def getPrevCached(cache: RegionTransaction) -> BlockEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockEntry.prev.offset)));
        }

        def getNextCached(cache: RegionTransaction) -> BlockEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockEntry.next.offset)));
        }

        def getListPrevCached(cache: RegionTransaction) -> BlockEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockEntry.listPrev.offset)));
        }

        def getListNextCached(cache: RegionTransaction) -> BlockEntryHandle {
                return toHandle(cache.readI64(addr + u64.view(BlockEntry.listNext.offset)));
        }

        def setListNum(w: DirectRegionWriter, v: i16) {
                w.writeI16(addr + u64.view(BlockEntry.listNum.offset), v);
        }

        def setUsed(w: DirectRegionWriter, v: bool) {
                w.writeU8(addr + u64.view(BlockEntry.used.offset), if(v, 1u8, 0u8));
        }

        def setPrev(w: DirectRegionWriter, v: BlockEntryHandle) {
                w.writeI64(addr + u64.view(BlockEntry.prev.offset), toOffset(v));
        }

        def setNext(w: DirectRegionWriter, v: BlockEntryHandle) {
                w.writeI64(addr + u64.view(BlockEntry.next.offset), toOffset(v));
        }

        def setListPrev(w: DirectRegionWriter, v: BlockEntryHandle) {
                w.writeI64(addr + u64.view(BlockEntry.listPrev.offset), toOffset(v));
        }

        def setListNext(w: DirectRegionWriter, v: BlockEntryHandle) {
                w.writeI64(addr + u64.view(BlockEntry.listNext.offset), toOffset(v));
        }

        def setListNumCached(cache: RegionTransaction, v: i16) {
                cache.writeI16(addr + u64.view(BlockEntry.listNum.offset), v);
        }

        def setUsedCached(cache: RegionTransaction, v: bool) {
                def num: u8 = if(v, 1, 0);
                cache.writeU8(addr + u64.view(BlockEntry.used.offset), num);
        }

        def setPrevCached(cache: RegionTransaction, v: BlockEntryHandle) {
                cache.writeI64(addr + u64.view(BlockEntry.prev.offset), toOffset(v));
        }

        def setNextCached(cache: RegionTransaction, v: BlockEntryHandle) {
                cache.writeI64(addr + u64.view(BlockEntry.next.offset), toOffset(v));
        }

        def setListPrevCached(cache: RegionTransaction, v: BlockEntryHandle) {
                cache.writeI64(addr + u64.view(BlockEntry.listPrev.offset), toOffset(v));
        }

        def setListNextCached(cache: RegionTransaction, v: BlockEntryHandle) {
                cache.writeI64(addr + u64.view(BlockEntry.listNext.offset), toOffset(v));
        }
}

type ChunkHandle(addr: u64) #unboxed {
        def isNull() -> bool {
                return addr == 0;
        }

        def getRef() -> Ref<ChunkHeader> {
                return Ref<ChunkHeader>.of(CiRuntime.forgeRange<byte>(PWRegionUtils.pointerFromU64(addr), ChunkHeader.size));
        }

        def getOffset() -> u64 {
                return getRef().offset;
        }

        def getLimit() -> u64 {
                return getRef().limit;
        }

        def getChunkLimit() -> u64 {
                return getRef().chunk_limit;
        }

        def getLinemarks() -> u64 {
                return getRef().linemarks;
        }

        def setOffset(w: DirectRegionWriter, v: u64) {
                w.writeU64(addr + u64.view(ChunkHeader.offset.offset), v);
        }

        def setLimit(w: DirectRegionWriter, v: u64) {
                w.writeU64(addr + u64.view(ChunkHeader.limit.offset), v);
        }

        def setChunkLimit(w: DirectRegionWriter, v: u64) {
                w.writeU64(addr + u64.view(ChunkHeader.chunk_limit.offset), v);
        }

        def setLinemarks(w: DirectRegionWriter, v: u64) {
                w.writeU64(addr + u64.view(ChunkHeader.linemarks.offset), v);
        }

        def setOffsetCached(cache: RegionTransaction, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.offset.offset), v);
        }

        def setLimitCached(cache: RegionTransaction, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.limit.offset), v);
        }

        def setChunkLimitCached(cache: RegionTransaction, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.chunk_limit.offset), v);
        }

        def setLinemarksCached(cache: RegionTransaction, v: u64) {
                cache.writeU64(addr + u64.view(ChunkHeader.linemarks.offset), v);
        }
}

type LineMarkTableHandle(addr: u64, size: u64) #unboxed {
        def [n: u64] -> LineMarkHandle {
                return if(
                        n < size,
                        LineMarkHandle(addr + n * u64.!(LineMark.size)),
                        LineMarkHandle(0)
                );
        }
}

type LineMarkHandle(addr: u64) #unboxed {
        def getRef() -> Ref<LineMark> {
                return Ref<LineMark>.of(CiRuntime.forgeRange<byte>(PWRegionUtils.pointerFromU64(addr), LineMark.size));
        }

        def getMark() -> u8 {
                return getRef().mark;
        }

        def setMark(v: u8) {
                getRef().mark = v;
        }
}

type LogEntryHandle(addr: u64) { }


// =============================================================================
// Section 6: WAL Infrastructure (write-behind cache and write-ahead log)
// =============================================================================

// Wrapper ADT to store the cached value and its width (size)
type CachedUpdate(value: u64, size: u8) #unboxed { }

// Direct, non-transactional writes to the persistent image through the traced
// PersistentOperations seam. Legal only where no WAL transaction protects the
// bytes: format() builds the whole region before the WAL exists and publishes
// it with a single persistRange(). Steady-state allocator mutations must use
// RegionTransaction (the *Cached setters) instead.
//
// The method names deliberately mirror RegionTransaction's write* family so a
// direct setter and its *Cached twin read as line-for-line counterparts, and
// so that bypassing the WAL by accident stays visible at the call site.
//
// Addresses are absolute; the seam takes region-relative offsets, so the
// translation lives here rather than at every call site.
class DirectRegionWriter {
        private def ops: PersistentOperations;
        def regionStart: u64;

        new(ops, regionStart) { }

        // Write BlockEntry.used (u1/bool stored as u8)
        def writeU8(addr: u64, val: u8) {
                ops.storeU8(addr - regionStart, val);
        }

        // Write BlockEntry.listNum
        def writeI16(addr: u64, val: i16) {
                ops.storeU16(addr - regionStart, u16.view(val));
        }

        // Write ChunkHeader.offset, limit
        def writeU64(addr: u64, val: u64) {
                ops.storeU64(addr - regionStart, val);
        }

        // Write BlockEntry.prev, next, listPrev, listNext
        def writeI64(addr: u64, val: i64) {
                ops.storeU64(addr - regionStart, u64.view(val));
        }

        // Region-relative forms, for header and descriptor fields whose offsets
        // already are (mirrors DualTxnWal's headerStore*/recordStore* split).
        def writeOffsetU32(offset: u64, val: u32) {
                ops.storeU32(offset, val);
        }

        def writeOffsetU64(offset: u64, val: u64) {
                ops.storeU64(offset, val);
        }
}

// A transaction facade over the write-behind cache and redo log.
// This component buffers writes in DRAM, then commits them through DualTxnWal.
//
// CONSTRAINT: ALIGNED ACCESS ONLY
// This implementation uses a HashMap to store updates. It does not support spatial
// queries or overlapping intervals. Consequently:
// 1. Reads must match the exact address of previous writes.
// 2. Mixed-width accesses (e.g., writing 8 bytes at 0x10, then reading 1 byte at 0x11)
//    will result in a cache miss, returning stale data.
class RegionTransaction {
        private var cache: HashMap<u64, CachedUpdate>;
        private def addrs = Vector<u64>.new();
        private def wal: DualTxnWal;
        def regionStart: u64;

        new(wal, regionStart) {
                cache = HashMap<u64, CachedUpdate>.new(hash, u64.==);
        }

        def isDirty() -> bool {
                return addrs.length != 0;
        }

        // Persistence failures leave the durable outcome indeterminate. The
        // current WAL instance cannot safely accept more work; callers must
        // abandon this mount, reopen it, and recover the durable image.
        def requiresRecovery() -> bool {
                return wal.requiresRecovery();
        }

        // Phase B commit: one persistence boundary in steady state.
        // wal.commit() persists the record together with the *previous*
        // transaction's applied after-images (the piggybacked boundary); this
        // transaction's own after-images are applied write-behind afterwards
        // and ride the next commit's boundary, an explicit flush(), or the
        // WAL's close(). Until then the durable record keeps them
        // recoverable, and the WAL's overwrite guard protects the slot.
        def commit() -> bool {
                if (requiresRecovery()) return false;
                if (!isDirty()) return true;
                appendToWal();
                def txnSeq = wal.commit();
                if (txnSeq == 0u64) return false;
                if (!applyToRegion()) return false;
                clear();
                return true;
        }

        // Explicit boundary for idle/unmount: complete durability for applied
        // after-images that have not yet ridden a later commit's boundary.
        def flush() -> bool {
                return wal.persistAppliedData();
        }

        def recover() -> DualWalRecovery {
                return wal.recover();
        }

        private def clear() {
                // Empty the map in place rather than reallocating it: {addrs} holds exactly
                // the set of keys present in {cache}, and HashMap.remove retains the backing
                // table, so this reuses both structures' storage across commits.
                for (i < addrs.length) cache.remove(addrs[i]);
                addrs.clear();
        }

        def readU8(addr: u64) -> u8 {
                if (cache.has(addr)) return u8.view(cache[addr].value);
                return wal.readU8(addr - regionStart);
        }

        def readI16(addr: u64) -> i16 {
                if (cache.has(addr)) return i16.view(cache[addr].value);
                return wal.readI16(addr - regionStart);
        }

        def readU64(addr: u64) -> u64 {
                if (cache.has(addr)) return u64.view(cache[addr].value);
                return wal.readU64(addr - regionStart);
        }

        def readI64(addr: u64) -> i64 {
                if (cache.has(addr)) return i64.view(cache[addr].value);
                return wal.readI64(addr - regionStart);
        }

        // Write BlockEntry.used (u1/bool stored as u8)
        def writeU8(addr: u64, val: u8) {
                writeHelper(addr, 1, u64.view(val));
        }

        // Write BlockEntry.listNum
        def writeI16(addr: u64, val: i16) {
                writeHelper(addr, 2, u64.view(u16.view(val)));
        }

        // Write ChunkHeader.offset, limit
        def writeU64(addr: u64, val: u64) {
                writeHelper(addr, 8, val);
        }

        // Write BlockEntry.prev, next, listPrev, listNext
        def writeI64(addr: u64, val: i64) {
                writeHelper(addr, 8, u64.view(val));
        }

        private def writeHelper(addr: u64, size: u8, val: u64) {
                if (!cache.has(addr)) {
                        addrs.put(addr);
                }
                cache[addr] = CachedUpdate(val, size);
        }

        private def appendToWal() {
                addrs.apply(
                        fun (addr: u64) {
                                def c: CachedUpdate = cache[addr];
                                wal.append(addr - regionStart, c.value, c.size);
                        }
                );
        }

        private def applyToRegion() -> bool {
                for (i < addrs.length) {
                        def addr = addrs[i];
                        def c: CachedUpdate = cache[addr];
                        if (!wal.applyUpdate(addr - regionStart, c.value, c.size)) return false;
                }
                return true;
        }

        // Hash function: Convert u64 -> i32
        private def hash(addr: u64) => i32.view(addr ^ (addr >> 32));
}



// =============================================================================
// Section 7: Core Region Implementation
// =============================================================================

// Generic block-based region manager with an in-region WAL.
class PWRegion {
        def var backendRegion: BackendRegion;
        def var rng: Range<byte>;  // the actual bytes of the region
        def numBlocks: u64;
        def blockSize: u64;  // Size of each block
        def metaDataDescs: Range<Ref<MetaDataDesc>>;
        def var sentinels: BlockTableHandle;
        def var smallSentinel: BlockEntryHandle;
        def var largeSentinel: BlockEntryHandle;
        def blankChunkHandle = NULL_CHUNK;
        def var blockTableHandle: BlockTableHandle;
        def var logChunk: ChunkHandle;
        private var wal: DualTxnWal;
        def var regionStart: u64;
        def var txn: RegionTransaction;
        private var writer: DirectRegionWriter;

        new(backend: TxnRegionBackend, numBlocks, metaDataDescs, blockSize: u64, forceFormat: bool) {
                var size = numBlocks * blockSize;
                var prot = BackendProt.READ.mask | BackendProt.WRITE.mask;
                backendRegion = backend.create(size, prot, forceFormat);
                if (backendRegion == null) {
                        // Creation failed
                        return;
                }
                rng = backendRegion.range;
                regionStart = u64.view(Pointer.atElement(rng, 0));
                if (!validGeometry(blockSize)) {
                        Trace.OUT.put2("PWRegion geometry unsupported: %d blocks of %d bytes",
                                numBlocks, blockSize).ln();
                        backendRegion.destroy();
                        backendRegion = null;
                        return;
                }
                // Resolve before init(): format() writes the header, sentinels,
                // block table and descriptors through this writer well before
                // ensureWal() constructs the WAL and its own provider reference.
                writer = DirectRegionWriter.new(X86_64PersistentOps.ensureFor(backendRegion), regionStart);
                init(blockSize, forceFormat);
        }

        // The persistent-operation seam contracts naturally aligned 1/2/4/8-byte
        // stores and rejects anything else by aborting (System.error), so a
        // geometry that would misalign a formatted structure must be refused
        // here rather than reaching the provider. Every structure format()
        // writes -- the 8-aligned header, 40-byte block entries anchored at the
        // region end, and 32-byte descriptors -- is naturally aligned exactly
        // when the region size is a multiple of 8, since 40 % 8 == 0 and
        // 32 % 8 == 0.
        private def validGeometry(blockSize: u64) -> bool {
                if (numBlocks == 0 || blockSize == 0) return false;
                if (blockSize % 8 != 0) return false;
                def size = numBlocks * blockSize;
                // '>' not '!=': an mmap backing store may round the mapping up.
                if (size > u64.!(rng.length)) return false;
                def fixed = u64.!(PWRegionHeader.size)
                        + u64.!(BlockLists.MAX_LISTS) * u64.!(BlockEntry.size)
                        + (numBlocks + 1) * u64.!(BlockEntry.size)
                        + u64.!(metaDataDescs.length * MetaDataDesc.size);
                return fixed <= size;
        }

        private def sanitizeOffset(offset: u64) {
                if (PWRegions.sanitize) {
                        def addr = u64.view(Pointer.atElement(rng, 0));
                        if (offset < rng.length) {
                                Trace.OUT.put3("offset %d is good for region at 0x%x of length %d",
                                        offset, addr, rng.length).ln();
                        } else {
                                Trace.OUT.put3("offset %d is bad for region at 0x%x of length %d",
                                        offset, addr, rng.length).ln();
                        }
                }
        }

        private def sanitizeAddress(addr: u64) {
                if (PWRegions.sanitize) {
                        def delta: long = i64.view(addr) - i64.view(Pointer.atElement(rng, 0));
                        def baseAddr = u64.view(Pointer.atElement(rng, 0));
                        if (delta < 0 || delta >= rng.length) {
                                Trace.OUT.put3("address 0x%x is bad for region at 0x%x of length %d",
                                        addr, baseAddr, rng.length).ln();
                        } else {
                                Trace.OUT.put3("address 0x%x is good for region at 0x%x of length %d",
                                        addr, baseAddr, rng.length).ln();
                        }
                }
        }

        def offsetInRegion(addr: u64) -> u64 {
                return addr - regionStart;
        }

        def blockOfOffset(offset: u64) -> u64 {
                return offset / blockSize;
        }

        def blockIndexOf(blk: BlockEntryHandle) -> u64 {
                return (blk.addr - blockTableHandle.addr) / u64.!(BlockEntry.size);
        }

        def blockEntryToChunk(blk: BlockEntryHandle) -> ChunkHandle {
                return ChunkHandle(regionStart + (blockSize * blockIndexOf(blk)));
        }

        def chunkToBlockEntry(chunk: ChunkHandle) -> BlockEntryHandle {
                var index = blockOfOffset(offsetInRegion(chunk.addr));
                return blockTableHandle[index];
        }

        private def init(blockSize: u64, forceFormat: bool) {
                if (forceFormat) {
                        format(blockSize);
                        return;
                }
                var hdr = getHeader();
                if (hdr.magic == PWRegions.MAGIC) {
                        mount(blockSize);
                } else {
                        format(blockSize);
                }
        }

        private def ensureWal(logChunkAddr: u64, blockSize: u64, initializeFresh: bool) {
                if (wal == null) {
                        wal = DualTxnWal.new(regionStart, logChunkAddr, blockSize, backendRegion, initializeFresh);
                }
                if (txn == null) {
                        txn = RegionTransaction.new(wal, regionStart);
                }
        }

        // Mounts an existing, fully formatted region
        private def mount(blockSize: u64) {
                def hdr = getHeader();

                if (blockSize != hdr.blockSize) {
                        Trace.OUT.put2("blockSize mismatch: requested %d, stored %d",
                                blockSize, hdr.blockSize).ln();
                        return;
                }

                if (this.numBlocks != hdr.numBlocks) {
                        Trace.OUT.put2("numBlocks mismatch: requested %d, stored %d",
                                this.numBlocks, hdr.numBlocks).ln();
                        return;
                }

                sentinels = BlockTableHandle(u64.view(Pointer.atElement(rng, int.!(hdr.sentinels))), u64.!(BlockLists.MAX_LISTS));
                smallSentinel = sentinels[u64.!(ListKind.SMALL_FREE.code)];
                largeSentinel = sentinels[u64.!(ListKind.LARGE_FREE.code)];

                def numBlockTableEntries = hdr.numBlocks + 1;
                def blockTableSize = numBlockTableEntries * u64.!(BlockEntry.size);

                blockTableHandle = BlockTableHandle(u64.view(Pointer.atElement(rng, int.!(hdr.blockTable))), numBlockTableEntries);

                var logChunkOffset = hdr.logChunk;
                if (logChunkOffset == 0) logChunkOffset = blockSize; // defensive: field unset -> block 1
                logChunk = ChunkHandle(regionStart + logChunkOffset);
                ensureWal(logChunk.addr, blockSize, false);

                match (txn.recover()) {
                        CORRUPT => Trace.OUT.puts("WAL corrupt on mount: log records ignored").ln();
                        PERSIST_FAILED => Trace.OUT.puts("WAL recovery replay could not be persisted; records retained for the next mount").ln();
                        _ => ;
                }
        }

        // Reset all fields of a block entry to their default (empty) state
        private def clearBlockEntry(entry: BlockEntryHandle) {
                entry.setListNum(writer, 0);
                entry.setUsed(writer, false);
                entry.setPrev(writer, NULL_BLOCK_ENTRY);
                entry.setNext(writer, NULL_BLOCK_ENTRY);
                entry.setListPrev(writer, NULL_BLOCK_ENTRY);
                entry.setListNext(writer, NULL_BLOCK_ENTRY);
        }

        // Initialize list sentinels just after the region header
        private def headerSetU64(offset: int, value: u64) {
                writer.writeOffsetU64(u64.view(offset), value);
        }

        private def formatSentinels() {
                def sentinelOffset = u64.!(PWRegionHeader.size);
                headerSetU64(PWRegionHeader.sentinels.offset, sentinelOffset);
                sentinels = BlockTableHandle(regionStart + sentinelOffset, u64.!(BlockLists.MAX_LISTS));
                sanitizeOffset(sentinelOffset);
                sanitizeOffset(sentinelOffset + u64.!(sentinels.size));
                for (i < u64.!(BlockLists.MAX_LISTS)) {
                        clearBlockEntry(sentinels[i]);
                }
        }

        // Allocate block table space from the end of the region
        private def formatBlockTable(currentRegionEnd: u64) -> u64 {
                def numBlockTableEntries = numBlocks + 1;
                def blockTableSize = numBlockTableEntries * u64.!(BlockEntry.size);
                var end = currentRegionEnd - blockTableSize;
                headerSetU64(PWRegionHeader.blockTable.offset, end);
                sanitizeOffset(end);
                blockTableHandle = BlockTableHandle(regionStart + end, numBlockTableEntries);

                for (i < numBlockTableEntries) {
                        clearBlockEntry(blockTableHandle[i]);
                }
                return end;
        }

        // Allocate metadata descriptor and metadata space from the end of the region
        private def formatMetaData(size: u64, currentRegionEnd: u64) -> u64 {
                def metaDataDescsSize = u64.!(metaDataDescs.length * MetaDataDesc.size);
                // {end} walks downward as each descriptor's metadata is carved off,
                // so the descriptor table's own base must be captured separately.
                def descsOffset = currentRegionEnd - metaDataDescsSize;
                var end = descsOffset;
                sanitizeOffset(end);
                headerSetU64(PWRegionHeader.metaDataDescs.offset, end);
                headerSetU64(PWRegionHeader.numDescs.offset, u64.!(metaDataDescs.length));

                for (i < metaDataDescs.length) {
                        var desc = metaDataDescs[i];
                        var metaDataSize = u64.!(desc.fixedBytes);
                        var numUnits = (size + desc.unitSize - 1) / desc.unitSize;
                        metaDataSize += numUnits * desc.bytesPerUnit;
                        end -= metaDataSize;
                        sanitizeOffset(end);

                        // Written field-by-field through the seam rather than through
                        // a Ref<MetaDataDesc>, so every descriptor store appears in the
                        // trace. Note the widths differ: kind/offset are u64, the three
                        // sizing fields are u32. Bytes +20..+23 are layout padding and
                        // stay at their zero-initialized value.
                        def descOffset = descsOffset + u64.!(i * MetaDataDesc.size);
                        writer.writeOffsetU64(descOffset + u64.view(MetaDataDesc.kind.offset), desc.kind);
                        writer.writeOffsetU32(descOffset + u64.view(MetaDataDesc.fixedBytes.offset), desc.fixedBytes);
                        writer.writeOffsetU32(descOffset + u64.view(MetaDataDesc.unitSize.offset), desc.unitSize);
                        writer.writeOffsetU32(descOffset + u64.view(MetaDataDesc.bytesPerUnit.offset), desc.bytesPerUnit);
                        writer.writeOffsetU64(descOffset + u64.view(MetaDataDesc.offset.offset), end);
                }
                return end;
        }

        // Formats a completely uninitialized region of memory
        private def format(blockSize: u64) {
                def size = numBlocks * blockSize;

                headerSetU64(PWRegionHeader.numBlocks.offset, this.numBlocks);
                headerSetU64(PWRegionHeader.numBytes.offset, size);
                headerSetU64(PWRegionHeader.blockSize.offset, blockSize);
                // Written explicitly rather than left at its zero-initialized
                // value: a fresh region must publish "no root" as a store the
                // trace can see, and a reformat over an old image must clear a
                // stale root instead of inheriting it.
                headerSetU64(PWRegionHeader.userRoot.offset, 0);

                formatSentinels();
                var currentRegionEnd = formatBlockTable(size);
                currentRegionEnd = formatMetaData(size, currentRegionEnd);
                def blockTableOffset = blockTableHandle.addr - regionStart;
                def sentinelOffset = u64.!(PWRegionHeader.size);

                var metaDataBytes = u64.!(rng.length) - currentRegionEnd;
                var metaDataBlocks = (metaDataBytes + (blockSize - 1)) / blockSize;
                // Block 0 (header), block 1 (WAL log chunk), at least one free block,
                // and the metadata blocks must all fit. Without this check the
                // unsigned subtraction below underflows, blockTableHandle[] returns
                // NULL_BLOCK_ENTRY, and the linkage stores below target address 0.
                // Returning here leaves the magic unstamped, so a later mount() sees
                // the mismatch and reformats rather than trusting a partial image.
                if (numBlocks < metaDataBlocks + 3u64) {
                        Trace.OUT.put2("region too small to format: %d blocks of %d bytes",
                                numBlocks, blockSize).ln();
                        return;
                }
                var userDataBlocks = numBlocks - (metaDataBlocks + 1);

                // Set up block list linkage
                var headerBlockHandle = blockTableHandle[0];
                var logBlockHandle = blockTableHandle[1];
                var firstFreeBlockHandle = blockTableHandle[2];
                smallSentinel = sentinels[u64.!(ListKind.SMALL_FREE.code)];
                largeSentinel = sentinels[u64.!(ListKind.LARGE_FREE.code)];
                var metaHandle = blockTableHandle[u64.!(userDataBlocks + 1)];
                var lastHandle = blockTableHandle[u64.!(numBlocks)];

                // Block 0: region header (METADATA, used)
                sanitizeAddress(headerBlockHandle.addr);
                headerBlockHandle.setListNum(writer, ListKind.METADATA.code);
                headerBlockHandle.setUsed(writer, true);
                headerBlockHandle.setNext(writer, logBlockHandle);
                sanitizeOffset(blockTableOffset + u64.!(BlockEntry.size));

                // Block 1: WAL log chunk (METADATA, used)
                sanitizeAddress(logBlockHandle.addr);
                logBlockHandle.setListNum(writer, ListKind.METADATA.code);
                logBlockHandle.setUsed(writer, true);
                logBlockHandle.setPrev(writer, headerBlockHandle);
                logBlockHandle.setNext(writer, firstFreeBlockHandle);
                sanitizeOffset(blockTableOffset + 2u64 * u64.!(BlockEntry.size));

                logChunk = blockEntryToChunk(logBlockHandle);
                headerSetU64(PWRegionHeader.logChunk.offset, offsetInRegion(logChunk.addr));
                ensureWal(logChunk.addr, blockSize, true);

                // Block 2: first free block (LARGE_FREE)
                sanitizeAddress(firstFreeBlockHandle.addr);
                firstFreeBlockHandle.setListNum(writer, ListKind.LARGE_FREE.code);
                firstFreeBlockHandle.setNext(writer, metaHandle);
                firstFreeBlockHandle.setPrev(writer, logBlockHandle);
                firstFreeBlockHandle.setListPrev(writer, largeSentinel);
                firstFreeBlockHandle.setListNext(writer, NULL_BLOCK_ENTRY);
                sanitizeOffset(blockTableOffset + (userDataBlocks + 1) * u64.!(BlockEntry.size));
                sanitizeOffset(blockTableOffset);
                sanitizeOffset(sentinelOffset + u64.!(ListKind.LARGE_FREE.code * i64.!(BlockEntry.size)));

                // Sentinels: small starts empty, large points to firstFreeBlock
                sanitizeAddress(smallSentinel.addr);
                smallSentinel.setListNext(writer, NULL_BLOCK_ENTRY);
                sanitizeOffset(blockTableOffset);

                sanitizeAddress(largeSentinel.addr);
                largeSentinel.setListNext(writer, firstFreeBlockHandle);
                sanitizeOffset(blockTableOffset + u64.!(BlockEntry.size));

                // Metadata block (METADATA, used)
                sanitizeAddress(metaHandle.addr);
                metaHandle.setListNum(writer, ListKind.METADATA.code);
                metaHandle.setUsed(writer, true);
                metaHandle.setNext(writer, lastHandle);
                metaHandle.setPrev(writer, firstFreeBlockHandle);
                metaHandle.setListPrev(writer, NULL_BLOCK_ENTRY);
                metaHandle.setListNext(writer, NULL_BLOCK_ENTRY);
                sanitizeOffset(blockTableOffset + numBlocks * u64.!(BlockEntry.size));
                sanitizeOffset(blockTableOffset + u64.!(BlockEntry.size));

                // End-of-region marker (NONE, used)
                sanitizeAddress(lastHandle.addr);
                lastHandle.setListNum(writer, ListKind.NONE.code);
                lastHandle.setUsed(writer, true);
                lastHandle.setPrev(writer, metaHandle);
                sanitizeOffset(blockTableOffset + (userDataBlocks + 1) * u64.!(BlockEntry.size));

                headerSetU64(PWRegionHeader.magic.offset, PWRegions.MAGIC);

                // Persist the freshly formatted region image before exposing it.
                backendRegion.persistRange(0, u64.!(rng.length));
        }

        def getHeader() -> Ref<PWRegionHeader> {
                var copy = Array<byte>.new(PWRegionHeader.size);
                def base = PWRegionUtils.pointerFromU64(regionStart);
                for (i < PWRegionHeader.size) {
                        copy[i] = (base + i).load<byte>();
                }
                return Ref<PWRegionHeader>.of(copy[0 ..+ copy.length]);
        }

        def getMetaDataDesc(i: u64) -> Ref<MetaDataDesc> {
                var hdr = getHeader();
                return Ref<MetaDataDesc>.of(CiRuntime.forgeRange<byte>(
                        PWRegionUtils.pointerFromU64(regionStart + hdr.metaDataDescs + i * u64.!(MetaDataDesc.size)),
                        MetaDataDesc.size));
        }

        def blockEntryAt(offset: u64) -> Ref<BlockEntry> {
                return Ref<BlockEntry>.of(CiRuntime.forgeRange<byte>(
                        PWRegionUtils.pointerFromU64(regionStart + offset),
                        BlockEntry.size));
        }

        def createChunk(startEntry: BlockEntryHandle, numBlocks: u32) -> ChunkHandle {
                var chunk = ChunkHandle(regionStart + blockIndexOf(startEntry) * blockSize);

                chunk.setOffsetCached(txn, u64.!(ChunkHeader.size));
                chunk.setLimitCached(txn, u64.!(numBlocks) * blockSize);
                chunk.setChunkLimitCached(txn, u64.!(numBlocks) * blockSize);
                linkChunkLineMarks(chunk);
                return chunk;
        }

        // Extension hook for allocators with per-chunk line metadata.
        def linkChunkLineMarks(chunk: ChunkHandle) { }

        def allocChunk(numBlocks: u32) -> ChunkHandle {
                if (requiresRecovery()) return blankChunkHandle;
                if (numBlocks == 0) return blankChunkHandle;
                if (numBlocks == 1) {
                        // Try the small free block list
                        var firstHandle = smallSentinel.getListNextCached(txn);
                        if (!firstHandle.isNull()) {
                                removeFromList(firstHandle);
                                firstHandle.setUsedCached(txn, true);
                                var chunk = createChunk(firstHandle, 1);
                                if (!performCommit()) return blankChunkHandle;
                                return chunk;
                        }
                }
                var thisHandle = largeSentinel.getListNextCached(txn);
                while (!thisHandle.isNull()) {
                        var thisIndex = blockIndexOf(thisHandle);
                        var nextHandle = thisHandle.getNextCached(txn);
                        if (nextHandle.isNull()) return blankChunkHandle;
                        var nextIndex = blockIndexOf(nextHandle);
                        var chunkBlocks = nextIndex - thisIndex;
                        if (numBlocks > chunkBlocks) {
                                thisHandle = thisHandle.getListNextCached(txn);
                                continue;
                        }
                        if (numBlocks == chunkBlocks) {
                                removeFromList(thisHandle);
                                thisHandle.setUsedCached(txn, true);
                                var chunk = createChunk(thisHandle, numBlocks);
                                if (!performCommit()) return blankChunkHandle;
                                return chunk;
                        }

                        // Split: allocate numBlocks from front, remainder stays free
                        var remIndex = thisIndex + numBlocks;
                        var remHandle = blockTableHandle[remIndex];
                        var remBlocks = nextIndex - remIndex;

                        // Set remainder's memory-order links
                        remHandle.setUsedCached(txn, false);
                        remHandle.setPrevCached(txn, thisHandle);
                        remHandle.setNextCached(txn, nextHandle);

                        // Update neighbors' memory-order links
                        thisHandle.setNextCached(txn, remHandle);
                        nextHandle.setPrevCached(txn, remHandle);

                        // Remove thisHandle from free list
                        removeFromList(thisHandle);

                        // Insert remainder into the correct free list
                        if (remBlocks == 1) {
                                insertAfter(smallSentinel, remHandle, ListKind.SMALL_FREE);
                        } else {
                                insertAfter(largeSentinel, remHandle, ListKind.LARGE_FREE);
                        }

                        // Mark allocated block as used
                        thisHandle.setUsedCached(txn, true);
                        var chunk = createChunk(thisHandle, numBlocks);
                        if (!performCommit()) return blankChunkHandle;
                        return chunk;
                }
                return blankChunkHandle;
        }

        def freeChunk(chunk: ChunkHandle) -> bool {
                if (requiresRecovery()) return false;
                if (chunk.isNull()) return false;

                // Reject handles that cannot name the start of a block in this
                // region before converting the address into a block-table index.
                // In particular, subtraction in chunkToBlockEntry() would
                // otherwise underflow for a handle owned by another region.
                if (chunk.addr < regionStart) return false;
                def chunkOffset = chunk.addr - regionStart;
                if (chunkOffset >= numBlocks * blockSize) return false;
                if (chunkOffset % blockSize != 0) return false;

                var entry = chunkToBlockEntry(chunk);
                if (entry.isNull()) return false;
                if (entry.getListNumCached(txn) != ListKind.NONE.code) return false;
                if (!entry.getUsedCached(txn)) return false;

                entry.setUsedCached(txn, false);

                // Coalesce Left
                def prev = entry.getPrevCached(txn);
                if (!prev.isNull() && !prev.getUsedCached(txn)) {
                        removeFromList(prev);
                        def next = entry.getNextCached(txn);
                        prev.setNextCached(txn, next);
                        if (!next.isNull()) {
                                next.setPrevCached(txn, prev);
                        }
                        entry = prev;
                }

                // Coalesce Right
                def next = entry.getNextCached(txn);
                if (!next.isNull() && !next.getUsedCached(txn)) {
                        removeFromList(next);
                        def nextNext = next.getNextCached(txn);
                        entry.setNextCached(txn, nextNext);
                        if (!nextNext.isNull()) {
                                nextNext.setPrevCached(txn, entry);
                        }
                }

                // Insert into the appropriate free list based on coalesced size
                def startIndex = blockIndexOf(entry);
                def nextNeighbor = entry.getNextCached(txn);
                def endIndex = if (nextNeighbor.isNull(), numBlocks, blockIndexOf(nextNeighbor));
                def newSize = endIndex - startIndex;

                if (newSize == 1) {
                        insertAfter(smallSentinel, entry, ListKind.SMALL_FREE);
                } else {
                        insertAfter(largeSentinel, entry, ListKind.LARGE_FREE);
                }
                return performCommit();
        }

        // The durable root. A mounted region is otherwise opaque to its caller:
        // the block table records which extents are in use, but not which of
        // them the caller wants to reach after a remount. The root is a single
        // region-relative offset the caller publishes transactionally, so a
        // program that stops and restarts can find its own data again instead
        // of hardcoding an offset.
        //
        // 0 means "no root". Offset 0 is the region header, which is never
        // allocatable, so the sentinel cannot collide with a real target.
        def getUserRoot() -> u64 {
                if (txn == null) return 0;
                return txn.readU64(regionStart + u64.view(PWRegionHeader.userRoot.offset));
        }

        // Publishes {offset} as the root in its own transaction. Returns false
        // for a rejected value or a failed commit; use requiresRecovery() to
        // tell an out-of-range argument from a persistence failure.
        //
        // The root is published by a separate transaction from the allocation
        // it names, so a crash between the two leaks the allocated extent: it
        // stays marked used but nothing reaches it. That is a space leak, not
        // an inconsistency, and it is the direct consequence of allocChunk()
        // committing on its own (see docs/CRITIQUE.md #1). A caller that must
        // not leak should publish first and allocate into a root-reachable
        // free list of its own.
        def setUserRoot(offset: u64) -> bool {
                if (requiresRecovery()) return false;
                if (txn == null) return false;
                // Reject an offset that cannot name a byte in this region.
                // Without this, a remount would hand the caller back a wild
                // address derived from regionStart.
                if (offset >= numBlocks * blockSize) return false;
                txn.writeU64(regionStart + u64.view(PWRegionHeader.userRoot.offset), offset);
                return performCommit();
        }

        // Distinguish an ordinary allocator rejection (for example, no fitting
        // chunk or an oversized WAL record) from a persistence failure that
        // makes this mounted instance unsafe to continue using.
        def requiresRecovery() -> bool {
                return txn != null && txn.requiresRecovery();
        }

        // Insert entry into list immediately after sentinel (head insertion)
        def insertAfter(sentinel: BlockEntryHandle, entry: BlockEntryHandle, kind: ListKind) {
                entry.setListNumCached(txn, kind.code);
                var listNext = sentinel.getListNextCached(txn);

                // Link: sentinel -> entry -> listNext
                sentinel.setListNextCached(txn, entry);
                entry.setListPrevCached(txn, sentinel);
                entry.setListNextCached(txn, listNext);

                if (!listNext.isNull()) {
                        listNext.setListPrevCached(txn, entry);
                }
        }

        def removeFromList(blk: BlockEntryHandle) {
                var listPrev = blk.getListPrevCached(txn);
                var listNext = blk.getListNextCached(txn);

                if (!listPrev.isNull()) {
                        listPrev.setListNextCached(txn, listNext);
                }
                if (!listNext.isNull()) {
                        listNext.setListPrevCached(txn, listPrev);
                }

                blk.setListPrevCached(txn, NULL_BLOCK_ENTRY);
                blk.setListNextCached(txn, NULL_BLOCK_ENTRY);
                blk.setListNumCached(txn, ListKind.NONE.code);
        }

        // Deallocate this region
        def deallocate() {
                if (wal != null) {
                        wal.close();
                        wal = null;
                }
                // The writer's provider holds a range over memory that destroy()
                // is about to unmap; drop it so a stale direct store fails
                // deterministically instead of writing into unmapped pages.
                writer = null;
                if (backendRegion != null) {
                        backendRegion.destroy();
                        backendRegion = null;
                }
        }

        private def performCommit() -> bool {
                return txn.commit();
        }

        private def recover() -> DualWalRecovery {
                return txn.recover();
        }
}


// =============================================================================
// Section 8: Immix Extensions
// =============================================================================

class ImmixPWRegion extends PWRegion {
        new(backend: TxnRegionBackend, numBlocks: u64, metaDataDescs: Range<Ref<MetaDataDesc>>, blockSize: u64, forceFormat: bool)
                super(backend, numBlocks, metaDataDescs, blockSize, forceFormat) {
                // Backend creation can fail (for example, MAP_SYNC on a non-DAX
                // filesystem). Leave the Immix view empty just as PWRegion leaves
                // the failed mount unopened instead of dereferencing address 0.
                if (backendRegion != null) lineMarks = getLineMarks();
        }

        // Line mark definitions
        def var lineMarks: LineMarkTableHandle;
        def var numLineMarks: u64;
        def var lineSize: u64;

        private def getLineMarks() -> LineMarkTableHandle {
                var hdr = getHeader();
                for (i < hdr.numDescs) {
                        var r = getMetaDataDesc(u64.!(i));
                        if (r.kind == ImmixPWRegions.ImmixLineMarkMetaKind) {
                                lineSize = u64.!(r.unitSize);
                                var spaceSize = numBlocks * blockSize;
                                numLineMarks = (spaceSize + lineSize - 1) / lineSize;
                                // fixedBytes is a descriptor-owned prefix; per-unit
                                // line marks begin immediately after it.
                                def lineMarksOffset = r.offset + u64.!(r.fixedBytes);
                                var lmrng = this.rng[lineMarksOffset ..+ numLineMarks * u64.!(LineMark.size)];
                                return LineMarkTableHandle(u64.view(Pointer.atElement(lmrng, 0) - Pointer.NULL), numLineMarks);
                        }
                }
                return LineMarkTableHandle(0, 0);
        }

        def linkChunkLineMarks(chunk: ChunkHandle) {
                if (lineMarks.addr == 0 || lineMarks.size == 0) {
                        chunk.setLinemarksCached(txn, 0);
                        return;
                }
                def lineIndex = offsetInRegion(chunk.addr) / lineSize;
                chunk.setLinemarksCached(txn, lineMarks[lineIndex].addr - regionStart);
        }

        def resetAllLineMarks() {
                // Line marks are transient GC state. They deliberately bypass the
                // allocator transaction/WAL and must be rebuilt after a crash.
                for (index < numLineMarks) {
                        lineMarks[index].getRef().mark = ImmixPWRegions.ImmixLineMarkResetValue;
                }
        }
}

component ImmixPWRegions {
        def ImmixLineMarkMetaKind = 0x0000_0001_0000_0000u64;
        def ImmixLineMarkResetValue = 0u8;
        def DefaultImmixLineSize = 256u32;

        // Line mark states (matching original Immix paper)
        // Lines are either free (unmarked) or contain live objects (marked)
        def LINE_FREE: u8 = 0;    // unmarked - line is available for allocation
        def LINE_MARKED: u8 = 1;  // marked - line contains live objects
}


component MemRegions {
        def defaultMetaDataDescs = Array<byte>.new(MetaDataDesc.size * 1);
        def lineMarkDescRef = Ref<MetaDataDesc>.at(defaultMetaDataDescs, 0);
        def BlockSize = 512u64 * 1024u64;
        new() {
                var r = lineMarkDescRef;
                r.kind = ImmixPWRegions.ImmixLineMarkMetaKind;
                r.fixedBytes = 0;
                r.unitSize = ImmixPWRegions.DefaultImmixLineSize;
                r.bytesPerUnit = u32.!(LineMark.size);
                // leave offset unset (i.e., 0)
        }
}
