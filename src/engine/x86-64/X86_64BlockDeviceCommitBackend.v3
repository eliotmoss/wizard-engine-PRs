// Block device commit backend: WAL and data live in files on disk.
// I/O is via pwrite64/pread64 + fdatasync/fsync (Linux syscalls).
// Maintains an in-memory copy (the PWRegion's rng) for fast reads and
// compatibility with direct Ref<> access in PWRegion handle types.
//
// fdatasync is used for most durability operations (avoids writing
// non-essential metadata like atime/mtime). fsync is only used when
// the file size changes (e.g., after ftruncate in syncRegion).

class BlockDeviceCommitBackend extends TxnCommitBackend {
	def dataFd: int;
	def walFd: int;
	def var walBuffer: Array<byte>;
	def var maxEntries: u32;
	def var regionStart: u64;
	def var currentEntryIndex: u32 = 0;

	new(dataFd, walFd, blockSize: u64) {
		walBuffer = Array<byte>.new(int.!(blockSize));
		maxEntries = u32.!((blockSize - u64.!(LogHeader.size)) / u64.!(LogEntry.size));
	}

	// --- Lifecycle ---

	def initRegion(rs: u64, rng: Range<byte>) {
		this.regionStart = rs;
		// Load data file into in-memory region
		def ptr = Pointer.atElement(rng, 0);
		def size = u64.!(rng.length);
		Linux.syscall(LinuxConst.SYS_pread64, (dataFd, ptr, size, 0));
		// Load WAL file into buffer
		def walPtr = Pointer.atElement(walBuffer, 0);
		def walSize = u64.!(walBuffer.length);
		Linux.syscall(LinuxConst.SYS_pread64, (walFd, walPtr, walSize, 0));
	}

	def syncRegion(rng: Range<byte>) {
		def ptr = Pointer.atElement(rng, 0);
		def size = u64.!(rng.length);
		// ftruncate changes file size -- use fsync to persist size metadata
		Linux.syscall(LinuxConst.SYS_ftruncate, (dataFd, size));
		Linux.syscall(LinuxConst.SYS_pwrite64, (dataFd, ptr, size, 0));
		Linux.syscall(LinuxConst.SYS_fsync, dataFd);
		// Pre-allocate WAL file to full block size so subsequent
		// writes stay within the allocated size (fdatasync-safe)
		Linux.syscall(LinuxConst.SYS_ftruncate, (walFd, u64.!(walBuffer.length)));
		Linux.syscall(LinuxConst.SYS_fsync, walFd);
		// Initialize WAL file with clean header
		walClear();
	}

	// --- WAL operations ---

	def walAppend(offset: u64, value: u64, width: u8) {
		if (currentEntryIndex >= maxEntries) return;
		def entryOffset = int.!(LogHeader.size) + int.!(currentEntryIndex) * int.!(LogEntry.size);
		var entry = Ref<LogEntry>.of(walBuffer[entryOffset ..+ LogEntry.size]);
		entry.offset = offset;
		entry.value = value;
		entry.width = width;
		currentEntryIndex++;
	}

	def walCommit() {
		var header = Ref<LogHeader>.of(walBuffer[0 ..+ LogHeader.size]);
		header.numEntries = currentEntryIndex;

		def entryBase = u64.view(Pointer.atElement(walBuffer, int.!(LogHeader.size)));
		header.checksum = PWRegionUtils.calculateLogChecksum(entryBase, currentEntryIndex);

		// Phase 1: Write entries to WAL file, fdatasync
		def entryBytes = u64.view(currentEntryIndex) * u64.!(LogEntry.size);
		if (entryBytes > 0) {
			Linux.syscall(LinuxConst.SYS_pwrite64, (walFd,
				Pointer.atElement(walBuffer, int.!(LogHeader.size)),
				entryBytes,
				u64.!(LogHeader.size)));
		}
		Linux.syscall(LinuxConst.SYS_fdatasync, walFd);

		// Phase 2: Write header with status=1, fdatasync
		header.status = 1;
		Linux.syscall(LinuxConst.SYS_pwrite64, (walFd,
			Pointer.atElement(walBuffer, 0),
			u64.!(LogHeader.size),
			0));
		Linux.syscall(LinuxConst.SYS_fdatasync, walFd);
	}

	def walClear() {
		var header = Ref<LogHeader>.of(walBuffer[0 ..+ LogHeader.size]);
		header.status = 0;
		Linux.syscall(LinuxConst.SYS_pwrite64, (walFd,
			Pointer.atElement(walBuffer, 0),
			u64.!(LogHeader.size),
			0));
		Linux.syscall(LinuxConst.SYS_fdatasync, walFd);
		currentEntryIndex = 0;
	}

	// --- Data application ---

	def applyUpdate(offset: u64, value: u64, width: u8) {
		// Write to in-memory region
		def addr = PWRegionUtils.pointerFromU64(regionStart + offset);
		match (width) {
			1 => addr.store<u8>(u8.view(value));
			2 => addr.store<u16>(u16.view(value));
			4 => addr.store<u32>(u32.view(value));
			8 => addr.store<u64>(value);
			_ => ;
		}
		// Persist to data file (source is the in-memory region)
		Linux.syscall(LinuxConst.SYS_pwrite64, (dataFd, addr, u64.view(width), offset));
	}

	def applyFence() {
		Linux.syscall(LinuxConst.SYS_fdatasync, dataFd);
	}

	// --- Read (from in-memory copy, kept in sync by applyUpdate) ---

	def readU8(offset: u64) -> u8 {
		return PWRegionUtils.pointerFromU64(regionStart + offset).load<u8>();
	}

	def readI16(offset: u64) -> i16 {
		return PWRegionUtils.pointerFromU64(regionStart + offset).load<i16>();
	}

	def readU64(offset: u64) -> u64 {
		return PWRegionUtils.pointerFromU64(regionStart + offset).load<u64>();
	}

	def readI64(offset: u64) -> i64 {
		return PWRegionUtils.pointerFromU64(regionStart + offset).load<i64>();
	}

	// --- Recovery ---

	def recover() -> bool {
		var header = Ref<LogHeader>.of(walBuffer[0 ..+ LogHeader.size]);
		if (header.status != 1) return false;

		def entryBase = u64.view(Pointer.atElement(walBuffer, int.!(LogHeader.size)));
		def expected = header.checksum;
		def actual = PWRegionUtils.calculateLogChecksum(entryBase, header.numEntries);

		if (expected != actual) {
			// Checksum mismatch -- corrupt log, ignore
			header.status = 0;
			Linux.syscall(LinuxConst.SYS_pwrite64, (walFd,
				Pointer.atElement(walBuffer, 0),
				u64.!(LogHeader.size),
				0));
			Linux.syscall(LinuxConst.SYS_fdatasync, walFd);
			return false;
		}

		// Replay entries
		var entryAddr = entryBase;
		for (i < header.numEntries) {
			def entry = Ref<LogEntry>.of(
				CiRuntime.forgeRange<byte>(PWRegionUtils.pointerFromU64(entryAddr), LogEntry.size));
			applyUpdate(entry.offset, entry.value, entry.width);
			entryAddr = entryAddr + u64.!(LogEntry.size);
		}

		// Ensure data is durable
		Linux.syscall(LinuxConst.SYS_fdatasync, dataFd);

		// Clear WAL
		header.status = 0;
		Linux.syscall(LinuxConst.SYS_pwrite64, (walFd,
			Pointer.atElement(walBuffer, 0),
			u64.!(LogHeader.size),
			0));
		Linux.syscall(LinuxConst.SYS_fdatasync, walFd);

		return true;
	}

	// --- Lifecycle ---

	def close() {
		Linux.syscall(LinuxConst.SYS_close, dataFd);
		Linux.syscall(LinuxConst.SYS_close, walFd);
	}
}

// File I/O helpers for BlockDeviceCommitBackend
component BlockDeviceIO {
	def O_RDWR = 2;
	def O_CREAT = 64;	// 0100 octal
	def FILE_MODE = 420;	// 0644 octal

	def openOrCreate(path: string) -> int {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		var r = Linux.syscall(LinuxConst.SYS_open,
			(Pointer.atElement(pathBuf, 0), O_RDWR | O_CREAT, FILE_MODE));
		return int.!(r.0);
	}

	def unlink(path: string) {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		Linux.syscall(LinuxConst.SYS_unlink, Pointer.atElement(pathBuf, 0));
	}
}
