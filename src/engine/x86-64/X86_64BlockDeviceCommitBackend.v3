// Block device commit backend: region image and WAL share one backing file.
// I/O is via pread64/pwrite64 + fdatasync/fsync (Linux syscalls).
// The live working region remains in-memory (PWRegion.rng), while block 1 of
// that region is also the in-memory WAL buffer, matching the PMEM layout.
//
// fdatasync is used for steady-state durability operations. fsync is only used
// when the backing file grows via ftruncate during one-time initialization.

class BlockDeviceCommitBackend extends TxnCommitBackend {
	def fd: int;
	def blockSize: u64;

	def var maxEntries: u32;

	def var regionStart: u64;
	def var header: Ref<LogHeader>;
	def var entryBase: u64;

	def var currentEntryIndex: u32 = 0;

	new(fd, blockSize) {
		maxEntries = u32.!((blockSize - u64.!(LogHeader.size)) / u64.!(LogEntry.size));
	}

	// --- Lifecycle ---

	def initRegion(rng: Range<byte>) {
		def regionStartPtr = Pointer.atElement(rng, 0);
		regionStart = u64.view(regionStartPtr);
		def logChunkAddr = regionStart + blockSize;
		header = Ref<LogHeader>.of(
			CiRuntime.forgeRange<byte>(PWRegionUtils.pointerFromU64(logChunkAddr), LogHeader.size));
		entryBase = logChunkAddr + u64.!(LogHeader.size);

		def size = u64.!(rng.length);
		def fileSize = Linux.syscall(LinuxConst.SYS_lseek, (fd, 0, LinuxConst.SEEK_END)).0;
		if (fileSize < i64.view(size)) {
			Linux.syscall(LinuxConst.SYS_ftruncate, (fd, size));
			Linux.syscall(LinuxConst.SYS_fsync, fd);
		}
		Linux.syscall(LinuxConst.SYS_pread64, (fd, regionStartPtr, size, 0));
	}

	def syncRegion(rng: Range<byte>) {
		def ptr = Pointer.atElement(rng, 0);
		def size = u64.!(rng.length);
		Linux.syscall(LinuxConst.SYS_pwrite64, (fd, ptr, size, 0));
		Linux.syscall(LinuxConst.SYS_fdatasync, fd);
		walClear();
	}

	// --- WAL operations ---

	def walAppend(offset: u64, value: u64, width: u8) {
		if (currentEntryIndex >= maxEntries) return;
		def entryAddr = entryBase + u64.view(currentEntryIndex) * u64.!(LogEntry.size);
		var entry = Ref<LogEntry>.of(
			CiRuntime.forgeRange<byte>(PWRegionUtils.pointerFromU64(entryAddr), LogEntry.size));
		entry.offset = offset;
		entry.value = value;
		entry.width = width;
		currentEntryIndex++;
	}

	def walCommit() {
		header.numEntries = currentEntryIndex;
		header.checksum = PWRegionUtils.calculateLogChecksum(entryBase, currentEntryIndex);

		// Phase 1: write entries, then make them durable.
		def entryBytes = u64.view(currentEntryIndex) * u64.!(LogEntry.size);
		if (entryBytes > 0) {
			Linux.syscall(LinuxConst.SYS_pwrite64, (fd,
				PWRegionUtils.pointerFromU64(entryBase),
				entryBytes,
				blockSize + u64.!(LogHeader.size)));
		}
		Linux.syscall(LinuxConst.SYS_fdatasync, fd);

		// Phase 2: mark the header committed, then make it durable.
		header.status = 1;
		Linux.syscall(LinuxConst.SYS_pwrite64, (fd,
			Pointer.atRef(header),
			u64.!(LogHeader.size),
			blockSize));
		Linux.syscall(LinuxConst.SYS_fdatasync, fd);
	}

	def walClear() {
		header.status = 0;
		Linux.syscall(LinuxConst.SYS_pwrite64, (fd,
			Pointer.atRef(header),
			u64.!(LogHeader.size),
			blockSize));
		Linux.syscall(LinuxConst.SYS_fdatasync, fd);
		currentEntryIndex = 0;
	}

	// --- Data application ---

	def applyUpdate(offset: u64, value: u64, width: u8) {
		// Write to in-memory region
		def addr = PWRegionUtils.pointerFromU64(regionStart + offset);
		match (width) {
			1 => addr.store<u8>(u8.view(value));
			2 => addr.store<u16>(u16.view(value));
			4 => addr.store<u32>(u32.view(value));
			8 => addr.store<u64>(value);
			_ => ;
		}
		Linux.syscall(LinuxConst.SYS_pwrite64, (fd, addr, u64.view(width), offset));
	}

	def applyFence() {
		Linux.syscall(LinuxConst.SYS_fdatasync, fd);
	}

	// --- Read (from in-memory copy, kept in sync by applyUpdate) ---

	def readU8(offset: u64) -> u8 {
		return PWRegionUtils.pointerFromU64(regionStart + offset).load<u8>();
	}

	def readI16(offset: u64) -> i16 {
		return PWRegionUtils.pointerFromU64(regionStart + offset).load<i16>();
	}

	def readU64(offset: u64) -> u64 {
		return PWRegionUtils.pointerFromU64(regionStart + offset).load<u64>();
	}

	def readI64(offset: u64) -> i64 {
		return PWRegionUtils.pointerFromU64(regionStart + offset).load<i64>();
	}

	// --- Recovery ---

	def recover() -> bool {
		if (header.status != 1) {
			currentEntryIndex = 0;
			return false;
		}

		def expected = header.checksum;
		def actual = PWRegionUtils.calculateLogChecksum(entryBase, header.numEntries);

		if (expected != actual) {
			header.status = 0;
			Linux.syscall(LinuxConst.SYS_pwrite64, (fd,
				Pointer.atRef(header),
				u64.!(LogHeader.size),
				blockSize));
			Linux.syscall(LinuxConst.SYS_fdatasync, fd);
			currentEntryIndex = 0;
			return false;
		}

		var entryAddr = entryBase;
		for (i < header.numEntries) {
			def entry = Ref<LogEntry>.of(
				CiRuntime.forgeRange<byte>(PWRegionUtils.pointerFromU64(entryAddr), LogEntry.size));
			applyUpdate(entry.offset, entry.value, entry.width);
			entryAddr = entryAddr + u64.!(LogEntry.size);
		}

		Linux.syscall(LinuxConst.SYS_fdatasync, fd);

		header.status = 0;
		Linux.syscall(LinuxConst.SYS_pwrite64, (fd,
			Pointer.atRef(header),
			u64.!(LogHeader.size),
			blockSize));
		Linux.syscall(LinuxConst.SYS_fdatasync, fd);
		currentEntryIndex = 0;

		return true;
	}

	// --- Lifecycle ---

	def close() {
		Linux.syscall(LinuxConst.SYS_close, fd);
	}
}

// File I/O helpers for BlockDeviceCommitBackend
component BlockDeviceIO {
	def O_RDWR = 2;
	def O_CREAT = 64;	// 0100 octal
	def FILE_MODE = 420;	// 0644 octal

	def openOrCreate(path: string) -> int {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		var r = Linux.syscall(LinuxConst.SYS_open,
			(Pointer.atElement(pathBuf, 0), O_RDWR | O_CREAT, FILE_MODE));
		return int.!(r.0);
	}

	def unlink(path: string) {
		var pathBuf = Array<byte>.new(path.length + 1);
		for (i < path.length) pathBuf[i] = path[i];
		pathBuf[path.length] = 0;
		Linux.syscall(LinuxConst.SYS_unlink, Pointer.atElement(pathBuf, 0));
	}
}
