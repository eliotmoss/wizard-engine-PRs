// Abstract interface for WAL commit backends.
// Decouples the commit protocol (WAL append, commit, apply, recover)
// from the storage medium. Region allocation and durable mapping live in
// TxnRegionBackend implementations; commit backends only manage WAL ordering.
//
// All offsets passed to this interface are region-relative.
//
// Implementations:
// 1. RegionWalCommitBackend: In-region log with backend-provided flush/fence

class TxnCommitBackend {
	// --- WAL operations ---
	// Append a log entry recording a change at the given region-relative offset.
	def walAppend(offset: u64, value: u64, width: u8);

	// Commit the current WAL transaction (make all appended entries durable).
	def walCommit();

	// Clear/reset the WAL after data has been applied.
	def walClear();

	// --- Data application ---
	// Apply a single update to the persistent data store at a region-relative offset.
	def applyUpdate(offset: u64, value: u64, width: u8);

	// Ensure all applied updates are durable (fence/fdatasync).
	def applyFence();

	// --- Read (cache-miss fallthrough) ---
	// Read from the backing store at a region-relative offset.
	def readU8(offset: u64) -> u8;
	def readI16(offset: u64) -> i16;
	def readU64(offset: u64) -> u64;
	def readI64(offset: u64) -> i64;

	// --- Recovery ---
	// Replay any committed-but-unapplied WAL entries.
	// Returns true if recovery was performed, false if no recovery needed.
	def recover() -> bool;

	// Release resources held by this backend.
	def close();
}
