// Helpers for the basic-operation benchmark (test/pwopsbench.main.v3), kept
// here, as PWSieve.v3 is for pwsievebench, so the unit tests can check them
// (PWOpsTest.v3).
//
// A per-operation benchmark has two things to get right that its own numbers
// cannot confirm: what persistence work each operation should do, so that a
// count which drifts fails the run instead of skewing it, and how to leave a
// region whose log holds a committed transaction that was never applied, so
// that a mount has something to replay.

// The newest valid record in a region's log, read back after a commit: the
// transaction that commit wrote.
class PWOpsRecord(txnSeq: u64, entryCount: u32, recordLen: u32, recordOffset: u64, distinctLines: int) {
        // The cache lines one commit of this record writes back on PMEM. The
        // record's own: the WAL prepares the recordLen bytes from its slot's
        // region-relative offset, recordOffset, and the provider writes back
        // every line that range touches (CacheLines.writeBackLines). A slot
        // starts on a line when the log block does, as at 4 KiB blocks, and then
        // that is recordLen / 64 lines; RegionAllocator allows any block size that is a
        // multiple of 8, and at others (4,104 bytes, say) a slot starts inside a
        // line and the record touches one more. Then, once applied, each line
        // its after-images touch, once: TwoSlotWal.writeBackAfterImages() merges
        // extents whose lines touch and prepares each merged range, which covers
        // exactly the lines written.
        def commitLines() -> int {
                return recordLines() + distinctLines;
        }

        def recordLines() -> int {
                def line = CacheLines.CACHE_LINE_SIZE;
                def first = recordOffset - recordOffset % line;
                def end = recordOffset + u64.view(recordLen);
                return int.!((end - first + line - 1u64) / line);
        }
}

component PWOps {
        // The region-relative offset of the log block, read from the header as
        // RegionAllocator.mount() reads it (0 means the pre-field default, block 1).
        def logBlockOffset(range: Range<byte>, blockSize: u64) -> u64 {
                def hdr = Ref<RegionHeader>.of(range[0 ..+ RegionHeader.size]);
                return if(hdr.logBlock == 0, blockSize, hdr.logBlock);
        }

        // The newest record that validates in either slot of {region}'s log, or
        // null. Reads through a second TwoSlotWal over the same log, which only
        // loads: its constructor validates the header and scans the slots, and
        // validateSlot() checks the checksum exactly as recovery would.
        def latestRecord(region: RegionAllocator) -> PWOpsRecord {
                def offset = logBlockOffset(region.rng, region.blockSize);
                def wal = TwoSlotWal.new(region.regionStart, region.regionStart + offset,
                        region.blockSize, region.backendRegion, OpenMode.ATTACH);
                if (!wal.openOk) return null;
                def seq0 = wal.validateSlot(0), seq1 = wal.validateSlot(1);
                def seq = if(seq0 > seq1, seq0, seq1);
                if (seq == 0u64) return null;
                def addr = wal.slotAddr(wal.slotIndexOf(seq));
                def header = wal.recordHeaderAt(addr);
                def count = header.entryCount;
                def lines = Vector<u64>.new();
                var entryAddr = addr + u64.!(WalRecordHeader.size);
                for (i < count) {
                        def line = wal.walEntryAt(entryAddr).offset >> 6;
                        var seen = false;
                        for (j < lines.length) if (lines[j] == line) seen = true;
                        if (!seen) lines.put(line);
                        entryAddr += u64.!(WalEntry.size);
                }
                return PWOpsRecord.new(seq, count, header.recordLen, addr - region.regionStart, lines.length);
        }

        // Leave {raw}, a formatted and cleanly closed region, with one committed
        // transaction in its log whose after-images were never applied: {count}
        // u64 entries at {offset}, {offset} + 8, ..., of {value}, {value} + 1,
        // .... Returns the record's txnSeq, or 0 if it could not be committed.
        //
        // This is PmemDaxIntegrationTest's recipe, and TwoSlotWalTest's
        // writeTxn(): the production TwoSlotWal appends and commits, so the
        // record and its commit-point boundary are exactly what a
        // TransactionCache commit writes. Nothing is applied, and the caller
        // closes {raw} without the log's close(), which would persist the data and
        // scrub the record. The durable result is the state a crash leaves
        // right after a commit point: the record valid, its after-images
        // absent, so the next mount must replay them.
        def commitUnapplied(raw: StorageRegion, blockSize: u64, offset: u64, count: int, value: u64) -> u64 {
                def regionStart = u64.view(Pointer.atElement(raw.range, 0));
                def wal = TwoSlotWal.new(regionStart, regionStart + logBlockOffset(raw.range, blockSize),
                        blockSize, raw, OpenMode.ATTACH);
                if (!wal.openOk) return 0u64;
                for (i < count) {
                        if (!wal.append(offset + u64.!(i) * 8u64, value + u64.!(i), 8u8)) return 0u64;
                }
                return wal.commit();
        }
}
