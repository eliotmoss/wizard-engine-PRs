// Tests for PWOps.v3, the basic-operation benchmark's helpers.
//
// The benchmark (test/pwopsbench.main.v3) fails a run whose persistence work
// per operation differs from what the operation should do. On PMEM that
// expectation is derived from the record the commit wrote (PWOpsRecord), and a
// recovery is expected to write back one line per replayed entry. The hosts
// with a DAX mount are not the hosts where the suite runs, so these tests
// check the expectations here, on the production PmemRegion boundary path
// over anonymous memory, recording every CLWB and SFENCE it issues.
//
// Geometry is the benchmark's: 256 x 4096 = 1 MiB.

def PWOPS_BLOCKS = 256u64;
def PWOPS_BLOCK_SIZE = 4096u64;

def PWT = UnitTests.registerT("pwops:", _, PWOpsTester.new, _);
def PWX = [
	PWT("alloc_free_write_back_record_and_after_images", test_pwops_alloc_free_write_back_record_and_after_images),
	PWT("alloc_free_reach_a_steady_state", test_pwops_alloc_free_reach_a_steady_state),
	PWT("empty_commit_issues_nothing", test_pwops_empty_commit_issues_nothing),
	PWT("clean_mount_issues_no_boundary", test_pwops_clean_mount_issues_no_boundary),
	PWT("commit_unapplied_leaves_record_without_data", test_pwops_commit_unapplied_leaves_record_without_data),
	PWT("recovery_replays_with_one_line_per_entry", test_pwops_recovery_replays_with_one_line_per_entry),
	()
];

// A PMEM region over anonymous memory that outlives its RegionAllocator: close()
// drops only the pending-writeback flag, as a crash or an unmount would, and
// leaves the bytes for the next mount, as the file on a DAX mount would.
class PWOpsTestRegion extends PmemRegion {
	var released = false;

	new(mapping: Mapping) super(mapping, -1) { }

	def close() {
		cleanupBeforeClose();
	}

	// The end of the test: nothing may touch the region afterwards.
	def release() {
		if (released) return;
		mapping.range.unmap();
		released = true;
	}
}

class PWOpsTester(t: Tester) {
	var container: PWOpsTestRegion;
	var recorder: RecordingProvider;

	new() {
		def mapping = Mmap.reserve(PWOPS_BLOCKS * PWOPS_BLOCK_SIZE, Mmap.PROT_READ | Mmap.PROT_WRITE);
		if (mapping == null) return;
		container = PWOpsTestRegion.new(mapping);
		recorder = RecordingProvider.new(container.range);
		container.setProvider(recorder);
	}

	def ready() -> bool {
		if (container != null) return true;
		t.fail("could not reserve the test region");
		return false;
	}

	def open(fresh: bool) -> RegionAllocator {
		return RegionAllocator.new(PreparedStorageBackend.new(container), PWOPS_BLOCKS,
			Array<Ref<MetadataDescriptor>>.new(0), PWOPS_BLOCK_SIZE, if(fresh, OpenMode.FORMAT, OpenMode.ATTACH));
	}

	def count(kind: PersistenceEventKind) -> int {
		var n = 0;
		for (i < recorder.events.length) if (recorder.events[i].kind == kind) n++;
		return n;
	}

	def release() {
		if (container != null) container.release();
	}
}

// One allocation or free, as the benchmark times it: exactly one boundary, and
// the record's lines plus each distinct after-image line written back.
def checkOp(tc: PWOpsTester, region: RegionAllocator, what: string) -> PWOpsRecord {
	def rec = PWOps.latestRecord(region);
	if (rec == null) {
		tc.t.fail1("%s: no valid record in the log", what);
		return null;
	}
	if (tc.count(PersistenceEventKind.SFENCE) != 1) {
		tc.t.fail2("%s: %d fences, expected 1", what, tc.count(PersistenceEventKind.SFENCE));
	}
	if (tc.count(PersistenceEventKind.CLWB) != rec.commitLines()) {
		tc.t.fail3("%s: %d lines written back, the record predicts %d", what,
			tc.count(PersistenceEventKind.CLWB), rec.commitLines());
	}
	return rec;
}

def checkInvariants(tc: PWOpsTester, region: RegionAllocator) {
	def err = AllocatorInvariants.check(region);
	if (err != null) tc.t.fail1("allocator invariants: %s", err);
}

def test_pwops_alloc_free_write_back_record_and_after_images(tc: PWOpsTester) {
	if (!tc.ready()) return;
	def region = tc.open(true);
	if (region.txn == null) {
		tc.t.fail("could not format");
		return tc.release();
	}
	for (n in [1u32, 8u32, 64u32]) {
		tc.recorder.clear();
		def chunk = region.allocChunk(n);
		if (chunk.isNull()) {
			tc.t.fail1("alloc(%d) failed", n);
			break;
		}
		def a = checkOp(tc, region, "alloc");
		// A split allocation writes more than one field of a block entry,
		// so its after-images share lines: the formula must not be the
		// entry count.
		if (a != null && a.distinctLines >= int.!(a.entryCount)) {
			tc.t.fail2("alloc: %d entries on %d lines, expected sharing", a.entryCount, a.distinctLines);
		}
		tc.recorder.clear();
		tc.t.assertz(true, region.freeChunk(chunk));
		checkOp(tc, region, "free");
	}
	checkInvariants(tc, region);
	region.deallocate();
	tc.release();
}

// The benchmark learns each operation's counts in warm-up and requires every
// measured operation to match them, which holds only if alternating alloc and
// free returns the allocator to the same state.
def test_pwops_alloc_free_reach_a_steady_state(tc: PWOpsTester) {
	if (!tc.ready()) return;
	def region = tc.open(true);
	if (region.txn == null) {
		tc.t.fail("could not format");
		return tc.release();
	}
	for (n in [1u32, 8u32, 64u32]) {
		var allocEntries = 0u32, allocLines = 0, freeEntries = 0u32, freeLines = 0;
		for (i < 5) {
			tc.recorder.clear();
			def chunk = region.allocChunk(n);
			def a = checkOp(tc, region, "alloc");
			tc.recorder.clear();
			tc.t.assertz(true, region.freeChunk(chunk));
			def f = checkOp(tc, region, "free");
			if (a == null || f == null) break;
			if (i == 0) {
				allocEntries = a.entryCount;
				allocLines = a.commitLines();
				freeEntries = f.entryCount;
				freeLines = f.commitLines();
			}
			tc.t.assert_eq(allocEntries, a.entryCount);
			tc.t.assert_eq(allocLines, a.commitLines());
			tc.t.assert_eq(freeEntries, f.entryCount);
			tc.t.assert_eq(freeLines, f.commitLines());
		}
	}
	checkInvariants(tc, region);
	region.deallocate();
	tc.release();
}

// TransactionCache.commit() with nothing buffered returns before the WAL: no
// record, no store, no writeback, no fence.
def test_pwops_empty_commit_issues_nothing(tc: PWOpsTester) {
	if (!tc.ready()) return;
	def region = tc.open(true);
	if (region.txn == null) {
		tc.t.fail("could not format");
		return tc.release();
	}
	tc.recorder.clear();
	for (i < 3) tc.t.assertz(true, region.txn.commit());
	tc.t.asserti(0, tc.recorder.events.length);
	region.deallocate();
	tc.release();
}

// A clean close scrubs the log, so a mount replays nothing and persists
// nothing: the mount's time is opening and reading, not a boundary.
def test_pwops_clean_mount_issues_no_boundary(tc: PWOpsTester) {
	if (!tc.ready()) return;
	def formatted = tc.open(true);
	if (formatted.txn == null) {
		tc.t.fail("could not format");
		return tc.release();
	}
	tc.t.assertz(false, formatted.allocChunk(8u32).isNull());
	formatted.deallocate();
	for (i < 2) {
		tc.recorder.clear();
		def mounted = tc.open(false);
		if (mounted.txn == null) {
			tc.t.fail("could not mount");
			return tc.release();
		}
		tc.t.assertz(true, mounted.lastRecovery == WalRecovery.CLEAN);
		tc.t.asserti(0, tc.count(PersistenceEventKind.CLWB));
		tc.t.asserti(0, tc.count(PersistenceEventKind.SFENCE));
		tc.t.asserti(0, tc.count(PersistenceEventKind.STORE));
		tc.t.assertz(true, PWOps.latestRecord(mounted) == null);
		mounted.deallocate();
	}
	tc.release();
}

// Formats, allocates the chunk the after-images go to, and closes cleanly.
// Returns the region-relative offset of the chunk's first u64, or 0.
def formatWithScratch(tc: PWOpsTester) -> u64 {
	def formatted = tc.open(true);
	if (formatted.txn == null) {
		tc.t.fail("could not format");
		return 0;
	}
	def chunk = formatted.allocChunk(1u32);
	if (chunk.isNull()) {
		tc.t.fail("could not allocate the scratch chunk");
		formatted.deallocate();
		return 0;
	}
	def offset = formatted.offsetInRegion(chunk.addr) + u64.!(ChunkHeader.size);
	formatted.deallocate();
	return offset;
}

def loadU64(tc: PWOpsTester, offset: u64) -> u64 {
	return Pointer.atElement(tc.container.range, int.!(offset)).load<u64>();
}

def test_pwops_commit_unapplied_leaves_record_without_data(tc: PWOpsTester) {
	if (!tc.ready()) return;
	def base = formatWithScratch(tc);
	if (base == 0) return tc.release();
	tc.recorder.clear();
	tc.t.assert_eq(1u64, PWOps.commitUnapplied(tc.container, PWOPS_BLOCK_SIZE, base, 8, 0x5A00u64));
	// The commit point only: the record's lines and one fence, no data.
	tc.t.asserti(1, tc.count(PersistenceEventKind.SFENCE));
	for (i < 8) tc.t.assert_eq(0u64, loadU64(tc, base + u64.!(i) * 8u64));
	tc.container.close();
	tc.release();
}

// The recovery the benchmark times: a mount that replays one record of k
// entries. TwoSlotWal replays with applyAfterImage(), which prepares each entry
// on its own, so k u64 entries are k writebacks even where they share lines,
// then one fence. The cycle repeats with the same counts, as the benchmark
// requires.
def test_pwops_recovery_replays_with_one_line_per_entry(tc: PWOpsTester) {
	if (!tc.ready()) return;
	def base = formatWithScratch(tc);
	if (base == 0) return tc.release();
	for (k in [8, 24]) {
		for (round < 2) {
			def value = 0x5A5A_0000u64 + u64.!(k * 100 + round * 1000);
			if (PWOps.commitUnapplied(tc.container, PWOPS_BLOCK_SIZE, base, k, value) == 0u64) {
				tc.t.fail1("could not commit an unapplied record of %d entries", k);
				return tc.release();
			}
			tc.container.close();
			tc.recorder.clear();
			def mounted = tc.open(false);
			if (mounted.txn == null) {
				tc.t.fail("could not mount for recovery");
				return tc.release();
			}
			tc.t.assertz(true, mounted.lastRecovery == WalRecovery.REPLAYED);
			tc.t.asserti(k, tc.count(PersistenceEventKind.CLWB));
			tc.t.asserti(1, tc.count(PersistenceEventKind.SFENCE));
			for (i < k) tc.t.assert_eq(value + u64.!(i), loadU64(tc, base + u64.!(i) * 8u64));
			checkInvariants(tc, mounted);
			mounted.deallocate();
		}
	}
	// The close after each replay scrubbed the record: the next mount is clean.
	def clean = tc.open(false);
	tc.t.assertz(true, clean.lastRecovery == WalRecovery.CLEAN);
	clean.deallocate();
	tc.release();
}
