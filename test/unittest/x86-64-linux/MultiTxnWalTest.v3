// MultiTxnWal Tests
// Tests the persistent multi-transaction redo log and recovery flow.

def MTW = UnitTests.registerT("multi_wal:", _, MultiTxnWalTester.new, _);
def MTWX = [
	MTW("fresh_superblocks", test_multi_fresh_superblocks),
	MTW("fresh_superblock_persist_failure_rejected", test_multi_fresh_superblock_persist_failure_rejected),
	MTW("selects_newest_superblock", test_multi_selects_newest_superblock),
	MTW("ignores_corrupt_newer_superblock", test_multi_ignores_corrupt_newer_superblock),
	MTW("corrupt_superblocks_reported", test_multi_corrupt_superblocks_reported),
	MTW("recovers_persisted_record", test_multi_recovers_persisted_record),
	MTW("invalid_checksum_ignored", test_multi_invalid_checksum_ignored),
	MTW("invalid_width_rejected", test_multi_invalid_width_rejected),
	MTW("empty_commit_has_sequence", test_multi_empty_commit_has_sequence),
	MTW("invalid_append_poisons_transaction", test_multi_invalid_append_poisons_transaction),
	MTW("null_backend_rejected", test_multi_null_backend_rejected),
	MTW("recovery_persist_failure_reported", test_multi_recovery_persist_failure_reported),
	MTW("gap_abandon_persist_failure_reported", test_multi_gap_abandon_persist_failure_reported),
	MTW("contiguous_prefix_only", test_multi_contiguous_prefix_only),
	MTW("epoch_stale_rejected", test_multi_epoch_stale_rejected),
	MTW("wraparound_checkpoint_reserve", test_multi_wraparound_checkpoint_reserve),
	MTW("recovers_multiple_records", test_multi_recovers_multiple_records),
	MTW("crash_mid_log_recovery", test_multi_crash_mid_log_recovery),
	MTW("commit_after_recovery_survives", test_multi_commit_after_recovery_survives),
	MTW("failed_persist_no_duplicate", test_multi_failed_persist_no_duplicate),
	MTW("checkpoint_policy_thresholds", test_multi_checkpoint_policy_thresholds),
	MTW("maybe_checkpoint_count", test_multi_maybe_checkpoint_count),
	MTW("maybe_checkpoint_occupancy", test_multi_maybe_checkpoint_occupancy),
	()
];

class MultiTxnWalTestBackend extends TxnRegionBackend {
	def range: Range<byte>;

	new(range) { }

	def create(size: u64, prot: int, fresh: bool) -> BackendRegion {
		return MultiTxnWalTestRegion.new(range);
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "multi_txn_wal_test";
	}
}

class MultiTxnWalTestRegion extends BackendRegion {
	new(range: Range<byte>) super(range) { }

	def destroy() { }

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		return true;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		return true;
	}

	def persistChanges() -> bool {
		return true;
	}
}

// A region that can fail the next persistRange on demand, to exercise the
// failed-commit-point path in appendCommittedRecord.
class FailingRegion extends BackendRegion {
	var failNextPersistRange = false;
	var failNextPersistChanges = false;
	var persistRangeCalls = 0;
	var failPersistRangeCall = 0;

	new(range: Range<byte>) super(range) { }

	def destroy() { }

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		return true;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		persistRangeCalls++;
		if (persistRangeCalls == failPersistRangeCall) return false;
		if (failNextPersistRange) {
			failNextPersistRange = false;
			return false;
		}
		return true;
	}

	def persistChanges() -> bool {
		if (failNextPersistChanges) {
			failNextPersistChanges = false;
			return false;
		}
		return true;
	}
}

// A region whose checkpoint cost class is configurable, so the per-backend
// threshold wiring in configureCheckpointPolicy() can be exercised directly.
class CostRegion extends BackendRegion {
	def cost: CheckpointCost;

	new(range: Range<byte>, cost) super(range) { }

	def destroy() { }

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		return true;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		return true;
	}

	def persistChanges() -> bool {
		return true;
	}

	def checkpointCost() -> CheckpointCost {
		return cost;
	}
}

class MultiTxnWalTester(t: Tester) {
	var data: Array<byte>;
	var backend: MultiTxnWalTestBackend;
	var backendRegion: BackendRegion;
	var wal: MultiTxnWal;
	var regionStart: u64;
	var logAddr: u64;

	new() {
		data = Array<byte>.new(4096);
		for (i < data.length) data[i] = 0u8;
		regionStart = u64.view(Pointer.atElement(data, 0));
		logAddr = regionStart + 1024u64;
		backend = MultiTxnWalTestBackend.new(data[0 ..+ data.length]);
		backendRegion = backend.create(u64.!(data.length), BackendProt.READ.mask | BackendProt.WRITE.mask, true);
		wal = MultiTxnWal.new(regionStart, logAddr, 1024u64, backendRegion, true);
	}

	def reopen() -> MultiTxnWal {
		return MultiTxnWal.new(regionStart, logAddr, 1024u64, backendRegion, false);
	}

	def writeTxn(offset: u64, value: u64, width: u8) -> u64 {
		wal.append(offset, value, width);
		return wal.commit();
	}

	// Commit one transaction and mark it applied, exactly as RegionTransaction
	// does (commit -> noteApplied). Without noteApplied, appliedSeqVolatile never
	// advances and a lazy checkpoint could not reclaim anything.
	def writeAndApply(offset: u64, value: u64, width: u8) -> u64 {
		wal.append(offset, value, width);
		def seq = wal.commit();
		if (seq != 0u64) wal.noteApplied(seq);
		return seq;
	}

	def checksumAddrFor(seqOffset: u64) -> u64 {
		def start = wal.ringBase + seqOffset;
		def entryCount = PWRegionUtils.pointerFromU64(start + u64.view(TxnRecordHeader.entryCount.offset)).load<u32>();
		return start + u64.!(TxnRecordHeader.size) + u64.view(entryCount) * u64.!(LogEntry.size) + u64.view(TxnCommitTrailer.checksum.offset);
	}

	def corruptChecksumAt(recordOffset: u64) {
		def addr = checksumAddrFor(recordOffset);
		def old = PWRegionUtils.pointerFromU64(addr).load<u64>();
		PWRegionUtils.pointerFromU64(addr).store<u64>(old + 1u64);
	}
}

def test_multi_fresh_superblocks(tc: MultiTxnWalTester) {
	tc.t.assertz(true, tc.wal.validateSuperblock(0));
	tc.t.assertz(true, tc.wal.validateSuperblock(1));
	tc.t.assert_eq(1u64, tc.wal.logEpoch);
	tc.t.assert_eq(0u64, tc.wal.durableAppliedSeq);
}

// Fresh formatting requires both redundant superblock copies to reach their
// persistence boundaries. A failure of either copy leaves the current WAL
// unusable rather than allowing transactions on an indeterminately formatted
// log.
def test_multi_fresh_superblock_persist_failure_rejected(tc: MultiTxnWalTester) {
	def firstData = Array<byte>.new(4096);
	def firstStart = u64.view(Pointer.atElement(firstData, 0));
	def firstRegion = FailingRegion.new(firstData[0 ..+ firstData.length]);
	firstRegion.failPersistRangeCall = 1;
	def firstWal = MultiTxnWal.new(firstStart, firstStart + 1024u64, 1024u64, firstRegion, true);
	tc.t.assertz(false, firstWal.openOk);
	tc.t.assertz(false, firstWal.append(200u64, 0x55u64, 1u8));
	tc.t.assert_eq(0u64, firstWal.commit());
	tc.t.assertz(true, firstWal.recover() == MultiWalRecovery.CORRUPT);

	def secondData = Array<byte>.new(4096);
	def secondStart = u64.view(Pointer.atElement(secondData, 0));
	def secondRegion = FailingRegion.new(secondData[0 ..+ secondData.length]);
	secondRegion.failPersistRangeCall = 2;
	def secondWal = MultiTxnWal.new(secondStart, secondStart + 1024u64, 1024u64, secondRegion, true);
	tc.t.assertz(false, secondWal.openOk);
	tc.t.assertz(false, secondWal.append(200u64, 0x55u64, 1u8));
	tc.t.assert_eq(0u64, secondWal.commit());
	tc.t.assertz(true, secondWal.recover() == MultiWalRecovery.CORRUPT);
}

def test_multi_selects_newest_superblock(tc: MultiTxnWalTester) {
	tc.writeTxn(200u64, 0x55u64, 1u8);
	tc.wal.noteApplied(1u64);
	tc.t.assertz(true, tc.wal.checkpoint(1u64));
	var reopened = tc.reopen();
	tc.t.assert_eq(3u64, reopened.currentGeneration);
	tc.t.assert_eq(1u64, reopened.logEpoch);
}

def test_multi_ignores_corrupt_newer_superblock(tc: MultiTxnWalTester) {
	tc.writeTxn(200u64, 0x55u64, 1u8);
	tc.wal.noteApplied(1u64);
	tc.t.assertz(true, tc.wal.checkpoint(1u64));
	var newer = tc.wal.superblockAt(tc.wal.currentSuperblockIndex);
	newer.checksum = newer.checksum + 1u64;
	var reopened = tc.reopen();
	tc.t.assert_eq(2u64, reopened.currentGeneration);
}

def test_multi_corrupt_superblocks_reported(tc: MultiTxnWalTester) {
	PWRegionUtils.pointerFromU64(tc.logAddr).store<u64>(0u64);
	PWRegionUtils.pointerFromU64(tc.logAddr + u64.!(WalSuperblock.size)).store<u64>(0u64);
	def reopened = tc.reopen();
	tc.t.assertz(false, reopened.openOk);
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.CORRUPT);
}

def test_multi_recovers_persisted_record(tc: MultiTxnWalTester) {
	tc.t.assert_eq(1u64, tc.writeTxn(200u64, 0x55u64, 1u8));
	var reopened = tc.reopen();
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.REPLAYED);
	tc.t.assert_eq(0x55u8, tc.data[200]);
	tc.t.assert_eq(1u64, reopened.durableAppliedSeq);
}

def test_multi_invalid_checksum_ignored(tc: MultiTxnWalTester) {
	tc.writeTxn(200u64, 0x55u64, 1u8);
	tc.corruptChecksumAt(0u64);
	var reopened = tc.reopen();
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.CLEAN);
	tc.t.assert_eq(0u8, tc.data[200]);
}

def test_multi_invalid_width_rejected(tc: MultiTxnWalTester) {
	tc.t.assertz(false, tc.wal.append(200u64, 0x55u64, 3u8));
	tc.t.assert_eq(0u64, tc.wal.commit());
	tc.t.assert_eq(0, tc.wal.activeRecords.length);
}

// Empty commits are real zero-entry records. They consume a sequence number so
// success can never collide with commit()'s zero failure sentinel.
def test_multi_empty_commit_has_sequence(tc: MultiTxnWalTester) {
	tc.t.assert_eq(1u64, tc.wal.commit());
	tc.t.assert_eq(1, tc.wal.activeRecords.length);
	tc.t.assert_eq(0u32, tc.wal.activeRecords[0].entryCount);
	def reopened = tc.reopen();
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.REPLAYED);
	tc.t.assert_eq(1u64, reopened.durableAppliedSeq);
}

// Once any append fails validation, the pending transaction must fail as a
// whole. commit() clears the poison and buffered entries so a later transaction
// can proceed normally without inheriting a partial write set.
def test_multi_invalid_append_poisons_transaction(tc: MultiTxnWalTester) {
	tc.t.assertz(true, tc.wal.append(200u64, 0x11u64, 1u8));
	tc.t.assertz(false, tc.wal.append(201u64, 0x22u64, 3u8));
	tc.t.assert_eq(0u64, tc.wal.commit());
	tc.t.assert_eq(0, tc.wal.activeRecords.length);
	tc.t.assert_eq(1u64, tc.wal.nextTxnSeq);

	tc.t.assertz(true, tc.wal.append(202u64, 0x33u64, 1u8));
	tc.t.assert_eq(1u64, tc.wal.commit());
	def reopened = tc.reopen();
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.REPLAYED);
	tc.t.assert_eq(0u8, tc.data[200]);
	tc.t.assert_eq(0x33u8, tc.data[202]);
}

// MultiTxnWal requires a real backend: accepting null made persistence methods
// act as no-ops while entry validation dereferenced the missing region.
def test_multi_null_backend_rejected(tc: MultiTxnWalTester) {
	def wal = MultiTxnWal.new(tc.regionStart, tc.logAddr, 1024u64, null, true);
	tc.t.assertz(false, wal.openOk);
	tc.t.assertz(false, wal.maybeCheckpoint());
	tc.t.assertz(true, wal.recover() == MultiWalRecovery.CORRUPT);
}

// Recovery reports a failed data durability boundary distinctly. The record
// remains replayable, so retrying recovery can finish and publish it.
def test_multi_recovery_persist_failure_reported(tc: MultiTxnWalTester) {
	tc.t.assert_eq(1u64, tc.writeTxn(200u64, 0x55u64, 1u8));
	def region = FailingRegion.new(tc.data[0 ..+ tc.data.length]);
	def reopened = MultiTxnWal.new(tc.regionStart, tc.logAddr, 1024u64, region, false);
	region.failNextPersistChanges = true;
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.PERSIST_FAILED);
	tc.t.assert_eq(0x55u8, tc.data[200]);
	tc.t.assert_eq(0u64, reopened.durableAppliedSeq);
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.REPLAYED);
	tc.t.assert_eq(1u64, reopened.durableAppliedSeq);
}

// The no-prefix path also publishes an epoch bump to abandon valid records
// after a sequence gap. Failure of that superblock persist must not be reported
// as an ordinary clean mount.
def test_multi_gap_abandon_persist_failure_reported(tc: MultiTxnWalTester) {
	tc.writeTxn(200u64, 0x11u64, 1u8);
	tc.writeTxn(201u64, 0x22u64, 1u8);
	tc.corruptChecksumAt(0u64);                    // seq 2 survives after a gap
	def region = FailingRegion.new(tc.data[0 ..+ tc.data.length]);
	def reopened = MultiTxnWal.new(tc.regionStart, tc.logAddr, 1024u64, region, false);
	region.failNextPersistRange = true;
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.PERSIST_FAILED);
	tc.t.assert_eq(1u64, reopened.logEpoch);       // failed publication was not adopted
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.CLEAN);
	tc.t.assert_eq(2u64, reopened.logEpoch);
	tc.t.assert_eq(0u8, tc.data[201]);
}

def test_multi_contiguous_prefix_only(tc: MultiTxnWalTester) {
	tc.writeTxn(200u64, 0x11u64, 1u8);
	def secondOffset = tc.wal.headOffset;
	tc.writeTxn(201u64, 0x22u64, 1u8);
	tc.corruptChecksumAt(0u64);
	var reopened = tc.reopen();
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.CLEAN);
	tc.t.assert_eq(0u8, tc.data[200]);
	tc.t.assert_eq(0u8, tc.data[201]);
	tc.t.assertz(true, secondOffset > 0u64);
}

// Epoch-stale rejection: a record whose checksum is valid and whose txnSeq is
// past durableAppliedSeq must still be ignored once its epoch no longer matches
// the current WAL incarnation. This isolates the `recordEpoch != logEpoch` guard
// from the `txnSeq <= durableAppliedSeq` guard.
def test_multi_epoch_stale_rejected(tc: MultiTxnWalTester) {
	// Two epoch-1 records. Corrupt the first so seq 2 becomes a stray valid
	// record sitting after a sequence gap.
	tc.writeTxn(200u64, 0x11u64, 1u8);              // seq 1 at ring offset 0
	def strayOffset = tc.wal.headOffset;            // where seq 2 will land
	tc.writeTxn(201u64, 0x22u64, 1u8);              // seq 2
	tc.corruptChecksumAt(0u64);

	// First recovery finds no contiguous prefix (seq 1 invalid) but sees the
	// stray seq 2, so it abandons it by bumping the epoch and republishing.
	var r1 = tc.reopen();
	tc.t.assertz(true, r1.recover() == MultiWalRecovery.CLEAN);

	// Reopen reads the persisted, freshly bumped epoch. The stray seq 2 record
	// is still physically present, still checksum-valid, and its txnSeq (2) is
	// still greater than durableAppliedSeq (0) -- so the ONLY thing that can
	// reject it now is the epoch mismatch.
	var r2 = tc.reopen();
	tc.t.assert_eq(2u64, r2.logEpoch);              // bumped from the original 1
	tc.t.assert_eq(0u64, r2.durableAppliedSeq);     // nothing was ever committed durably
	tc.t.assertz(true, r2.recover() == MultiWalRecovery.CLEAN); // stray epoch-1 record rejected
	tc.t.assert_eq(0u8, tc.data[201]);              // and never applied
	tc.t.assertz(true, strayOffset > 0u64);
}

// Wrap-around / log-full -> checkpoint -> reserve: fill the small ring until a
// commit cannot fit, forcing reserveRecord to lazily checkpoint the applied
// tail, reclaim now-durable records, and retry the reservation at the wrapped
// (offset 0) slot. Every commit must still succeed and the ring must wrap.
def test_multi_wraparound_checkpoint_reserve(tc: MultiTxnWalTester) {
	// ringBytes = 1024 - 2*64 = 896; a 1-entry record is align64(64+48+32) = 192,
	// so 4 records fit and the 5th must wrap. Bound the loop well above that.
	def maxRecords = 64;
	var prevHead = 0u64;
	var wrapped = false;
	var committed = 0;
	for (i < maxRecords) {
		prevHead = tc.wal.headOffset;
		def seq = tc.writeAndApply(200u64, u64.view(i), 1u8);
		// The overflowing commit must still succeed: reserveRecord checkpoints
		// the applied tail and retries rather than dropping the transaction.
		tc.t.assertz(true, seq != 0u64);
		committed++;
		if (tc.wal.headOffset <= prevHead) {        // head moved backwards => wrapped
			wrapped = true;
			break;
		}
	}
	tc.t.assertz(true, wrapped);                        // the ring wrapped at least once
	tc.t.assertz(true, committed > 1);                  // wrap happened after several records
	tc.t.assertz(true, tc.wal.durableAppliedSeq > 0u64);// the lazy checkpoint advanced durability
	tc.t.assertz(true, tc.wal.appliedSeqVolatile >= tc.wal.durableAppliedSeq);
	// After reclaim the ring no longer tracks every record ever written -- only
	// the post-checkpoint tail remains active.
	tc.t.assertz(true, tc.wal.activeRecords.length < committed);
}

// Multi-record recovery: a run of committed transactions must all be replayed
// in order on remount, with durableAppliedSeq advanced to the last one.
def test_multi_recovers_multiple_records(tc: MultiTxnWalTester) {
	tc.t.assert_eq(1u64, tc.writeTxn(200u64, 0x11u64, 1u8));
	tc.t.assert_eq(2u64, tc.writeTxn(201u64, 0x22u64, 1u8));
	tc.t.assert_eq(3u64, tc.writeTxn(202u64, 0x33u64, 1u8));

	var reopened = tc.reopen();
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.REPLAYED);
	tc.t.assert_eq(0x11u8, tc.data[200]);
	tc.t.assert_eq(0x22u8, tc.data[201]);
	tc.t.assert_eq(0x33u8, tc.data[202]);
	tc.t.assert_eq(3u64, reopened.durableAppliedSeq);
	tc.t.assert_eq(3u64, reopened.appliedSeqVolatile);
}

// Crash mid-log: a crash during the final commit leaves its record only
// partially durable (its checksum never settled). Recovery must replay the
// contiguous committed prefix and stop at the torn tail -- the partial record
// and anything after it are not applied.
def test_multi_crash_mid_log_recovery(tc: MultiTxnWalTester) {
	tc.writeTxn(200u64, 0x11u64, 1u8);              // seq 1 at ring offset 0
	tc.writeTxn(201u64, 0x22u64, 1u8);              // seq 2
	def tornOffset = tc.wal.headOffset;             // where seq 3 lands
	tc.writeTxn(202u64, 0x33u64, 1u8);              // seq 3 -- the torn tail

	// Model the interrupted commit: the final record is unreadable because its
	// checksum never reached durability.
	tc.corruptChecksumAt(tornOffset);

	var reopened = tc.reopen();
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.REPLAYED); // committed prefix still replays
	tc.t.assert_eq(0x11u8, tc.data[200]);           // seq 1 applied
	tc.t.assert_eq(0x22u8, tc.data[201]);           // seq 2 applied
	tc.t.assert_eq(0u8, tc.data[202]);              // torn seq 3 NOT applied
	tc.t.assert_eq(2u64, reopened.durableAppliedSeq);
	tc.t.assertz(true, tornOffset > 0u64);
}

// Recover -> commit -> crash -> recover: recovery bumps the epoch exactly once,
// and the in-memory epoch must match what the superblock published. Records
// committed after a recovery are stamped with that epoch; if the copies ever
// disagree, a crash before the next checkpoint silently loses those commits on
// the following mount.
def test_multi_commit_after_recovery_survives(tc: MultiTxnWalTester) {
	tc.t.assert_eq(1u64, tc.writeTxn(200u64, 0x55u64, 1u8));

	// First crash + recovery: replays seq 1 and publishes epoch 2.
	var recovered = tc.reopen();
	tc.t.assertz(true, recovered.recover() == MultiWalRecovery.REPLAYED);
	tc.t.assert_eq(2u64, recovered.logEpoch);       // in-memory epoch == published epoch

	// Commit seq 2 on the recovered WAL, then crash again before any checkpoint.
	recovered.append(210u64, 0x66u64, 1u8);
	tc.t.assert_eq(2u64, recovered.commit());

	// Second recovery must replay the post-recovery commit, not reject it as
	// stale-epoch.
	var reopened = tc.reopen();
	tc.t.assert_eq(2u64, reopened.logEpoch);
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.REPLAYED);
	tc.t.assert_eq(0x66u8, tc.data[210]);
	tc.t.assert_eq(2u64, reopened.durableAppliedSeq);
}

// Failed commit point: when the record's persistRange fails, the fully-written
// record must be scrubbed and the head rolled back, so a retried commit reuses
// both the same txnSeq (a skipped seq would gap the committed prefix and
// abandon later acked commits) and the same ring slot. Otherwise two valid
// records with the same sequence can coexist and recovery may replay the
// failed attempt's contents instead of the acknowledged retry's.
def test_multi_failed_persist_no_duplicate(tc: MultiTxnWalTester) {
	def data = Array<byte>.new(4096);
	for (i < data.length) data[i] = 0u8;
	def base = u64.view(Pointer.atElement(data, 0));
	def log = base + 1024u64;
	def region = FailingRegion.new(data[0 ..+ data.length]);
	def wal = MultiTxnWal.new(base, log, 1024u64, region, true);

	wal.append(200u64, 0x55u64, 1u8);
	tc.t.assert_eq(1u64, wal.commit());             // seq 1 committed normally
	def headBefore = wal.headOffset;                // where seq 2 will land

	// Commit seq 2 with a failing commit point.
	region.failNextPersistRange = true;
	wal.append(210u64, 0x11u64, 1u8);
	tc.t.assert_eq(0u64, wal.commit());
	tc.t.assert_eq(2u64, wal.nextTxnSeq);           // seq NOT burned
	tc.t.assert_eq(headBefore, wal.headOffset);     // head rolled back to the slot
	// The failed record's header magic is scrubbed -- it can never validate.
	tc.t.assert_eq(0u64, PWRegionUtils.pointerFromU64(wal.ringBase + headBefore).load<u64>());

	// Retry with different contents, as RegionTransaction does when its dirty
	// cache accumulated more writes between the failure and the retry.
	wal.append(210u64, 0x22u64, 1u8);
	wal.append(211u64, 0x33u64, 1u8);
	tc.t.assert_eq(2u64, wal.commit());
	// The retry overwrote the failed attempt's slot -- same seq, one location.
	tc.t.assertz(true, wal.headOffset > headBefore);

	// Crash + recover: only the acknowledged retry's contents are replayed.
	def reopened = MultiTxnWal.new(base, log, 1024u64, region, false);
	tc.t.assertz(true, reopened.recover() == MultiWalRecovery.REPLAYED);
	tc.t.assert_eq(0x55u8, data[200]);              // seq 1
	tc.t.assert_eq(0x22u8, data[210]);              // retry's value, not 0x11
	tc.t.assert_eq(0x33u8, data[211]);              // retry's extra entry
	tc.t.assert_eq(2u64, reopened.durableAppliedSeq);
}

// Per-backend threshold wiring: configureCheckpointPolicy() must map each
// CheckpointCost class to its constants (free->aggressive, expensive->lazy).
def test_multi_checkpoint_policy_thresholds(tc: MultiTxnWalTester) {
	def data = Array<byte>.new(4096);
	for (i < data.length) data[i] = 0u8;
	def base = u64.view(Pointer.atElement(data, 0));
	def log = base + 1024u64;

	def freeWal = MultiTxnWal.new(base, log, 1024u64, CostRegion.new(data[0 ..+ data.length], CheckpointCost.FREE), true);
	tc.t.assert_eq(MultiTxnWalConstants.CHECKPOINT_TXN_FREE, freeWal.checkpointTxnThreshold);
	tc.t.assert_eq(MultiTxnWalConstants.CHECKPOINT_FILL_FREE, freeWal.checkpointFillPercent);

	def cheapWal = MultiTxnWal.new(base, log, 1024u64, CostRegion.new(data[0 ..+ data.length], CheckpointCost.CHEAP), false);
	tc.t.assert_eq(MultiTxnWalConstants.CHECKPOINT_TXN_CHEAP, cheapWal.checkpointTxnThreshold);
	tc.t.assert_eq(MultiTxnWalConstants.CHECKPOINT_FILL_CHEAP, cheapWal.checkpointFillPercent);

	def expWal = MultiTxnWal.new(base, log, 1024u64, CostRegion.new(data[0 ..+ data.length], CheckpointCost.EXPENSIVE), false);
	tc.t.assert_eq(MultiTxnWalConstants.CHECKPOINT_TXN_EXPENSIVE, expWal.checkpointTxnThreshold);
	tc.t.assert_eq(MultiTxnWalConstants.CHECKPOINT_FILL_EXPENSIVE, expWal.checkpointFillPercent);
}

// Count-cap path: on a FREE backend (txn threshold 1) a single applied commit
// is enough for maybeCheckpoint() to publish durability and reclaim the record,
// well below the occupancy watermark.
def test_multi_maybe_checkpoint_count(tc: MultiTxnWalTester) {
	def data = Array<byte>.new(4096);
	for (i < data.length) data[i] = 0u8;
	def base = u64.view(Pointer.atElement(data, 0));
	def log = base + 1024u64;
	def wal = MultiTxnWal.new(base, log, 1024u64, CostRegion.new(data[0 ..+ data.length], CheckpointCost.FREE), true);

	wal.append(200u64, 0x55u64, 1u8);
	def seq = wal.commit();
	tc.t.assert_eq(1u64, seq);
	wal.noteApplied(seq);
	tc.t.assertz(true, wal.maybeCheckpoint());
	tc.t.assert_eq(1u64, wal.durableAppliedSeq);    // count cap (threshold 1) fired
	tc.t.assert_eq(0, wal.activeRecords.length);     // record reclaimed
	tc.t.assert_eq(0u64, wal.activeBytes);
}

// Occupancy-watermark path: on an EXPENSIVE backend the count cap is 64 (never
// reached here) but the 50% fill watermark fires. ringBytes = 896, each 1-entry
// record is 192 B, so the watermark (448 B) is crossed at the third record.
def test_multi_maybe_checkpoint_occupancy(tc: MultiTxnWalTester) {
	tc.writeAndApply(200u64, 0x11u64, 1u8);
	tc.t.assertz(true, tc.wal.maybeCheckpoint());
	tc.t.assert_eq(0u64, tc.wal.durableAppliedSeq);  // 192 B < 448 B watermark

	tc.writeAndApply(201u64, 0x22u64, 1u8);
	tc.t.assertz(true, tc.wal.maybeCheckpoint());
	tc.t.assert_eq(0u64, tc.wal.durableAppliedSeq);  // 384 B < 448 B watermark

	tc.writeAndApply(202u64, 0x33u64, 1u8);
	tc.t.assertz(true, tc.wal.maybeCheckpoint());
	tc.t.assert_eq(3u64, tc.wal.durableAppliedSeq);  // 576 B >= 448 B -> checkpoint
	tc.t.assert_eq(0, tc.wal.activeRecords.length);
	tc.t.assert_eq(0u64, tc.wal.activeBytes);
}
