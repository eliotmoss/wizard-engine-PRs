// RegionTransaction Tests
// Tests cached transactional writes and the encapsulated redo-log commit flow.

def T = UnitTests.registerT("wal_cache:", _, RegionTransactionTester.new, _);
def X = [
	T("basic_u8_flow", test_basic_u8_flow),
	T("basic_u64_flow", test_basic_u64_flow),
	T("read_fallthrough", test_read_fallthrough),
	T("commit_applies_and_clears", test_commit_applies_and_clears),
	T("commit_uses_persistence_api", test_commit_uses_persistence_api),
	T("next_commit_persists_previous_data", test_next_commit_persists_previous_data),
	T("flush_completes_durability", test_flush_completes_durability),
	T("commit_clean_noop", test_commit_clean_noop),
	T("commit_overflow_returns_false", test_commit_overflow_returns_false),
	T("commit_overflow_then_success", test_commit_overflow_then_success),
	T("overwrite_update", test_overwrite_update),
	T("is_dirty_check", test_is_dirty_check),
	T("misaligned_access", test_misaligned_access),
	()
];

class CountingBackend extends TxnRegionBackend {
	def range: Range<byte>;
	def var prepareChangedRangeCount = 0;
	def var persistRangeCount = 0;
	def var persistChangesCount = 0;
	def var lastDirtyOffset: u64 = 0;
	def var lastDirtySize: u64 = 0;

	new(range) { }

	def create(size: u64, prot: int, fresh: bool) -> BackendRegion {
		return CountingRegion.new(range, this);
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "counting";
	}
}

class CountingRegion extends BackendRegion {
	def counter: CountingBackend;

	new(range: Range<byte>, counter: CountingBackend) super(range) { }

	def destroy() { }

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		counter.prepareChangedRangeCount++;
		counter.lastDirtyOffset = offset;
		counter.lastDirtySize = size;
		return true;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		counter.persistRangeCount++;
		return true;
	}

	def persistChanges() -> bool {
		counter.persistChangesCount++;
		return true;
	}
}

class RegionTransactionTester(t: Tester) {
	var txn: RegionTransaction;
	var wal: DualTxnWal;
	var backend: CountingBackend;
	var backendRegion: BackendRegion;
	// Backing memory for the pointers to test read-through and write-back
	var dummyData: Array<byte>;

	new() {
		dummyData = Array<byte>.new(4096);
		// Initialize memory with a known pattern (0xAA) to detect changes/fallthroughs
		for (i < dummyData.length) dummyData[i] = 0xAAu8;
		def regionStart = u64.view(Pointer.atElement(dummyData, 0));
		backend = CountingBackend.new(dummyData[0 ..+ dummyData.length]);
		backendRegion = backend.create(u64.!(dummyData.length), BackendProt.READ.mask | BackendProt.WRITE.mask, true);
		wal = DualTxnWal.new(regionStart, regionStart + 1024u64, 1024u64, backendRegion, true);
		txn = RegionTransaction.new(wal, regionStart);
		backend.prepareChangedRangeCount = 0;
		backend.persistRangeCount = 0;
		backend.persistChangesCount = 0;
	}

	def getAddr(offset: int) -> u64 {
		return u64.view(Pointer.atElement(dummyData, offset));
	}

	// Helper to read actual RAM (bypassing cache) to verify write-behind behavior
	def readRamU8(offset: int) -> u8 {
		return dummyData[offset];
	}

	def readRamU64(offset: int) -> u64 {
		return Pointer.atElement(dummyData, offset).load<u64>();
	}

	// The first transaction gets txnSeq 1, which parity-maps to slot 1.
	def recordHeader() -> Ref<TxnRecordHeader> {
		return wal.recordHeaderAt(wal.slotAddr(1));
	}

	def logEntry(index: u32) -> Ref<LogEntry> {
		def addr = wal.slotAddr(1) + u64.!(TxnRecordHeader.size) + u64.view(index) * u64.!(LogEntry.size);
		return wal.logEntryAt(addr);
	}
}

// Test 1: Basic Write and Read flow for U8
// Verifies that writing to cache allows reading from cache, but does not immediately touch RAM.
def test_basic_u8_flow(tc: RegionTransactionTester) {
	var addr = tc.getAddr(0);
	var val = 0x11u8;

	// 1. Write to cache
	tc.txn.writeU8(addr, val);

	// 2. Read back (should come from cache)
	var readVal = tc.txn.readU8(addr);
	tc.t.assert_eq(val, readVal);

	// 3. Verify RAM is NOT updated yet (Write-Behind)
	tc.t.assert_eq(0xAAu8, tc.readRamU8(0));
}

// Test 2: Basic Write and Read flow for U64
def test_basic_u64_flow(tc: RegionTransactionTester) {
	var addr = tc.getAddr(8);
	var val = 0xDEAD_BEEF_CAFE_BABE_u64;

	tc.txn.writeU64(addr, val);
	
	var readVal = tc.txn.readU64(addr);
	tc.t.assert_eq(val, readVal);
}

// Test 3: Cache Miss (Fallthrough to Memory)
// If the address is not in the cache, it should load the value currently in RAM.
def test_read_fallthrough(tc: RegionTransactionTester) {
	var addr = tc.getAddr(16);
	
	// We haven't written to the cache for 'addr'.
	// RAM was initialized to 0xAA in setup.
	
	var val = tc.txn.readU8(addr);
	
	// Should return value from memory, not 0 or null
	tc.t.assert_eq(0xAAu8, val);
	tc.t.assertz(false, tc.txn.isDirty());
}

// Test 4: Commit writes a durable WAL record, then applies cached data and clears only the cache.
def test_commit_applies_and_clears(tc: RegionTransactionTester) {
	var addr = tc.getAddr(200);
	var val = 0x0102_0304_0506_0708u64;

	tc.txn.writeU64(addr, val);
	tc.t.assertz(true, tc.txn.isDirty());
	tc.t.assert_eq(0xAAu8, tc.readRamU8(200));
	tc.txn.commit();

	var entry = tc.logEntry(0u32);
	tc.t.assert_eq(addr - tc.wal.regionStart, entry.offset);
	tc.t.assert_eq(val, entry.value);
	tc.t.assert_eq(8u8, entry.width);
	tc.t.assert_eq(1u32, tc.recordHeader().entryCount);
	tc.t.assert_eq(1u64, tc.wal.slotSeqs[1]);
	tc.t.assert_eq(1u64, tc.wal.lastCommittedSeq);
	tc.t.assert_eq(0u64, tc.wal.dataDurableSeq);	// phase B: data persist deferred to the next boundary
	tc.t.assert_eq(val, tc.readRamU64(200));
	tc.t.assertz(false, tc.txn.isDirty());
}

// Test 5: WAL commit uses one persistence boundary (phase B): the record is
// prepared and persisted via persistChanges (no per-record persistRange), and
// the applied data is only prepared -- its persist rides the next boundary.
def test_commit_uses_persistence_api(tc: RegionTransactionTester) {
	var addr = tc.getAddr(200);
	var val = 0x0102_0304_0506_0708u64;

	tc.txn.writeU64(addr, val);
	tc.txn.commit();

	tc.t.assert_eq(0, tc.backend.persistRangeCount);
	tc.t.assert_eq(2, tc.backend.prepareChangedRangeCount);	// record + applied data
	tc.t.assert_eq(1, tc.backend.persistChangesCount);
	tc.t.assert_eq(addr - tc.wal.regionStart, tc.backend.lastDirtyOffset);
	tc.t.assert_eq(8u64, tc.backend.lastDirtySize);
}

// Test 5b: the piggybacked boundary -- the next commit's single boundary
// completes durability for the previous transaction's applied data.
def test_next_commit_persists_previous_data(tc: RegionTransactionTester) {
	tc.txn.writeU64(tc.getAddr(200), 0x11u64);
	tc.txn.commit();
	tc.t.assert_eq(0u64, tc.wal.dataDurableSeq);

	tc.txn.writeU64(tc.getAddr(208), 0x22u64);
	tc.txn.commit();
	tc.t.assert_eq(2, tc.backend.persistChangesCount);	// still one boundary per commit
	tc.t.assert_eq(1u64, tc.wal.dataDurableSeq);		// record 2 durable => txn 1 data durable
	tc.t.assert_eq(2u64, tc.wal.lastCommittedSeq);
}

// Test 5c: flush() is the explicit idle/unmount boundary for the data whose
// persist was deferred past the last commit.
def test_flush_completes_durability(tc: RegionTransactionTester) {
	tc.txn.writeU64(tc.getAddr(200), 0x11u64);
	tc.txn.commit();
	tc.t.assert_eq(0u64, tc.wal.dataDurableSeq);

	tc.t.assertz(true, tc.txn.flush());
	tc.t.assert_eq(2, tc.backend.persistChangesCount);	// commit boundary + flush
	tc.t.assert_eq(1u64, tc.wal.dataDurableSeq);
}

// Test 6: Committing a clean transaction is a no-op.
def test_commit_clean_noop(tc: RegionTransactionTester) {
	var addr = tc.getAddr(20);
	tc.t.assertz(false, tc.txn.isDirty());
	tc.txn.commit();
	tc.t.assertz(false, tc.txn.isDirty());
	tc.t.assert_eq(0xAAu8, tc.readRamU8(20));
	tc.t.assert_eq(0xAAu8, tc.txn.readU8(addr));
}

// Test 7: Overwriting updates the cache entry
def test_overwrite_update(tc: RegionTransactionTester) {
	var addr = tc.getAddr(16);

	tc.txn.writeU64(addr, 100u64);
	tc.t.assert_eq(100u64, tc.txn.readU64(addr));

	tc.txn.writeU64(addr, 200u64);
	tc.t.assert_eq(200u64, tc.txn.readU64(addr));
}

// Test 8: Verifying the isDirty check
def test_is_dirty_check(tc: RegionTransactionTester) {
	var addr = tc.getAddr(32);

	tc.t.assertz(false, tc.txn.isDirty());

	tc.txn.writeI16(addr, 123i16);
	tc.t.assertz(true, tc.txn.isDirty());
}

// Test 9: Aligned/Spatial Access Constraints
def test_misaligned_access(tc: RegionTransactionTester) {
	var baseAddr = tc.getAddr(60);
	var offsetAddr = tc.getAddr(61);

	var val = 0x0102030405060708u64;

	// Write 8 bytes to baseAddr
	tc.txn.writeU64(baseAddr, val);

	// Verify we can read the u64 back
	tc.t.assert_eq(val, tc.txn.readU64(baseAddr));

	// Try to read u8 at baseAddr + 1. 
	// Since the cache maps (u64 addr) -> Entry, and (baseAddr) != (offsetAddr),
	// this should be a cache miss and fall through to memory (0xAA).
	// It should NOT return 0x07 (the 2nd byte of the u64).
	
	var byteVal = tc.txn.readU8(offsetAddr);

	tc.t.assert_eq(0xAAu8, byteVal);
}

// Test 10: A transaction whose buffered writes cannot fit in a record slot
// (25 u64 entries -> 960 B record > 448 B slotBytes) must fail commit(),
// leaving the cache dirty and the buffered values still readable.
def test_commit_overflow_returns_false(tc: RegionTransactionTester) {
	for (i < 25) {
		tc.txn.writeU64(tc.getAddr(2048 + i * 8), u64.view(i));
	}
	tc.t.assertz(true, tc.txn.isDirty());
	tc.t.assertz(false, tc.txn.commit());
	tc.t.assertz(true, tc.txn.isDirty());
	tc.t.assert_eq(7u64, tc.txn.readU64(tc.getAddr(2048 + 7 * 8)));
	tc.t.assert_eq(0u64, tc.wal.lastCommittedSeq);
	tc.t.assert_eq(0u64, tc.wal.slotSeqs[0]);
	tc.t.assert_eq(0u64, tc.wal.slotSeqs[1]);
}

// Test 11: A failed commit must not wedge the shared WAL: the oversized-record
// check short-circuits before any slot is touched, so no sequence was burned.
// A second, independent transaction on the same WAL must still commit
// normally afterward.
def test_commit_overflow_then_success(tc: RegionTransactionTester) {
	for (i < 25) {
		tc.txn.writeU64(tc.getAddr(2048 + i * 8), u64.view(i));
	}
	tc.t.assertz(false, tc.txn.commit());
	tc.t.assertz(true, tc.txn.isDirty());

	var txn2 = RegionTransaction.new(tc.wal, tc.wal.regionStart);
	txn2.writeU64(tc.getAddr(3000), 0x99u64);
	tc.t.assertz(true, txn2.commit());
	tc.t.assert_eq(1u64, tc.wal.lastCommittedSeq);
	tc.t.assertz(false, txn2.isDirty());
}
