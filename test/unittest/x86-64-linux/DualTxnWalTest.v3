// DualTxnWal Tests
// Tests the two-slot persistent redo log and its recovery flow (phase B:
// piggybacked persistence boundary, one boundary per commit in steady state).
//
// Geometry used throughout: blockSize=1024 -> slotBytes = (1024 - 64) / 2
// aligned down to 64 = 448. Slot 0 is at logAddr+64, slot 1 at logAddr+512.
// txnSeq parity selects the slot: odd sequences land in slot 1, even in slot 0.

def DWT = UnitTests.registerT("dual_wal:", _, DualTxnWalTester.new, _);
def DWTX = [
	DWT("fresh_header", test_dual_fresh_header),
	DWT("empty_commit_returns_seq", test_dual_empty_commit_returns_seq),
	DWT("commit_alternates_slots", test_dual_commit_alternates_slots),
	DWT("commit_crash_recover", test_dual_commit_crash_recover),
	DWT("clean_empty_recover", test_dual_clean_empty_recover),
	DWT("torn_record_rejected", test_dual_torn_record_rejected),
	DWT("two_slots_replay_in_order", test_dual_two_slots_replay_in_order),
	DWT("replay_latest_two_after_overwrite", test_dual_replay_latest_two_after_overwrite),
	DWT("oversize_commit_fails", test_dual_oversize_commit_fails),
	DWT("poisoned_append_fails_commit", test_dual_poisoned_append_fails_commit),
	DWT("unrecovered_slot_blocks_overwrite", test_dual_unrecovered_slot_blocks_overwrite),
	DWT("failed_persist_requires_reopen", test_dual_failed_persist_requires_reopen),
	DWT("recovery_persist_failure_requires_reopen", test_dual_recovery_persist_failure_requires_reopen),
	DWT("corrupt_header_reports_corrupt", test_dual_corrupt_header_reports_corrupt),
	DWT("apply_then_crash_recover", test_dual_apply_then_crash_recover),
	DWT("back_to_back_commits_then_crash", test_dual_back_to_back_commits_then_crash),
	DWT("one_boundary_per_commit", test_dual_one_boundary_per_commit),
	DWT("flush_persists_applied_data", test_dual_flush_persists_applied_data),
	DWT("flush_failure_requires_reopen", test_dual_flush_failure_requires_reopen),
	DWT("close_scrubs_for_clean_remount", test_dual_close_scrubs_for_clean_remount),
	DWT("close_data_persist_failure_requires_reopen", test_dual_close_data_persist_failure_requires_reopen),
	DWT("close_keeps_unrecovered_records", test_dual_close_keeps_unrecovered_records),
	DWT("shadow_crash_restores_durable_bytes", test_shadow_crash_restores_durable_bytes),
	DWT("shadow_copy_then_fail_is_durable", test_shadow_copy_then_fail_is_durable),
	DWT("shadow_partial_copy_then_fail", test_shadow_partial_copy_then_fail),
	DWT("failed_prepare_then_crash_is_clean", test_dual_failed_prepare_then_crash_is_clean),
	DWT("failed_persist_before_copy_then_crash_is_clean", test_dual_failed_persist_before_copy_then_crash_is_clean),
	DWT("indeterminate_persist_record_replays", test_dual_indeterminate_persist_record_replays),
	DWT("partial_record_persist_then_crash_is_rejected", test_dual_partial_record_persist_then_crash_is_rejected),
	()
];

// One-shot outcome for a shadow persistence operation. COPY_THEN_FAIL models
// an indeterminate syscall result: the requested bytes reached the durable
// image even though the caller receives false. PARTIAL_COPY_THEN_FAIL models a
// torn write by copying the first half of each requested range.
enum ShadowPersistOutcome {
	SUCCESS,
	FAIL_BEFORE_COPY,
	COPY_THEN_FAIL,
	PARTIAL_COPY_THEN_FAIL
}

// Test-only executable model of BackendRegion durability. Pointer writes made
// by the WAL mutate {range}, the live image. Persistence operations explicitly
// copy live bytes into {durable}; crash() discards every unpersisted write by
// restoring the live image from that durable shadow.
class ShadowDurableRegion extends BackendRegion {
	var durable: Array<byte>;
	var pendingOffsets = Vector<u64>.new();
	var pendingSizes = Vector<u64>.new();
	var prepareChangedRangeCount = 0;
	var persistRangeCount = 0;
	var persistChangesCount = 0;
	var failNextPrepareChangedRange = false;
	var nextPersistRangeOutcome = ShadowPersistOutcome.SUCCESS;
	var nextPersistChangesOutcome = ShadowPersistOutcome.SUCCESS;

	new(range: Range<byte>) super(range) {
		durable = Array<byte>.new(range.length);
		for (i < durable.length) durable[i] = range[i];
	}

	def destroy() { }

	def validRange(offset: u64, size: u64) -> bool {
		def regionSize = u64.!(range.length);
		return offset <= regionSize && size <= regionSize - offset;
	}

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		prepareChangedRangeCount++;
		if (!validRange(offset, size)) return false;
		if (failNextPrepareChangedRange) {
			failNextPrepareChangedRange = false;
			return false;
		}
		if (size != 0u64) {
			pendingOffsets.put(offset);
			pendingSizes.put(size);
		}
		return true;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		persistRangeCount++;
		if (!validRange(offset, size)) return false;
		def outcome = nextPersistRangeOutcome;
		nextPersistRangeOutcome = ShadowPersistOutcome.SUCCESS;
		match (outcome) {
			SUCCESS => {
				copyLiveRange(offset, size);
				return true;
			}
			FAIL_BEFORE_COPY => return false;
			COPY_THEN_FAIL => {
				copyLiveRange(offset, size);
				return false;
			}
			PARTIAL_COPY_THEN_FAIL => {
				copyLiveRange(offset, partialSize(size));
				return false;
			}
		}
	}

	def persistChanges() -> bool {
		persistChangesCount++;
		def outcome = nextPersistChangesOutcome;
		nextPersistChangesOutcome = ShadowPersistOutcome.SUCCESS;
		match (outcome) {
			SUCCESS => {
				copyPreparedRanges(false);
				clearPreparedRanges();
				return true;
			}
			FAIL_BEFORE_COPY => return false;
			COPY_THEN_FAIL => {
				copyPreparedRanges(false);
				return false;
			}
			PARTIAL_COPY_THEN_FAIL => {
				copyPreparedRanges(true);
				return false;
			}
		}
	}

	// Restore exactly the bytes that survived persistence and discard all
	// process-local range preparation and one-shot fault state.
	def crash() {
		for (i < durable.length) range[i] = durable[i];
		clearPreparedRanges();
		failNextPrepareChangedRange = false;
		nextPersistRangeOutcome = ShadowPersistOutcome.SUCCESS;
		nextPersistChangesOutcome = ShadowPersistOutcome.SUCCESS;
	}

	private def clearPreparedRanges() {
		pendingOffsets.clear();
		pendingSizes.clear();
	}

	private def copyPreparedRanges(partial: bool) {
		for (i < pendingOffsets.length) {
			def size = pendingSizes[i];
			copyLiveRange(pendingOffsets[i], if(partial, partialSize(size), size));
		}
	}

	private def copyLiveRange(offset: u64, size: u64) {
		def start = int.!(offset);
		def length = int.!(size);
		for (i < length) durable[start + i] = range[start + i];
	}

	private def partialSize(size: u64) -> u64 {
		if (size <= 1u64) return size;
		return size / 2u64;
	}
}

// A region that counts persistence-API calls, to pin down the boundary count
// per commit and the piggybacked-durability induction property.
class DualWalCountingRegion extends BackendRegion {
	var prepareChangedRangeCount = 0;
	var persistRangeCount = 0;
	var persistChangesCount = 0;

	new(range: Range<byte>) super(range) { }

	def destroy() { }

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		prepareChangedRangeCount++;
		return true;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		persistRangeCount++;
		return true;
	}

	def persistChanges() -> bool {
		persistChangesCount++;
		return true;
	}
}

class DualTxnWalTester(t: Tester) {
	var data: Array<byte>;
	var backendRegion: BackendRegion;
	var shadowRegion: ShadowDurableRegion;
	var wal: DualTxnWal;
	var regionStart: u64;
	var logAddr: u64;

	new() {
		data = Array<byte>.new(4096);
		for (i < data.length) data[i] = 0u8;
		regionStart = u64.view(Pointer.atElement(data, 0));
		logAddr = regionStart + 1024u64;
		shadowRegion = ShadowDurableRegion.new(data[0 ..+ data.length]);
		backendRegion = shadowRegion;
		wal = DualTxnWal.new(regionStart, logAddr, 1024u64, backendRegion, true);
	}

	def reopen() -> DualTxnWal {
		return DualTxnWal.new(regionStart, logAddr, 1024u64, backendRegion, false);
	}

	def crashAndReopen() -> DualTxnWal {
		shadowRegion.crash();
		return reopen();
	}

	// Commit one transaction without applying it, modelling a crash between
	// the commit point and the data apply.
	def writeTxn(offset: u64, value: u64, width: u8) -> u64 {
		wal.append(offset, value, width);
		return wal.commit();
	}

	// The full per-transaction cycle as RegionTransaction drives it: commit,
	// then apply the after-images (whose persist rides the next boundary).
	def commitAndApply(offset: u64, value: u64, width: u8) -> u64 {
		wal.append(offset, value, width);
		def seq = wal.commit();
		wal.applyUpdate(offset, value, width);
		return seq;
	}

	def corruptChecksumOfSlot(slot: int) -> u64 {
		def recordAddr = wal.slotAddr(slot);
		def entryCount = PWRegionUtils.pointerFromU64(recordAddr + u64.view(TxnRecordHeader.entryCount.offset)).load<u32>();
		def addr = recordAddr + u64.!(TxnRecordHeader.size) + u64.view(entryCount) * u64.!(LogEntry.size) + u64.view(TxnCommitTrailer.checksum.offset);
		def old = PWRegionUtils.pointerFromU64(addr).load<u64>();
		PWRegionUtils.pointerFromU64(addr).store<u64>(old + 1u64);
		return addr;
	}
}

// Fresh initialization: a valid header, computed slot geometry, empty slots.
def test_dual_fresh_header(tc: DualTxnWalTester) {
	tc.t.assertz(true, tc.wal.openOk);
	tc.t.assertz(true, tc.wal.validateHeader());
	tc.t.assert_eq(448u64, tc.wal.slotBytes);
	tc.t.assert_eq(1u64, tc.wal.nextTxnSeq);
	tc.t.assert_eq(0u64, tc.wal.slotSeqs[0]);
	tc.t.assert_eq(0u64, tc.wal.slotSeqs[1]);
	tc.t.assert_eq(0u64, tc.wal.validateSlot(0));
	tc.t.assert_eq(0u64, tc.wal.validateSlot(1));
}

// An empty transaction commits as an entryCount=0 record: a successful commit
// always returns a nonzero sequence, so the 0 failure sentinel is unambiguous
// (MultiTxnWal returned durableAppliedSeq here, colliding with 0 when fresh).
def test_dual_empty_commit_returns_seq(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.wal.commit());
	tc.t.assert_eq(2u64, tc.wal.nextTxnSeq);
	tc.t.assert_eq(1u64, tc.wal.slotSeqs[1]);
}

// Sequence parity alternates the slots; the third commit overwrites slot 1
// after earlier boundaries have piggybacked the destroyed record's data.
def test_dual_commit_alternates_slots(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.commitAndApply(200u64, 0x11u64, 1u8));
	tc.t.assert_eq(1u64, tc.wal.slotSeqs[1]);
	tc.t.assert_eq(2u64, tc.commitAndApply(201u64, 0x22u64, 1u8));
	tc.t.assert_eq(2u64, tc.wal.slotSeqs[0]);
	tc.t.assert_eq(3u64, tc.commitAndApply(202u64, 0x33u64, 1u8));
	tc.t.assert_eq(3u64, tc.wal.slotSeqs[1]);
	tc.t.assert_eq(2u64, tc.wal.slotSeqs[0]);
	tc.t.assert_eq(3u64, tc.wal.lastCommittedSeq);
	tc.t.assert_eq(2u64, tc.wal.dataDurableSeq);	// seq 3's boundary covered through seq 2
}

// Commit -> crash -> recover: the committed record replays its after-images.
def test_dual_commit_crash_recover(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.writeTxn(200u64, 0x55u64, 1u8));
	tc.t.assert_eq(0u8, tc.data[200]);	// crashed before apply
	var reopened = tc.crashAndReopen();
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(0x55u8, tc.data[200]);
	tc.t.assert_eq(1u64, reopened.dataDurableSeq);
	tc.t.assert_eq(2u64, reopened.nextTxnSeq);
	tc.shadowRegion.crash();
	tc.t.assert_eq(0x55u8, tc.data[200]);	// recovery persisted the replay
}

// Remounting a WAL that never committed anything is clean.
def test_dual_clean_empty_recover(tc: DualTxnWalTester) {
	var reopened = tc.reopen();
	tc.t.assertz(true, reopened.openOk);
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.CLEAN);
	tc.t.assert_eq(1u64, reopened.nextTxnSeq);
}

// A torn record (checksum never settled) is rejected: nothing replays and the
// sequence restarts.
def test_dual_torn_record_rejected(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.writeTxn(200u64, 0x55u64, 1u8));
	def checksumAddr = tc.corruptChecksumOfSlot(1);
	tc.t.assertz(true, tc.shadowRegion.persistRange(checksumAddr - tc.regionStart, 8u64));
	var reopened = tc.crashAndReopen();
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.CLEAN);
	tc.t.assert_eq(0u8, tc.data[200]);
	tc.t.assert_eq(1u64, reopened.nextTxnSeq);
}

// Two valid slots replay in ascending txnSeq order: the later record's
// after-image for a shared offset must win.
def test_dual_two_slots_replay_in_order(tc: DualTxnWalTester) {
	tc.wal.append(200u64, 0x11u64, 1u8);
	tc.wal.append(201u64, 0xAAu64, 1u8);
	tc.t.assert_eq(1u64, tc.wal.commit());
	tc.wal.applyUpdate(200u64, 0x11u64, 1u8);
	tc.wal.applyUpdate(201u64, 0xAAu64, 1u8);
	tc.t.assert_eq(2u64, tc.commitAndApply(200u64, 0x22u64, 1u8));

	var reopened = tc.crashAndReopen();
	tc.t.assert_eq(0x11u8, tc.data[200]);	// seq 1 data rode seq 2's boundary
	tc.t.assert_eq(0xAAu8, tc.data[201]);
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(0x22u8, tc.data[200]);	// seq 2 replayed after seq 1
	tc.t.assert_eq(0xAAu8, tc.data[201]);	// seq 1's other entry survived
	tc.t.assert_eq(2u64, reopened.dataDurableSeq);
	tc.t.assert_eq(3u64, reopened.nextTxnSeq);
}

// After a slot is overwritten, recovery replays exactly the latest two
// transactions; the destroyed record's data was made durable by a later
// commit's piggybacked boundary before it was destroyed.
def test_dual_replay_latest_two_after_overwrite(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.commitAndApply(202u64, 0x33u64, 1u8));
	tc.t.assert_eq(2u64, tc.commitAndApply(200u64, 0x11u64, 1u8));
	tc.t.assert_eq(3u64, tc.commitAndApply(201u64, 0x22u64, 1u8));	// overwrites seq 1's slot

	var reopened = tc.crashAndReopen();
	tc.t.assert_eq(0x33u8, tc.data[202]);	// seq 1 record gone, data durable
	tc.t.assert_eq(0x11u8, tc.data[200]);	// seq 2 data rode seq 3's boundary
	tc.t.assert_eq(0u8, tc.data[201]);	// seq 3 after-image still pending
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(0x11u8, tc.data[200]);
	tc.t.assert_eq(0x22u8, tc.data[201]);
	tc.t.assert_eq(0x33u8, tc.data[202]);
	tc.t.assert_eq(3u64, reopened.dataDurableSeq);
	tc.t.assert_eq(4u64, reopened.nextTxnSeq);
}

// A record too large for a slot fails commit() cleanly: no sequence burned,
// and the WAL stays usable for the next transaction.
def test_dual_oversize_commit_fails(tc: DualTxnWalTester) {
	for (i < 25) {
		tc.wal.append(u64.view(2048 + i * 8), u64.view(i), 8u8);
	}
	tc.t.assert_eq(0u64, tc.wal.commit());	// 960 B record > 448 B slot
	tc.t.assertz(false, tc.wal.requiresRecovery());
	tc.t.assert_eq(1u64, tc.wal.nextTxnSeq);
	tc.t.assert_eq(0u64, tc.wal.slotSeqs[1]);
	tc.t.assert_eq(1u64, tc.writeTxn(200u64, 0x55u64, 1u8));
}

// An invalid append poisons the pending transaction: commit() must fail
// rather than durably committing a transaction that silently lost a write.
// The poison clears with the failed commit, so the next transaction works.
def test_dual_poisoned_append_fails_commit(tc: DualTxnWalTester) {
	tc.t.assertz(true, tc.wal.append(200u64, 0x11u64, 1u8));
	tc.t.assertz(false, tc.wal.append(201u64, 0x22u64, 3u8));	// invalid width
	tc.t.assertz(true, tc.wal.poisoned);
	tc.t.assert_eq(0u64, tc.wal.commit());
	tc.t.assertz(false, tc.wal.poisoned);
	tc.t.assertz(false, tc.wal.requiresRecovery());
	tc.t.assert_eq(1u64, tc.wal.nextTxnSeq);
	tc.t.assert_eq(1u64, tc.writeTxn(200u64, 0x33u64, 1u8));
}

// Mounting without recovery scans the slots for the sequence but leaves the
// records unrecovered: the overwrite guard must refuse to destroy them until
// recover() has replayed and persisted their data.
def test_dual_unrecovered_slot_blocks_overwrite(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.commitAndApply(200u64, 0x11u64, 1u8));
	tc.t.assert_eq(2u64, tc.commitAndApply(201u64, 0x22u64, 1u8));

	var reopened = tc.crashAndReopen();
	tc.t.assert_eq(3u64, reopened.nextTxnSeq);	// scanned from the slots
	reopened.append(202u64, 0x33u64, 1u8);
	tc.t.assert_eq(0u64, reopened.commit());	// slot 1 holds unrecovered seq 1
	tc.t.assertz(false, reopened.requiresRecovery());	// no backend failure

	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	reopened.append(202u64, 0x33u64, 1u8);
	tc.t.assert_eq(3u64, reopened.commit());
	tc.t.assert_eq(3u64, reopened.slotSeqs[1]);
}

// A persistence failure in the commit overwrite guard latches this WAL
// instance. Every mutating or persistence operation is rejected without
// reaching the backend; only a new instance may recover and resume.
def test_dual_failed_persist_requires_reopen(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.commitAndApply(200u64, 0x55u64, 1u8));
	tc.t.assert_eq(2u64, tc.commitAndApply(201u64, 0x66u64, 1u8));

	// Reopen without recovery. Committing seq 3 would overwrite the only
	// unrecovered copy of seq 1, so the guard first attempts a data persist.
	var failed = tc.crashAndReopen();
	tc.shadowRegion.nextPersistChangesOutcome = ShadowPersistOutcome.FAIL_BEFORE_COPY;
	tc.t.assertz(true, failed.append(210u64, 0x11u64, 1u8));
	tc.t.assert_eq(0u64, failed.commit());
	tc.t.assertz(true, failed.requiresRecovery());
	tc.t.assert_eq(3u64, failed.nextTxnSeq);		// sequence not burned

	def prepareCount = tc.shadowRegion.prepareChangedRangeCount;
	def persistRangeCount = tc.shadowRegion.persistRangeCount;
	def persistChangesCount = tc.shadowRegion.persistChangesCount;

	tc.t.assertz(false, failed.append(210u64, 0x22u64, 1u8));
	tc.t.assert_eq(0u64, failed.commit());
	failed.applyUpdate(300u64, 0x77u64, 1u8);
	tc.t.assert_eq(0u8, tc.data[300]);
	tc.t.assertz(false, failed.persistAppliedData());
	tc.t.assertz(true, failed.recover() == DualWalRecovery.PERSIST_FAILED);
	failed.close();

	// None of the rejected operations may prepare or persist more bytes.
	tc.t.assert_eq(prepareCount, tc.shadowRegion.prepareChangedRangeCount);
	tc.t.assert_eq(persistRangeCount, tc.shadowRegion.persistRangeCount);
	tc.t.assert_eq(persistChangesCount, tc.shadowRegion.persistChangesCount);

	// A fresh instance resolves the durable state, then accepts new work.
	tc.shadowRegion.crash();
	var reopened = tc.reopen();
	tc.t.assertz(false, reopened.requiresRecovery());
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(0x55u8, tc.data[200]);
	tc.t.assert_eq(0x66u8, tc.data[201]);
	tc.t.assertz(true, reopened.append(210u64, 0x33u64, 1u8));
	tc.t.assert_eq(3u64, reopened.commit());
}

// A failure while persisting replayed after-images is indeterminate: the
// current WAL instance must latch recovery-required and reject further work.
// A newly constructed instance can inspect the durable slots and replay again.
def test_dual_recovery_persist_failure_requires_reopen(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.writeTxn(200u64, 0x5Au64, 1u8));

	var failed = tc.crashAndReopen();
	tc.shadowRegion.nextPersistChangesOutcome = ShadowPersistOutcome.FAIL_BEFORE_COPY;
	tc.t.assertz(true, failed.recover() == DualWalRecovery.PERSIST_FAILED);
	tc.t.assertz(true, failed.requiresRecovery());
	tc.t.assert_eq(1u64, failed.slotSeqs[1]);
	tc.t.assert_eq(1u64, failed.lastCommittedSeq);
	tc.t.assert_eq(2u64, failed.nextTxnSeq);
	tc.t.assert_eq(0u64, failed.dataDurableSeq);

	def prepareCount = tc.shadowRegion.prepareChangedRangeCount;
	def persistRangeCount = tc.shadowRegion.persistRangeCount;
	def persistChangesCount = tc.shadowRegion.persistChangesCount;

	tc.t.assertz(false, failed.append(201u64, 0x66u64, 1u8));
	tc.t.assert_eq(0u64, failed.commit());
	failed.applyUpdate(300u64, 0x77u64, 1u8);
	tc.t.assert_eq(0u8, tc.data[300]);
	tc.t.assertz(false, failed.persistAppliedData());
	tc.t.assertz(true, failed.recover() == DualWalRecovery.PERSIST_FAILED);
	failed.close();

	// Rejected operations must not issue another persistence request.
	tc.t.assert_eq(prepareCount, tc.shadowRegion.prepareChangedRangeCount);
	tc.t.assert_eq(persistRangeCount, tc.shadowRegion.persistRangeCount);
	tc.t.assert_eq(persistChangesCount, tc.shadowRegion.persistChangesCount);

	// The failed replay was not durable. A fresh instance replays the retained
	// record again, persists it successfully, and makes it survive another crash.
	tc.shadowRegion.crash();
	tc.t.assert_eq(0u8, tc.data[200]);
	var reopened = tc.reopen();
	tc.t.assertz(false, reopened.requiresRecovery());
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(0x5Au8, tc.data[200]);
	tc.t.assert_eq(1u64, reopened.dataDurableSeq);
	tc.t.assert_eq(2u64, reopened.nextTxnSeq);
	tc.shadowRegion.crash();
	tc.t.assert_eq(0x5Au8, tc.data[200]);
}

// A corrupt WAL header makes the log unusable, and recover() reports it as
// CORRUPT rather than conflating it with a clean mount.
def test_dual_corrupt_header_reports_corrupt(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.writeTxn(200u64, 0x55u64, 1u8));
	PWRegionUtils.pointerFromU64(tc.logAddr).store<u64>(0u64);	// scrub header magic
	tc.t.assertz(true, tc.shadowRegion.persistRange(tc.logAddr - tc.regionStart, 8u64));

	var reopened = tc.crashAndReopen();
	tc.t.assertz(false, reopened.openOk);
	tc.t.assertz(false, reopened.requiresRecovery());
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.CORRUPT);
	tc.t.assert_eq(0u8, tc.data[200]);	// nothing replayed
	tc.t.assert_eq(0u64, reopened.commit());	// and nothing can commit
}

// Phase B: crash after the record is applied but before the next commit's
// boundary persisted the data. The record is still valid, so recovery re-runs
// the (idempotent) after-images and completes durability.
def test_dual_apply_then_crash_recover(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.commitAndApply(200u64, 0x77u64, 1u8));
	tc.t.assert_eq(0x77u8, tc.data[200]);		// applied...
	tc.t.assert_eq(0u64, tc.wal.dataDurableSeq);	// ...but its persist is deferred

	var reopened = tc.crashAndReopen();
	tc.t.assert_eq(0u8, tc.data[200]);		// unpersisted after-image disappeared
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(0x77u8, tc.data[200]);		// durable record restored it
	tc.t.assert_eq(1u64, reopened.dataDurableSeq);
	tc.t.assert_eq(2u64, reopened.nextTxnSeq);
	tc.shadowRegion.crash();
	tc.t.assert_eq(0x77u8, tc.data[200]);		// recovery made it durable
}

// Phase B: back-to-back full transaction cycles, then a crash. The two
// surviving records replay; every transaction's data is intact because each
// destroyed record's data had already ridden a later commit's boundary.
def test_dual_back_to_back_commits_then_crash(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.commitAndApply(200u64, 0x11u64, 1u8));
	tc.t.assert_eq(2u64, tc.commitAndApply(201u64, 0x22u64, 1u8));
	tc.t.assert_eq(3u64, tc.commitAndApply(202u64, 0x33u64, 1u8));
	tc.t.assert_eq(3u64, tc.wal.lastCommittedSeq);
	tc.t.assert_eq(2u64, tc.wal.dataDurableSeq);	// seq 3's data awaits the next boundary

	var reopened = tc.crashAndReopen();
	tc.t.assert_eq(0x11u8, tc.data[200]);		// persisted by seq 2 boundary
	tc.t.assert_eq(0x22u8, tc.data[201]);		// persisted by seq 3 boundary
	tc.t.assert_eq(0u8, tc.data[202]);		// seq 3 data was still pending
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(0x11u8, tc.data[200]);
	tc.t.assert_eq(0x22u8, tc.data[201]);
	tc.t.assert_eq(0x33u8, tc.data[202]);
	tc.t.assert_eq(3u64, reopened.dataDurableSeq);
	tc.t.assert_eq(4u64, reopened.nextTxnSeq);
}

// Phase B boundary count and the induction property: each commit issues
// exactly one persistChanges (no per-record persistRange), and a durable
// record N+1 implies txn N's data is durable (dataDurableSeq == N).
def test_dual_one_boundary_per_commit(tc: DualTxnWalTester) {
	def data = Array<byte>.new(4096);
	for (i < data.length) data[i] = 0u8;
	def base = u64.view(Pointer.atElement(data, 0));
	def region = DualWalCountingRegion.new(data[0 ..+ data.length]);
	def wal = DualTxnWal.new(base, base + 1024u64, 1024u64, region, true);
	region.prepareChangedRangeCount = 0;
	region.persistRangeCount = 0;
	region.persistChangesCount = 0;

	for (n < 3u64) {
		def seq = n + 1u64;
		wal.append(200u64 + seq, seq, 1u8);
		tc.t.assert_eq(seq, wal.commit());
		wal.applyUpdate(200u64 + seq, seq, 1u8);
		tc.t.assert_eq(int.!(seq), region.persistChangesCount);	// one boundary per commit
		tc.t.assert_eq(0, region.persistRangeCount);		// record rode persistChanges
		tc.t.assert_eq(seq - 1u64, wal.dataDurableSeq);		// record N durable => txn N-1 data durable
	}
	// Each commit prepares the record plus the txn's single applied entry.
	tc.t.assert_eq(6, region.prepareChangedRangeCount);
}

// persistAppliedData() is the explicit idle/unmount boundary: it completes
// durability for applied data without requiring another commit.
def test_dual_flush_persists_applied_data(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.commitAndApply(200u64, 0x44u64, 1u8));
	tc.t.assert_eq(0u64, tc.wal.dataDurableSeq);
	tc.t.assertz(true, tc.wal.persistAppliedData());
	tc.t.assert_eq(1u64, tc.wal.dataDurableSeq);
	var reopened = tc.crashAndReopen();
	tc.t.assert_eq(0x44u8, tc.data[200]);		// explicit flush survived crash
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	tc.wal = reopened;
	// The slot is now reclaimable: seq 3 overwrites it without a guard retry.
	tc.t.assert_eq(2u64, tc.commitAndApply(201u64, 0x55u64, 1u8));
	tc.t.assert_eq(3u64, tc.commitAndApply(202u64, 0x66u64, 1u8));
}

// An explicit flush failure leaves the persistence outcome uncertain. The
// current instance must reject all further work; after a crash, a new instance
// replays the retained record and makes the after-image durable.
def test_dual_flush_failure_requires_reopen(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.commitAndApply(200u64, 0x45u64, 1u8));
	tc.shadowRegion.nextPersistChangesOutcome = ShadowPersistOutcome.FAIL_BEFORE_COPY;
	tc.t.assertz(false, tc.wal.persistAppliedData());
	tc.t.assertz(true, tc.wal.requiresRecovery());
	tc.t.assert_eq(0u64, tc.wal.dataDurableSeq);
	tc.t.assert_eq(1u64, tc.wal.slotSeqs[1]);

	def prepareCount = tc.shadowRegion.prepareChangedRangeCount;
	def persistChangesCount = tc.shadowRegion.persistChangesCount;
	tc.t.assertz(false, tc.wal.persistAppliedData());
	tc.t.assertz(false, tc.wal.append(201u64, 0x46u64, 1u8));
	tc.t.assert_eq(0u64, tc.wal.commit());
	tc.t.assert_eq(prepareCount, tc.shadowRegion.prepareChangedRangeCount);
	tc.t.assert_eq(persistChangesCount, tc.shadowRegion.persistChangesCount);

	var reopened = tc.crashAndReopen();
	tc.t.assert_eq(0u8, tc.data[200]);
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(0x45u8, tc.data[200]);
	tc.t.assert_eq(1u64, reopened.dataDurableSeq);
	tc.shadowRegion.crash();
	tc.t.assert_eq(0x45u8, tc.data[200]);
}

// A clean close() persists the deferred data and scrubs the reclaimable
// slots, so a clean remount is replay-free (CLEAN, sequence restarts).
def test_dual_close_scrubs_for_clean_remount(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.commitAndApply(200u64, 0x11u64, 1u8));
	tc.t.assert_eq(2u64, tc.commitAndApply(201u64, 0x22u64, 1u8));
	tc.wal.close();
	tc.t.assert_eq(0u64, tc.wal.slotSeqs[0]);
	tc.t.assert_eq(0u64, tc.wal.slotSeqs[1]);

	var reopened = tc.crashAndReopen();
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.CLEAN);
	tc.t.assert_eq(1u64, reopened.nextTxnSeq);
	tc.t.assert_eq(0x11u8, tc.data[200]);	// data persisted by close()
	tc.t.assert_eq(0x22u8, tc.data[201]);
}

// close() uses the same final-data persistence boundary as explicit flush. If
// it fails, close must retain the record, latch recovery-required, and perform
// no slot scrubbing so a new instance can replay after a crash.
def test_dual_close_data_persist_failure_requires_reopen(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.commitAndApply(200u64, 0x77u64, 1u8));
	tc.shadowRegion.nextPersistChangesOutcome = ShadowPersistOutcome.FAIL_BEFORE_COPY;
	tc.wal.close();
	tc.t.assertz(true, tc.wal.requiresRecovery());
	tc.t.assert_eq(0u64, tc.wal.dataDurableSeq);
	tc.t.assert_eq(1u64, tc.wal.slotSeqs[1]);

	def persistRangeCount = tc.shadowRegion.persistRangeCount;
	def persistChangesCount = tc.shadowRegion.persistChangesCount;
	tc.wal.close();
	tc.t.assert_eq(persistRangeCount, tc.shadowRegion.persistRangeCount);
	tc.t.assert_eq(persistChangesCount, tc.shadowRegion.persistChangesCount);

	var reopened = tc.crashAndReopen();
	tc.t.assert_eq(0u8, tc.data[200]);
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(0x77u8, tc.data[200]);
	tc.t.assert_eq(1u64, reopened.dataDurableSeq);
	tc.shadowRegion.crash();
	tc.t.assert_eq(0x77u8, tc.data[200]);
}

// close() must never scrub a slot whose data is not known durable: records
// scanned by a mount that skipped recover() survive close and still replay.
def test_dual_close_keeps_unrecovered_records(tc: DualTxnWalTester) {
	tc.t.assert_eq(1u64, tc.writeTxn(200u64, 0x99u64, 1u8));	// committed, never applied

	var reopened = tc.crashAndReopen();	// scans the durable slot but does not recover
	reopened.close();
	tc.t.assert_eq(1u64, reopened.slotSeqs[1]);	// record retained

	tc.shadowRegion.crash();
	var again = tc.reopen();
	tc.t.assertz(true, again.recover() == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(0x99u8, tc.data[200]);
}

// The shadow distinguishes process-visible writes from durable bytes:
// unpersisted stores disappear, while a prepared + persisted store survives.
def test_shadow_crash_restores_durable_bytes(tc: DualTxnWalTester) {
	tc.data[200] = 0x11u8;
	tc.shadowRegion.crash();
	tc.t.assert_eq(0u8, tc.data[200]);

	tc.data[200] = 0x22u8;
	tc.t.assertz(true, tc.shadowRegion.prepareChangedRange(200u64, 1u64));
	tc.t.assertz(true, tc.shadowRegion.persistChanges());
	tc.data[200] = 0x33u8;	// live-only overwrite
	tc.shadowRegion.crash();
	tc.t.assert_eq(0x22u8, tc.data[200]);
}

// A persistence call can copy every requested byte and still report failure.
// The crash must reveal those bytes, making the outcome observably
// indeterminate rather than equivalent to FAIL_BEFORE_COPY.
def test_shadow_copy_then_fail_is_durable(tc: DualTxnWalTester) {
	tc.data[200] = 0x44u8;
	tc.t.assertz(true, tc.shadowRegion.prepareChangedRange(200u64, 1u64));
	tc.shadowRegion.nextPersistChangesOutcome = ShadowPersistOutcome.COPY_THEN_FAIL;
	tc.t.assertz(false, tc.shadowRegion.persistChanges());
	tc.data[200] = 0x55u8;	// discardable live mutation after the failed call
	tc.shadowRegion.crash();
	tc.t.assert_eq(0x44u8, tc.data[200]);
}

// The partial outcome copies the first half of each prepared range and loses
// the rest at crash, providing a deterministic torn-write model.
def test_shadow_partial_copy_then_fail(tc: DualTxnWalTester) {
	for (i < 8) tc.data[300 + i] = u8.!(i + 1);
	tc.t.assertz(true, tc.shadowRegion.prepareChangedRange(300u64, 8u64));
	tc.shadowRegion.nextPersistChangesOutcome = ShadowPersistOutcome.PARTIAL_COPY_THEN_FAIL;
	tc.t.assertz(false, tc.shadowRegion.persistChanges());
	tc.shadowRegion.crash();
	for (i < 4) tc.t.assert_eq(u8.!(i + 1), tc.data[300 + i]);
	for (i < 4) tc.t.assert_eq(0u8, tc.data[304 + i]);
}

// Failure while preparing the record means the later persistence boundary was
// never entered. Restoring the durable image removes the complete live record.
def test_dual_failed_prepare_then_crash_is_clean(tc: DualTxnWalTester) {
	tc.shadowRegion.failNextPrepareChangedRange = true;
	tc.wal.append(200u64, 0x66u64, 1u8);
	tc.t.assert_eq(0u64, tc.wal.commit());
	tc.t.assertz(true, tc.wal.requiresRecovery());

	var reopened = tc.crashAndReopen();
	tc.t.assertz(false, reopened.requiresRecovery());
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.CLEAN);
	tc.t.assert_eq(0u8, tc.data[200]);
	tc.t.assert_eq(1u64, reopened.nextTxnSeq);
}

// A definite fail-before-copy outcome leaves no durable record, so immediate
// crash/reopen must not replay the attempted transaction.
def test_dual_failed_persist_before_copy_then_crash_is_clean(tc: DualTxnWalTester) {
	tc.shadowRegion.nextPersistChangesOutcome = ShadowPersistOutcome.FAIL_BEFORE_COPY;
	tc.wal.append(200u64, 0x77u64, 1u8);
	tc.t.assert_eq(0u64, tc.wal.commit());
	tc.t.assertz(true, tc.wal.requiresRecovery());

	var reopened = tc.crashAndReopen();
	tc.t.assertz(false, reopened.requiresRecovery());
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.CLEAN);
	tc.t.assert_eq(0u8, tc.data[200]);
	tc.t.assert_eq(1u64, reopened.nextTxnSeq);
}

// Normative recovery-required contract: persistChanges copied the complete
// record but reported failure, so commit() returned 0 (unacknowledged, not
// aborted). After a crash, recovery may replay the valid durable record because
// its after-images are idempotent.
def test_dual_indeterminate_persist_record_replays(tc: DualTxnWalTester) {
	tc.shadowRegion.nextPersistChangesOutcome = ShadowPersistOutcome.COPY_THEN_FAIL;
	tc.wal.append(200u64, 0x99u64, 1u8);
	tc.t.assert_eq(0u64, tc.wal.commit());
	tc.t.assertz(true, tc.wal.requiresRecovery());
	tc.t.assertz(false, tc.wal.append(201u64, 0xAAu64, 1u8));

	var reopened = tc.crashAndReopen();
	tc.t.assertz(false, reopened.requiresRecovery());
	tc.t.assert_eq(0u8, tc.data[200]);
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(0x99u8, tc.data[200]);
	tc.t.assert_eq(2u64, reopened.nextTxnSeq);
	tc.t.assertz(true, reopened.append(201u64, 0xAAu64, 1u8));
	tc.t.assert_eq(2u64, reopened.commit());
}

// A partially persisted record has no matching complete trailer/checksum.
// Recovery must reject it rather than publish the failed transaction.
def test_dual_partial_record_persist_then_crash_is_rejected(tc: DualTxnWalTester) {
	tc.shadowRegion.nextPersistChangesOutcome = ShadowPersistOutcome.PARTIAL_COPY_THEN_FAIL;
	tc.wal.append(200u64, 0x88u64, 1u8);
	tc.t.assert_eq(0u64, tc.wal.commit());
	tc.t.assertz(true, tc.wal.requiresRecovery());

	var reopened = tc.crashAndReopen();
	tc.t.assertz(false, reopened.requiresRecovery());
	tc.t.assertz(true, reopened.recover() == DualWalRecovery.CLEAN);
	tc.t.assert_eq(0u8, tc.data[200]);
	tc.t.assert_eq(1u64, reopened.nextTxnSeq);
	tc.t.assertz(true, reopened.append(201u64, 0x44u64, 1u8));
	tc.t.assert_eq(1u64, reopened.commit());
}
