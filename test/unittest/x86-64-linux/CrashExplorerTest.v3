// Schedule-enumeration tests (second slice of milestone 4 in
// docs/pmem-crash-model.md). These pin which durable images a crash at one cut
// can produce, that equivalent schedules deduplicate to one state, that a
// budget is reported rather than silently applied, that the reduced search
// agrees with the full one at every cut, and that its line classes give exactly
// the distinct images the per-line prefix vectors give.

def PET = UnitTests.registerT("crash_explorer:", _, CrashExplorerTester.new, _);
def PETX = [
	PET("single_store_has_two_images", test_explore_single_store_has_two_images),
	PET("fence_forces_one_image", test_explore_fence_forces_one_image),
	PET("independent_lines_multiply", test_explore_independent_lines_multiply),
	PET("torn_prefixes_enumerated", test_explore_torn_prefixes_enumerated),
	PET("fence_floor_limits_later_stores", test_explore_fence_floor_limits_later_stores),
	PET("brackets_lazy_and_eager", test_explore_brackets_lazy_and_eager),
	PET("reduction_agrees_with_full_search", test_explore_reduction_agrees_with_full_search),
	PET("budget_truncates_and_reports", test_explore_budget_truncates_and_reports),
	PET("real_wal_images_at_boundaries", test_explore_real_wal_images_at_boundaries),
	PET("property_holds_over_every_image", test_explore_property_holds_over_every_image),
	PET("property_failure_becomes_counterexample", test_explore_property_failure_becomes_counterexample),
	PET("all_cuts_reports_earliest_failure", test_explore_all_cuts_reports_earliest_failure),
	PET("truncated_search_is_not_evidence", test_explore_truncated_search_is_not_evidence),
	PET("cut_range_checks_only_its_cuts", test_explore_cut_range_checks_only_its_cuts),
	PET("line_classes_equal_distinct_images", test_explore_line_classes_equal_distinct_images),
	PET("over_budget_selection_takes_extremes_then_seeded_random", test_explore_over_budget_selection_takes_extremes_then_seeded_random),
	()
];

// A set of durable images compared byte for byte. The bucket key is a hash of
// the bytes of {lines}, the trace's touched lines: a function of the image, so
// equal images share a bucket, and cheaper than digest() over the region,
// since the images of one cut differ only there.
class CrashExplorerImageSet(lines: Array<u64>) {
	def buckets = HashMap<u64, Vector<CrashImage>>.new(imageSetKey, u64.==);
	var count = 0;

	def length() -> int {
		return count;
	}

	def contains(image: CrashImage) -> bool {
		def bucket = buckets[key(image)];
		if (bucket == null) return false;
		for (i < bucket.length) if (bucket[i].sameBytes(image)) return true;
		return false;
	}

	// True when {image} was not already present.
	def add(image: CrashImage) -> bool {
		def k = key(image);
		var bucket = buckets[k];
		if (bucket == null) {
			bucket = Vector<CrashImage>.new();
			buckets[k] = bucket;
		}
		for (i < bucket.length) if (bucket[i].sameBytes(image)) return false;
		bucket.put(image);
		count++;
		return true;
	}

	private def key(image: CrashImage) -> u64 {
		def bytes = image.bytes;
		var h = 0x9E37_79B9_7F4A_7C15_u64;
		for (line in lines) {
			var end = int.!(line) + int.!(CacheLines.CACHE_LINE_SIZE);
			if (end > bytes.length) end = bytes.length;
			for (j = int.!(line); j < end; j++) {
				def r = (h << 7) | (h >> 57);
				h = (r ^ u64.view(bytes[j])) * 0x1000_0000_01B3_u64;
			}
		}
		return h;
	}
}

def imageSetKey(key: u64) -> int {
	return i32.view(key ^ (key >> 32));
}

class CrashExplorerTester(t: Tester) {
	def A = 0x1111_2222_3333_4444_u64;
	def B = 0x5555_6666_7777_8888_u64;
	def C = 0x9999_AAAA_BBBB_CCCC_u64;
	// A budget no test trace reaches, so a search under it is complete.
	def EXHAUSTIVE = 1 << 30;

	def store(seq: u64, offset: u64, width: u8, value: u64) -> PersistenceEvent {
		return PersistenceEvent(seq, PersistenceEventKind.STORE, offset, width, value);
	}

	def clwb(seq: u64, cacheLine: u64) -> PersistenceEvent {
		return PersistenceEvent(seq, PersistenceEventKind.CLWB, cacheLine, 0u8, 0u64);
	}

	def fence(seq: u64) -> PersistenceEvent {
		return PersistenceEvent(seq, PersistenceEventKind.SFENCE, 0u64, 0u8, 0u64);
	}

	def trace(name: string, events: Array<PersistenceEvent>) -> PersistenceTrace {
		def result = PersistenceTrace.new(name, 256u64, events);
		def check = result.validate();
		if (!check.ok()) {
			t.fail(check.render(StringBuilder.new().puts("test trace is not modelable: ")).toString());
		}
		return result;
	}

	def explore(tr: PersistenceTrace, cut: int) -> CrashExploration {
		return CrashExplorer.crashImages(tr, null, cut, 0);
	}

	def reduced(tr: PersistenceTrace, cut: int) -> CrashExploration {
		return CrashExplorer.reducedCrashImages(tr, null, cut, 0);
	}

	// Same set of durable images, regardless of the order they were found in.
	// Both searches keep each image once, byte for byte, so equal counts and
	// containment make the sets equal.
	def assertSameImages(expected: CrashExploration, got: CrashExploration) {
		t.asserti(expected.imageCount(), got.imageCount());
		for (i < expected.images.length) t.assertz(true, got.containsImage(expected.images[i]));
	}

	// The traces the reduction is checked on, ending with one whose stores
	// often rewrite the bytes a line already holds.
	def reductionTraces() -> Array<PersistenceTrace> {
		return [
			trace("r_one_line", [
				store(1u64, 0u64, 8u8, A),
				store(2u64, 8u64, 8u8, B),
				clwb(3u64, 0u64),
				fence(4u64),
				store(5u64, 16u64, 8u8, C)
			]),
			trace("r_two_lines", [
				store(1u64, 0u64, 8u8, A),
				store(2u64, 64u64, 8u8, B),
				clwb(3u64, 64u64),
				fence(4u64),
				store(5u64, 72u64, 4u8, 0x2222_3333_u64),
				clwb(6u64, 0u64),
				fence(7u64)
			]),
			trace("r_overwrite", [
				store(1u64, 32u64, 8u8, A),
				store(2u64, 32u64, 8u8, B),
				clwb(3u64, 0u64),
				fence(4u64)
			]),
			repeatsTrace()
		];
	}

	// Every small trace this file's tests explore, as they define them.
	def smallTraces() -> Array<PersistenceTrace> {
		def others = [
			trace("one_store", [store(1u64, 8u64, 8u8, A)]),
			trace("fenced", [store(1u64, 8u64, 8u8, A), clwb(2u64, 0u64), fence(3u64)]),
			trace("two_lines", [store(1u64, 0u64, 8u8, A), store(2u64, 128u64, 8u8, B)]),
			trace("one_line_three_stores", [
				store(1u64, 0u64, 8u8, A),
				store(2u64, 8u64, 8u8, B),
				store(3u64, 16u64, 8u8, C)
			]),
			trace("floor", [
				store(1u64, 0u64, 8u8, A),
				clwb(2u64, 0u64),
				fence(3u64),
				store(4u64, 8u64, 8u8, B)
			]),
			trace("mixed", [
				store(1u64, 0u64, 8u8, A),
				clwb(2u64, 0u64),
				store(3u64, 128u64, 4u8, 0x1234_5678_u64),
				fence(4u64),
				store(5u64, 8u64, 2u8, 0xABCDu64)
			]),
			trace("budgeted", [
				store(1u64, 0u64, 8u8, A),
				store(2u64, 8u64, 8u8, B),
				store(3u64, 64u64, 8u8, C),
				store(4u64, 128u64, 8u8, A)
			]),
			trace("late_failure", [
				store(1u64, 64u64, 8u8, B),
				store(2u64, 0u64, 8u8, A),
				clwb(3u64, 0u64),
				fence(4u64)
			]),
			trace("ordered", [store(1u64, 0u64, 8u8, A), store(2u64, 8u64, 8u8, B)]),
			trace("unflushed", [store(1u64, 0u64, 8u8, A)]),
			trace("budgeted_check", [
				store(1u64, 0u64, 8u8, A),
				store(2u64, 8u64, 8u8, B),
				store(3u64, 64u64, 8u8, C)
			])
		];
		return Arrays.concat(others, reductionTraces());
	}

	// Stores that rewrite a line's bytes: a zero over zero, a value stored,
	// cleared and stored again, a fenced value rewritten, and a line whose only
	// store changes nothing. Most of its prefix vectors repeat an image.
	def repeatsTrace() -> PersistenceTrace {
		return trace("repeats", [
			store(1u64, 0u64, 8u8, 0u64),
			store(2u64, 8u64, 8u8, A),
			store(3u64, 8u64, 8u8, 0u64),
			store(4u64, 8u64, 8u8, A),
			store(5u64, 64u64, 8u8, B),
			clwb(6u64, 64u64),
			fence(7u64),
			store(8u64, 64u64, 8u8, B),
			store(9u64, 72u64, 4u8, 0x1234_5678_u64),
			store(10u64, 128u64, 2u8, 0u64)
		]);
	}

	// The reduced search as it stood until 2026-10-19, kept as the reference
	// for the line classes: an odometer over every per-line prefix length from
	// the fence-forced floor to the line's last store, least significant line
	// first, each image read from the machine and kept once, byte for byte.
	// The old search restore()d the machine at every vector; this one restores
	// only when a line wraps back to its floor and otherwise completes the
	// lowest line's next store with writebackAt(), the machine's own forward
	// transition, which reaches the same state. Returns the distinct images and
	// the number of prefix vectors.
	def prefixOdometer(tr: PersistenceTrace, initial: Array<byte>,
		cut: int) -> (CrashExplorerImageSet, int) {

		def m = CrashModel.new(tr, initial);
		m.runTo(cut);
		def floor = m.snapshot();
		def lines = m.lineCount();
		def counts = Arrays.dup(floor.durableCounts);
		def limits = Array<int>.new(lines);
		for (i < lines) limits[i] = m.storesInLine(i);
		def distinct = CrashExplorerImageSet.new(tr.touchedLines());
		var states = 0;
		var more = true;
		while (more) {
			states++;
			distinct.add(m.crash());
			more = false;
			for (i < lines) {
				if (counts[i] < limits[i]) {
					counts[i]++;
					more = true;
					if (i == 0) m.writebackAt(0, counts[0]);
					else m.restore(CrashModelState.new(floor.pos, Arrays.dup(counts), floor.requiredCounts));
					break;
				}
				counts[i] = floor.durableCounts[i];
			}
		}
		return (distinct, states);
	}

	// The line classes at {cut} against the old odometer: the same image set,
	// byte for byte; a count equal to its number of distinct images; its number
	// of prefix vectors as {product}; the lazy image first. Each line's classes
	// are also rebuilt with the machine, that line drained to each of its
	// prefixes and every other line at its floor: the distinct contents in
	// order of first appearance, each at its least prefix. Returns the old
	// odometer's prefix vectors and distinct images.
	def assertClassesMatchOdometer(tr: PersistenceTrace, initial: Array<byte>, cut: int) -> (int, int) {
		def got = CrashExplorer.reducedCrashImages(tr, initial, cut, EXHAUSTIVE);
		def expected = prefixOdometer(tr, initial, cut);
		def old = expected.0, states = expected.1;
		t.assertz(false, got.truncated);
		t.asserti(old.length(), got.imageCount());
		t.asserti(got.imageCount(), got.statesVisited);
		t.assert_eq(long.!(old.length()), got.classProduct);
		t.assert_eq(long.!(states), got.product);
		def mine = CrashExplorerImageSet.new(tr.touchedLines());
		for (i < got.images.length) {
			t.assertz(true, old.contains(got.images[i]));
			t.assertz(true, mine.add(got.images[i]));
		}
		def lazy = CrashImages.lazyCrash(tr, initial, cut);
		t.assertz(true, got.imageCount() > 0 && got.images[0].sameBytes(lazy));

		def classes = CrashExplorer.lineClasses(tr, initial, cut);
		def m = CrashModel.new(tr, initial);
		m.runTo(cut);
		def floor = m.snapshot();
		t.asserti(m.lineCount(), classes.length);
		for (i < classes.length) {
			def c = classes[i];
			t.assert_eq(m.lineAt(i), c.line);
			t.asserti(floor.durableCounts[i], c.floor);
			t.asserti(m.storesInLine(i), c.last);
			def start = int.!(c.line);
			var end = start + int.!(CacheLines.CACHE_LINE_SIZE);
			if (end > lazy.size()) end = lazy.size();
			def prefixes = Vector<int>.new();
			def contents = Vector<Array<byte>>.new();
			for (p = c.floor; p <= c.last; p++) {
				def counts = Arrays.dup(floor.durableCounts);
				counts[i] = p;
				m.restore(CrashModelState.new(floor.pos, counts, floor.requiredCounts));
				def bytes = Arrays.range(m.crash().bytes, start, end);
				var seen = false;
				for (k < contents.length) if (Arrays.equal(contents[k], bytes)) seen = true;
				if (seen) continue;
				prefixes.put(p);
				contents.put(bytes);
			}
			t.asserti(prefixes.length, c.count());
			if (!t.ok) break;
			for (k < prefixes.length) {
				t.asserti(prefixes[k], c.prefixes[k]);
				t.assertz(true, Arrays.equal(contents[k], c.contents[k]));
			}
		}
		return (states, old.length());
	}

	// Four lines, each holding three stores of different values and nothing
	// fenced, so each line has four contents and the cut 4^4 = 256 images.
	def fourLinesTrace() -> PersistenceTrace {
		def events = Vector<PersistenceEvent>.new();
		var seq = 1u64;
		for (k < 3) {
			for (line < 4) {
				def value = u64.!(1 + 16 * line + k);
				events.put(store(seq, u64.!(64 * line + 8 * k), 8u8, value));
				seq++;
			}
		}
		return trace("four_lines", events.extract());
	}

	// The image whose line i holds the class {choice[i]} of {classes}, built by
	// the machine: every line drained to that class's least prefix.
	def imageOf(tr: PersistenceTrace, cut: int, classes: Array<CrashLineClasses>,
		choice: Array<int>) -> CrashImage {

		def m = CrashModel.new(tr, null);
		m.runTo(cut);
		def floor = m.snapshot();
		def counts = Array<int>.new(classes.length);
		for (i < counts.length) counts[i] = classes[i].prefixes[choice[i]];
		m.restore(CrashModelState.new(floor.pos, counts, floor.requiredCounts));
		return m.crash();
	}

	def sameSequence(a: CrashExploration, b: CrashExploration) -> bool {
		if (a.images.length != b.images.length) return false;
		for (i < a.images.length) if (!a.images[i].sameBytes(b.images[i])) return false;
		return true;
	}

	// Record one real commit -- append and commit, no apply -- through the
	// production WAL, as crash_recovery: does, and the bytes that were
	// durable before it: the WAL header the constructor persisted.
	def recordOneCommit() -> (PersistenceTrace, Array<byte>) {
		def region = makePmemRegion();
		if (region == null) return (null, null);
		def recorder = RecordingProvider.!(region.provider());
		def base = u64.view(Pointer.atElement(region.range, 0));
		def wal = TwoSlotWal.new(base, base + 1024u64, 1024u64, region, OpenMode.FORMAT);
		def mounted = Array<byte>.new(region.range.length);
		for (i < mounted.length) mounted[i] = region.range[i];
		recorder.clear();
		var ok = wal.append(200u64, 0x8877_6655_4433_2211_u64, 8u8);
		ok = ok && wal.commit() == 1u64;
		def tr = recorder.snapshot("dual_wal_commit");
		region.close();
		if (!ok || !tr.validate().ok()) return (null, null);
		return (tr, mounted);
	}

	def countOf(text: string, needle: string) -> int {
		if (needle.length == 0 || needle.length > text.length) return 0;
		var found = 0;
		for (i < text.length - needle.length + 1) {
			var hit = true;
			for (j < needle.length) if (text[i + j] != needle[j]) hit = false;
			if (hit) found++;
		}
		return found;
	}

	// Program order within a line: the second store can only be durable if the
	// first one is. Holds on every image the model produces.
	def orderedProperty(image: CrashImage) -> string {
		if (image.read(8u64, 8) != 0u64 && image.read(0u64, 8) != A) {
			return "second store durable without the first";
		}
		return null;
	}

	// Fails on any image whose line 192 holds the last value stored there.
	def lastValueAbsent(image: CrashImage) -> string {
		if (image.read(208u64, 8) == u64.!(1 + 16 * 3 + 2)) return "line 192 holds its last value";
		return null;
	}

	// Deliberately too strong: an unflushed store is not durable on every
	// schedule, so this fails on exactly the images that dropped it.
	def durableProperty(image: CrashImage) -> string {
		if (image.read(0u64, 8) != A) return "first store absent";
		return null;
	}

	def makePmemRegion() -> PmemRegion {
		def mapping = Mmap.reserve(4096u64, Mmap.PROT_READ | Mmap.PROT_WRITE);
		if (mapping == null) return null;
		def region = PmemRegion.new(mapping, -1);
		region.setProvider(RecordingProvider.new(region.range));
		return region;
	}
}

// One unflushed store is one bit of freedom: the crash either caught the
// eviction or it did not.
def test_explore_single_store_has_two_images(tc: CrashExplorerTester) {
	def tr = tc.trace("one_store", [tc.store(1u64, 8u64, 8u8, tc.A)]);

	def before = tc.explore(tr, 0);
	tc.t.asserti(1, before.imageCount());
	tc.t.assertz(false, before.truncated);

	def after = tc.explore(tr, 1);
	tc.t.asserti(2, after.imageCount());
	tc.t.assertz(true, after.containsImage(CrashImages.lazyCrash(tr, null, 1)));
	tc.t.assertz(true, after.containsImage(CrashImages.eagerCrash(tr, null, 1)));
	// Three states: nothing done, the store executed, the store written back.
	tc.t.asserti(3, after.statesVisited);
}

// A completed fence removes the freedom it covers: after it, the store is
// durable on every schedule, so the cut has exactly one image. This is what
// makes the WAL's commit point a commit point.
def test_explore_fence_forces_one_image(tc: CrashExplorerTester) {
	def tr = tc.trace("fenced", [
		tc.store(1u64, 8u64, 8u8, tc.A),
		tc.clwb(2u64, 0u64),
		tc.fence(3u64)
	]);

	def atFence = tc.explore(tr, 3);
	tc.t.asserti(1, atFence.imageCount());
	tc.t.assert_eq(tc.A, atFence.images[0].read(8u64, 8));

	// Before the fence returns, both outcomes are still reachable.
	tc.t.asserti(2, tc.explore(tr, 2).imageCount());
}

// Different cache lines are independent, so their freedom multiplies rather
// than being decided together by one all-or-nothing flush.
def test_explore_independent_lines_multiply(tc: CrashExplorerTester) {
	def tr = tc.trace("two_lines", [
		tc.store(1u64, 0u64, 8u8, tc.A),
		tc.store(2u64, 128u64, 8u8, tc.B)
	]);

	def all = tc.explore(tr, 2);
	tc.t.asserti(4, all.imageCount());
	tc.t.assertz(false, all.truncated);

	var withFirst = 0;
	var withSecond = 0;
	for (i < all.images.length) {
		if (all.images[i].read(0u64, 8) == tc.A) withFirst++;
		if (all.images[i].read(128u64, 8) == tc.B) withSecond++;
	}
	tc.t.asserti(2, withFirst);
	tc.t.asserti(2, withSecond);
}

// A line's writeback may stop after any of its stores, so three stores on one
// line give four images -- the partially constructed WAL record states the
// model must not collapse away.
def test_explore_torn_prefixes_enumerated(tc: CrashExplorerTester) {
	def tr = tc.trace("one_line_three_stores", [
		tc.store(1u64, 0u64, 8u8, tc.A),
		tc.store(2u64, 8u64, 8u8, tc.B),
		tc.store(3u64, 16u64, 8u8, tc.C)
	]);

	def all = tc.explore(tr, 3);
	tc.t.asserti(4, all.imageCount());
	// Program order holds in every image: a later store is never durable while
	// an earlier one on the same line is missing.
	for (i < all.images.length) {
		def img = all.images[i];
		if (img.read(8u64, 8) != 0u64) tc.t.assert_eq(tc.A, img.read(0u64, 8));
		if (img.read(16u64, 8) != 0u64) tc.t.assert_eq(tc.B, img.read(8u64, 8));
	}
}

// A fence sets a floor, not a ceiling: stores made after the CLWB on the same
// line stay free, so the cut keeps exactly the freedom the protocol left open.
def test_explore_fence_floor_limits_later_stores(tc: CrashExplorerTester) {
	def tr = tc.trace("floor", [
		tc.store(1u64, 0u64, 8u8, tc.A),
		tc.clwb(2u64, 0u64),
		tc.fence(3u64),
		tc.store(4u64, 8u64, 8u8, tc.B)
	]);

	def all = tc.explore(tr, 4);
	tc.t.asserti(2, all.imageCount());
	for (i < all.images.length) tc.t.assert_eq(tc.A, all.images[i].read(0u64, 8));
	tc.t.assertz(true, all.containsImage(CrashImages.lazyCrash(tr, null, 4)));
	tc.t.assertz(true, all.containsImage(CrashImages.eagerCrash(tr, null, 4)));
}

// The two canonical schedules are the extremes of the search, so an exploration
// that lost either of them has lost the weakest and strongest images recovery
// must cope with.
def test_explore_brackets_lazy_and_eager(tc: CrashExplorerTester) {
	def tr = tc.trace("mixed", [
		tc.store(1u64, 0u64, 8u8, tc.A),
		tc.clwb(2u64, 0u64),
		tc.store(3u64, 128u64, 4u8, 0x1234_5678_u64),
		tc.fence(4u64),
		tc.store(5u64, 8u64, 2u8, 0xABCDu64)
	]);

	for (cut < tr.length() + 1) {
		def all = tc.explore(tr, cut);
		tc.t.assertz(false, all.truncated);
		tc.t.assertz(true, all.containsImage(CrashImages.lazyCrash(tr, null, cut)));
		tc.t.assertz(true, all.containsImage(CrashImages.eagerCrash(tr, null, cut)));
	}
}

// The reduction claim, checked rather than argued: replaying with no voluntary
// writeback and then enumerating per-line prefixes above the fence-forced floor
// reaches exactly the images the full branching search reaches.
def test_explore_reduction_agrees_with_full_search(tc: CrashExplorerTester) {
	def traces = tc.reductionTraces();
	for (i < traces.length) {
		def tr = traces[i];
		for (cut < tr.length() + 1) {
			def full = tc.explore(tr, cut);
			tc.t.assertz(false, full.truncated);
			def small = tc.reduced(tr, cut);
			tc.t.assertz(false, small.truncated);
			tc.assertSameImages(full, small);
			// What the line classes count is what the full search finds.
			tc.t.assert_eq(long.!(full.imageCount()), small.classProduct);
		}
	}
}

// A search that ran out of budget must say so: a truncated exploration is not
// evidence that no other image exists.
def test_explore_budget_truncates_and_reports(tc: CrashExplorerTester) {
	def tr = tc.trace("budgeted", [
		tc.store(1u64, 0u64, 8u8, tc.A),
		tc.store(2u64, 8u64, 8u8, tc.B),
		tc.store(3u64, 64u64, 8u8, tc.C),
		tc.store(4u64, 128u64, 8u8, tc.A)
	]);

	def complete = tc.explore(tr, 4);
	tc.t.assertz(false, complete.truncated);
	// Three lines, one holding two stores: 3 * 2 * 2 prefix combinations.
	tc.t.asserti(12, complete.imageCount());

	def capped = CrashExplorer.crashImages(tr, null, 4, 4);
	tc.t.assertz(true, capped.truncated);
	tc.t.assertz(true, capped.imageCount() <= complete.imageCount());

	def cappedReduced = CrashExplorer.reducedCrashImages(tr, null, 4, 2);
	tc.t.assertz(true, cappedReduced.truncated);
	tc.t.asserti(2, cappedReduced.imageCount());

	// The rendering carries the flag, so a stored artifact cannot be mistaken
	// for an exhaustive result.
	def artifact = capped.toArtifact();
	tc.t.assertz(true, Strings.startsWith(artifact, "--- pmem-exploration budgeted crash-after=4 of 4\n"));
	tc.t.asserti(1, tc.countOf(artifact, "truncated=true"));
	tc.t.asserti(capped.imageCount(), tc.countOf(artifact, "image digest=0x"));
	tc.t.asserti(1, tc.countOf(artifact, "--- end pmem-exploration budgeted"));
	tc.t.asserti(1, tc.countOf(complete.toArtifact(), "truncated=false"));
}

// The model applied to a recorded production trace: at the commit point the
// record is durable on every schedule while the after-image has not been
// written yet, and once the scenario has flushed and fenced every line it
// touched the cut has exactly one image.
def test_explore_real_wal_images_at_boundaries(tc: CrashExplorerTester) {
	def region = tc.makePmemRegion();
	if (region == null) {
		tc.t.fail("trace mapping allocation failed");
		return;
	}
	def recorder = RecordingProvider.!(region.provider());
	def base = u64.view(Pointer.atElement(region.range, 0));
	def wal = TwoSlotWal.new(base, base + 1024u64, 1024u64, region, OpenMode.FORMAT);

	def value = 0x8877_6655_4433_2211_u64;
	recorder.clear();
	tc.t.assertz(true, wal.append(200u64, value, 8u8));
	tc.t.assert_eq(1u64, wal.commit());
	tc.t.assertz(true, wal.applyAfterImage(200u64, value, 8u8));
	tc.t.assertz(true, wal.persistAfterImages());
	def tr = recorder.snapshot("dual_wal_commit_apply_flush");
	tc.t.assertz(true, tr.validate().ok());

	// Everything touched has been flushed and fenced, so no freedom is left.
	def atEnd = CrashExplorer.reducedCrashImages(tr, null, tr.length(), 0);
	tc.t.assertz(false, atEnd.truncated);
	tc.t.asserti(1, atEnd.imageCount());
	tc.t.assert_eq(value, atEnd.images[0].read(200u64, 8));
	tc.t.assertz(true, atEnd.containsImage(CrashImages.lazyCrash(tr, null, tr.length())));

	// At the commit point the record is durable on every schedule; the
	// after-image has not been stored yet, so no image can contain it.
	def commitFence = tr.length() - 3;
	def atCommit = CrashExplorer.reducedCrashImages(tr, null, commitFence, 0);
	tc.t.assertz(false, atCommit.truncated);
	tc.t.asserti(1, atCommit.imageCount());
	tc.t.assertz(false, 0u64 == atCommit.images[0].read(1536u64, 8));
	tc.t.assert_eq(0u64, atCommit.images[0].read(200u64, 8));

	// One event later the after-image exists but is unflushed: two images, and
	// the record survives in both.
	def applied = CrashExplorer.reducedCrashImages(tr, null, commitFence + 1, 0);
	tc.t.asserti(2, applied.imageCount());
	for (i < applied.images.length) {
		tc.t.assertz(false, 0u64 == applied.images[i].read(1536u64, 8));
	}
	tc.t.assertz(true, applied.containsImage(CrashImages.lazyCrash(tr, null, commitFence + 1)));
	tc.t.assertz(true, applied.containsImage(CrashImages.eagerCrash(tr, null, commitFence + 1)));
	region.close();
}


// A property that holds is reported as holding over every image the cut permits
// -- and only counts as evidence when the search that produced them was
// complete.
def test_explore_property_holds_over_every_image(tc: CrashExplorerTester) {
	def tr = tc.trace("ordered", [
		tc.store(1u64, 0u64, 8u8, tc.A),
		tc.store(2u64, 8u64, 8u8, tc.B)
	]);
	def property = CrashImageProperty.new("same-line stores persist in order",
		0u64, 16, tc.orderedProperty);

	def result = CrashExplorer.checkImages(tr, null, 2, 0, property);
	tc.t.assertz(true, result.ok());
	tc.t.assertz(true, result.exhaustive());
	tc.t.asserti(3, result.imagesChecked);
	tc.t.asserti(3, result.exploration.imageCount());
	// With no counterexample the artifact is the exploration summary.
	tc.t.asserti(1, tc.countOf(result.toArtifact(), "truncated=false"));

	def sweep = CrashExplorer.checkAllCuts(tr, null, 0, property);
	tc.t.assertz(true, sweep.exhaustive());
	// Cuts 0, 1 and 2 permit 1, 2 and 3 images.
	tc.t.asserti(6, sweep.imagesChecked);
}

// A failing property becomes a stored counterexample: the failing durable
// bytes, the schedule prefix that produced them, and a window of the region
// worth reading.
def test_explore_property_failure_becomes_counterexample(tc: CrashExplorerTester) {
	def tr = tc.trace("unflushed", [tc.store(1u64, 0u64, 8u8, tc.A)]);
	def property = CrashImageProperty.new("first store survives", 0u64, 16,
		tc.durableProperty);

	def result = CrashExplorer.checkImages(tr, null, 1, 0, property);
	tc.t.assertz(false, result.ok());
	tc.t.assertz(false, result.exhaustive());
	tc.t.assertz(false, result.truncated);

	def cx = result.counterexample;
	tc.t.assert_string("unflushed", cx.scenario);
	tc.t.assert_string("first store survives", cx.property);
	tc.t.assert_string("first store absent", cx.detail);
	tc.t.asserti(1, cx.crashAfter);
	// The image it carries is the one that dropped the store: the lazy schedule.
	tc.t.assert_eq(CrashImages.lazyCrash(tr, null, 1).digest(), cx.durableImage().digest());
	tc.t.assertz(false, CrashImages.eagerCrash(tr, null, 1).digest() == cx.durableImage().digest());

	def artifact = cx.toArtifact();
	tc.t.asserti(1, tc.countOf(artifact, "detail: first store absent"));
	tc.t.asserti(1, tc.countOf(artifact, "durable-image: bytes=256 digest=0x"));
	tc.t.asserti(1, tc.countOf(artifact, "durable-window: offset=0 length=16"));
	tc.t.asserti(1, tc.countOf(artifact, "00000000: 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"));
	tc.t.asserti(1, tc.countOf(artifact, "--- pmem-trace unflushed"));
}

// Sweeping every cut reports the earliest one at which the property can fail,
// which is the cut worth reading: later failures are usually the same hole.
def test_explore_all_cuts_reports_earliest_failure(tc: CrashExplorerTester) {
	def tr = tc.trace("late_failure", [
		tc.store(1u64, 64u64, 8u8, tc.B),
		tc.store(2u64, 0u64, 8u8, tc.A),
		tc.clwb(3u64, 0u64),
		tc.fence(4u64)
	]);
	def property = CrashImageProperty.new("first store survives", 0u64, 8,
		tc.durableProperty);

	def sweep = CrashExplorer.checkAllCuts(tr, null, 0, property);
	tc.t.assertz(false, sweep.ok());
	// Cuts 0 and 1 have no store at offset 0 at all, so they fail first.
	tc.t.asserti(0, sweep.counterexample.crashAfter);
	tc.t.asserti(0, sweep.counterexample.cutTrace().length());

	// Once the fence has completed, the store is durable on every schedule, so
	// the same property holds at that cut.
	def atFence = CrashExplorer.checkImages(tr, null, 4, 0, property);
	tc.t.assertz(true, atFence.exhaustive());
	tc.t.asserti(2, atFence.exploration.imageCount());
}

// A budget that stopped the search is not a proof: the result says so even when
// every image it did check passed.
def test_explore_truncated_search_is_not_evidence(tc: CrashExplorerTester) {
	def tr = tc.trace("budgeted_check", [
		tc.store(1u64, 0u64, 8u8, tc.A),
		tc.store(2u64, 8u64, 8u8, tc.B),
		tc.store(3u64, 64u64, 8u8, tc.C)
	]);
	def property = CrashImageProperty.new("same-line stores persist in order",
		0u64, 16, tc.orderedProperty);

	def capped = CrashExplorer.checkImages(tr, null, 3, 2, property);
	tc.t.assertz(true, capped.ok());
	tc.t.assertz(true, capped.truncated);
	tc.t.assertz(false, capped.exhaustive());
	tc.t.asserti(2, capped.imagesChecked);

	def complete = CrashExplorer.checkImages(tr, null, 3, 0, property);
	tc.t.assertz(true, complete.exhaustive());
	tc.t.asserti(6, complete.imagesChecked);
}


// A property is often only claimed from a point in a scenario onward, so a
// range must check the cuts it was given and no others: the property that fails
// at the start of this trace holds from the fence on, and asking for that
// suffix must not drag the earlier cuts back in. Ends outside the trace clamp.
def test_explore_cut_range_checks_only_its_cuts(tc: CrashExplorerTester) {
	def tr = tc.trace("late_failure", [
		tc.store(1u64, 64u64, 8u8, tc.B),
		tc.store(2u64, 0u64, 8u8, tc.A),
		tc.clwb(3u64, 0u64),
		tc.fence(4u64)
	]);
	def property = CrashImageProperty.new("first store survives", 0u64, 8,
		tc.durableProperty);

	// From the fence onward the store is durable on every schedule.
	def suffix = CrashExplorer.checkCutRange(tr, null, 4, 99, 0, property);
	tc.t.assertz(true, suffix.exhaustive());

	// A range that reaches back before the fence fails at its own earliest cut,
	// not at the trace's.
	def wider = CrashExplorer.checkCutRange(tr, null, 2, 4, 0, property);
	tc.t.assertz(false, wider.ok());
	tc.t.asserti(2, wider.counterexample.crashAfter);

	// The whole trace is the range 0..length, and delegating to it must not
	// change what the sweep reports.
	def all = CrashExplorer.checkAllCuts(tr, null, 0, property);
	def same = CrashExplorer.checkCutRange(tr, null, 0, tr.length(), 0, property);
	tc.t.asserti(all.counterexample.crashAfter, same.counterexample.crashAfter);
	tc.t.asserti(all.imagesChecked, same.imagesChecked);
}

// The line classes, checked against the enumeration they replace. At every cut
// of this file's traces, and at sampled cuts of a recorded one-commit TwoSlotWal
// trace, the reduced search's images are exactly the distinct images of the old
// prefix odometer, each once; its count is that odometer's number of distinct
// images and its {product} that odometer's number of prefix vectors.
def test_explore_line_classes_equal_distinct_images(tc: CrashExplorerTester) {
	def traces = tc.smallTraces();
	for (i < traces.length) {
		def tr = traces[i];
		for (cut < tr.length() + 1) tc.assertClassesMatchOdometer(tr, null, cut);
	}

	// The repeats trace at its last cut: five prefixes of line 0 give two
	// contents, three of line 64 give two, and two of line 128 give one.
	def repeats = tc.repeatsTrace();
	def end = CrashExplorer.reducedCrashImages(repeats, null, repeats.length(), 0);
	tc.t.assert_eq(30L, end.product);
	tc.t.assert_eq(4L, end.classProduct);
	tc.t.asserti(4, end.imageCount());

	// A recorded commit. Its first 192 stores zero the record slot one byte at a
	// time over bytes that are already zero, so up to cut 192 every prefix
	// vector gives the lazy image; the record's stores follow. The sampled cuts
	// include the zeroing's 4,225 vectors at cut 128 and the record's first
	// store at cut 193, where 278,850 vectors give two images. The later cuts
	// before the commit point cost the reference more than a unit test should
	// spend.
	def recorded = tc.recordOneCommit();
	def wal = recorded.0, mounted = recorded.1;
	if (wal == null) {
		tc.t.fail("could not record a production WAL commit");
		return;
	}
	tc.t.asserti(214, wal.length());
	for (cut in [0, 16, 32, 48, 64, 80, 96, 112, 128, 193, wal.length()]) {
		def r = tc.assertClassesMatchOdometer(wal, mounted, cut);
		if (cut == 128) {
			tc.t.asserti(4225, r.0);
			tc.t.asserti(1, r.1);
		}
		if (cut == 193) {
			tc.t.asserti(278850, r.0);
			tc.t.asserti(2, r.1);
		}
	}
}

// A cut with more distinct images than the budget is truncated, and the budget
// goes first to the extremes: the lazy image, the eager image, each line alone
// at its last content, and each line alone one content below its last with the
// rest at theirs; then to images drawn at random with a seed derived from the
// trace and the cut. The selection holds only images the cut admits, each once,
// and the same seed gives the same images in the same order.
def test_explore_over_budget_selection_takes_extremes_then_seeded_random(tc: CrashExplorerTester) {
	def tr = tc.fourLinesTrace();
	def cut = tr.length();
	def all = CrashExplorer.reducedCrashImages(tr, null, cut, tc.EXHAUSTIVE);
	tc.t.assertz(false, all.truncated);
	tc.t.asserti(256, all.imageCount());
	def classes = CrashExplorer.lineClasses(tr, null, cut);
	tc.t.asserti(4, classes.length);
	for (c in classes) tc.t.asserti(4, c.count());

	def got = CrashExplorer.reducedCrashImages(tr, null, cut, 16);
	tc.t.assertz(true, got.truncated);
	tc.t.asserti(16, got.imageCount());
	tc.t.assert_eq(256L, got.classProduct);
	tc.t.assert_eq(CrashExplorer.selectionSeed(tr, cut), got.seed);
	def seen = CrashExplorerImageSet.new(tr.touchedLines());
	for (i < got.images.length) {
		tc.t.assertz(true, all.containsImage(got.images[i]));
		tc.t.assertz(true, seen.add(got.images[i]));
	}

	// The extremes, in order: lazy, eager, then each line alone at its last
	// content, then each line one below its last with the rest at theirs.
	tc.t.assertz(true, got.images[0].sameBytes(CrashImages.lazyCrash(tr, null, cut)));
	tc.t.assertz(true, got.images[1].sameBytes(CrashImages.eagerCrash(tr, null, cut)));
	for (i < 4) {
		def alone = Array<int>.new(4);
		alone[i] = 3;
		tc.t.assertz(true, got.images[2 + i].sameBytes(tc.imageOf(tr, cut, classes, alone)));
		def below = [3, 3, 3, 3];
		below[i] = 2;
		tc.t.assertz(true, got.images[6 + i].sameBytes(tc.imageOf(tr, cut, classes, below)));
	}

	// Reproducible: the derived seed replays through selectCrashImages(), a
	// second run gives the same sequence, and another seed keeps the extremes
	// but draws a different random tail.
	def replay = CrashExplorer.selectCrashImages(tr, null, cut, 16, got.seed);
	tc.t.assertz(true, tc.sameSequence(got, replay));
	tc.t.assertz(true, tc.sameSequence(got, CrashExplorer.reducedCrashImages(tr, null, cut, 16)));
	def other = CrashExplorer.selectCrashImages(tr, null, cut, 16, got.seed + 1u64);
	tc.t.asserti(16, other.imageCount());
	for (i < 10) tc.t.assertz(true, other.images[i].sameBytes(got.images[i]));
	var differ = false;
	for (i = 10; i < 16; i++) if (!other.images[i].sameBytes(got.images[i])) differ = true;
	tc.t.assertz(true, differ);

	// A budget below the extremes' count stops them in order, and a budget of
	// every image but one still draws distinct images to the end.
	def three = CrashExplorer.reducedCrashImages(tr, null, cut, 3);
	tc.t.asserti(3, three.imageCount());
	for (i < 3) tc.t.assertz(true, three.images[i].sameBytes(got.images[i]));
	def most = CrashExplorer.reducedCrashImages(tr, null, cut, 255);
	tc.t.assertz(true, most.truncated);
	tc.t.asserti(255, most.imageCount());
	def mostSeen = CrashExplorerImageSet.new(tr.touchedLines());
	for (i < most.images.length) {
		tc.t.assertz(true, all.containsImage(most.images[i]));
		tc.t.assertz(true, mostSeen.add(most.images[i]));
	}

	// A sweep's counterexample names the failing image's place in the
	// selection and the seed, so the same search finds it again.
	def property = CrashImageProperty.new("line 192 never holds its last value", 192u64, 8,
		tc.lastValueAbsent);
	def result = CrashExplorer.checkImages(tr, null, cut, 4, property);
	tc.t.assertz(false, result.ok());
	// The eager image is the second one taken.
	tc.t.asserti(2, result.imagesChecked);
	def note = result.counterexample.selectionNote();
	tc.t.assertz(true, Strings.startsWith(note, "image 2 of 4 chosen from 256 distinct images by budget 4"));
	tc.t.asserti(1, tc.countOf(result.counterexample.toArtifact(), "selection: image 2 of 4"));
}
