// Persistent-operation seam and trace-recorder tests. These use ordinary
// anonymous memory; no DAX mapping or PMEM hardware is required.

def POT = UnitTests.registerT("provider:", _, ProviderTester.new, _);
def POTX = [
	POT("native_instruction_encodings", test_persistent_native_instruction_encodings),
	POT("native_instruction_smoke", test_persistent_native_instruction_smoke),
	POT("scalar_stores_are_typed_little_endian", test_persistent_scalar_stores_are_typed_little_endian),
	POT("pmem_range_translation", test_persistent_pmem_range_translation),
	POT("dual_wal_phase_b_trace", test_persistent_dual_wal_phase_b_trace),
	POT("dual_wal_two_transaction_trace", test_persistent_dual_wal_two_transaction_trace),
	POT("dual_wal_recovery_trace", test_persistent_dual_wal_recovery_trace),
	POT("dual_wal_batched_apply_writes_each_line_back_once", test_persistent_dual_wal_batched_apply_writes_each_line_back_once),
	POT("dual_wal_boundaries_drain_unprepared_after_images", test_persistent_dual_wal_boundaries_drain_unprepared_after_images),
	POT("pwregion_format_trace", test_persistent_pwregion_format_trace),
	POT("pwregion_format_descriptor_trace", test_persistent_pwregion_format_descriptor_trace),
	POT("pwregion_alloc_applies_after_commit_boundary", test_persistent_pwregion_alloc_applies_after_commit_boundary),
	POT("pwregion_txn_writes_each_line_back_once", test_persistent_pwregion_txn_writes_each_line_back_once),
	POT("immix_line_marks_cross_the_seam", test_persistent_immix_line_marks_cross_the_seam),
	POT("reader_matches_raw", test_persistent_reader_matches_raw),
	POT("load_observer_runs_before_the_load", test_persistent_load_observer_runs_before_the_load),
	POT("load_audit_covers_fields", test_persistent_load_audit_covers_fields),
	POT("load_audit_unobserved_bytes_inert", test_persistent_load_audit_unobserved_bytes_inert),
	POT("load_audit_sieve_reattach_inert", test_persistent_load_audit_sieve_reattach_inert),
	POT("load_audit_btree_reattach_inert", test_persistent_load_audit_btree_reattach_inert),
	POT("load_audit_btree_descents_fetch_the_path", test_persistent_load_audit_btree_descents_fetch_the_path),
	()
];

// Geometry of the traced region used by the RegionAllocator format tests.
component TraceAllocators {
	def BLOCKS = 8u64;
	def BLOCK_SIZE = 4096u64;
	def SIZE = 32768u64;                    // BLOCKS * BLOCK_SIZE
	def LOG_CHUNK_START = 4096u64;          // block 1
	def LOG_CHUNK_END = 8192u64;
	def BLOCK_TABLE_ENTRIES = 9u64;         // numBlocks + 1
	def BLOCK_TABLE_START = 32408u64;       // SIZE - BLOCK_TABLE_ENTRIES * BlockTableEntry.size
	def SENTINEL_START = 88u64;             // RegionHeader.size
	def SENTINEL_COUNT = 8u64;              // FreeLists.MAX_LISTS
}

// Installs the trace recorder on the region *before* RegionAllocator ever sees it.
// This is precisely why RegionAllocator must read its provider from the region rather
// than construct one unconditionally: the recorder has to already be the
// region's single provider when format() issues its very first store.
class TraceAllocatorBackend extends StorageBackend {
	var region: PmemRegion;

	def open(size: u64, access: int, mode: OpenMode) -> StorageRegion {
		def mapping = Mmap.reserve(size, RegionMapping.convertProt(access));
		if (mapping == null) return null;
		region = PmemRegion.new(mapping, -1);
		region.setProvider(RecordingProvider.new(region.range));
		return region;
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "trace-pmem";
	}

	def recorder() -> RecordingProvider {
		if (region == null) return null;
		return RecordingProvider.!(region.provider());
	}
}

class ProviderTester(t: Tester) {
	var data = Array<byte>.new(4096);
	var recorder = RecordingProvider.new(data[0 ..+ data.length]);

	def assertSequences(events: Vector<PersistenceEvent>) {
		for (i < events.length) t.assert_eq(u64.!(i + 1), events[i].seq);
	}

	def assertStore(event: PersistenceEvent, seq: u64,
		offset: u64, width: u8, value: u64) {
		t.assertz(true, event.kind == PersistenceEventKind.STORE);
		t.assert_eq(seq, event.seq);
		t.assert_eq(offset, event.offset);
		t.assert_eq(width, event.width);
		t.assert_eq(value, event.value);
	}

	def makePmemRegion() -> PmemRegion {
		def mapping = Mmap.reserve(4096u64, Mmap.PROT_READ | Mmap.PROT_WRITE);
		if (mapping == null) return null;
		def region = PmemRegion.new(mapping, -1);
		region.setProvider(RecordingProvider.new(region.range));
		return region;
	}

	def recorderOf(region: PmemRegion) -> RecordingProvider {
		return RecordingProvider.!(region.provider());
	}

	// Every recorded store must satisfy the crash model's scalar-atomicity
	// baseline (docs/pmem-crash-model.md): a naturally aligned 1/2/4/8-byte
	// store that lies inside the region and never spans two cache lines. A
	// store violating this could tear in a way the explorer does not model.
	// PersistenceTrace.validate() is the single definition of that baseline, so
	// this checks the frozen trace rather than restating the rules.
	def assertStoreContract(events: Vector<PersistenceEvent>, regionSize: u64) {
		def check = PersistenceTrace.new("store-contract", regionSize, events.copy()).validate();
		if (!check.ok()) {
			t.fail(check.render(StringBuilder.new().puts("store contract violated: ")).toString());
		}
	}

	// Mark every byte covered by a recorded store, so a format trace can be
	// checked for complete structural coverage instead of event-by-event.
	def storeCoverage(events: Vector<PersistenceEvent>, regionSize: u64) -> Array<bool> {
		def covered = Array<bool>.new(int.!(regionSize));
		for (i < events.length) {
			def e = events[i];
			if (e.kind != PersistenceEventKind.STORE) continue;
			for (b < int.view(e.width)) covered[int.!(e.offset) + b] = true;
		}
		return covered;
	}

	def firstFence(events: Vector<PersistenceEvent>) -> int {
		for (i < events.length) if (events[i].kind == PersistenceEventKind.SFENCE) return i;
		return -1;
	}

	// Whether a CLWB of {line} was recorded at or after {from} and before the
	// last fence in the trace.
	def clwbBeforeLastFence(recorder: RecordingProvider, from: int, line: u64) -> bool {
		var lastFence = -1;
		for (i < recorder.events.length) {
			if (recorder.events[i].kind == PersistenceEventKind.SFENCE) lastFence = i;
		}
		for (i = from; i < lastFence; i++) {
			def e = recorder.events[i];
			if (e.kind == PersistenceEventKind.CLWB && e.offset == line) return true;
		}
		return false;
	}

	def assertCovered(covered: Array<bool>, start: u64, len: u64, expected: bool) {
		for (i < int.!(len)) t.assertz(expected, covered[int.!(start) + i]);
	}

	// Both the sentinels and the block table are arrays of BlockTableEntry. Every
	// field is written by clearBlockTableEntry(); bytes +3..+8 are layout padding.
	def assertBlockEntriesCovered(covered: Array<bool>, start: u64, count: u64) {
		for (i < int.!(count)) {
			def base = start + u64.!(i) * u64.!(BlockTableEntry.size);
			assertCovered(covered, base, 3u64, true);           // listNum + used
			assertCovered(covered, base + 3u64, 5u64, false);   // padding gap
			assertCovered(covered, base + 8u64, 32u64, true);   // prev/next/listPrev/listNext
		}
	}

	def noDescs() -> Array<Ref<MetadataDescriptor>> {
		return Array<Ref<MetadataDescriptor>>.new(0);
	}

	// Two descriptors with distinct, non-default field values, so a swapped or
	// wrongly-sized descriptor store cannot pass unnoticed.
	def twoDescs() -> Array<Ref<MetadataDescriptor>> {
		def bytes = Array<byte>.new(MetadataDescriptor.size * 2);
		def other = Ref<MetadataDescriptor>.at(bytes, 0);
		other.kind = 0x4f_54_48_45_52u64; // "OTHER"
		other.fixedBytes = 3u32;
		other.unitSize = 1024u32;
		other.bytesPerUnit = 2u32;

		def line = Ref<MetadataDescriptor>.at(bytes, MetadataDescriptor.size);
		line.kind = ImmixLineMarks.ImmixLineMarkMetaKind;
		line.fixedBytes = 4u32;
		line.unitSize = 128u32;
		line.bytesPerUnit = u32.!(LineMark.size);

		def descs = Array<Ref<MetadataDescriptor>>.new(2);
		descs[0] = other;
		descs[1] = line;
		return descs;
	}

	def lineDescs() -> Array<Ref<MetadataDescriptor>> {
		def bytes = Array<byte>.new(MetadataDescriptor.size);
		def line = Ref<MetadataDescriptor>.at(bytes, 0);
		line.kind = ImmixLineMarks.ImmixLineMarkMetaKind;
		line.fixedBytes = 0u32;
		line.unitSize = ImmixLineMarks.DefaultImmixLineSize;
		line.bytesPerUnit = u32.!(LineMark.size);

		def descs = Array<Ref<MetadataDescriptor>>.new(1);
		descs[0] = line;
		return descs;
	}

	def indexOfStore(events: Vector<PersistenceEvent>, offset: u64) -> int {
		for (i < events.length) {
			def e = events[i];
			if (e.kind == PersistenceEventKind.STORE && e.offset == offset) return i;
		}
		return -1;
	}
}

// Pin the exact native stubs used by the PMEM backend. These checks protect the
// Virgil assembler adaptation as well as the required instruction encodings.
def test_persistent_native_instruction_encodings(tc: ProviderTester) {
	var w = DataWriter.new();
	var asm = X86_64Assemblers.create64(w);
	asm.d.clwb(X86_64Regs.RSI.indirect()).ret();
	def clwb = [0x66u8, 0x0Fu8, 0xAEu8, 0x36u8, 0xC3u8];
	tc.t.assert_eq(clwb.length, w.pos);
	for (i < clwb.length) tc.t.assert_eq(clwb[i], w.data[i]);

	w = DataWriter.new();
	asm = X86_64Assemblers.create64(w);
	asm.d.clflushopt(X86_64Regs.RSI.indirect()).ret();
	def clflushOpt = [0x66u8, 0x0Fu8, 0xAEu8, 0x3Eu8, 0xC3u8];
	tc.t.assert_eq(clflushOpt.length, w.pos);
	for (i < clflushOpt.length) tc.t.assert_eq(clflushOpt[i], w.data[i]);

	w = DataWriter.new();
	asm = X86_64Assemblers.create64(w);
	asm.d.clflush(X86_64Regs.RSI.indirect()).ret();
	def clflush = [0x0Fu8, 0xAEu8, 0x3Eu8, 0xC3u8];
	tc.t.assert_eq(clflush.length, w.pos);
	for (i < clflush.length) tc.t.assert_eq(clflush[i], w.data[i]);

	w = DataWriter.new();
	asm = X86_64Assemblers.create64(w);
	asm.sfence().ret();
	def sfence = [0x0Fu8, 0xAEu8, 0xF8u8, 0xC3u8];
	tc.t.assert_eq(sfence.length, w.pos);
	for (i < sfence.length) tc.t.assert_eq(sfence[i], w.data[i]);
}

// Exercise the generated CPUID, writeback, and SFENCE stubs without requiring
// a DAX filesystem. The writeback target is an ordinary live cache line.
def test_persistent_native_instruction_smoke(tc: ProviderTester) {
	def basic = Target.cpuid(0u64, 0u64);
	tc.t.assertz(true, basic.0 > 0u64);
	tc.t.assertz(true, Target.supportsClflush() || Target.supportsClflushOpt() || Target.supportsClwb());
	tc.t.assertz(true, Target.supportsSfence());

	def line = Array<byte>.new(int.!(CacheLines.CACHE_LINE_SIZE));
	line[0] = 0xA5u8;
	X86_64CacheControl.writeBackLine(Pointer.atElement(line, 0));
	X86_64CacheControl.fence();
	tc.t.assert_eq(0xA5u8, line[0]);
}

// The recording provider executes the same native scalar stores as production,
// then records the normalized value and width. The byte assertions pin x86-64
// little-endian behavior rather than relying only on typed loads.
def test_persistent_scalar_stores_are_typed_little_endian(tc: ProviderTester) {
	tc.recorder.storeU8(1u64, 0xA5u8);
	tc.recorder.storeU16(2u64, 0xB1C2u16);
	tc.recorder.storeU32(4u64, 0xD3E4_F506_u32);
	tc.recorder.storeU64(8u64, 0x1728_394A_5B6C_7D8E_u64);

	tc.assertStore(tc.recorder.events[0], 1u64, 1u64, 1u8, 0xA5u64);
	tc.assertStore(tc.recorder.events[1], 2u64, 2u64, 2u8, 0xB1C2u64);
	tc.assertStore(tc.recorder.events[2], 3u64, 4u64, 4u8, 0x0000_0000_D3E4_F506_u64);
	tc.assertStore(tc.recorder.events[3], 4u64, 8u64, 8u8, 0x1728_394A_5B6C_7D8E_u64);
	tc.assertSequences(tc.recorder.events);

	tc.t.assert_eq(0xA5u8, tc.data[1]);
	tc.t.assert_eq(0xC2u8, tc.data[2]);
	tc.t.assert_eq(0xB1u8, tc.data[3]);
	tc.t.assert_eq(0x06u8, tc.data[4]);
	tc.t.assert_eq(0xF5u8, tc.data[5]);
	tc.t.assert_eq(0xE4u8, tc.data[6]);
	tc.t.assert_eq(0xD3u8, tc.data[7]);
	def expected64 = [0x8Eu8, 0x7Du8, 0x6Cu8, 0x5Bu8,
		0x4Au8, 0x39u8, 0x28u8, 0x17u8];
	for (i < expected64.length) tc.t.assert_eq(expected64[i], tc.data[8 + i]);

	tc.recorder.clear();
	tc.t.assert_eq(0, tc.recorder.events.length);
	tc.recorder.storeU8(0u64, 0x11u8);
	tc.t.assert_eq(1u64, tc.recorder.events[0].seq);
	tc.recorder.reset();
	tc.t.assert_eq(0, tc.recorder.events.length);
}

// PMEM preparation translates byte ranges to every touched 64-byte line in
// ascending order. A fence appears only when a writeback is pending.
def test_persistent_pmem_range_translation(tc: ProviderTester) {
	def region = tc.makePmemRegion();
	if (region == null) {
		tc.t.fail("pmem trace mapping allocation failed");
		return;
	}
	def recorder = tc.recorderOf(region);

	tc.t.assertz(true, region.writeBack(4096u64, 0u64));
	tc.t.assert_eq(0, recorder.events.length);
	tc.t.assertz(true, region.drain());
	tc.t.assert_eq(0, recorder.events.length);

	tc.t.assertz(true, region.writeBack(73u64, 1u64));
	tc.t.assert_eq(1, recorder.events.length);
	tc.t.assertz(true, recorder.events[0].kind == PersistenceEventKind.CLWB);
	tc.t.assert_eq(64u64, recorder.events[0].offset);
	tc.t.assertz(true, region.drain());
	tc.t.assert_eq(2, recorder.events.length);
	tc.t.assertz(true, recorder.events[1].kind == PersistenceEventKind.SFENCE);

	recorder.clear();
	tc.t.assertz(true, region.writeBack(63u64, 130u64));
	def expectedLines = [0u64, 64u64, 128u64, 192u64];
	tc.t.assert_eq(expectedLines.length, recorder.events.length);
	for (i < expectedLines.length) {
		tc.t.assertz(true, recorder.events[i].kind == PersistenceEventKind.CLWB);
		tc.t.assert_eq(expectedLines[i], recorder.events[i].offset);
	}
	tc.assertSequences(recorder.events);
	tc.t.assertz(true, region.drain());
	tc.t.assertz(true, recorder.events[4].kind == PersistenceEventKind.SFENCE);
	tc.t.assert_eq(5u64, recorder.events[4].seq);
	def eventCount = recorder.events.length;
	tc.t.assertz(true, region.drain());
	tc.t.assert_eq(eventCount, recorder.events.length);

	// Synchronous range persistence uses the same line translation followed by
	// its own fence, without creating pending work for drain().
	recorder.clear();
	tc.t.assertz(true, region.persist(511u64, 2u64));
	tc.t.assert_eq(3, recorder.events.length);
	tc.t.assertz(true, recorder.events[0].kind == PersistenceEventKind.CLWB);
	tc.t.assert_eq(448u64, recorder.events[0].offset);
	tc.t.assertz(true, recorder.events[1].kind == PersistenceEventKind.CLWB);
	tc.t.assert_eq(512u64, recorder.events[1].offset);
	tc.t.assertz(true, recorder.events[2].kind == PersistenceEventKind.SFENCE);
	def afterPersist = recorder.events.length;
	tc.t.assertz(true, region.drain());
	tc.t.assert_eq(afterPersist, recorder.events.length);
	region.close();
}

// One real TwoSlotWal commit produces byte-visible record construction,
// record-line writebacks, the commit fence, then the write-behind after-image
// store and its line writeback. Explicit flush supplies the completing fence.
def test_persistent_dual_wal_phase_b_trace(tc: ProviderTester) {
	def region = tc.makePmemRegion();
	if (region == null) {
		tc.t.fail("phase-B trace mapping allocation failed");
		return;
	}
	def recorder = tc.recorderOf(region);
	def base = u64.view(Pointer.atElement(region.range, 0));
	def wal = TwoSlotWal.new(base, base + 1024u64, 1024u64, region, OpenMode.FORMAT);
	recorder.clear();

	def value = 0x8877_6655_4433_2211_u64;
	tc.t.assertz(true, wal.append(200u64, value, 8u8));
	tc.t.assert_eq(1u64, wal.commit());
	tc.assertSequences(recorder.events);

	var firstClwb = -1;
	for (i < recorder.events.length) {
		if (firstClwb < 0 && recorder.events[i].kind == PersistenceEventKind.CLWB) firstClwb = i;
	}
	tc.t.assertz(true, firstClwb > 0);
	def recordStart = 1536u64; // odd txnSeq -> slot 1
	def recordLen = 192u64;
	// zeroBytes() remains byte-visible rather than becoming an atomic record
	// event. Build that long expected prefix programmatically.
	for (i < int.!(recordLen)) {
		tc.assertStore(recorder.events[i], u64.!(i + 1),
			recordStart + u64.!(i), 1u8, 0u64);
	}
	var field = int.!(recordLen);
	tc.assertStore(recorder.events[field++], u64.!(field), recordStart,
		8u8, WalLayout.RECORD_MAGIC);
	tc.assertStore(recorder.events[field++], u64.!(field),
		recordStart + u64.view(WalRecordHeader.version.offset), 2u8,
		u64.!(WalLayout.RECORD_VERSION));
	tc.assertStore(recorder.events[field++], u64.!(field),
		recordStart + u64.view(WalRecordHeader.headerSize.offset), 2u8,
		u64.!(WalRecordHeader.size));
	tc.assertStore(recorder.events[field++], u64.!(field),
		recordStart + u64.view(WalRecordHeader.entrySize.offset), 2u8,
		u64.!(WalEntry.size));
	tc.assertStore(recorder.events[field++], u64.!(field),
		recordStart + u64.view(WalRecordHeader.recordLen.offset), 4u8, recordLen);
	tc.assertStore(recorder.events[field++], u64.!(field),
		recordStart + u64.view(WalRecordHeader.entryCount.offset), 4u8, 1u64);
	tc.assertStore(recorder.events[field++], u64.!(field),
		recordStart + u64.view(WalRecordHeader.logEpoch.offset), 8u8, 0u64);
	tc.assertStore(recorder.events[field++], u64.!(field),
		recordStart + u64.view(WalRecordHeader.txnSeq.offset), 8u8, 1u64);
	def entryStart = recordStart + u64.!(WalRecordHeader.size);
	tc.assertStore(recorder.events[field++], u64.!(field), entryStart,
		8u8, 200u64);
	tc.assertStore(recorder.events[field++], u64.!(field),
		entryStart + u64.view(WalEntry.value.offset), 8u8, value);
	tc.assertStore(recorder.events[field++], u64.!(field),
		entryStart + u64.view(WalEntry.width.offset), 1u8, 8u64);
	def trailerStart = entryStart + u64.!(WalEntry.size);
	tc.assertStore(recorder.events[field++], u64.!(field), trailerStart,
		8u8, WalLayout.TRAILER_MAGIC);
	tc.assertStore(recorder.events[field++], u64.!(field),
		trailerStart + u64.view(WalRecordTrailer.recordLen.offset), 4u8, recordLen);
	tc.assertStore(recorder.events[field++], u64.!(field),
		trailerStart + u64.view(WalRecordTrailer.entryCount.offset), 4u8, 1u64);
	tc.assertStore(recorder.events[field++], u64.!(field),
		trailerStart + u64.view(WalRecordTrailer.logEpoch.offset), 8u8, 0u64);
	tc.assertStore(recorder.events[field++], u64.!(field),
		trailerStart + u64.view(WalRecordTrailer.txnSeq.offset), 8u8, 1u64);
	def checksumOffset = trailerStart + u64.view(WalRecordTrailer.checksum.offset);
	tc.assertStore(recorder.events[field++], u64.!(field), checksumOffset,
		8u8, 0u64);
	def publishedChecksum = Pointer.atElement(region.range, int.!(checksumOffset)).load<u64>();
	tc.assertStore(recorder.events[field++], u64.!(field), checksumOffset,
		8u8, publishedChecksum);
	tc.t.assert_eq(field, firstClwb);
	def expectedRecordLines = [1536u64, 1600u64, 1664u64];
	for (i < expectedRecordLines.length) {
		def event = recorder.events[firstClwb + i];
		tc.t.assertz(true, event.kind == PersistenceEventKind.CLWB);
		tc.t.assert_eq(expectedRecordLines[i], event.offset);
	}
	def commitFence = firstClwb + expectedRecordLines.length;
	tc.t.assert_eq(commitFence + 1, recorder.events.length);
	tc.t.assertz(true, recorder.events[commitFence].kind == PersistenceEventKind.SFENCE);

	tc.t.assertz(true, wal.applyAfterImage(200u64, value, 8u8));
	tc.t.assert_eq(commitFence + 3, recorder.events.length);
	tc.assertStore(recorder.events[commitFence + 1],
		recorder.events[commitFence].seq + 1u64, 200u64, 8u8, value);
	tc.t.assertz(true, recorder.events[commitFence + 2].kind == PersistenceEventKind.CLWB);
	tc.t.assert_eq(192u64, recorder.events[commitFence + 2].offset);
	def beforeFlush = recorder.events.length;
	tc.t.assertz(true, wal.persistAfterImages());
	tc.t.assert_eq(beforeFlush + 1, recorder.events.length);
	tc.t.assertz(true, recorder.events[beforeFlush].kind == PersistenceEventKind.SFENCE);
	tc.assertSequences(recorder.events);
	region.close();
}

// Transaction N's after-image CLWB remains outstanding until transaction N+1
// commits. Its event precedes N+1's record construction and commit fence, and
// each commit still contributes exactly one boundary.
def test_persistent_dual_wal_two_transaction_trace(tc: ProviderTester) {
	def region = tc.makePmemRegion();
	if (region == null) {
		tc.t.fail("two-transaction trace mapping allocation failed");
		return;
	}
	def recorder = tc.recorderOf(region);
	def base = u64.view(Pointer.atElement(region.range, 0));
	def wal = TwoSlotWal.new(base, base + 1024u64, 1024u64, region, OpenMode.FORMAT);
	recorder.clear();

	wal.append(200u64, 0x11u64, 1u8);
	tc.t.assert_eq(1u64, wal.commit());
	wal.applyAfterImage(200u64, 0x11u64, 1u8);
	def afterFirst = recorder.events.length;
	tc.t.assertz(true, recorder.events[afterFirst - 1].kind == PersistenceEventKind.CLWB);
	tc.t.assert_eq(192u64, recorder.events[afterFirst - 1].offset);

	wal.append(201u64, 0x22u64, 1u8);
	tc.t.assert_eq(2u64, wal.commit());
	var fenceCount = 0;
	var secondFence = -1;
	for (i < recorder.events.length) {
		if (recorder.events[i].kind == PersistenceEventKind.SFENCE) {
			fenceCount++;
			if (fenceCount == 2) secondFence = i;
		}
	}
	tc.t.assert_eq(2, fenceCount);
	tc.t.assertz(true, secondFence > afterFirst);
	var eventIndex = afterFirst;
	while (eventIndex < secondFence) {
		tc.t.assertz(true, recorder.events[eventIndex].kind != PersistenceEventKind.SFENCE);
		eventIndex++;
	}
	wal.applyAfterImage(201u64, 0x22u64, 1u8);
	var afterApplyFenceCount = 0;
	for (i < recorder.events.length) {
		if (recorder.events[i].kind == PersistenceEventKind.SFENCE) afterApplyFenceCount++;
	}
	tc.t.assert_eq(2, afterApplyFenceCount); // applying transaction 2 adds no boundary
	tc.t.assertz(true, recorder.events[recorder.events.length - 1].kind == PersistenceEventKind.CLWB);
	tc.assertSequences(recorder.events);
	region.close();
}

// storeAfterImage() writes an after-image and nothing else; writeBackAfterImages() then
// writes each touched line back once, in ascending order, after every store.
// The after-images are stored out of address order to exercise the sort; 192
// and 200 share a line, 256 is on the next line (merged into one range), and
// 400 is on a line of its own.
def test_persistent_dual_wal_batched_apply_writes_each_line_back_once(tc: ProviderTester) {
	def region = tc.makePmemRegion();
	if (region == null) {
		tc.t.fail("batched-apply trace mapping allocation failed");
		return;
	}
	def recorder = tc.recorderOf(region);
	def base = u64.view(Pointer.atElement(region.range, 0));
	def wal = TwoSlotWal.new(base, base + 1024u64, 1024u64, region, OpenMode.FORMAT);
	def offsets = [400u64, 256u64, 200u64, 192u64];
	for (o in offsets) tc.t.assertz(true, wal.append(o, o + 1u64, 8u8));
	tc.t.assert_eq(1u64, wal.commit());
	def afterCommit = recorder.events.length;

	for (o in offsets) tc.t.assertz(true, wal.storeAfterImage(o, o + 1u64, 8u8));
	tc.t.assert_eq(afterCommit + offsets.length, recorder.events.length);
	for (i < offsets.length) {
		def e = recorder.events[afterCommit + i];
		tc.assertStore(e, e.seq, offsets[i], 8u8, offsets[i] + 1u64);
	}

	tc.t.assertz(true, wal.writeBackAfterImages());
	def expectedLines = [192u64, 256u64, 384u64];
	def firstClwb = afterCommit + offsets.length;
	tc.t.assert_eq(firstClwb + expectedLines.length, recorder.events.length);
	for (i < expectedLines.length) {
		def e = recorder.events[firstClwb + i];
		tc.t.assertz(true, e.kind == PersistenceEventKind.CLWB);
		tc.t.assert_eq(expectedLines[i], e.offset);
	}
	// Nothing left to prepare: a second call adds no events, and the explicit
	// boundary contributes only its fence.
	tc.t.assertz(true, wal.writeBackAfterImages());
	tc.t.assert_eq(firstClwb + expectedLines.length, recorder.events.length);
	tc.t.assertz(true, wal.persistAfterImages());
	tc.t.assert_eq(firstClwb + expectedLines.length + 1, recorder.events.length);
	tc.t.assertz(true, recorder.events[recorder.events.length - 1].kind == PersistenceEventKind.SFENCE);
	tc.t.assert_eq(1u64, wal.dataDurableSeq);
	tc.assertSequences(recorder.events);
	region.close();
}

// The preparation is the applier's to place but not its to forget: an
// after-image stored and never prepared is written back by the next boundary
// that claims it -- the next commit's, or persistAfterImages()'s -- before
// that boundary's fence.
def test_persistent_dual_wal_boundaries_drain_unprepared_after_images(tc: ProviderTester) {
	def region = tc.makePmemRegion();
	if (region == null) {
		tc.t.fail("drain trace mapping allocation failed");
		return;
	}
	def recorder = tc.recorderOf(region);
	def base = u64.view(Pointer.atElement(region.range, 0));
	def wal = TwoSlotWal.new(base, base + 1024u64, 1024u64, region, OpenMode.FORMAT);
	recorder.clear();

	tc.t.assertz(true, wal.append(200u64, 0x11u64, 8u8));
	tc.t.assert_eq(1u64, wal.commit());
	tc.t.assertz(true, wal.storeAfterImage(200u64, 0x11u64, 8u8));
	def storedFirst = recorder.events.length;
	tc.t.assertz(true, wal.append(264u64, 0x22u64, 8u8));
	tc.t.assert_eq(2u64, wal.commit());
	tc.t.assert_eq(1u64, wal.dataDurableSeq);
	tc.t.assertz(true, tc.clwbBeforeLastFence(recorder, storedFirst, 192u64));

	tc.t.assertz(true, wal.storeAfterImage(264u64, 0x22u64, 8u8));
	def storedSecond = recorder.events.length;
	tc.t.assertz(true, wal.persistAfterImages());
	tc.t.assert_eq(2u64, wal.dataDurableSeq);
	tc.t.assertz(true, tc.clwbBeforeLastFence(recorder, storedSecond, 256u64));
	tc.assertSequences(recorder.events);
	region.close();
}

// Through the allocator's transaction facade: eleven u64 writes over three
// lines -- a full line, the line after it, and a line two further on -- are
// written back as three line writebacks, after all eleven stores.
def test_persistent_pwregion_txn_writes_each_line_back_once(tc: ProviderTester) {
	def backend = TraceAllocatorBackend.new();
	def region = RegionAllocator.new(backend, TraceAllocators.BLOCKS, tc.noDescs(),
		TraceAllocators.BLOCK_SIZE, OpenMode.FORMAT);
	if (backend.region == null) {
		tc.t.fail("txn trace mapping allocation failed");
		return;
	}
	def chunk = region.allocChunk(1u32);
	tc.t.assertz(false, chunk.isNull());
	def line0 = (chunk.addr + u64.!(ChunkHeader.size) + 63u64) & ~63u64;
	def writes = Vector<u64>.new();
	for (i < 8) writes.put(line0 + u64.!(i * 8));
	writes.put(line0 + 64u64);
	writes.put(line0 + 192u64);
	writes.put(line0 + 200u64);
	def regionStart = region.txn.regionStart;
	def expectedLines = [line0 - regionStart, line0 + 64u64 - regionStart, line0 + 192u64 - regionStart];
	def recorder = backend.recorder();

	recorder.clear();
	for (i < writes.length) region.txn.writeU64(writes[i], 0x1000u64 + u64.!(i));
	tc.t.assertz(true, region.txn.commit());
	def fence = tc.firstFence(recorder.events);
	tc.t.assertz(true, fence > 0);
	var stores = 0, clwbs = 0;
	for (i = fence + 1; i < recorder.events.length; i++) {
		def e = recorder.events[i];
		if (e.kind == PersistenceEventKind.STORE) {
			tc.t.assert_eq(0, clwbs);	// every store precedes every writeback
			stores++;
		} else if (e.kind == PersistenceEventKind.CLWB) {
			tc.t.assert_eq(expectedLines[clwbs], e.offset);
			clwbs++;
		}
	}
	tc.t.assert_eq(writes.length, stores);
	tc.t.assert_eq(expectedLines.length, clwbs);
	tc.assertSequences(recorder.events);
	region.deallocate();
}

// The store audit's core regression: RegionAllocator.format() builds the entire region
// image through the seam, so a recorded trace is a complete description of what
// was written. Asserted structurally -- the trace is several hundred events, and
// pinning each one would break on any benign layout change.
def test_persistent_pwregion_format_trace(tc: ProviderTester) {
	def backend = TraceAllocatorBackend.new();
	def region = RegionAllocator.new(backend, TraceAllocators.BLOCKS, tc.noDescs(),
		TraceAllocators.BLOCK_SIZE, OpenMode.FORMAT);
	if (backend.region == null) {
		tc.t.fail("format trace mapping allocation failed");
		return;
	}
	tc.t.assertz(true, region.backendRegion != null);
	def events = backend.recorder().events;
	def size = TraceAllocators.SIZE;

	tc.assertSequences(events);
	tc.assertStoreContract(events, size);

	// Structural coverage: every field format() is responsible for is written,
	// and the two known holes stay holes.
	def covered = tc.storeCoverage(events, size);
	tc.assertCovered(covered, 0u64, 40u64, true);           // blockTable..numDescs
	// RegionHeader.metadata (+40) is deliberately never written by format();
	// it keeps its zero-initialized value. Asserted so the hole is documented
	// rather than silently absorbed by a weaker check.
	tc.assertCovered(covered, 40u64, 8u64, false);
	tc.assertCovered(covered, 48u64, 40u64, true);          // metadataDescriptors..userRoot
	tc.assertBlockEntriesCovered(covered, TraceAllocators.SENTINEL_START,
		TraceAllocators.SENTINEL_COUNT);
	tc.assertBlockEntriesCovered(covered, TraceAllocators.BLOCK_TABLE_START,
		TraceAllocators.BLOCK_TABLE_ENTRIES);

	// One total order: the WAL's own fresh-header stores are interleaved into
	// RegionAllocator's linkage stores, bounded by the logBlock field store that
	// precedes ensureWal() and the magic store that ends format().
	def logBlockField = tc.indexOfStore(events, u64.view(RegionHeader.logBlock.offset));
	def magicField = tc.indexOfStore(events, u64.view(RegionHeader.magic.offset));
	tc.t.assertz(true, logBlockField >= 0);
	tc.t.assertz(true, magicField > logBlockField);
	var sawLogBlockStore = false;
	for (i < events.length) {
		def e = events[i];
		if (e.kind != PersistenceEventKind.STORE) continue;
		if (e.offset < TraceAllocators.LOG_CHUNK_START) continue;
		if (e.offset >= TraceAllocators.LOG_CHUNK_END) continue;
		sawLogBlockStore = true;
		tc.t.assertz(true, i > logBlockField && i < magicField);
	}
	tc.t.assertz(true, sawLogBlockStore);

	// Publication, in two steps: format() flushes the whole region under one
	// fence before the magic is stored, then stores the magic and writes its
	// line back under a fence of its own. The magic store is the last store,
	// and nothing is written between the whole-region run and it.
	def lines = int.!(size / 64u64);
	def last = events.length - 1;
	tc.t.assertz(true, events[last].kind == PersistenceEventKind.SFENCE);
	tc.t.assertz(true, events[last - 1].kind == PersistenceEventKind.CLWB);
	tc.t.assert_eq(0u64, events[last - 1].offset);  // the magic's line
	tc.t.assert_eq(last - 2, magicField);
	def fenceIndex = magicField - 1;
	def runStart = fenceIndex - lines;
	tc.t.assertz(true, events[fenceIndex].kind == PersistenceEventKind.SFENCE);
	for (i < lines) {
		def e = events[runStart + i];
		tc.t.assertz(true, e.kind == PersistenceEventKind.CLWB);
		tc.t.assert_eq(u64.!(i) * 64u64, e.offset);
	}
	tc.t.assertz(true, events[runStart - 1].kind == PersistenceEventKind.STORE);
	region.deallocate();
}

// Descriptor fields are the only place the allocator needs a 4-byte store, so
// this pins the u32/u64 width split that a Ref<> field assignment used to hide.
def test_persistent_pwregion_format_descriptor_trace(tc: ProviderTester) {
	def backend = TraceAllocatorBackend.new();
	def descs = tc.twoDescs();
	def region = RegionAllocator.new(backend, TraceAllocators.BLOCKS, descs,
		TraceAllocators.BLOCK_SIZE, OpenMode.FORMAT);
	if (backend.region == null) {
		tc.t.fail("descriptor trace mapping allocation failed");
		return;
	}
	def events = backend.recorder().events;
	tc.assertStoreContract(events, TraceAllocators.SIZE);

	def hdr = region.getHeader();
	tc.t.assert_eq(2u64, hdr.numDescs);
	def descsOffset = hdr.metadataDescriptors;

	for (d < 2) {
		def base = descsOffset + u64.!(d) * u64.!(MetadataDescriptor.size);
		def source = descs[d];
		// Exactly five stores land in this descriptor, in field order.
		def found = Vector<PersistenceEvent>.new();
		for (i < events.length) {
			def e = events[i];
			if (e.kind != PersistenceEventKind.STORE) continue;
			if (e.offset < base) continue;
			if (e.offset >= base + u64.!(MetadataDescriptor.size)) continue;
			found.put(e);
		}
		tc.t.assert_eq(5, found.length);
		tc.assertStore(found[0], found[0].seq,
			base + u64.view(MetadataDescriptor.kind.offset), 8u8, source.kind);
		tc.assertStore(found[1], found[1].seq,
			base + u64.view(MetadataDescriptor.fixedBytes.offset), 4u8, u64.!(source.fixedBytes));
		tc.assertStore(found[2], found[2].seq,
			base + u64.view(MetadataDescriptor.unitSize.offset), 4u8, u64.!(source.unitSize));
		tc.assertStore(found[3], found[3].seq,
			base + u64.view(MetadataDescriptor.bytesPerUnit.offset), 4u8, u64.!(source.bytesPerUnit));
		tc.assertStore(found[4], found[4].seq,
			base + u64.view(MetadataDescriptor.offset.offset), 8u8,
			region.getMetadataDescriptor(u64.!(d)).offset);
	}

	// The 4-byte layout gap at +20 is never stored.
	def covered = tc.storeCoverage(events, TraceAllocators.SIZE);
	for (d < 2) {
		def base = descsOffset + u64.!(d) * u64.!(MetadataDescriptor.size);
		tc.assertCovered(covered, base + 20u64, 4u64, false);
	}
	region.deallocate();
}

// Once the region is mounted, allocator mutations must reach the region only as
// WAL after-images applied *after* the commit boundary. With every store now
// observable, that ordering is directly checkable rather than inferred.
def test_persistent_pwregion_alloc_applies_after_commit_boundary(tc: ProviderTester) {
	def backend = TraceAllocatorBackend.new();
	def region = RegionAllocator.new(backend, TraceAllocators.BLOCKS, tc.noDescs(),
		TraceAllocators.BLOCK_SIZE, OpenMode.FORMAT);
	if (backend.region == null) {
		tc.t.fail("alloc trace mapping allocation failed");
		return;
	}
	def recorder = backend.recorder();
	recorder.clear();

	def chunk = region.allocChunk(1u32);
	tc.t.assertz(false, chunk.isNull());
	def events = recorder.events;
	tc.assertSequences(events);
	tc.assertStoreContract(events, TraceAllocators.SIZE);

	// The commit point is the first fence of the transaction.
	var commitFence = -1;
	for (i < events.length) {
		if (commitFence < 0 && events[i].kind == PersistenceEventKind.SFENCE) commitFence = i;
	}
	tc.t.assertz(true, commitFence > 0);

	var sawRecordStore = false;
	var sawAfterImage = false;
	for (i < events.length) {
		def e = events[i];
		if (e.kind != PersistenceEventKind.STORE) continue;
		def inLog = e.offset >= TraceAllocators.LOG_CHUNK_START
			&& e.offset < TraceAllocators.LOG_CHUNK_END;
		if (inLog) {
			// Record construction precedes the commit boundary.
			sawRecordStore = true;
			tc.t.assertz(true, i < commitFence);
		} else {
			// Region data is only written after its redo record is durable.
			sawAfterImage = true;
			tc.t.assertz(true, i > commitFence);
			// The region header is written by format() alone.
			tc.t.assertz(true, e.offset >= TraceAllocators.SENTINEL_START);
		}
	}
	tc.t.assertz(true, sawRecordStore);
	tc.t.assertz(true, sawAfterImage);
	region.deallocate();
}

// Immix line marks are deliberately transient: they bypass the WAL, and no
// writeback or fence is issued for them. Their stores still cross the seam like
// every other store the allocator makes, so a trace records each one as a 1-byte
// store at the mark's region-relative offset, and nothing else. The offsets
// are derived from the on-region descriptor, not from the handle's own code.
def test_persistent_immix_line_marks_cross_the_seam(tc: ProviderTester) {
	def backend = TraceAllocatorBackend.new();
	def region = ImmixRegionAllocator.new(backend, TraceAllocators.BLOCKS, tc.lineDescs(),
		TraceAllocators.BLOCK_SIZE, OpenMode.FORMAT);
	if (backend.region == null) {
		tc.t.fail("line-mark trace mapping allocation failed");
		return;
	}
	tc.t.assertz(true, region.backendRegion != null);
	def desc = region.getMetadataDescriptor(0u64);
	def firstMark = desc.offset + u64.!(desc.fixedBytes);
	def marks = TraceAllocators.SIZE / u64.!(ImmixLineMarks.DefaultImmixLineSize);
	tc.t.assert_eq(marks, region.numLineMarks);
	def recorder = backend.recorder();
	recorder.clear();

	// One mark set: one store, and the mark reads back through the forged ref.
	def mark = region.lineMarks[3u64];
	mark.setMarkUnlogged(region.lineMarkWriter(), ImmixLineMarks.LINE_MARKED);
	tc.t.assert_eq(1, recorder.events.length);
	tc.assertStore(recorder.events[0], 1u64, firstMark + 3u64 * u64.!(LineMark.size),
		1u8, u64.!(ImmixLineMarks.LINE_MARKED));
	tc.t.assert_eq(ImmixLineMarks.LINE_MARKED, mark.getMarkInRegion(region.reader()));

	// A reset: one store per mark, in table order, each a STORE event, so
	// none is a writeback or a fence.
	recorder.clear();
	region.resetAllLineMarks();
	def events = recorder.events;
	tc.t.assert_eq(int.!(marks), events.length);
	for (i < events.length) {
		tc.assertStore(events[i], u64.!(i + 1), firstMark + u64.!(i) * u64.!(LineMark.size),
			1u8, u64.!(ImmixLineMarks.ImmixLineMarkResetValue));
	}
	tc.assertSequences(events);
	tc.assertStoreContract(events, TraceAllocators.SIZE);
	tc.t.assert_eq(ImmixLineMarks.ImmixLineMarkResetValue, mark.getMarkInRegion(region.reader()));
	region.deallocate();
}

// Reopen and invoke the production recovery implementation against the same
// recorded record. Replay uses the identical store seam and its completing
// writeback/fence are visible in the same total order.
def test_persistent_dual_wal_recovery_trace(tc: ProviderTester) {
	def region = tc.makePmemRegion();
	if (region == null) {
		tc.t.fail("recovery trace mapping allocation failed");
		return;
	}
	def recorder = tc.recorderOf(region);
	def base = u64.view(Pointer.atElement(region.range, 0));
	def wal = TwoSlotWal.new(base, base + 1024u64, 1024u64, region, OpenMode.FORMAT);
	wal.append(200u64, 0xA5u64, 1u8);
	tc.t.assert_eq(1u64, wal.commit());
	recorder.clear();

	def reopened = TwoSlotWal.new(base, base + 1024u64, 1024u64, region, OpenMode.ATTACH);
	tc.t.assertz(true, reopened.recover() == WalRecovery.REPLAYED);
	tc.t.assert_eq(3, recorder.events.length);
	tc.assertStore(recorder.events[0], 1u64, 200u64, 1u8, 0xA5u64);
	tc.t.assertz(true, recorder.events[1].kind == PersistenceEventKind.CLWB);
	tc.t.assert_eq(192u64, recorder.events[1].offset);
	tc.t.assertz(true, recorder.events[2].kind == PersistenceEventKind.SFENCE);
	tc.assertSequences(recorder.events);
	tc.t.assert_eq(0xA5u8, region.range[200]);
	region.close();
}

// ---------------------------------------------------------------------------
// The load seam: RegionReader and LoadObserver.
// ---------------------------------------------------------------------------

// What one mount of a crash image did: the verdict of the check run over it,
// the recovery it performed, and every store, writeback, fence and load it
// made, in their recorded order.
class LoadAuditRun(verdict: string, recovery: WalRecovery,
	stores: Array<PersistenceEvent>, loads: Array<LoadEvent>) {

	// Bytes the run loaded or stored: the bytes that can affect it.
	def touched(regionBytes: int) -> Array<bool> {
		def mask = Array<bool>.new(regionBytes);
		for (e in loads) {
			if (e.bytes == null) continue;
			for (b < e.bytes.length) mask[int.!(e.offset) + b] = true;
		}
		for (e in stores) {
			if (e.kind != PersistenceEventKind.STORE) continue;
			for (b < int.view(e.width)) mask[int.!(e.offset) + b] = true;
		}
		return mask;
	}

	// The first way {that} differs from this run, or null.
	def difference(that: LoadAuditRun) -> string {
		if (recovery != that.recovery) return "recovery outcome differs";
		if (verdict == null) {
			if (that.verdict != null) return "verdict differs";
		} else if (that.verdict == null || !Strings.equal(verdict, that.verdict)) {
			return "verdict differs";
		}
		if (stores.length != that.stores.length) return "number of persistent operations differs";
		for (i < stores.length) {
			def x = stores[i], y = that.stores[i];
			if (x.seq != y.seq || x.kind != y.kind || x.offset != y.offset
				|| x.width != y.width || x.value != y.value) {
				return Strings.format1("persistent operation %d differs", i);
			}
		}
		if (loads.length != that.loads.length) return "number of loads differs";
		for (i < loads.length) {
			if (!loads[i].same(that.loads[i])) {
				return loads[i].render(Strings.builderOf("load differs: ")).toString();
			}
		}
		return null;
	}
}

component LoadAudits {
	// The offsets of the observations {loads} recorded that cover {nodeBytes}
	// bytes, a B+Tree node's payload, in order; only those made before any
	// store after the first {before} events, unless {before} is negative.
	def nodeObserves(loads: RecordingLoadObserver, nodeBytes: u64, before: int) -> Array<u64> {
		def v = Vector<u64>.new();
		for (i < loads.loads.length) {
			def e = loads.loads[i];
			if (before >= 0 && e.afterEvents > before) break;
			if (e.length == nodeBytes) v.put(e.offset);
		}
		return v.extract();
	}

	// Mount {image} as production mounts a region, through a recording PMEM
	// container with loads recorded too, run {check} over the mounted
	// region, and keep what the mount, the recovery and the check did.
	def run(image: CrashImage, numBlocks: u64, blockSize: u64,
		check: RegionAllocator -> string) -> LoadAuditRun {

		def mount = CrashImageMounts.openMapped(image, true);
		if (mount == null) return null;
		def loads = mount.recorder.recordLoads();
		def region = RegionAllocator.new(PreparedStorageBackend.new(mount.region), numBlocks,
			Array<Ref<MetadataDescriptor>>.new(0), blockSize, OpenMode.ATTACH);
		if (region.backendRegion == null) {
			return LoadAuditRun.new("did not mount", WalRecovery.CLEAN,
				mount.recorder.events.copy(), loads.loads.copy());
		}
		def verdict = check(region);
		def result = LoadAuditRun.new(verdict, region.lastRecovery,
			mount.recorder.events.copy(), loads.loads.copy());
		region.deallocate();
		return result;
	}

	// {image} with every byte {keep} does not mark replaced by {fill}.
	def refill(image: CrashImage, keep: Array<bool>, fill: int -> byte) -> CrashImage {
		def bytes = Array<byte>.new(image.size());
		for (i < bytes.length) bytes[i] = if(keep[i], image.bytes[i], fill(i));
		return CrashImage.new(bytes);
	}

	def zeroes(i: int) -> byte { return 0x00u8; }
	def ones(i: int) -> byte { return 0xFFu8; }
	def hashed(i: int) -> byte {
		return u8.view((u64.!(i) * 0x9E37_79B9_7F4A_7C15_u64 + 0x5Au64) >> 56);
	}

	// Mount {image}, then mount it three more times with every byte the first
	// mount neither loaded nor stored set to 0x00, to 0xFF and to a hash of
	// its offset. Returns the first difference, or null. A load that reached
	// the region without being observed, and mattered, shows up here as a
	// difference in the loads, the stores or the verdict.
	def checkInert(image: CrashImage, numBlocks: u64, blockSize: u64,
		check: RegionAllocator -> string, outcomes: Array<int>) -> string {

		def first = run(image, numBlocks, blockSize, check);
		if (first == null) return "could not map the image";
		outcomes[first.recovery.tag]++;
		def keep = first.touched(image.size());
		def fills = [zeroes, ones, hashed];
		def names = ["0x00", "0xFF", "a hash pattern"];
		for (f < fills.length) {
			def again = run(refill(image, keep, fills[f]), numBlocks, blockSize, check);
			if (again == null) return "could not map the refilled image";
			def diff = first.difference(again);
			if (diff != null) {
				return StringBuilder.new().put2("unobserved bytes set to %s change the run: %s",
					names[f], diff).toString();
			}
		}
		return null;
	}

	// checkInert() over the lazy and the eager image at every {stride}th cut
	// of {trace}, and at its last cut. Fails {t} with the first difference.
	def sweepInert(t: Tester, trace: PersistenceTrace, initial: Array<byte>,
		numBlocks: u64, blockSize: u64, stride: int, check: RegionAllocator -> string) -> Array<int> {

		def outcomes = Array<int>.new(WalRecovery.PERSIST_FAILED.tag + 1);
		var cut = 0;
		while (true) {
			def images = [CrashImages.lazyCrash(trace, initial, cut),
				CrashImages.eagerCrash(trace, initial, cut)];
			for (image in images) {
				def diff = checkInert(image, numBlocks, blockSize, check, outcomes);
				if (diff != null) {
					t.fail(StringBuilder.new().put2("cut %d: %s", cut, diff).toString());
					return outcomes;
				}
			}
			if (cut == trace.length()) break;
			cut += stride;
			if (cut > trace.length()) cut = trace.length();
		}
		return outcomes;
	}
}

// Checks run over a mounted image by the inert-bytes audits.
class LoadAuditChecks(capacity: int, liveSegments: u64) {
	def allocator(region: RegionAllocator) -> string {
		return AllocatorInvariants.check(region);
	}

	def sieve(region: RegionAllocator) -> string {
		def bad = AllocatorInvariants.check(region);
		if (bad != null) return bad;
		def sieve = PWSieve.new(region, liveSegments);
		if (!sieve.open()) return "sieve could not reattach to its root after recovery";
		return sieve.checkInvariants();
	}

	def btree(region: RegionAllocator) -> string {
		def bad = AllocatorInvariants.check(region);
		if (bad != null) return bad;
		def tree = PWBTree.new(region, capacity);
		if (!tree.open()) return "the tree could not reopen after recovery";
		return tree.checkInvariants();
	}
}

// With no observer installed, every reader load is the raw load it replaced:
// each width at every naturally aligned offset of a page of varied bytes, the
// region-relative form, and every field of each forged layout.
def test_persistent_reader_matches_raw(tc: ProviderTester) {
	def region = tc.makePmemRegion();
	if (region == null) {
		tc.t.fail("reader mapping allocation failed");
		return;
	}
	for (i < region.range.length) region.range[i] = u8.view(i * 37 + 11 + (i >> 8));
	def ops = region.provider();
	tc.t.assertz(true, ops.loadObserver == null);
	def base = u64.view(Pointer.atElement(region.range, 0));
	def r = RegionReader.new(ops, base);
	def raw = RegionUtils.pointerFromU64;
	def size = u64.!(region.range.length);

	for (off = 0u64; off < size; off++) {
		def a = base + off;
		tc.t.assert_eq(raw(a).load<u8>(), r.loadU8(a));
		if (off % 2u64 == 0u64) {
			tc.t.assert_eq(raw(a).load<u16>(), r.loadU16(a));
			tc.t.assert_eq(raw(a).load<i16>(), r.loadI16(a));
		}
		if (off % 4u64 == 0u64) tc.t.assert_eq(raw(a).load<u32>(), r.loadU32(a));
		if (off % 8u64 == 0u64) {
			tc.t.assert_eq(raw(a).load<u64>(), r.loadU64(a));
			tc.t.assert_eq(raw(a).load<i64>(), r.loadI64(a));
			tc.t.assert_eq(raw(a).load<u64>(), r.loadOffsetU64(off));
		}
	}

	def a = base + 512u64;
	def e = r.forgeBlockTableEntry(a);
	tc.t.assert_eq(raw(a).load<i16>(), e.listNum);
	tc.t.assert_eq(raw(a + 8u64).load<i64>(), e.prev);
	tc.t.assert_eq(raw(a + 16u64).load<i64>(), e.next);
	tc.t.assert_eq(raw(a + 24u64).load<i64>(), e.listPrev);
	tc.t.assert_eq(raw(a + 32u64).load<i64>(), e.listNext);
	def c = r.forgeChunkHeader(a);
	tc.t.assert_eq(raw(a).load<u64>(), c.offset);
	tc.t.assert_eq(raw(a + 8u64).load<u64>(), c.limit);
	tc.t.assert_eq(raw(a + 16u64).load<u64>(), c.chunk_limit);
	tc.t.assert_eq(raw(a + 24u64).load<u64>(), c.linemarks);
	tc.t.assert_eq(raw(a + 3u64).load<u8>(), r.forgeLineMark(a + 3u64).mark);
	def d = r.forgeMetadataDescriptor(a);
	tc.t.assert_eq(raw(a).load<u64>(), d.kind);
	tc.t.assert_eq(raw(a + 8u64).load<u32>(), d.fixedBytes);
	tc.t.assert_eq(raw(a + 12u64).load<u32>(), d.unitSize);
	tc.t.assert_eq(raw(a + 16u64).load<u32>(), d.bytesPerUnit);
	tc.t.assert_eq(raw(a + 24u64).load<u64>(), d.offset);
	def h = r.forgeWalHeader(a);
	tc.t.assert_eq(raw(a).load<u64>(), h.magic);
	tc.t.assert_eq(raw(a + 48u64).load<u64>(), h.checksum);
	def rh = r.forgeRecordHeader(a);
	tc.t.assert_eq(raw(a).load<u64>(), rh.magic);
	tc.t.assert_eq(raw(a + u64.view(WalRecordHeader.txnSeq.offset)).load<u64>(), rh.txnSeq);
	def ct = r.forgeRecordTrailer(a);
	tc.t.assert_eq(raw(a + u64.view(WalRecordTrailer.checksum.offset)).load<u64>(), ct.checksum);
	def le = r.forgeWalEntry(a);
	tc.t.assert_eq(raw(a).load<u64>(), le.offset);
	tc.t.assert_eq(raw(a + 8u64).load<u64>(), le.value);
	tc.t.assert_eq(raw(a + 16u64).load<u8>(), le.width);

	// The handles' getters are the reader's loads.
	def entry = BlockTableEntryHandle(a);
	tc.t.assert_eq(raw(a).load<i16>(), entry.getListNumInRegion(r));
	tc.t.assertz(raw(a + 2u64).load<u8>() == 1u8, entry.getUsedInRegion(r));
	tc.t.assert_eq(u64.view(i64.view(a) + raw(a + 16u64).load<i64>()), entry.getNextInRegion(r).addr);
	def chunk = ChunkHandle(a);
	tc.t.assert_eq(raw(a + 8u64).load<u64>(), chunk.getLimitInRegion(r));
	tc.t.assert_eq(raw(a + 24u64).load<u64>(), chunk.getLinemarksInRegion(r));
	tc.t.assert_eq(raw(a + 5u64).load<u8>(), LineMarkHandle(a + 5u64).getMarkInRegion(r));

	// Reading through the seam stores nothing.
	tc.t.asserti(0, tc.recorderOf(region).events.length);
	region.close();
}

// Rewrites each observed range with one byte value, so a test can tell
// whether the load that follows saw the observer's bytes.
class RewritingLoadObserver(range: Range<byte>) extends LoadObserver {
	var fill = 0u8;
	var calls = 0;

	def beforeLoad(offset: u64, length: u64) {
		calls++;
		for (i < int.!(length)) range[int.!(offset) + i] = fill;
	}
}

// The observer contract: beforeLoad() runs before the load, over region-relative
// offsets, and what it writes is what the code loads. A recorder installed in
// front of it records the rewritten bytes, and neither adds a trace event.
def test_persistent_load_observer_runs_before_the_load(tc: ProviderTester) {
	def region = tc.makePmemRegion();
	if (region == null) {
		tc.t.fail("observer mapping allocation failed");
		return;
	}
	def ops = region.provider();
	def base = u64.view(Pointer.atElement(region.range, 0));
	def r = RegionReader.new(ops, base);
	def rewrite = RewritingLoadObserver.new(region.range);
	ops.loadObserver = rewrite;

	rewrite.fill = 0x5Au8;
	tc.t.assert_eq(0x5A5A_5A5A_5A5A_5A5A_u64, r.loadU64(base + 64u64));
	tc.t.assert_eq(0x5A5Au16, r.loadU16(base + 130u64));
	rewrite.fill = 0x01u8;
	def e = r.forgeBlockTableEntry(base + 256u64);
	tc.t.assert_eq(0x0101_0101_0101_0101_i64, e.listNext);	// observed once, for the whole layout
	tc.t.asserti(3, rewrite.calls);
	r.beforeLoad(base + 1000u64, 0u64);			// an empty range is not reported
	tc.t.asserti(3, rewrite.calls);

	def recorder = tc.recorderOf(region);
	def loads = recorder.recordLoads();
	tc.t.assertz(true, ops.loadObserver == loads);
	tc.t.assertz(true, loads.inner == rewrite);
	rewrite.fill = 0xC3u8;
	recorder.storeU8(8u64, 0x77u8);
	tc.t.assert_eq(0xC3u8, r.loadU8(base + 9u64));
	tc.t.assert_eq(0xC3C3u16, r.loadU16(base + 2048u64));
	tc.t.asserti(2, loads.loads.length);
	def first = loads.loads[0];
	tc.t.asserti(1, first.afterEvents);	// after the one store
	tc.t.assert_eq(9u64, first.offset);
	tc.t.assert_eq(1u64, first.length);
	tc.t.assert_eq(0xC3u64, first.value());
	tc.t.assert_eq(2048u64, loads.loads[1].offset);
	tc.t.assert_eq(0xC3C3u64, loads.loads[1].value());
	tc.t.asserti(0, loads.outside());
	// Loads never enter the trace.
	tc.t.asserti(1, recorder.events.length);
	tc.t.assertz(true, recorder.snapshot("loads").validate().ok());
	recorder.clear();
	tc.t.asserti(0, loads.loads.length);
	region.close();
}

// The load audit's core regression, the counterpart of the store audit: a
// mount, its recovery and the allocator's invariant walk load every byte they
// depend on through the seam. Format, commit a short history, take the bytes
// without close() (so both slots hold records to replay), mount them with a
// recording observer, recover and walk. Asserted structurally: the header
// fields mount reads, the WAL header and both records, every block entry the
// walk visits and the free-list heads; and the header fields mount does not
// read stay unobserved, so the audit cannot pass by observing everything.
def test_persistent_load_audit_covers_fields(tc: ProviderTester) {
	def backend = TraceAllocatorBackend.new();
	def region = RegionAllocator.new(backend, TraceAllocators.BLOCKS, tc.noDescs(),
		TraceAllocators.BLOCK_SIZE, OpenMode.FORMAT);
	if (backend.region == null) {
		tc.t.fail("load audit mapping allocation failed");
		return;
	}
	def first = region.allocChunk(1u32);
	def second = region.allocChunk(2u32);
	tc.t.assertz(false, first.isNull() || second.isNull());
	tc.t.assertz(true, region.freeChunk(first));
	def bytes = Array<byte>.new(region.rng.length);
	for (i < bytes.length) bytes[i] = region.rng[i];
	region.deallocate();
	def image = CrashImage.new(bytes);

	def mount = CrashImageMounts.openMapped(image, true);
	if (mount == null) {
		tc.t.fail("load audit mount allocation failed");
		return;
	}
	def loads = mount.recorder.recordLoads();
	def mounted = RegionAllocator.new(PreparedStorageBackend.new(mount.region), TraceAllocators.BLOCKS,
		tc.noDescs(), TraceAllocators.BLOCK_SIZE, OpenMode.ATTACH);
	tc.t.assertz(true, mounted.backendRegion != null);
	tc.t.assertz(true, mounted.lastRecovery == WalRecovery.REPLAYED);
	def violation = AllocatorInvariants.check(mounted);
	if (violation != null) tc.t.fail(violation);
	def afterWalk = loads.loads.length;
	// A transaction read that misses its write-behind cache reads the region.
	tc.t.assert_eq(0u64, mounted.getUserRoot());
	if (loads.loads.length != afterWalk + 1) {
		tc.t.fail("a transaction read that missed its cache was not observed");
		mounted.deallocate();
		return;
	}
	def rootLoad = loads.loads[afterWalk];
	tc.t.assert_eq(u64.view(RegionHeader.userRoot.offset), rootLoad.offset);
	tc.t.assert_eq(8u64, rootLoad.length);

	// Mount reads the magic before anything else, and before any store.
	def magic = loads.loads[0];
	tc.t.asserti(0, magic.afterEvents);
	tc.t.assert_eq(u64.view(RegionHeader.magic.offset), magic.offset);
	tc.t.assert_eq(8u64, magic.length);
	tc.t.assert_eq(RegionFormat.MAGIC, magic.value());

	// Every load lies in the region and is placed in the store order; the
	// trace itself stays modelable.
	tc.t.asserti(0, loads.outside());
	var last = 0;
	for (i < loads.loads.length) {
		def at = loads.loads[i].afterEvents;
		tc.t.assertz(true, at >= last && at <= mount.recorder.events.length);
		last = at;
	}
	tc.t.assertz(true, mount.recorder.snapshot("mount").validate().ok());

	def covered = loads.coverage();
	// Header: blockTable, sentinels, numBlocks; magic, blockSize, logBlock.
	tc.assertCovered(covered, 0u64, 24u64, true);
	tc.assertCovered(covered, 56u64, 24u64, true);
	// numBytes, numDescs, metadata and metadataDescriptors are not read by a mount
	// without descriptors; userRoot is, but only by getUserRoot() above.
	tc.assertCovered(covered, 24u64, 32u64, false);
	// The WAL header, whole: its fields, then its checksum over the rest.
	def log = TraceAllocators.LOG_CHUNK_START;
	tc.assertCovered(covered, log, u64.!(WalHeader.size), true);
	// Both records, whole, and nothing of either slot beyond its record.
	def slotBytes = ((TraceAllocators.BLOCK_SIZE - u64.!(WalHeader.size)) / 2u64) & ~63u64;
	for (slot < 2) {
		def start = log + u64.!(WalHeader.size) + u64.!(slot) * slotBytes;
		def recordLen = u64.!(image.read(start + u64.view(WalRecordHeader.recordLen.offset), 4));
		tc.t.assertz(true, recordLen > 0u64 && recordLen < slotBytes);
		tc.assertCovered(covered, start, recordLen, true);
		tc.assertCovered(covered, start + recordLen, 64u64, false);
	}
	// Every entry in memory order, read from the recovered region, and the
	// two free-list heads.
	def walk = RegionReader.new(NativeProvider.new(mount.region.range), mounted.regionStart);
	var entry = mounted.blockTableHandle[0u64];
	var visited = 0;
	while (!entry.isNull() && visited <= int.!(TraceAllocators.BLOCKS)) {
		tc.assertBlockEntriesCovered(covered, entry.addr - mounted.regionStart, 1u64);
		entry = entry.getNextInRegion(walk);
		visited++;
	}
	tc.t.assertz(true, visited >= 4);
	for (kind in [FreeListKind.SMALL_FREE, FreeListKind.LARGE_FREE]) {
		def head = mounted.sentinels[u64.!(kind.code)].addr - mounted.regionStart;
		tc.assertCovered(covered, head + u64.view(BlockTableEntry.listNext.offset), 8u64, true);
	}
	mounted.deallocate();
}

// The inert-bytes audit. A run that loads a byte without observing it can
// depend on it unseen; so mount, recover and walk a crash image with loads
// recorded, then again with every byte the run neither observed nor stored set
// to 0x00, 0xFF and a hash pattern. The loads (offset, length and bytes), the
// stores, the recovery outcome and the verdict must not change. Images: the
// lazy and the eager one at every cut of a recorded two-allocation scenario,
// so both a replaying and a clean recovery are covered.
def test_persistent_load_audit_unobserved_bytes_inert(tc: ProviderTester) {
	def at = AllocatorCrashTester.new(tc.t);
	if (!at.openRecordingRegion()) {
		tc.t.fail("could not format a recording RegionAllocator");
		return;
	}
	def trace = at.recordAllocations(2, "load_audit_two_allocations");
	def mounted = at.mounted;
	at.cleanup();
	if (trace == null) return;
	def checks = LoadAuditChecks.new(0, 0u64);
	def outcomes = LoadAudits.sweepInert(tc.t, trace, mounted, at.BLOCKS,
		at.BLOCK_SIZE, 1, checks.allocator);
	tc.t.assertz(true, outcomes[WalRecovery.CLEAN.tag] > 0);
	tc.t.assertz(true, outcomes[WalRecovery.REPLAYED.tag] > 0);
}

// The same audit over the sieve's reattach: recovery, the allocator walk,
// PWSieve.open() (which may free leaked extents) and the sieve's invariants,
// over the images of one recorded step.
def test_persistent_load_audit_sieve_reattach_inert(tc: ProviderTester) {
	def st = SieveCrashTester.new(tc.t);
	if (!st.openRecordingSieve()) {
		tc.t.fail("could not lay out a recording sieve");
		return;
	}
	def trace = st.recordStep("load_audit_sieve_step");
	def mounted = st.mounted;
	st.cleanup();
	if (trace == null) return;
	def checks = LoadAuditChecks.new(0, st.LIVE);
	def outcomes = LoadAudits.sweepInert(tc.t, trace, mounted, st.BLOCKS,
		st.BLOCK_SIZE, 1, checks.sieve);
	tc.t.assertz(true, outcomes[WalRecovery.REPLAYED.tag] > 0);
}

// And over the B+Tree's reattach: recovery, the allocator walk, PWBTree.open()
// (its invariants and leak sweep) and checkInvariants(), over the images of an
// update at height 3, at every cut, as the other two audits run (2,968 cuts,
// 5,936 images, each mounted four times; every fourth cut until 2026-10-27).
def test_persistent_load_audit_btree_reattach_inert(tc: ProviderTester) {
	def bt = BTreeCrashTester.new(tc.t);
	def trace = bt.recordUpdate("load_audit_btree_update");
	def mounted = bt.mounted;
	bt.cleanup();
	if (trace == null) return;
	def checks = LoadAuditChecks.new(bt.CAPACITY, 0u64);
	def outcomes = LoadAudits.sweepInert(tc.t, trace, mounted, bt.BLOCKS,
		bt.BLOCK_SIZE, 1, checks.btree);
	tc.t.assertz(true, outcomes[WalRecovery.REPLAYED.tag] > 0);
}

// The descents of get() and put() fetch each node on the key's path through
// the reader. The reattach audit cannot tell: open() has walked, and so
// observed, every node before either could run. So, on a tree of height 3
// with loads recorded from then on: a lookup observes exactly three whole
// nodes, root first, each once and none twice; and a put of the same key
// observes the same three, in the same order, before its first store.
def test_persistent_load_audit_btree_descents_fetch_the_path(tc: ProviderTester) {
	def bt = BTreeCrashTester.new(tc.t);
	if (!bt.openRecordingTree()) {
		tc.t.fail("could not open the recording tree");
		bt.cleanup();
		return;
	}
	def n = bt.insertsToReach(3);
	if (n < 0 || !bt.insertRange(0, n)) {
		bt.cleanup();
		return;
	}
	def tree = bt.tree;
	tc.t.assert_eq(3u64, tree.height());
	def header = u64.!(ChunkHeader.size);
	def nodeBytes = (bt.BLOCK_SIZE - header) / 8u64 * 8u64;
	def key = u64.!(n / 2);
	def loads = bt.recorder.recordLoads();

	def got = tree.get(key);
	tc.t.assertz(true, got.0);
	def path = LoadAudits.nodeObserves(loads, nodeBytes, -1);
	if (path.length != 3) {
		tc.t.fail1("a lookup observed %d whole nodes, not one per level", path.length);
		bt.cleanup();
		return;
	}
	tc.t.assert_eq(tree.rootNode() + header, path[0]);
	tc.t.assertz(true, path[0] != path[1] && path[1] != path[2] && path[0] != path[2]);

	loads.clear();
	def start = bt.recorder.events.length;
	tc.t.assertz(true, tree.put(key, got.1 + 1u64));
	def before = LoadAudits.nodeObserves(loads, nodeBytes, start);
	if (before.length != 3) {
		tc.t.fail1("a put observed %d whole nodes before its first store, not one per level", before.length);
		bt.cleanup();
		return;
	}
	for (i < 3) tc.t.assert_eq(path[i], before[i]);
	bt.cleanup();
}

