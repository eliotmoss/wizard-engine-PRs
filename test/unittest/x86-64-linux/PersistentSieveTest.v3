// The resumable sieve run through the crash-image explorer.
//
// PWSieveTest checks the workload against real remounts, and pwsieve.main.v3
// checks it against real SIGKILLs. Both are single schedules: whatever the
// kernel and the hardware happened to do that time. This instead records one
// sieve transaction's actual STORE/CLWB/SFENCE order, enumerates the durable
// images a crash at each point could leave under the model in
// docs/pmem-crash-model.md, and mounts every one of them through production
// recovery.
//
// Two properties are checked over those images. The allocator's structural
// invariants are the existing PersistentAllocatorProperty. The stronger one is
// the workload's own: mount the image, let PWSieve reattach through the durable
// root, and require its cross-object invariants to hold. That covers state the
// allocator has no opinion about -- whether the prime count still matches the
// bitmaps, whether a descriptor names an extent that is actually allocated --
// which is exactly the state a torn multi-object commit would damage.
//
// Scenarios are recorded over a PMEM-style region, never a volatile one: a
// volatile region's persistence boundaries emit no CLWB or SFENCE, so the model
// would be shown a run in which nothing was ever made durable.

def PST = UnitTests.registerT("persistent_sieve:", _, PersistentSieveTester.new, _);
def PSTX = [
	PST("recorded_step_is_modelable",        test_psieve_recorded_step_is_modelable),
	PST("final_cut_is_exhaustive",           test_psieve_final_cut_is_exhaustive),
	PST("step_images_satisfy_allocator",     test_psieve_step_images_satisfy_allocator),
	PST("step_images_satisfy_sieve",         test_psieve_step_images_satisfy_sieve),
	PST("retiring_step_images_stay_consistent", test_psieve_retiring_step_images_stay_consistent),
	PST("property_detects_a_damaged_image",  test_psieve_property_detects_a_damaged_image),
	()
];

class PersistentSieveTester(t: Tester) {
	// 2 KB blocks: the smallest geometry the allocator itself supports here,
	// since a splitting allocation buffers around twenty redo entries and the
	// WAL slot is (blockSize - 64) / 2 bytes. A 1 KB block gives a 480-byte
	// slot and the very first allocation fails to commit.
	def BLOCKS = 8u64;
	def BLOCK_SIZE = 2048u64;
	def LIVE = 2u64;
	// Small: every cut of a ~200-event trace is swept, so the per-cut image
	// count has to stay affordable. Truncation is reported, never assumed away.
	def BUDGET = 4;

	var mounted: Array<byte>;       // durable bytes before the recorded scenario
	var region: PWRegion;
	var sieve: PWSieve;
	var recorder: RecordingPersistentOperations;

	// Format a recording region and lay out the sieve on it. The recorded
	// scenario starts from a region that already has a published root, so
	// every enumerated image is one a restart could actually be handed.
	def openRecordingSieve() -> bool {
		region = PWRegion.new(RecordingPmemBackend.new(), BLOCKS,
			Array<Ref<MetaDataDesc>>.new(0), BLOCK_SIZE, true);
		if (region.backendRegion == null) return false;
		recorder = RecordingPersistentOperations.!(region.backendRegion.persistentOperations());
		sieve = PWSieve.new(region, LIVE);
		return sieve.open();
	}

	def snapshotMounted() {
		mounted = Array<byte>.new(region.rng.length);
		for (i < mounted.length) mounted[i] = region.rng[i];
	}

	// Record exactly one step() as a scenario, from a snapshot of the durable
	// bytes that preceded it.
	def recordStep(name: string) -> PersistentTrace {
		snapshotMounted();
		recorder.clear();
		if (!sieve.step()) {
			t.fail("sieve step failed while recording the scenario");
			return null;
		}
		def trace = recorder.snapshot(name);
		if (!trace.validate().ok()) {
			t.fail("recorded sieve trace is not modelable");
			return null;
		}
		return trace;
	}

	def allocatorProperty(name: string) -> PersistentImageProperty {
		return PersistentAllocatorProperty.new(BLOCKS, BLOCK_SIZE).property(name, 0u64, 0);
	}

	def sieveProperty(name: string) -> PersistentImageProperty {
		return PersistentSieveProperty.new(BLOCKS, BLOCK_SIZE, LIVE).property(name);
	}

	def cleanup() {
		if (region != null) {
			region.deallocate();
			region = null;
		}
		sieve = null;
	}
}

// The workload's own property over an enumerated crash image: mount it, run
// production recovery, let the sieve find itself through the durable root, and
// require both the allocator's structure and the sieve's cross-object
// invariants. Reattaching is part of the property, not a precondition -- a
// restart that cannot find its own root has lost the region as surely as one
// that finds it inconsistent.
class PersistentSieveProperty(numBlocks: u64, blockSize: u64, liveSegments: u64) {

	def check(image: PersistentDurableImage) -> string {
		def backend = PersistentImageBackend.new(image);
		def region = PWRegion.new(backend, numBlocks, Array<Ref<MetaDataDesc>>.new(0), blockSize, false);
		if (region.backendRegion == null) return "durable image did not mount as an allocator";

		var violation = PersistentAllocatorInvariants.check(region);
		if (violation == null) {
			// open() is the real restart path: it reclaims extents nothing
			// names and finishes an interrupted retirement, then the
			// invariants must hold on what is left.
			def sieve = PWSieve.new(region, liveSegments);
			if (!sieve.open()) violation = "sieve could not reattach to its root after recovery";
			else violation = sieve.checkInvariants();
		}
		region.deallocate();
		return violation;
	}

	def property(name: string) -> PersistentImageProperty {
		return PersistentImageProperty.new(name, 0u64, 0, check);
	}
}


// A recorded step must satisfy the crash model's baseline -- naturally aligned
// failure-atomic stores that never cross a cache line -- or nothing downstream
// means anything. The bulk bitmap write is the interesting part: it goes
// through the same seam as the log, so it is held to the same contract.
def test_psieve_recorded_step_is_modelable(tc: PersistentSieveTester) {
	if (!tc.openRecordingSieve()) {
		tc.t.fail("could not lay out a recording sieve");
		return;
	}
	def trace = tc.recordStep("pwsieve_step");
	tc.cleanup();
	if (trace == null) return;

	tc.t.assertz(true, trace.validate().ok());
	// A step is a substantial scenario: the bitmap, its persistence boundary,
	// the WAL record, the commit boundary and the after-images.
	tc.t.assertz(true, trace.length() > 100);
	tc.t.assertz(true, trace.touchedLines().length > 8);
}

// At the end of a step several durable images are still permitted, and that is
// phase B working as designed: the commit boundary persists the WAL record and
// the *previous* transaction's after-images, while this transaction's own
// after-images are applied write-behind and ride the next commit. So the newly
// published descriptor and root counters may or may not have reached the
// medium. Every one of those images must still recover into a consistent
// sieve -- from the record if the after-images did not land, from the applied
// bytes if they did. The search here is complete, so this is evidence rather
// than a sample.
def test_psieve_final_cut_is_exhaustive(tc: PersistentSieveTester) {
	if (!tc.openRecordingSieve()) {
		tc.t.fail("could not lay out a recording sieve");
		return;
	}
	def trace = tc.recordStep("pwsieve_step_end");
	tc.cleanup();
	if (trace == null) return;

	def result = PersistentExplorer.checkImages(trace, tc.mounted, trace.length(), 64,
		tc.sieveProperty("every image a completed step permits recovers"));
	if (!result.ok()) tc.t.fail(result.toArtifact());
	tc.t.assertz(true, result.exhaustive());
	// More than one, precisely because the after-images are still deferred.
	tc.t.assertz(true, result.imagesChecked > 1);
}

// Every crash schedule at every point of one step must leave an allocator a
// production mount can recover into a structurally sound state.
def test_psieve_step_images_satisfy_allocator(tc: PersistentSieveTester) {
	if (!tc.openRecordingSieve()) {
		tc.t.fail("could not lay out a recording sieve");
		return;
	}
	def trace = tc.recordStep("pwsieve_step_alloc");
	tc.cleanup();
	if (trace == null) return;

	def result = PersistentExplorer.checkAllCuts(trace, tc.mounted, tc.BUDGET,
		tc.allocatorProperty("allocator survives every crash schedule of a sieve step"));
	if (!result.ok()) tc.t.fail(result.toArtifact());
	tc.t.assertz(true, result.imagesChecked > trace.length());
	// Under this budget the sweep is not a complete search, and says so.
	tc.t.assertz(false, result.exhaustive());
}

// The stronger statement: the workload's own state, not just the allocator's.
// A torn commit that left the prime count disagreeing with the bitmaps would
// satisfy the allocator's invariants and fail here.
def test_psieve_step_images_satisfy_sieve(tc: PersistentSieveTester) {
	if (!tc.openRecordingSieve()) {
		tc.t.fail("could not lay out a recording sieve");
		return;
	}
	def trace = tc.recordStep("pwsieve_step_sieve");
	tc.cleanup();
	if (trace == null) return;

	def result = PersistentExplorer.checkAllCuts(trace, tc.mounted, tc.BUDGET,
		tc.sieveProperty("sieve invariants survive every crash schedule of a step"));
	if (!result.ok()) tc.t.fail(result.toArtifact());
	tc.t.assertz(true, result.imagesChecked > trace.length());
	tc.t.assertz(false, result.exhaustive());
}

// The step that also retires a segment is the one with the most going on: a
// publishing commit followed by a second transaction that unpublishes a
// descriptor and frees its extent together. A crash between the two is
// legitimate and must leave a state the next mount can finish.
def test_psieve_retiring_step_images_stay_consistent(tc: PersistentSieveTester) {
	if (!tc.openRecordingSieve()) {
		tc.t.fail("could not lay out a recording sieve");
		return;
	}
	// Fill the retention window first, so the recorded step retires.
	for (k < 2) {
		if (!tc.sieve.step()) {
			tc.t.fail("could not fill the retention window");
			tc.cleanup();
			return;
		}
	}
	def trace = tc.recordStep("pwsieve_retiring_step");
	tc.cleanup();
	if (trace == null) return;

	def result = PersistentExplorer.checkAllCuts(trace, tc.mounted, tc.BUDGET,
		tc.sieveProperty("a retiring step leaves a recoverable sieve"));
	if (!result.ok()) tc.t.fail(result.toArtifact());
	tc.t.assertz(true, result.imagesChecked > trace.length());
}

// The checks above are only worth something if they can fail. Corrupt one byte
// of a durable bitmap and the sieve property must reject that image, naming
// the disagreement rather than mounting happily.
def test_psieve_property_detects_a_damaged_image(tc: PersistentSieveTester) {
	if (!tc.openRecordingSieve()) {
		tc.t.fail("could not lay out a recording sieve");
		return;
	}
	def trace = tc.recordStep("pwsieve_damaged");
	tc.cleanup();
	if (trace == null) return;

	// The maximal schedule: every dirty line evicted at every boundary, so
	// everything the step wrote survives. The most complete image the cut
	// permits, and the right baseline for a damage check.
	def intact = PersistentImages.eagerCrash(trace, tc.mounted, trace.length());

	def property = PersistentSieveProperty.new(tc.BLOCKS, tc.BLOCK_SIZE, tc.LIVE);
	def baseline = property.check(intact);
	if (baseline != null) tc.t.fail(baseline);

	// Flip bits inside the live segment's bitmap. The block table and the
	// descriptors are untouched, so the allocator still walks cleanly; only
	// the cross-object check can see this.
	def damaged = Array<byte>.new(intact.size());
	for (i < damaged.length) damaged[i] = intact.bytes[i];
	def segmentBody = int.!(2u64 * tc.BLOCK_SIZE + u64.!(ChunkHeader.size));
	damaged[segmentBody] = damaged[segmentBody] ^ 0xFFu8;
	damaged[segmentBody + 1] = damaged[segmentBody + 1] ^ 0xFFu8;

	def image = PersistentDurableImage.new(damaged);
	def violation = property.check(image);
	if (violation == null) tc.t.fail("a corrupted bitmap was accepted");
}
