// Crash after a complete free transaction has applied after-images for both
// left and right coalescing, but before those after-images ride a later commit
// or clean-close boundary. Remount must replay the record and reconstruct the
// original five-block free extent without child cleanup.
def test_bd_abrupt_coalescing_free_recovers_transaction(tc: BlockDevicePWRegionTester) {
	tc.region.deallocate();
	tc.region = null;

	def pid = Linux.syscall(LinuxConst.SYS_fork, ()).0;
