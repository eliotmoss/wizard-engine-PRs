	tc.assertAllocatorInvariants(recovered);

	tc.cleanup();
}

// Complete the non-cooperative applied-after-image crash matrix with the
// coalescing-free path. The final free has applied the updates that absorb both
// neighboring extents, but those updates have not ridden another fdatasync.
// Kill the stopped child without cleanup and require remount to replay the
// retained WAL record into the original five-block free extent.
def test_bd_sigkill_coalescing_free_recovers_transaction(tc: BlockDevicePWRegionTester) {
	tc.region.deallocate();
	tc.region = null;

	def pid = Linux.syscall(LinuxConst.SYS_fork, ()).0;
	if (pid < 0) {
		tc.t.fail("fork failed");
		tc.cleanup();
		return;
	}
