	if (killResult != 0 || waitedForKill != pid || waitStatus[0] != BD_SIGKILL) {
		tc.cleanup();
		return;
	}

	def recovered = tc.remount();
	tc.assertRecoveredCoalescingFree(recovered);
	tc.assertAllocatorInvariants(recovered);

	tc.cleanup();
}

// A corrupt committed WAL must not replay, and recovery must durably clear it.
def test_bd_corrupt_wal_checksum(tc: BlockDevicePWRegionTester) {
	var entry = tc.region.blockTableHandle[2u64];
	tc.t.assertz(false, entry.getUsed());

	tc.writeCommittedWalUpdate(
		tc.region,
		entry.addr + u64.view(BlockEntry.used.offset),
		1u64,
		1u8);

	tc.corruptFirstRecordChecksum(tc.region);

	var region2 = tc.remount();
	tc.t.assertz(false, region2.blockTableHandle[2u64].getUsed());

	tc.cleanup();
}
