// PWRegion Tests
// Tests the block-based region allocator (PWRegion) and its WAL commit flow.
//
// Setup: numBlocks=8, blockSize=4096, no metaDataDescs, forceFormat=true.
// With these params, the layout after format() is:
//   Block 0: region header (METADATA, used)
//   Block 1: WAL log chunk (METADATA, used)
//   Blocks 2-6: one contiguous LARGE_FREE entry (5 allocatable blocks)
//   Block 7: metadata overhead block (METADATA, used) -- contains block table
//   Entry 8: end-of-region marker (NONE, used) -- no backing data block
//

def T = UnitTests.registerT("pwregion:", _, PWRegionTester.new, _);
def X = [
	T("format_magic",              test_format_magic),
	T("format_header_fields",      test_format_header_fields),
	T("format_sentinels",          test_format_sentinels),
	T("format_free_list_nonempty", test_format_free_list_nonempty),
	T("alloc_1_valid",             test_alloc_1_valid),
	T("alloc_multi_valid",         test_alloc_multi_valid),
	T("alloc_zero_rejected",       test_alloc_zero_rejected),
	T("alloc_oversized_rejected",  test_alloc_oversized_rejected),
	T("alloc_sets_used",           test_alloc_sets_used),
	T("alloc_chunk_header",        test_alloc_chunk_header),
	T("free_null_rejected",        test_free_null_rejected),
	T("free_double_rejected",      test_free_double_rejected),
	T("free_foreign_rejected",     test_free_foreign_rejected),
	T("free_clears_used",          test_free_clears_used),
	T("free_then_realloc",         test_free_then_realloc),
	T("exhaust_free_blocks",       test_exhaust_free_blocks),
	T("coalesce_right",            test_coalesce_right),
	T("commit_clears_transaction", test_commit_clears_transaction),
	()
];

class PWRegionTester(t: Tester) {
	var region: PWRegion;

	new() {
		region = PWRegion.new(
			Backends.getVolatile(),
			8u64,
			Array<Ref<MetaDataDesc>>.new(0),
			4096u64,
			true
		);
	}

	// True if alloc succeeded. allocChunk returns ChunkHandle(Pointer.NULL) on failure
	def allocSucceeded(chunk: ChunkHandle) -> bool {
		return !chunk.isNull();
	}
}


// =============================================================================
// Format tests: verify the region header and free lists are correct after init
// =============================================================================

// After format(), the MAGIC constant must be stamped in the header.
def test_format_magic(tc: PWRegionTester) {
	var hdr = tc.region.getHeader();
	tc.t.assert_eq(PWRegions.MAGIC, hdr.magic);
}

// Header fields must match the constructor arguments.
def test_format_header_fields(tc: PWRegionTester) {
	var hdr = tc.region.getHeader();
	tc.t.assert_eq(8u64, hdr.numBlocks);
	tc.t.assert_eq(4096u64, hdr.blockSize);
	tc.t.assert_eq(8u64 * 4096u64, hdr.numBytes);
	tc.t.assert_eq(4096u64, hdr.logChunk); // block 1 at blockSize 4096
}

// Both sentinel handles must point into the region (non-NULL addresses).
def test_format_sentinels(tc: PWRegionTester) {
	tc.t.assertz(false, tc.region.smallSentinel.isNull());
	tc.t.assertz(false, tc.region.largeSentinel.isNull());
}

// The large free list must have at least one entry after format.
// format() writes directly to memory (not through the cache), so
// getListNextCached falls through to memory and reads the correct value.
def test_format_free_list_nonempty(tc: PWRegionTester) {
	var firstFree = tc.region.largeSentinel.getListNextCached(tc.region.txn);
	tc.t.assertz(false, firstFree.isNull());
}


// =============================================================================
// Allocation tests
// =============================================================================

// allocChunk(1) must return a valid chunk on a fresh region.
def test_alloc_1_valid(tc: PWRegionTester) {
	var chunk = tc.region.allocChunk(1u32);
	tc.t.assertz(true, tc.allocSucceeded(chunk));
}

// allocChunk(3) must also succeed -- there are 5 free blocks available.
def test_alloc_multi_valid(tc: PWRegionTester) {
	var chunk = tc.region.allocChunk(3u32);
	tc.t.assertz(true, tc.allocSucceeded(chunk));
}

// Zero is not a meaningful chunk size. Reject it before the split path so it
// cannot create a zero-length chunk or rewrite the existing free-list entry.
def test_alloc_zero_rejected(tc: PWRegionTester) {
	var chunk = tc.region.allocChunk(0u32);
	tc.t.assertz(false, tc.allocSucceeded(chunk));
	tc.t.assertz(false, tc.region.txn.isDirty());
	tc.t.assertz(true, tc.allocSucceeded(tc.region.allocChunk(5u32)));
}

// A request larger than all user data must report ordinary exhaustion without
// buffering allocator mutations.
def test_alloc_oversized_rejected(tc: PWRegionTester) {
	var chunk = tc.region.allocChunk(6u32);
	tc.t.assertz(false, tc.allocSucceeded(chunk));
	tc.t.assertz(false, tc.region.txn.isDirty());
	tc.t.assertz(true, tc.allocSucceeded(tc.region.allocChunk(5u32)));
}

// After allocChunk(1), the block entry's used flag must be true when read
// directly from memory (allocChunk commits before returning).
def test_alloc_sets_used(tc: PWRegionTester) {
	var chunk = tc.region.allocChunk(1u32);
	var entry = tc.region.chunkToBlockEntry(chunk);
	tc.t.assertz(true, entry.getUsed());
}

// After allocChunk(1), the chunk header fields must reflect the initial
// allocation state written by createChunk().
def test_alloc_chunk_header(tc: PWRegionTester) {
	var chunk = tc.region.allocChunk(1u32);
	// offset = ChunkHeader.size (start of usable space past the header)
	tc.t.assert_eq(u64.!(ChunkHeader.size), chunk.getOffset());
	// limit = 1 block * 4096 bytes/block
	tc.t.assert_eq(4096u64, chunk.getLimit());
}


// =============================================================================
// Free tests
// =============================================================================

// Null is the allocation-failure sentinel, not a valid chunk to free.
def test_free_null_rejected(tc: PWRegionTester) {
	tc.t.assertz(false, tc.region.freeChunk(tc.region.blankChunkHandle));
	tc.t.assertz(false, tc.region.txn.isDirty());
}

// The first free succeeds and commits; the second must be rejected without
// adding writes to the shared transaction.
def test_free_double_rejected(tc: PWRegionTester) {
	var chunk = tc.region.allocChunk(1u32);
	tc.t.assertz(true, tc.region.freeChunk(chunk));
	tc.t.assertz(false, tc.region.freeChunk(chunk));
	tc.t.assertz(false, tc.region.txn.isDirty());
}

// A chunk allocated by another region must be rejected before its address is
// translated into this region's block-table index.
def test_free_foreign_rejected(tc: PWRegionTester) {
	var foreignRegion = PWRegion.new(
		Backends.getVolatile(),
		8u64,
		Array<Ref<MetaDataDesc>>.new(0),
		4096u64,
		true
	);
	var foreignChunk = foreignRegion.allocChunk(1u32);

	tc.t.assertz(true, !foreignChunk.isNull());
	tc.t.assertz(false, tc.region.freeChunk(foreignChunk));
	tc.t.assertz(false, tc.region.txn.isDirty());
	tc.t.assertz(true, foreignRegion.chunkToBlockEntry(foreignChunk).getUsed());
}

// After alloc+free, the block entry must show used == false.
def test_free_clears_used(tc: PWRegionTester) {
	var chunk = tc.region.allocChunk(1u32);
	tc.region.freeChunk(chunk);
	var entry = tc.region.chunkToBlockEntry(chunk);
	tc.t.assertz(false, entry.getUsed());
}

// After alloc+free, a subsequent alloc must succeed (the block was returned to
// the free list).
def test_free_then_realloc(tc: PWRegionTester) {
	var chunk1 = tc.region.allocChunk(5u32);
	tc.region.freeChunk(chunk1);
	var chunk2 = tc.region.allocChunk(5u32);
	tc.t.assertz(true, tc.allocSucceeded(chunk2));
}


// =============================================================================
// Exhaustion test
// =============================================================================

// With numBlocks=8 and no metadata descriptors, exactly 5 user blocks are
// available (indices 2-6). The first 5 alloc(1) calls must succeed; the 6th
// must return blankChunkHandle.
def test_exhaust_free_blocks(tc: PWRegionTester) {
	for (i < 5) {
		var c = tc.region.allocChunk(1u32);
		if (!tc.allocSucceeded(c)) {
			tc.t.fail1("alloc %d of 5 failed unexpectedly", i);
			return;
		}
	}
	var overflow = tc.region.allocChunk(1u32);
	tc.t.assertz(false, tc.allocSucceeded(overflow));
}


// =============================================================================
// Coalescing test
// =============================================================================

// Allocate two adjacent single-block chunks (blocks 2 and 3), then free both.
// Freeing block 3 should trigger:
//   - left-coalesce  (block 2 is already free)
//   - right-coalesce (blocks 4-6 are large-free)
// yielding one 5-block free entry spanning blocks 2-6.
// A subsequent alloc(2) must succeed, proving coalescing occurred.
def test_coalesce_right(tc: PWRegionTester) {
	// Alloc block 2 and block 3. Each allocation commits before returning.
	var chunk2 = tc.region.allocChunk(1u32);
	var chunk3 = tc.region.allocChunk(1u32);

	// Free block 2: no free neighbors yet, goes to the small free list.
	tc.region.freeChunk(chunk2);

	// Free block 3: triggers left-coalesce (block 2 is free) and
	// right-coalesce (blocks 4-6 are large-free). Result: one large entry.
	tc.region.freeChunk(chunk3);

	// alloc(2) must succeed by splitting the coalesced 5-block entry.
	var chunk = tc.region.allocChunk(2u32);
	tc.t.assertz(true, tc.allocSucceeded(chunk));
}


// =============================================================================
// Transaction lifecycle test
// =============================================================================

// The transaction must report clean after an alloc, since allocChunk
// performs its own commit at the end of the transaction boundary.
def test_commit_clears_transaction(tc: PWRegionTester) {
	tc.t.assertz(false, tc.region.txn.isDirty());
	tc.region.allocChunk(1u32);
	tc.t.assertz(false, tc.region.txn.isDirty());
}


// =============================================================================
// Immix line-mark linkage
// =============================================================================

def IRT = UnitTests.registerT("pwregion_immix:", _, ImmixPWRegionTester.new, _);
def IRX = [
	IRT("descriptor_controls_line_size", test_immix_descriptor_controls_line_size),
	IRT("chunk_links_first_line_mark", test_immix_chunk_links_first_line_mark),
	()
];

class ImmixPWRegionTester(t: Tester) {
	var descBytes: Array<byte>;
	var descs: Array<Ref<MetaDataDesc>>;
	var region: ImmixPWRegion;

	new() {
		descBytes = Array<byte>.new(MetaDataDesc.size);
		def desc = Ref<MetaDataDesc>.at(descBytes, 0);
		desc.kind = ImmixPWRegions.ImmixLineMarkMetaKind;
		desc.fixedBytes = 0;
		desc.unitSize = 128u32;
		desc.bytesPerUnit = u32.!(LineMark.size);

		descs = Array<Ref<MetaDataDesc>>.new(1);
		descs[0] = desc;
		region = ImmixPWRegion.new(Backends.getVolatile(), 8u64, descs, 4096u64, true);
	}
}

// The persisted metadata descriptor, rather than a global constant, controls
// both the line-table geometry and chunk-to-line-mark indexing.
def test_immix_descriptor_controls_line_size(tc: ImmixPWRegionTester) {
	def expectedMarks = (8u64 * 4096u64 + 127u64) / 128u64;

	tc.t.assert_eq(128u64, tc.region.lineSize);
	tc.t.assert_eq(expectedMarks, tc.region.numLineMarks);
}

// createChunk() must link to the mark covering the chunk's actual region
// offset, not merely to the start of the global line-mark table.
def test_immix_chunk_links_first_line_mark(tc: ImmixPWRegionTester) {
	def chunk = tc.region.allocChunk(1u32);
	def lineIndex = tc.region.offsetInRegion(chunk.addr) / tc.region.lineSize;
	def expectedOffset = tc.region.lineMarks[lineIndex].addr - tc.region.regionStart;

	tc.t.assertz(false, chunk.isNull());
	tc.t.assertz(false, expectedOffset == 0);
	tc.t.assert_eq(expectedOffset, chunk.getLinemarks());
}


// =============================================================================
// Commit-failure propagation test (small slots force WAL overflow)
// =============================================================================

// numBlocks=8, blockSize=512 -> slotBytes = (512 - 64) / 2 aligned down to
// 64 = 192. A single allocChunk(2) split-path call buffers 16 distinct cache
// writes in one WAL transaction; the resulting record (>= 448 B) can never
// fit in a 192 B slot, so the commit must fail.
def SRT = UnitTests.registerT("pwregion_overflow:", _, SmallRingPWRegionTester.new, _);
def SX = [
	SRT("alloc_overflow_returns_blank", test_alloc_overflow_returns_blank),
	()
];

class SmallRingPWRegionTester(t: Tester) {
	var region: PWRegion;

	new() {
		region = PWRegion.new(
			Backends.getVolatile(),
			8u64,
			Array<Ref<MetaDataDesc>>.new(0),
			512u64,
			true
		);
	}

	def allocSucceeded(chunk: ChunkHandle) -> bool {
		return !chunk.isNull();
	}
}

// allocChunk(2) on a fresh small-slot region takes the split path (16
// buffered writes), which overflows slotBytes=192. The commit must fail,
// allocChunk must return blankChunkHandle (not a chunk claiming success), and
// the transaction must remain dirty (data retained, not lost).
def test_alloc_overflow_returns_blank(tc: SmallRingPWRegionTester) {
	tc.t.assertz(false, tc.region.txn.isDirty());
	var chunk = tc.region.allocChunk(2u32);
	tc.t.assertz(false, tc.allocSucceeded(chunk));
	tc.t.assertz(true, tc.region.txn.isDirty());
	tc.t.assertz(false, tc.region.requiresRecovery());
}


// =============================================================================
// Recovery-required propagation (injected persistence failure)
// =============================================================================

def PRT = UnitTests.registerT("pwregion_recovery:", _, RecoveryPWRegionTester.new, _);
def PRX = [
	PRT("alloc_persist_failure_requires_recovery", test_alloc_persist_failure_requires_recovery),
	PRT("free_persist_failure_requires_recovery", test_free_persist_failure_requires_recovery),
	()
];

class RecoveryPWRegionBackend extends TxnRegionBackend {
	var region: RecoveryPWBackendRegion;

	def create(size: u64, prot: int, fresh: bool) -> BackendRegion {
		def data = Array<byte>.new(int.!(size));
		region = RecoveryPWBackendRegion.new(data[0 ..+ data.length]);
		return region;
	}

	def isPersistent() -> bool {
		return true;
	}

	def name() -> string {
		return "recovery-test";
	}
}

class RecoveryPWBackendRegion extends BackendRegion {
	var failNextPersistChanges = false;
	var persistChangesCount = 0;

	new(range: Range<byte>) super(range) { }

	def destroy() { }

	def prepareChangedRange(offset: u64, size: u64) -> bool {
		return true;
	}

	def persistRange(offset: u64, size: u64) -> bool {
		return true;
	}

	def persistChanges() -> bool {
		persistChangesCount++;
		if (failNextPersistChanges) {
			failNextPersistChanges = false;
			return false;
		}
		return true;
	}
}

class RecoveryPWRegionTester(t: Tester) {
	var backend: RecoveryPWRegionBackend;
	var region: PWRegion;

	new() {
		backend = RecoveryPWRegionBackend.new();
		region = PWRegion.new(
			backend,
			8u64,
			Array<Ref<MetaDataDesc>>.new(0),
			4096u64,
			true
		);
	}

	def allocSucceeded(chunk: ChunkHandle) -> bool {
		return !chunk.isNull();
	}
}

// A failed allocator commit must remain distinguishable from exhaustion or
// capacity rejection at the PWRegion API. The shared transaction stays dirty,
// and the mounted allocator rejects later work without another boundary.
def test_alloc_persist_failure_requires_recovery(tc: RecoveryPWRegionTester) {
	tc.t.assertz(false, tc.region.requiresRecovery());
	def committedChunk = tc.region.allocChunk(1u32);
	tc.t.assertz(true, tc.allocSucceeded(committedChunk));
	tc.backend.region.failNextPersistChanges = true;

	def failedChunk = tc.region.allocChunk(1u32);
	tc.t.assertz(false, tc.allocSucceeded(failedChunk));
	tc.t.assertz(true, tc.region.requiresRecovery());
	tc.t.assertz(true, tc.region.txn.isDirty());

	def persistChangesCount = tc.backend.region.persistChangesCount;
	tc.t.assertz(false, tc.allocSucceeded(tc.region.allocChunk(1u32)));
	tc.t.assertz(false, tc.region.freeChunk(committedChunk));
	tc.t.assertz(true, tc.region.chunkToBlockEntry(committedChunk).getUsed());
	tc.t.assert_eq(persistChangesCount, tc.backend.region.persistChangesCount);
}

// freeChunk() must propagate its own commit-point persistence failure rather
// than report that the chunk was released. The buffered free remains visible
// through the shared transaction, but its after-images have not reached live
// region memory; the latched mount rejects later allocator work without
// issuing another persistence boundary.
def test_free_persist_failure_requires_recovery(tc: RecoveryPWRegionTester) {
	def chunk = tc.region.allocChunk(1u32);
	def entry = tc.region.chunkToBlockEntry(chunk);
	tc.t.assertz(true, tc.allocSucceeded(chunk));
	tc.t.assertz(true, entry.getUsed());
	tc.backend.region.failNextPersistChanges = true;

	tc.t.assertz(false, tc.region.freeChunk(chunk));
	tc.t.assertz(true, tc.region.requiresRecovery());
	tc.t.assertz(true, tc.region.txn.isDirty());
	tc.t.assertz(false, entry.getUsedCached(tc.region.txn));
	tc.t.assertz(true, entry.getUsed());

	def persistChangesCount = tc.backend.region.persistChangesCount;
	tc.t.assertz(false, tc.allocSucceeded(tc.region.allocChunk(1u32)));
	tc.t.assertz(false, tc.region.freeChunk(chunk));
	tc.t.assertz(true, entry.getUsed());
	tc.t.assert_eq(persistChangesCount, tc.backend.region.persistChangesCount);
}


// =============================================================================
// Backend region ownership tests
// =============================================================================

def BACKEND_PATH = "/tmp/wiz_test_txn_backend_region";

def MT = UnitTests.registerT("txn_backend:", _, FileMmapBackendTester.new, _);
def MX = [
	MT("fresh_truncates_and_zero_fills", test_fresh_truncates_and_zero_fills),
	MT("missing_attach_creates_zeroed_file", test_missing_attach_creates_zeroed_file),
	MT("mapped_file_region_owns_state", test_mapped_file_region_owns_state),
	MT("mapped_file_persist_changes_clears_dirty_flag", test_mapped_file_persist_changes_clears_dirty_flag),
	MT("mapped_file_persist_changes_keeps_other_region_dirty", test_mapped_file_persist_changes_keeps_other_region_dirty),
	MT("mapped_file_persist_changes_failure_keeps_dirty_flag", test_mapped_file_persist_changes_failure_keeps_dirty_flag),
	MT("mapped_file_persist_range_keeps_dirty_flag", test_mapped_file_persist_range_keeps_dirty_flag),
	MT("mapped_file_invalid_ops_fail", test_mapped_file_invalid_ops_fail),
	MT("mapped_file_region_destroy_owns_lifecycle", test_mapped_file_region_destroy_owns_lifecycle),
	MT("fdatasync_invalid_fd_fails", test_fdatasync_invalid_fd_fails),
	MT("pmem_region_tracks_pending_writeback", test_pmem_region_tracks_pending_writeback),
	()
];

class FileMmapBackendTester(t: Tester) {
	var backend: FileMmapBackend;
	var region1: BackendRegion;
	var region2: BackendRegion;

	new() {
		RegionFileIO.unlink(BACKEND_PATH);
		backend = FileMmapBackend.new(BACKEND_PATH);
	}

	def cleanup() {
		if (region1 != null) {
			region1.destroy();
			region1 = null;
		}
		if (region2 != null) {
			region2.destroy();
			region2 = null;
		}
		RegionFileIO.unlink(BACKEND_PATH);
	}
}

// A fresh open must discard both stale contents and a stale larger extent.
// Fill an 8 KiB backing file with nonzero bytes, then recreate it at 4 KiB and
// verify the kernel-provided post-truncation extent is entirely zeroed.
def test_fresh_truncates_and_zero_fills(tc: FileMmapBackendTester) {
	def prot = BackendProt.READ.mask | BackendProt.WRITE.mask;
	tc.region1 = tc.backend.create(8192u64, prot, false);

	if (tc.region1 == null) {
		tc.t.fail("initial mapped file backend creation failed");
		tc.cleanup();
		return;
	}

	for (i < tc.region1.range.length) {
		Pointer.atElement(tc.region1.range, i).store<u8>(0xa5u8);
	}
	tc.t.assertz(true, tc.region1.persistRange(0u64, 8192u64));
	tc.region1.destroy();
	tc.region1 = null;

	tc.region1 = tc.backend.create(4096u64, prot, true);
	if (tc.region1 == null) {
		tc.t.fail("fresh mapped file backend creation failed");
		tc.cleanup();
		return;
	}

	var allZero = true;
	for (i < tc.region1.range.length) {
		if (Pointer.atElement(tc.region1.range, i).load<u8>() != 0u8) allZero = false;
	}
	tc.t.assertz(true, allZero);
	tc.t.assert_eq(4096, tc.region1.range.length);

	def fd = RegionFileIO.open(BACKEND_PATH);
	if (fd < 0) {
		tc.t.fail("fresh backing file could not be reopened");
	} else {
		def size = Linux.syscall(LinuxConst.SYS_lseek, (fd, 0, LinuxConst.SEEK_END)).0;
		tc.t.assert_eq(4096u64, u64.view(size));
		RegionFileIO.close(fd);
	}

	tc.cleanup();
}

// Mount intent on a missing path falls back to creating a fresh, zero-filled
// backing file rather than failing or exposing unspecified bytes.
def test_missing_attach_creates_zeroed_file(tc: FileMmapBackendTester) {
	def prot = BackendProt.READ.mask | BackendProt.WRITE.mask;
	tc.region1 = tc.backend.create(4096u64, prot, false);

	if (tc.region1 == null) {
		tc.t.fail("missing-file attach fallback failed");
		tc.cleanup();
		return;
	}

	var allZero = true;
	for (i < tc.region1.range.length) {
		if (Pointer.atElement(tc.region1.range, i).load<u8>() != 0u8) allZero = false;
	}
	tc.t.assertz(true, allZero);
	tc.t.assert_eq(4096, tc.region1.range.length);

	def fd = RegionFileIO.open(BACKEND_PATH);
	tc.t.assertz(true, fd >= 0);
	if (fd >= 0) {
		def size = Linux.syscall(LinuxConst.SYS_lseek, (fd, 0, LinuxConst.SEEK_END)).0;
		tc.t.assert_eq(4096u64, u64.view(size));
		RegionFileIO.close(fd);
	}

	tc.cleanup();
}

def test_mapped_file_region_owns_state(tc: FileMmapBackendTester) {
	def prot = BackendProt.READ.mask | BackendProt.WRITE.mask;
	tc.region1 = tc.backend.create(4096u64, prot, false);
	tc.region2 = tc.backend.create(4096u64, prot, false);

	if (tc.region1 == null || tc.region2 == null) {
		tc.t.fail("mapped file backend creation failed");
		tc.cleanup();
		return;
	}

	var r1 = FileMmapRegion.!(tc.region1);
	var r2 = FileMmapRegion.!(tc.region2);

	tc.t.assertz(false, r1.mapping == r2.mapping);
	tc.t.assertz(false, r1.mapping.range.start == r2.mapping.range.start);
	tc.t.assertz(true, Pointer.atElement(r1.range, 0) == r1.mapping.range.start);
	tc.t.assert_eq(int.!(r1.mapping.range.size()), r1.range.length);
	tc.t.assertz(true, Pointer.atElement(r2.range, 0) == r2.mapping.range.start);
	tc.t.assert_eq(int.!(r2.mapping.range.size()), r2.range.length);

	tc.t.assertz(true, tc.region1.prepareChangedRange(128u64, 16u64));
	tc.t.assertz(true, tc.region2.prepareChangedRange(256u64, 32u64));

	tc.t.assertz(true, r1.hasDirtyChanges);
	tc.t.assertz(true, r2.hasDirtyChanges);

	tc.t.assertz(true, tc.region1.persistChanges());
	tc.t.assertz(false, r1.hasDirtyChanges);
	tc.t.assertz(true, r2.hasDirtyChanges);

	tc.region1.destroy();
	tc.region1 = null;

	tc.t.assertz(true, r1.mapping == null);
	tc.t.assert_eq(-1, r1.fd);
	tc.t.assertz(false, r2.mapping == null);
	tc.t.assertz(true, r2.hasDirtyChanges);

	Pointer.atElement(tc.region2.range, 0).store<u8>(0x42u8);
	tc.t.assert_eq(0x42u8, Pointer.atElement(tc.region2.range, 0).load<u8>());

	tc.t.assertz(true, tc.region2.persistChanges());
	tc.t.assertz(false, r2.hasDirtyChanges);

	tc.cleanup();
}

def test_mapped_file_persist_changes_clears_dirty_flag(tc: FileMmapBackendTester) {
	def prot = BackendProt.READ.mask | BackendProt.WRITE.mask;
	tc.region1 = tc.backend.create(4096u64, prot, false);

	if (tc.region1 == null) {
		tc.t.fail("mapped file backend creation failed");
		tc.cleanup();
		return;
	}

	var r1 = FileMmapRegion.!(tc.region1);
	Pointer.atElement(tc.region1.range, 64).store<u8>(0x7au8);
	tc.t.assertz(true, tc.region1.prepareChangedRange(64u64, 1u64));

	tc.t.assertz(true, r1.hasDirtyChanges);
	tc.t.assertz(true, tc.region1.persistChanges());
	tc.t.assertz(false, r1.hasDirtyChanges);

	tc.cleanup();
}

def test_mapped_file_persist_changes_keeps_other_region_dirty(tc: FileMmapBackendTester) {
	def prot = BackendProt.READ.mask | BackendProt.WRITE.mask;
	tc.region1 = tc.backend.create(4096u64, prot, false);
	tc.region2 = tc.backend.create(4096u64, prot, false);

	if (tc.region1 == null || tc.region2 == null) {
		tc.t.fail("mapped file backend creation failed");
		tc.cleanup();
		return;
	}

	var r1 = FileMmapRegion.!(tc.region1);
	var r2 = FileMmapRegion.!(tc.region2);

	Pointer.atElement(tc.region1.range, 128).store<u8>(0x11u8);
	Pointer.atElement(tc.region2.range, 256).store<u8>(0x22u8);
	tc.t.assertz(true, tc.region1.prepareChangedRange(128u64, 1u64));
	tc.t.assertz(true, tc.region2.prepareChangedRange(256u64, 1u64));

	tc.t.assertz(true, tc.region1.persistChanges());
	tc.t.assertz(false, r1.hasDirtyChanges);
	tc.t.assertz(true, r2.hasDirtyChanges);

	tc.cleanup();
}

def test_mapped_file_persist_changes_failure_keeps_dirty_flag(tc: FileMmapBackendTester) {
	def prot = BackendProt.READ.mask | BackendProt.WRITE.mask;
	tc.region1 = tc.backend.create(4096u64, prot, false);

	if (tc.region1 == null) {
		tc.t.fail("mapped file backend creation failed");
		tc.cleanup();
		return;
	}

	var r1 = FileMmapRegion.!(tc.region1);
	tc.t.assertz(true, tc.region1.prepareChangedRange(96u64, 8u64));
	RegionFileIO.close(r1.fd);

	tc.t.assertz(false, tc.region1.persistChanges());
	tc.t.assertz(true, r1.hasDirtyChanges);

	tc.cleanup();
}

def test_mapped_file_persist_range_keeps_dirty_flag(tc: FileMmapBackendTester) {
	def prot = BackendProt.READ.mask | BackendProt.WRITE.mask;
	tc.region1 = tc.backend.create(4096u64, prot, false);

	if (tc.region1 == null) {
		tc.t.fail("mapped file backend creation failed");
		tc.cleanup();
		return;
	}

	var r1 = FileMmapRegion.!(tc.region1);
	Pointer.atElement(tc.region1.range, 64).store<u8>(0x7au8);
	Pointer.atElement(tc.region1.range, 512).store<u8>(0x33u8);
	tc.t.assertz(true, tc.region1.prepareChangedRange(64u64, 1u64));
	tc.t.assertz(true, tc.region1.persistRange(512u64, 1u64));

	tc.t.assertz(true, r1.hasDirtyChanges);

	tc.cleanup();
}

def test_mapped_file_invalid_ops_fail(tc: FileMmapBackendTester) {
	def prot = BackendProt.READ.mask | BackendProt.WRITE.mask;
	tc.region1 = tc.backend.create(4096u64, prot, false);

	if (tc.region1 == null) {
		tc.t.fail("mapped file backend creation failed");
		tc.cleanup();
		return;
	}

	def volatileRegion = Backends.getVolatile().create(4096u64, prot, false);
	tc.t.assertz(true, volatileRegion.prepareChangedRange(0u64, 1u64));
	tc.t.assertz(true, volatileRegion.persistRange(0u64, 1u64));
	tc.t.assertz(true, volatileRegion.persistChanges());
	tc.t.assertz(false, tc.region1.prepareChangedRange(4096u64, 1u64));
	tc.t.assertz(false, tc.region1.prepareChangedRange(4095u64, 2u64));
	tc.t.assertz(true, tc.region1.prepareChangedRange(4096u64, 0u64));
	tc.t.assertz(false, tc.region1.persistRange(4096u64, 1u64));
	tc.t.assertz(false, tc.region1.persistRange(4095u64, 2u64));
	tc.t.assertz(true, tc.region1.persistRange(4096u64, 0u64));

	tc.cleanup();
}

def test_mapped_file_region_destroy_owns_lifecycle(tc: FileMmapBackendTester) {
	def prot = BackendProt.READ.mask | BackendProt.WRITE.mask;
	def otherBackend = FileMmapBackend.new(BACKEND_PATH);
	tc.region1 = otherBackend.create(4096u64, prot, false);

	if (tc.region1 == null) {
		tc.t.fail("mapped file backend creation failed");
		tc.cleanup();
		return;
	}

	var fileRegion = FileMmapRegion.!(tc.region1);
	tc.t.assertz(true, tc.region1.prepareChangedRange(64u64, 1u64));

	tc.region1.destroy();
	tc.region1 = null;
	tc.t.assertz(true, fileRegion.mapping == null);
	tc.t.assert_eq(-1, fileRegion.fd);
	tc.t.assertz(false, fileRegion.hasDirtyChanges);

	tc.cleanup();
}

def test_fdatasync_invalid_fd_fails(tc: FileMmapBackendTester) {
	tc.t.assertz(false, RegionFileIO.fdatasync(-1));
	tc.cleanup();
}

def test_pmem_region_tracks_pending_writeback(tc: FileMmapBackendTester) {
	def backend = PmemMmapBackend.new(BACKEND_PATH);
	def mapping = Mmap.reserve(4096u64, Mmap.PROT_READ | Mmap.PROT_WRITE);
	var region: BackendRegion = backend.makePersistentRegion(mapping, -1);

	if (region == null) {
		tc.t.fail("pmem test mapping allocation failed");
		return;
	}

	tc.t.assertz(true, FdMmapRegion.?(region));
	tc.t.assertz(true, PmemMmapRegion.?(region));
	tc.t.assertz(false, FileMmapRegion.?(region));

	def fdRegion = FdMmapRegion.!(region);
	def pmemRegion = PmemMmapRegion.!(region);
	tc.t.assertz(true, Pointer.atElement(fdRegion.range, 0) == fdRegion.mapping.range.start);
	tc.t.assert_eq(int.!(fdRegion.mapping.range.size()), fdRegion.range.length);
	tc.t.assertz(true, region.prepareChangedRange(32u64, 8u64));
	tc.t.assertz(true, pmemRegion.hasPendingWriteback);
	tc.t.assertz(true, region.prepareChangedRange(4096u64, 0u64));
	tc.t.assertz(false, region.prepareChangedRange(4096u64, 1u64));
	tc.t.assertz(false, region.prepareChangedRange(4095u64, 2u64));
	tc.t.assertz(true, region.persistRange(512u64, 1u64));
	tc.t.assertz(true, pmemRegion.hasPendingWriteback);
	tc.t.assertz(true, region.persistChanges());
	tc.t.assertz(false, pmemRegion.hasPendingWriteback);
	region.destroy();
	tc.t.assertz(true, fdRegion.mapping == null);
	tc.t.assert_eq(-1, fdRegion.fd);
}


// =============================================================================
// Block device backend tests
// =============================================================================

def BD_PATH = "/tmp/wiz_test_bd_region";
def BD_SIGKILL = 9;
def BD_SIGSTOP = 19;
def BD_WUNTRACED = 2;

component FileCommitTraceOp {
	def PREPARE_RANGE = 1;
	def FDATASYNC_COMPLETE = 2;
}

// Records range preparation around a successful call through the production
// FileMmapRegion fdatasync seam. This keeps the real mapping and syscall path
// while making the phase-B ordering visible to the test.
class FileCommitTraceRegion extends FileMmapRegion {
	var operations = Vector<int>.new();
	var preparedOffsets = Vector<u64>.new();
	var preparedSizes = Vector<u64>.new();

	new(mapping: Mapping, fd: int) super(mapping, fd) { }

	def onRangePrepared(offset: u64, size: u64) {
		operations.put(FileCommitTraceOp.PREPARE_RANGE);
		preparedOffsets.put(offset);
		preparedSizes.put(size);
	}

	def syncFileData() -> bool {
		def success = RegionFileIO.fdatasync(fd);
		if (success) operations.put(FileCommitTraceOp.FDATASYNC_COMPLETE);
		return success;
	}

	def clearTrace() {
		operations.clear();
		preparedOffsets.clear();
		preparedSizes.clear();
	}
}

class FileCommitTraceBackend extends FileMmapBackend {
	var tracedRegion: FileCommitTraceRegion;

	new(path: string) super(path) { }

	def makeFileRegion(newMapping: Mapping, fd: int) -> FileMmapRegion {
		if (newMapping == null) return null;
		tracedRegion = FileCommitTraceRegion.new(newMapping, fd);
		return tracedRegion;
	}
}

// Test-only file backend that stops its process after the real fdatasync at a
// WAL commit boundary, but before persistChanges() returns to DualTxnWal and
// RegionTransaction can apply the allocator after-images. The parent can then
// SIGKILL the stopped child to make this otherwise tiny protocol window fully
// deterministic.
class CommitBoundaryStopFileMmapRegion extends FileMmapRegion {
	var stopNextPersistChanges = true;

	new(mapping: Mapping, fd: int) super(mapping, fd) { }

	def syncFileData() -> bool {
		if (fd < 0) return false;
		if (!RegionFileIO.fdatasync(fd)) return false;

		if (stopNextPersistChanges) {
			stopNextPersistChanges = false;
			def pid = Linux.syscall(LinuxConst.SYS_getpid, ()).0;
			Linux.syscall(LinuxConst.SYS_kill, (pid, BD_SIGSTOP));
		}
		// The test always kills the stopped process. If it is unexpectedly
		// resumed, report failure rather than claiming the dirty state was reset.
		return false;
	}
}

class CommitBoundaryStopFileMmapBackend extends FileMmapBackend {
	new(path: string) super(path) { }

	def makeFileRegion(newMapping: Mapping, fd: int) -> FileMmapRegion {
		if (newMapping == null) return null;
		return CommitBoundaryStopFileMmapRegion.new(newMapping, fd);
	}
}

def BT = UnitTests.registerT("pwregion_bd:", _, BlockDevicePWRegionTester.new, _);
def BX = [
	BT("format_magic",          test_bd_format_magic),
	BT("initializes_file_size", test_bd_initializes_file_size),
	BT("stored_block_size_mismatch_rejected", test_bd_stored_block_size_mismatch_rejected),
	BT("stored_num_blocks_mismatch_rejected", test_bd_stored_num_blocks_mismatch_rejected),
	BT("legacy_log_chunk_fallback", test_bd_legacy_log_chunk_fallback),
	BT("alloc_valid",           test_bd_alloc_valid),
	BT("alloc_sets_used",       test_bd_alloc_sets_used),
	BT("free_clears_used",      test_bd_free_clears_used),
	BT("coalesce",              test_bd_coalesce),
	BT("persist_and_remount",   test_bd_persist_and_remount),
	BT("remount_alloc_state",   test_bd_remount_alloc_state),
	BT("file_commit_orders_fdatasync_before_after_images", test_bd_file_commit_orders_fdatasync_before_after_images),
	BT("mixed_sequence_preserves_invariants", test_bd_mixed_sequence_preserves_invariants),
	BT("seeded_mixed_histories_preserve_invariants", test_bd_seeded_mixed_histories_preserve_invariants),
	BT("recover_committed_wal", test_bd_recover_committed_wal),
	BT("abrupt_writer_recovers_committed_wal", test_bd_abrupt_writer_recovers_committed_wal),
	BT("abrupt_split_alloc_recovers_transaction", test_bd_abrupt_split_alloc_recovers_transaction),
	BT("abrupt_exact_fit_alloc_recovers_transaction", test_bd_abrupt_exact_fit_alloc_recovers_transaction),
	BT("abrupt_coalescing_free_recovers_transaction", test_bd_abrupt_coalescing_free_recovers_transaction),
	BT("sigkill_split_alloc_commit_boundary_recovers", test_bd_sigkill_split_alloc_commit_boundary_recovers),
	BT("sigkill_exact_fit_alloc_commit_boundary_recovers", test_bd_sigkill_exact_fit_alloc_commit_boundary_recovers),
	BT("sigkill_coalescing_free_commit_boundary_recovers", test_bd_sigkill_coalescing_free_commit_boundary_recovers),
	BT("sigkill_split_alloc_recovers_transaction", test_bd_sigkill_split_alloc_recovers_transaction),
	BT("sigkill_exact_fit_alloc_recovers_transaction", test_bd_sigkill_exact_fit_alloc_recovers_transaction),
	BT("sigkill_coalescing_free_recovers_transaction", test_bd_sigkill_coalescing_free_recovers_transaction),
	BT("corrupt_wal_checksum",  test_bd_corrupt_wal_checksum),
	()
];

class BlockDevicePWRegionTester(t: Tester) {
	var region: PWRegion;

	new() {
		RegionFileIO.unlink(BD_PATH);
		region = openRegion(true);
	}

	def allocSucceeded(chunk: ChunkHandle) -> bool {
		return !chunk.isNull();
	}

	def persistHeaderU64(offset: int, value: u64) -> bool {
		Pointer.atElement(region.backendRegion.range, offset).store<u64>(value);
		return region.backendRegion.persistRange(u64.view(offset), 8u64);
	}

	def cleanup() {
		if (region != null) {
			region.deallocate();
			region = null;
		}
		RegionFileIO.unlink(BD_PATH);
	}

	// Open a fresh region over existing files (mount, not format)
	def remount() -> PWRegion {
		if (region != null) {
			region.deallocate();
		}
		region = openRegion(false);
		return region;
	}

	// Start another generated history from a newly formatted backing file.
	def reformat() -> PWRegion {
		if (region != null) {
			region.deallocate();
		}
		region = openRegion(true);
		return region;
	}

	private def isBlockTableEntry(candidate: PWRegion, entry: BlockEntryHandle) -> bool {
		if (entry.isNull()) return false;
		if (entry.addr < candidate.blockTableHandle.addr) return false;
		def delta = entry.addr - candidate.blockTableHandle.addr;
		if (delta % u64.!(BlockEntry.size) != 0) return false;
		return delta / u64.!(BlockEntry.size) <= candidate.numBlocks;
	}

	private def walkFreeList(
		candidate: PWRegion,
		sentinel: BlockEntryHandle,
		kind: ListKind,
		listed: Array<bool>) {

		var previous = sentinel;
		var current = sentinel.getListNext();
		var steps = 0;
		while (!current.isNull()) {
			if (steps > int.!(candidate.numBlocks)) {
				t.fail("free-list cycle detected");
				return;
			}
			if (!isBlockTableEntry(candidate, current)) {
				t.fail("free list points outside block table");
				return;
			}

			def index = int.!(candidate.blockIndexOf(current));
			if (listed[index]) {
				t.fail1("block %d appears more than once on free lists", index);
				return;
			}
			listed[index] = true;
			t.assert_eq(kind.code, current.getListNum());
			t.assertz(false, current.getUsed());
			t.assert_eq(previous.addr, current.getListPrev().addr);

			previous = current;
			current = current.getListNext();
			steps++;
		}
	}

	// Walk both allocator structures directly. The memory-order chain must be
	// acyclic, ordered, and doubly linked; each free extent must be classified by
	// its actual span and appear exactly once on the matching free list.
	def assertAllocatorInvariants(candidate: PWRegion) {
		def entryCount = int.!(candidate.numBlocks + 1u64);
		var memorySeen = Array<bool>.new(entryCount);
		var freeByIndex = Array<bool>.new(entryCount);
		var listed = Array<bool>.new(entryCount);
		var previous = BlockEntryHandle(0u64);
		var current = candidate.blockTableHandle[0u64];
		var reachedEnd = false;
		var steps = 0;

		while (!current.isNull()) {
			if (steps >= entryCount) {
				t.fail("memory-order cycle detected");
				return;
			}
			if (!isBlockTableEntry(candidate, current)) {
				t.fail("memory-order link points outside block table");
				return;
			}

			def index = candidate.blockIndexOf(current);
			def arrayIndex = int.!(index);
			if (memorySeen[arrayIndex]) {
				t.fail1("block %d appears twice in memory order", arrayIndex);
				return;
			}
			memorySeen[arrayIndex] = true;
			t.assert_eq(previous.addr, current.getPrev().addr);

			def next = current.getNext();
			if (index == candidate.numBlocks) {
				t.assertz(true, current.getUsed());
				t.assert_eq(ListKind.NONE.code, current.getListNum());
				t.assertz(true, next.isNull());
				t.assertz(true, current.getListPrev().isNull());
				t.assertz(true, current.getListNext().isNull());
				reachedEnd = true;
				break;
			}
			if (!isBlockTableEntry(candidate, next)) {
				t.fail("memory-order chain ends before region marker");
				return;
			}

			def nextIndex = candidate.blockIndexOf(next);
			if (nextIndex <= index) {
				t.fail("memory-order block indices are not increasing");
				return;
			}
			t.assert_eq(current.addr, next.getPrev().addr);

			if (current.getUsed()) {
				def kind = current.getListNum();
				t.assertz(true, kind == ListKind.NONE.code || kind == ListKind.METADATA.code);
				t.assertz(true, current.getListPrev().isNull());
				t.assertz(true, current.getListNext().isNull());
			} else {
				def extentBlocks = nextIndex - index;
				def expectedKind = if(
					extentBlocks == 1u64,
					ListKind.SMALL_FREE.code,
					ListKind.LARGE_FREE.code);
				t.assert_eq(expectedKind, current.getListNum());
				if (!previous.isNull()) t.assertz(true, previous.getUsed());
				freeByIndex[arrayIndex] = true;
			}

			previous = current;
			current = next;
			steps++;
		}

		t.assertz(true, reachedEnd);
		walkFreeList(candidate, candidate.smallSentinel, ListKind.SMALL_FREE, listed);
		walkFreeList(candidate, candidate.largeSentinel, ListKind.LARGE_FREE, listed);
		for (i < entryCount) {
			t.assertz(freeByIndex[i], listed[i]);
		}
		t.assertz(false, candidate.requiresRecovery());
		t.assertz(false, candidate.txn.isDirty());
	}

	// Cross-check the allocator against the generated history's compact model.
	// Each nonzero element is an allocated extent beginning at that block index.
	def assertTrackedAllocations(candidate: PWRegion, allocationSizes: Array<u32>) {
		for (i = 2; i < 7; i++) {
			def size = allocationSizes[i];
			if (size == 0u32) continue;

			def entry = candidate.blockTableHandle[u64.view(i)];
			def next = entry.getNext();
			t.assertz(true, entry.getUsed());
			t.assert_eq(ListKind.NONE.code, entry.getListNum());
			t.assert_eq(u64.view(i) + u64.view(size), candidate.blockIndexOf(next));

			def chunk = candidate.blockEntryToChunk(entry);
			t.assert_eq(u64.view(size) * candidate.blockSize, chunk.getLimit());
			t.assert_eq(u64.view(size) * candidate.blockSize, chunk.getChunkLimit());
		}

		// The reverse check prevents an unexpected allocated extent from being
		// accepted merely because every modeled extent was found.
		var current = candidate.blockTableHandle[0u64];
		var steps = 0;
		while (!current.isNull()) {
			if (steps > int.!(candidate.numBlocks)) {
				t.fail("allocation-model walk found a memory-order cycle");
				return;
			}
			def index = candidate.blockIndexOf(current);
			if (index >= 2u64 && index < 7u64) {
				t.assertz(current.getUsed(), allocationSizes[int.!(index)] != 0u32);
			}
			current = current.getNext();
			steps++;
		}
	}

	def writeCommittedWalUpdate(region: PWRegion, addr: u64, value: u64, width: u8) {
		var wal = DualTxnWal.new(region.regionStart, region.logChunk.addr, region.blockSize, region.backendRegion, false);
		wal.append(addr - region.regionStart, value, width);
		wal.commit();
	}

	// Run in a forked child. Return an exit status instead of asserting because
	// the child's Tester state is private after fork. The caller terminates with
	// exit_group immediately after this returns, deliberately skipping every
	// PWRegion/DualTxnWal cleanup path.
	def writeCommittedWalUpdateAbruptly() -> int {
		region = openRegion(false);
		if (region.backendRegion == null || region.txn == null) return 2;

		def entry = region.blockTableHandle[2u64];
		if (entry.getUsed()) return 3;

		var wal = DualTxnWal.new(region.regionStart, region.logChunk.addr, region.blockSize, region.backendRegion, false);
		if (!wal.append(
			entry.addr + u64.view(BlockEntry.used.offset) - region.regionStart,
			1u64,
			1u8)) return 4;
		if (wal.commit() == 0u64) return 5;
		return 0;
	}

	// Run a complete allocator transaction in a forked child. allocChunk(1)
	// takes the large-free split path on a fresh region, so its one WAL record
	// contains all of the block-order, free-list, used-bit, and chunk-header
	// after-images. A dirty file backend after commit confirms those after-images
	// were applied but are still waiting for the next piggybacked boundary.
	def allocateSplitAbruptly() -> int {
		region = openRegion(false);
		if (region.backendRegion == null || region.txn == null) return 2;

		def chunk = region.allocChunk(1u32);
		if (chunk.isNull()) return 3;
		if (region.requiresRecovery()) return 4;
		if (region.txn.isDirty()) return 5;
		if (!region.blockTableHandle[2u64].getUsed()) return 6;
		if (!FileMmapRegion.?(region.backendRegion)) return 7;
		if (!FileMmapRegion.!(region.backendRegion).hasDirtyChanges) return 8;
		return 0;
	}

	// The custom backend stops inside persistChanges() after fdatasync has made
	// the split transaction's WAL record durable. allocChunk() must not return:
	// its multi-entry after-images have not yet been applied at this point.
	def allocateSplitAtCommitBoundary() -> int {
		region = PWRegion.new(
			CommitBoundaryStopFileMmapBackend.new(BD_PATH),
			8u64,
			Array<Ref<MetaDataDesc>>.new(0),
			4096u64,
			false
		);
		if (region.backendRegion == null || region.txn == null) return 2;
		if (!CommitBoundaryStopFileMmapRegion.?(region.backendRegion)) return 3;

		def chunk = region.allocChunk(1u32);
		if (chunk.isNull()) return 4;
		// Reaching this return means the expected SIGSTOP did not hold the child
		// at the commit boundary.
		return 5;
	}

	// Stop the exact-fit allocator path at the same commit-before-apply boundary.
	// This transaction removes the only free-list node instead of splitting it,
	// so recovery must reconstruct a distinct multi-entry structural update.
	def allocateExactFitAtCommitBoundary() -> int {
		region = PWRegion.new(
			CommitBoundaryStopFileMmapBackend.new(BD_PATH),
			8u64,
			Array<Ref<MetaDataDesc>>.new(0),
			4096u64,
			false
		);
		if (region.backendRegion == null || region.txn == null) return 2;
		if (!CommitBoundaryStopFileMmapRegion.?(region.backendRegion)) return 3;

		def chunk = region.allocChunk(5u32);
		if (chunk.isNull()) return 4;
		// Reaching this return means the expected SIGSTOP did not hold the child
		// at the commit boundary.
		return 5;
	}

	// The parent prepares two adjacent allocations and frees the first before
	// this child opens the file. Freeing block 3 then coalesces with both the
	// free block on its left and the large remainder on its right. The custom
	// backend stops after that complete transaction's WAL record is durable but
	// before freeChunk() can apply any of its structural after-images.
	def coalesceFreeAtCommitBoundary() -> int {
		region = PWRegion.new(
			CommitBoundaryStopFileMmapBackend.new(BD_PATH),
			8u64,
			Array<Ref<MetaDataDesc>>.new(0),
			4096u64,
			false
		);
		if (region.backendRegion == null || region.txn == null) return 2;
		if (!CommitBoundaryStopFileMmapRegion.?(region.backendRegion)) return 3;

		def allocatedRight = region.blockTableHandle[3u64];
		if (!allocatedRight.getUsed()) return 4;
		if (!region.freeChunk(region.blockEntryToChunk(allocatedRight))) return 5;
		// Reaching this return means the expected SIGSTOP did not hold the child
		// at the commit boundary.
		return 6;
	}

	// Run the exact-fit allocator path in a forked child. allocChunk(5) consumes
	// the entire initial large-free extent, so recovery must preserve both the
	// empty free lists and the shortened memory-order chain.
	def allocateExactFitAbruptly() -> int {
		region = openRegion(false);
		if (region.backendRegion == null || region.txn == null) return 2;

		def chunk = region.allocChunk(5u32);
		if (chunk.isNull()) return 3;
		if (region.requiresRecovery()) return 4;
		if (region.txn.isDirty()) return 5;
		if (!region.blockTableHandle[2u64].getUsed()) return 6;
		if (!region.largeSentinel.getListNext().isNull()) return 7;
		if (!FileMmapRegion.?(region.backendRegion)) return 8;
		if (!FileMmapRegion.!(region.backendRegion).hasDirtyChanges) return 9;
		return 0;
	}

	// Allocate adjacent one-block chunks, free the first, then free the second.
	// The final free coalesces left with the first chunk and right with the
	// remaining large extent in one multi-entry allocator transaction.
	def coalesceFreeAbruptly() -> int {
		region = openRegion(false);
		if (region.backendRegion == null || region.txn == null) return 2;

		def first = region.allocChunk(1u32);
		if (first.isNull()) return 3;
		def second = region.allocChunk(1u32);
		if (second.isNull()) return 4;
		if (!region.freeChunk(first)) return 5;
		if (!region.freeChunk(second)) return 6;
		if (region.requiresRecovery()) return 7;
		if (region.txn.isDirty()) return 8;

		def coalesced = region.blockTableHandle[2u64];
		if (coalesced.getUsed()) return 9;
		if (coalesced.getListNum() != ListKind.LARGE_FREE.code) return 10;
		if (!FileMmapRegion.?(region.backendRegion)) return 11;
		if (!FileMmapRegion.!(region.backendRegion).hasDirtyChanges) return 12;
		return 0;
	}

	def assertRecoveredSplitAllocation(recovered: PWRegion) {
		def logEntry = recovered.blockTableHandle[1u64];
		def allocated = recovered.blockTableHandle[2u64];
		def remainder = recovered.blockTableHandle[3u64];
		def metadata = recovered.blockTableHandle[7u64];
		def chunk = recovered.blockEntryToChunk(allocated);

		// Memory-order chain: log block -> allocated block -> remainder -> metadata.
		t.assertz(true, allocated.getUsed());
		t.assert_eq(ListKind.NONE.code, allocated.getListNum());
		t.assert_eq(logEntry.addr, allocated.getPrev().addr);
		t.assert_eq(remainder.addr, allocated.getNext().addr);
		t.assertz(true, allocated.getListPrev().isNull());
		t.assertz(true, allocated.getListNext().isNull());

		t.assertz(false, remainder.getUsed());
		t.assert_eq(ListKind.LARGE_FREE.code, remainder.getListNum());
		t.assert_eq(allocated.addr, remainder.getPrev().addr);
		t.assert_eq(metadata.addr, remainder.getNext().addr);
		t.assert_eq(recovered.largeSentinel.addr, remainder.getListPrev().addr);
		t.assertz(true, remainder.getListNext().isNull());
		t.assert_eq(remainder.addr, recovered.largeSentinel.getListNext().addr);
		t.assert_eq(remainder.addr, metadata.getPrev().addr);

		// The same transaction also initialized the allocated chunk header.
		t.assert_eq(u64.!(ChunkHeader.size), chunk.getOffset());
		t.assert_eq(4096u64, chunk.getLimit());
		t.assert_eq(4096u64, chunk.getChunkLimit());
		t.assert_eq(0u64, chunk.getLinemarks());
		t.assertz(false, recovered.requiresRecovery());
		t.assertz(false, recovered.txn.isDirty());
	}

	def assertRecoveredExactFitAllocation(recovered: PWRegion) {
		def logEntry = recovered.blockTableHandle[1u64];
		def allocated = recovered.blockTableHandle[2u64];
		def metadata = recovered.blockTableHandle[7u64];
		def endMarker = recovered.blockTableHandle[8u64];
		def chunk = recovered.blockEntryToChunk(allocated);

		// Memory order skips the consumed extent's interior table entries.
		t.assertz(true, allocated.getUsed());
		t.assert_eq(ListKind.NONE.code, allocated.getListNum());
		t.assert_eq(allocated.addr, logEntry.getNext().addr);
		t.assert_eq(logEntry.addr, allocated.getPrev().addr);
		t.assert_eq(metadata.addr, allocated.getNext().addr);
		t.assertz(true, metadata.getUsed());
		t.assert_eq(ListKind.METADATA.code, metadata.getListNum());
		t.assert_eq(allocated.addr, metadata.getPrev().addr);
		t.assert_eq(endMarker.addr, metadata.getNext().addr);
		t.assertz(true, metadata.getListPrev().isNull());
		t.assertz(true, metadata.getListNext().isNull());
		t.assert_eq(metadata.addr, endMarker.getPrev().addr);

		// Exact fit consumes the only free extent.
		t.assertz(true, allocated.getListPrev().isNull());
		t.assertz(true, allocated.getListNext().isNull());
		t.assertz(true, recovered.smallSentinel.getListNext().isNull());
		t.assertz(true, recovered.largeSentinel.getListNext().isNull());

		t.assert_eq(u64.!(ChunkHeader.size), chunk.getOffset());
		t.assert_eq(5u64 * 4096u64, chunk.getLimit());
		t.assert_eq(5u64 * 4096u64, chunk.getChunkLimit());
		t.assert_eq(0u64, chunk.getLinemarks());
		t.assertz(false, recovered.requiresRecovery());
		t.assertz(false, recovered.txn.isDirty());
	}

	def assertRecoveredCoalescingFree(recovered: PWRegion) {
		def logEntry = recovered.blockTableHandle[1u64];
		def coalesced = recovered.blockTableHandle[2u64];
		def freedRight = recovered.blockTableHandle[3u64];
		def absorbedRemainder = recovered.blockTableHandle[4u64];
		def metadata = recovered.blockTableHandle[7u64];
		def endMarker = recovered.blockTableHandle[8u64];

		// Both neighbors were absorbed: the memory-order chain contains one
		// five-block free extent between the log and metadata entries.
		t.assert_eq(coalesced.addr, logEntry.getNext().addr);
		t.assertz(false, coalesced.getUsed());
		t.assert_eq(ListKind.LARGE_FREE.code, coalesced.getListNum());
		t.assert_eq(logEntry.addr, coalesced.getPrev().addr);
		t.assert_eq(metadata.addr, coalesced.getNext().addr);
		t.assert_eq(coalesced.addr, metadata.getPrev().addr);
		t.assert_eq(endMarker.addr, metadata.getNext().addr);
		t.assert_eq(metadata.addr, endMarker.getPrev().addr);

		// The coalesced entry is the only free-list member. The freed-right and
		// old-remainder entries are interior to its extent and no longer listed.
		t.assertz(true, recovered.smallSentinel.getListNext().isNull());
		t.assert_eq(coalesced.addr, recovered.largeSentinel.getListNext().addr);
		t.assert_eq(recovered.largeSentinel.addr, coalesced.getListPrev().addr);
		t.assertz(true, coalesced.getListNext().isNull());
		t.assertz(false, freedRight.getUsed());
		t.assert_eq(ListKind.NONE.code, freedRight.getListNum());
		t.assertz(true, freedRight.getListPrev().isNull());
		t.assertz(true, freedRight.getListNext().isNull());
		t.assertz(false, absorbedRemainder.getUsed());
		t.assert_eq(ListKind.NONE.code, absorbedRemainder.getListNum());
		t.assertz(true, absorbedRemainder.getListPrev().isNull());
		t.assertz(true, absorbedRemainder.getListNext().isNull());
		t.assertz(false, recovered.requiresRecovery());
		t.assertz(false, recovered.txn.isDirty());
	}

	// Corrupt the record written by writeCommittedWalUpdate: its txnSeq 1
	// parity-maps to slot 1.
	def corruptFirstRecordChecksum(region: PWRegion) {
		var wal = DualTxnWal.new(region.regionStart, region.logChunk.addr, region.blockSize, region.backendRegion, false);
		def recordAddr = wal.slotAddr(1);
		def entryCount = PWRegionUtils.pointerFromU64(recordAddr + u64.view(TxnRecordHeader.entryCount.offset)).load<u32>();
		def checksumAddr = recordAddr + u64.!(TxnRecordHeader.size) + u64.view(entryCount) * u64.!(LogEntry.size) + u64.view(TxnCommitTrailer.checksum.offset);
		def checksum = PWRegionUtils.pointerFromU64(checksumAddr).load<u64>();
		PWRegionUtils.pointerFromU64(checksumAddr).store<u64>(checksum + 1u64);
		region.backendRegion.persistRange(checksumAddr - region.regionStart, 8u64);
	}

	private def openRegion(forceFormat: bool) -> PWRegion {
		return PWRegion.new(
			X86_64Backends.getFileMapped(BD_PATH),
			8u64,
			Array<Ref<MetaDataDesc>>.new(0),
			4096u64,
			forceFormat
		);
	}
}

// After format(), the MAGIC constant must be stamped in the header.
def test_bd_format_magic(tc: BlockDevicePWRegionTester) {
	var hdr = tc.region.getHeader();
	tc.t.assert_eq(PWRegions.MAGIC, hdr.magic);
	tc.cleanup();
}

// First-time initialization should size the backing file to the region.
def test_bd_initializes_file_size(tc: BlockDevicePWRegionTester) {
	def fd = RegionFileIO.open(BD_PATH);
	def size = Linux.syscall(LinuxConst.SYS_lseek, (fd, 0, LinuxConst.SEEK_END)).0;
	RegionFileIO.close(fd);
	tc.t.assert_eq(8u64 * 4096u64, u64.view(size));
	tc.cleanup();
}

// Mount must reject a region whose persisted block size no longer matches the
// constructor geometry, before constructing a transaction or WAL facade.
def test_bd_stored_block_size_mismatch_rejected(tc: BlockDevicePWRegionTester) {
	tc.t.assertz(true, tc.persistHeaderU64(PWRegionHeader.blockSize.offset, 2048u64));

	def region2 = tc.remount();
	tc.t.assert_eq(2048u64, region2.getHeader().blockSize);
	tc.t.assertz(true, region2.txn == null);
	tc.t.assertz(true, region2.logChunk.isNull());

	tc.cleanup();
}

// Mount performs the same early rejection when the persisted block count does
// not match, even though the mapped byte extent still has the requested size.
def test_bd_stored_num_blocks_mismatch_rejected(tc: BlockDevicePWRegionTester) {
	tc.t.assertz(true, tc.persistHeaderU64(PWRegionHeader.numBlocks.offset, 7u64));

	def region2 = tc.remount();
	tc.t.assert_eq(7u64, region2.getHeader().numBlocks);
	tc.t.assertz(true, region2.txn == null);
	tc.t.assertz(true, region2.logChunk.isNull());

	tc.cleanup();
}

// Older formatted regions have no explicit WAL offset. A zero value must map
// to block 1, produce a healthy transaction, and remain usable after mount.
def test_bd_legacy_log_chunk_fallback(tc: BlockDevicePWRegionTester) {
	tc.t.assertz(true, tc.persistHeaderU64(PWRegionHeader.logChunk.offset, 0u64));

	def region2 = tc.remount();
	tc.t.assert_eq(0u64, region2.getHeader().logChunk);
	tc.t.assertz(false, region2.txn == null);
	tc.t.assert_eq(4096u64, region2.offsetInRegion(region2.logChunk.addr));
	tc.t.assertz(true, tc.allocSucceeded(region2.allocChunk(1u32)));

	tc.cleanup();
}

// allocChunk(1) must return a valid chunk on a fresh region.
def test_bd_alloc_valid(tc: BlockDevicePWRegionTester) {
	var chunk = tc.region.allocChunk(1u32);
	tc.t.assertz(true, tc.allocSucceeded(chunk));
	tc.cleanup();
}

// After allocChunk(1), the block entry's used flag must be true.
def test_bd_alloc_sets_used(tc: BlockDevicePWRegionTester) {
	var chunk = tc.region.allocChunk(1u32);
	var entry = tc.region.chunkToBlockEntry(chunk);
	tc.t.assertz(true, entry.getUsed());
	tc.cleanup();
}

// After alloc+free, the block entry must show used == false.
def test_bd_free_clears_used(tc: BlockDevicePWRegionTester) {
	var chunk = tc.region.allocChunk(1u32);
	tc.region.freeChunk(chunk);
	var entry = tc.region.chunkToBlockEntry(chunk);
	tc.t.assertz(false, entry.getUsed());
	tc.cleanup();
}

// Coalescing must work with block device backend.
def test_bd_coalesce(tc: BlockDevicePWRegionTester) {
	var chunk2 = tc.region.allocChunk(1u32);
	var chunk3 = tc.region.allocChunk(1u32);

	tc.region.freeChunk(chunk2);
	tc.region.freeChunk(chunk3);

	// After coalescing, alloc(2) must succeed.
	var chunk = tc.region.allocChunk(2u32);
	tc.t.assertz(true, tc.allocSucceeded(chunk));
	tc.cleanup();
}

// After format + close + remount, the magic must be present.
def test_bd_persist_and_remount(tc: BlockDevicePWRegionTester) {
	// Region was formatted in constructor. Remount it.
	var region2 = tc.remount();
	tc.t.assert_eq(PWRegions.MAGIC, region2.getHeader().magic);
	tc.cleanup();
}

// After alloc + close + remount, allocation state must be preserved.
// If 1 block was allocated (out of 5 free), remount should have 4 free.
def test_bd_remount_alloc_state(tc: BlockDevicePWRegionTester) {
	// Allocate 1 block (leaves 4 free)
	var chunk = tc.region.allocChunk(1u32);
	tc.t.assertz(true, tc.allocSucceeded(chunk));

	// Remount
	var region2 = tc.remount();

	// Should be able to alloc 4 blocks (all remaining free space)
	var chunk2 = region2.allocChunk(4u32);
	tc.t.assertz(true, tc.allocSucceeded(chunk2));

	// Should NOT be able to alloc 1 more (exhausted)
	var chunk3 = region2.allocChunk(1u32);
	tc.t.assertz(false, tc.allocSucceeded(chunk3));

	tc.cleanup();
}

// A real file-backed phase-B commit must prepare its WAL record, complete the
// fdatasync commit boundary, and only then prepare the allocator after-images
// whose durability is deferred to the next boundary. The trace is cleared
// after mount so it contains exactly one allocator transaction.
def test_bd_file_commit_orders_fdatasync_before_after_images(tc: BlockDevicePWRegionTester) {
	tc.region.deallocate();
	def backend = FileCommitTraceBackend.new(BD_PATH);
	tc.region = PWRegion.new(
		backend,
		8u64,
		Array<Ref<MetaDataDesc>>.new(0),
		4096u64,
		false
	);

	def traced = backend.tracedRegion;
	if (tc.region.backendRegion == null || tc.region.txn == null || traced == null) {
		tc.t.fail("traced file backend mount failed");
		tc.cleanup();
		return;
	}

	traced.clearTrace();
	def chunk = tc.region.allocChunk(1u32);
	tc.t.assertz(false, chunk.isNull());
	tc.t.assertz(true, traced.operations.length >= 3);
	if (chunk.isNull() || traced.operations.length < 3) {
		tc.cleanup();
		return;
	}

	// The first prepared range is the complete checksummed record in block 1.
	def logOffset = tc.region.offsetInRegion(tc.region.logChunk.addr);
	def logEnd = logOffset + tc.region.blockSize;
	tc.t.assert_eq(FileCommitTraceOp.PREPARE_RANGE, traced.operations[0]);
	tc.t.assertz(true, traced.preparedOffsets[0] >= logOffset);
	tc.t.assertz(true, traced.preparedOffsets[0] + traced.preparedSizes[0] <= logEnd);

	// This event is emitted only after the production fdatasync call succeeds.
	tc.t.assert_eq(FileCommitTraceOp.FDATASYNC_COMPLETE, traced.operations[1]);

	// All remaining events are non-WAL allocator after-images. No second sync is
	// issued, so FileMmapRegion retains them for the next piggybacked boundary.
	for (i = 2; i < traced.operations.length; i++) {
		tc.t.assert_eq(FileCommitTraceOp.PREPARE_RANGE, traced.operations[i]);
		def preparedIndex = i - 1;
		def offset = traced.preparedOffsets[preparedIndex];
		def size = traced.preparedSizes[preparedIndex];
		tc.t.assertz(true, offset + size <= logOffset || offset >= logEnd);
	}
	tc.t.assert_eq(traced.operations.length - 1, traced.preparedOffsets.length);
	tc.t.assertz(true, traced.hasDirtyChanges);

	tc.cleanup();
}

// Exercise split allocation, isolated free extents, left/right coalescing, and
// repeated clean remounts in one history. Unlike allocation-probe tests, the
// invariant walker checks the complete memory-order and free-list structures
// after every mutation and after every remount.
def test_bd_mixed_sequence_preserves_invariants(tc: BlockDevicePWRegionTester) {
	tc.assertAllocatorInvariants(tc.region);

	def twoBlocks = tc.region.allocChunk(2u32);
	tc.t.assertz(false, twoBlocks.isNull());
	if (twoBlocks.isNull()) {
		tc.cleanup();
		return;
	}
	tc.assertAllocatorInvariants(tc.region);

	def middle = tc.region.allocChunk(1u32);
	tc.t.assertz(false, middle.isNull());
	if (middle.isNull()) {
		tc.cleanup();
		return;
	}
	tc.assertAllocatorInvariants(tc.region);

	def right = tc.region.allocChunk(1u32);
	tc.t.assertz(false, right.isNull());
	if (right.isNull()) {
		tc.cleanup();
		return;
	}
	tc.assertAllocatorInvariants(tc.region);

	// Freeing the middle allocation leaves two distinct one-block free extents.
	tc.t.assertz(true, tc.region.freeChunk(middle));
	tc.assertAllocatorInvariants(tc.region);

	var recovered = tc.remount();
	tc.assertAllocatorInvariants(recovered);

	// The old handles belonged to the unmapped address range. Rebuild handles
	// from stable block-table indices before continuing the history.
	def recoveredLeft = recovered.blockEntryToChunk(recovered.blockTableHandle[2u64]);
	tc.t.assertz(true, recovered.freeChunk(recoveredLeft));
	tc.assertAllocatorInvariants(recovered);

	recovered = tc.remount();
	tc.assertAllocatorInvariants(recovered);

	def recoveredRight = recovered.blockEntryToChunk(recovered.blockTableHandle[5u64]);
	tc.t.assertz(true, recovered.freeChunk(recoveredRight));
	tc.assertAllocatorInvariants(recovered);

	recovered = tc.remount();
	tc.assertAllocatorInvariants(recovered);
	tc.cleanup();
}

// A small deterministic property test. Multiple fixed seeds generate bounded
// allocate/free/remount histories, making failures exactly reproducible while
// covering many more fragmentation and coalescing orders than the hand-written
// history above. The model stores stable block indices because remount changes
// every mapped address and invalidates the old ChunkHandles.
def test_bd_seeded_mixed_histories_preserve_invariants(tc: BlockDevicePWRegionTester) {
	def seeds = [1, 0x5EED, 0xBEEF, 0xCAFE];
	for (seedIndex < seeds.length) {
		if (seedIndex > 0) tc.reformat();
		var state = seeds[seedIndex];
		var allocationSizes = Array<u32>.new(9);

		tc.assertAllocatorInvariants(tc.region);
		for (step < 64) {
			state = (state * 25173 + 13849) % 65536;
			def operation = state % 7;

			var activeCount = 0;
			for (i = 2; i < 7; i++) {
				if (allocationSizes[i] != 0u32) activeCount++;
			}

			if (operation == 0) {
				tc.remount();
			} else if (operation <= 3 && activeCount > 0) {
				state = (state * 25173 + 13849) % 65536;
				var ordinal = state % activeCount;
				var selected = -1;
				for (i = 2; i < 7; i++) {
					if (allocationSizes[i] == 0u32) continue;
					if (ordinal == 0) {
						selected = i;
						break;
					}
					ordinal--;
				}

				tc.t.assertz(true, selected >= 2);
				if (selected < 2) {
					tc.cleanup();
					return;
				}
				def entry = tc.region.blockTableHandle[u64.view(selected)];
				def freed = tc.region.freeChunk(tc.region.blockEntryToChunk(entry));
				tc.t.assertz(true, freed);
				if (!freed) {
					tc.cleanup();
					return;
				}
				allocationSizes[selected] = 0u32;
			} else {
				state = (state * 25173 + 13849) % 65536;
				def request = u32.!(1 + state % 3);
				def chunk = tc.region.allocChunk(request);
				if (chunk.isNull()) {
					// Exhaustion or fragmentation is an ordinary failed operation and
					// must not leave transactional state behind.
					tc.t.assertz(false, tc.region.requiresRecovery());
					tc.t.assertz(false, tc.region.txn.isDirty());
				} else {
					def index = int.!(tc.region.blockIndexOf(tc.region.chunkToBlockEntry(chunk)));
					def limit = index + int.!(request);
					tc.t.assertz(true, index >= 2 && limit <= 7);
					if (index < 2 || limit > 7) {
						tc.cleanup();
						return;
					}

					var disjoint = true;
					for (i = 2; i < 7; i++) {
						def trackedSize = int.!(allocationSizes[i]);
						if (trackedSize == 0) continue;
						if (!(i + trackedSize <= index || limit <= i)) disjoint = false;
					}
					tc.t.assertz(true, disjoint);
					if (!disjoint) {
						tc.cleanup();
						return;
					}
					allocationSizes[index] = request;
				}
			}

			tc.assertAllocatorInvariants(tc.region);
			tc.assertTrackedAllocations(tc.region, allocationSizes);
		}

		// Finish each history by freeing every modeled allocation. This adds a
		// final coalescing sweep and proves the resulting state survives remount.
		for (i = 2; i < 7; i++) {
			if (allocationSizes[i] == 0u32) continue;
			def entry = tc.region.blockTableHandle[u64.view(i)];
			def freed = tc.region.freeChunk(tc.region.blockEntryToChunk(entry));
			tc.t.assertz(true, freed);
			if (!freed) {
				tc.cleanup();
				return;
			}
			allocationSizes[i] = 0u32;
			tc.assertAllocatorInvariants(tc.region);
		}
		tc.remount();
		tc.assertAllocatorInvariants(tc.region);
		tc.assertTrackedAllocations(tc.region, allocationSizes);
	}
	tc.cleanup();
}

// A committed WAL should replay on remount and then be cleared.
def test_bd_recover_committed_wal(tc: BlockDevicePWRegionTester) {
	var entry = tc.region.blockTableHandle[2u64];
	tc.t.assertz(false, entry.getUsed());

	tc.writeCommittedWalUpdate(
		tc.region,
		entry.addr + u64.view(BlockEntry.used.offset),
		1u64,
		1u8);

	var region2 = tc.remount();
	tc.t.assertz(true, region2.blockTableHandle[2u64].getUsed());

	tc.cleanup();
}

// The writer process exits immediately after the WAL commit boundary, without
// applying the after-image and without deallocate()/DualTxnWal.close(). A
// separate process must be able to mount the same file and replay the durable
// record. This is process-crash consistency evidence for the real file backend;
// it is not a host power-loss test because both processes share one kernel and
// its page cache.
def test_bd_abrupt_writer_recovers_committed_wal(tc: BlockDevicePWRegionTester) {
	// Finish the fresh format and remove the parent's mapping before forking so
	// only the child writer has the region open at the simulated crash point.
	tc.region.deallocate();
	tc.region = null;

	def pid = Linux.syscall(LinuxConst.SYS_fork, ()).0;
	if (pid < 0) {
		tc.t.fail("fork failed");
		tc.cleanup();
		return;
	}
	if (pid == 0) {
		def childStatus = tc.writeCommittedWalUpdateAbruptly();
		Linux.syscall(LinuxConst.SYS_exit_group, childStatus);
		return;
	}

	var waitStatus = Array<int>.new(1);
	def waited = Linux.syscall(
		LinuxConst.SYS_wait4,
		(pid, Pointer.atElement(waitStatus, 0), 0, Pointer.NULL)).0;
	tc.t.assert_eq(pid, waited);
	tc.t.assert_eq(0, waitStatus[0]);
	if (waited != pid || waitStatus[0] != 0) {
		tc.cleanup();
		return;
	}

	def recovered = tc.remount();
	tc.t.assertz(true, recovered.blockTableHandle[2u64].getUsed());

	tc.cleanup();
}

// Exercise the other side of the phase-B crash window through the allocator's
// real transaction path: the record is durable and every after-image has been
// applied to the mapping, but those after-images have not ridden the next
// commit boundary. Abrupt exit must leave a replayable multi-entry record, and
// remount must reconstruct a structurally consistent split allocation without
// relying on DualTxnWal.close().
def test_bd_abrupt_split_alloc_recovers_transaction(tc: BlockDevicePWRegionTester) {
	tc.region.deallocate();
	tc.region = null;

	def pid = Linux.syscall(LinuxConst.SYS_fork, ()).0;
	if (pid < 0) {
		tc.t.fail("fork failed");
		tc.cleanup();
		return;
	}
	if (pid == 0) {
		def childStatus = tc.allocateSplitAbruptly();
		Linux.syscall(LinuxConst.SYS_exit_group, childStatus);
		return;
	}

	var waitStatus = Array<int>.new(1);
	def waited = Linux.syscall(
		LinuxConst.SYS_wait4,
		(pid, Pointer.atElement(waitStatus, 0), 0, Pointer.NULL)).0;
	tc.t.assert_eq(pid, waited);
	tc.t.assert_eq(0, waitStatus[0]);
	if (waited != pid || waitStatus[0] != 0) {
		tc.cleanup();
		return;
	}

	def recovered = tc.remount();
	tc.assertRecoveredSplitAllocation(recovered);

	tc.cleanup();
}

// Exercise a second complete allocator transaction at the applied-after-image
// crash window. Unlike the split path, exact fit removes the only free-list
// node and leaves no remainder; remount must recover that distinct structure
// from the multi-entry WAL record without child cleanup.
