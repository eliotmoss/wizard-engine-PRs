// Prepare the allocator so freeing block 3 must coalesce both neighbors, then
// stop immediately after that multi-entry WAL record reaches fdatasync. The
// child is killed before any after-image is applied; recovery must rebuild the
// original five-block extent using the record alone.
def test_bd_sigkill_coalescing_free_commit_boundary_recovers(tc: BlockDevicePWRegionTester) {
	def first = tc.region.allocChunk(1u32);
	def second = tc.region.allocChunk(1u32);
	tc.t.assertz(true, !first.isNull());
	tc.t.assertz(true, !second.isNull());
	if (first.isNull() || second.isNull()) {
		tc.cleanup();
		return;
	}
	tc.t.assertz(true, tc.region.freeChunk(first));
	if (tc.region.blockTableHandle[2u64].getUsed() ||
		!tc.region.blockTableHandle[3u64].getUsed()) {
		tc.t.fail("coalescing-free setup failed");
		tc.cleanup();
		return;
	}
	tc.assertAllocatorInvariants(tc.region);
	tc.region.deallocate();
	tc.region = null;

	def pid = Linux.syscall(LinuxConst.SYS_fork, ()).0;
	if (pid < 0) {
		tc.t.fail("fork failed");
		tc.cleanup();
		return;
	}
	if (pid == 0) {
		def childStatus = tc.coalesceFreeAtCommitBoundary();
		Linux.syscall(LinuxConst.SYS_exit_group, childStatus);
		return;
	}

	var waitStatus = Array<int>.new(1);
	def waitedForStop = Linux.syscall(
		LinuxConst.SYS_wait4,
		(pid, Pointer.atElement(waitStatus, 0), BD_WUNTRACED, Pointer.NULL)).0;
	def expectedStopStatus = BD_SIGSTOP * 256 + 127;
	tc.t.assert_eq(pid, waitedForStop);
	tc.t.assert_eq(expectedStopStatus, waitStatus[0]);
	if (waitedForStop != pid || waitStatus[0] != expectedStopStatus) {
		Linux.syscall(LinuxConst.SYS_kill, (pid, BD_SIGKILL));
		Linux.syscall(LinuxConst.SYS_wait4,
			(pid, Pointer.atElement(waitStatus, 0), 0, Pointer.NULL));
		tc.cleanup();
		return;
	}

	def killResult = Linux.syscall(LinuxConst.SYS_kill, (pid, BD_SIGKILL)).0;
	def waitedForKill = Linux.syscall(
		LinuxConst.SYS_wait4,
		(pid, Pointer.atElement(waitStatus, 0), 0, Pointer.NULL)).0;
	tc.t.assert_eq(0, killResult);
	tc.t.assert_eq(pid, waitedForKill);
	tc.t.assert_eq(BD_SIGKILL, waitStatus[0]);
	if (killResult != 0 || waitedForKill != pid || waitStatus[0] != BD_SIGKILL) {
		tc.cleanup();
		return;
	}

	def recovered = tc.remount();
	tc.assertRecoveredCoalescingFree(recovered);
	tc.assertAllocatorInvariants(recovered);

	tc.cleanup();
}

// Repeat the applied-after-image crash window with a non-cooperative process
// death. The child stops itself only after the allocator transaction and its
// structural checks complete; the parent observes that stop, sends SIGKILL,
// and remounts without allowing any child cleanup code to run.
def test_bd_sigkill_split_alloc_recovers_transaction(tc: BlockDevicePWRegionTester) {
	tc.region.deallocate();
	tc.region = null;

	def pid = Linux.syscall(LinuxConst.SYS_fork, ()).0;
	if (pid < 0) {
		tc.t.fail("fork failed");
		tc.cleanup();
		return;
	}
	if (pid == 0) {
		def childStatus = tc.allocateSplitAbruptly();
		if (childStatus != 0) {
			Linux.syscall(LinuxConst.SYS_exit_group, childStatus);
			return;
		}

		def childPid = Linux.syscall(LinuxConst.SYS_getpid, ()).0;
		def stopResult = Linux.syscall(LinuxConst.SYS_kill, (childPid, BD_SIGSTOP)).0;
		// Reaching this exit means SIGSTOP failed or somebody resumed the child.
		if (stopResult == 0) Linux.syscall(LinuxConst.SYS_exit_group, 10);
		else Linux.syscall(LinuxConst.SYS_exit_group, 11);
		return;
	}

	var waitStatus = Array<int>.new(1);
	def waitedForStop = Linux.syscall(
		LinuxConst.SYS_wait4,
		(pid, Pointer.atElement(waitStatus, 0), BD_WUNTRACED, Pointer.NULL)).0;
	def expectedStopStatus = BD_SIGSTOP * 256 + 127;
	tc.t.assert_eq(pid, waitedForStop);
	tc.t.assert_eq(expectedStopStatus, waitStatus[0]);
	if (waitedForStop != pid || waitStatus[0] != expectedStopStatus) {
		Linux.syscall(LinuxConst.SYS_kill, (pid, BD_SIGKILL));
		Linux.syscall(LinuxConst.SYS_wait4,
			(pid, Pointer.atElement(waitStatus, 0), 0, Pointer.NULL));
		tc.cleanup();
		return;
	}

	def killResult = Linux.syscall(LinuxConst.SYS_kill, (pid, BD_SIGKILL)).0;
	def waitedForKill = Linux.syscall(
		LinuxConst.SYS_wait4,
		(pid, Pointer.atElement(waitStatus, 0), 0, Pointer.NULL)).0;
	tc.t.assert_eq(0, killResult);
	tc.t.assert_eq(pid, waitedForKill);
	tc.t.assert_eq(BD_SIGKILL, waitStatus[0]);
	if (killResult != 0 || waitedForKill != pid || waitStatus[0] != BD_SIGKILL) {
		tc.cleanup();
		return;
	}

	def recovered = tc.remount();
	tc.assertRecoveredSplitAllocation(recovered);

	tc.cleanup();
}

