// Production-recovery-over-enumerated-image tests (milestone 5 of
// docs/pmem-crash-model.md). Every durable image a recorded DualTxnWal commit
// can leave behind is mounted and handed to the real recovery path, and the
// acknowledgement contract is checked against what recovery actually produced.
// No DAX mapping or PMEM hardware is required.

def PRT = UnitTests.registerT("persistent_recovery:", _, PersistentRecoveryTester.new, _);
def PRTX = [
	PRT("recovers_acknowledged_commit_image", test_recovery_recovers_acknowledged_commit_image),
	PRT("commit_boundary_survives_every_schedule", test_recovery_commit_boundary_survives_every_schedule),
	PRT("torn_record_images_never_invent_state", test_recovery_torn_record_images_never_invent_state),
	PRT("recovery_is_idempotent", test_recovery_recovery_is_idempotent),
	PRT("unmet_property_yields_image_counterexample", test_recovery_unmet_property_yields_image_counterexample),
	PRT("recovery_records_its_own_trace", test_recovery_recovery_records_its_own_trace),
	PRT("crash_during_recovery_still_recovers", test_recovery_crash_during_recovery_still_recovers),
	PRT("failed_replay_persist_latches_and_reopens", test_recovery_failed_replay_persist_latches_and_reopens),
	PRT("failed_replay_persist_never_loses_a_record", test_recovery_failed_replay_persist_never_loses_a_record),
	()
];

class PersistentRecoveryTester(t: Tester) {
	def VALUE = 0x8877_6655_4433_2211_u64;
	def OFFSET = 200u64;
	def LOG_OFFSET = 1024u64;
	def LOG_SIZE = 1024u64;
	def REGION_BYTES = 4096u64;

	// The region bytes that were already durable when the scenario began: the
	// mount is formatted and its WAL header persisted before the commit runs, so
	// the crash model starts from those bytes rather than from zeroes.
	var mounted: Array<byte>;
	var trace: PersistentTrace;

	// Record one real commit -- append, commit, no apply -- through the
	// production WAL on a trace-recording PMEM region.
	def recordCommit() -> bool {
		def mapping = Mmap.reserve(REGION_BYTES, Mmap.PROT_READ | Mmap.PROT_WRITE);
		if (mapping == null) return false;
		def region = PmemMmapRegion.new(mapping, -1);
		def recorder = RecordingPersistentOperations.new(region.range);
		region.setPersistentOperations(recorder);

		def base = u64.view(Pointer.atElement(region.range, 0));
		def wal = DualTxnWal.new(base, base + LOG_OFFSET, LOG_SIZE, region, true);
		mounted = Array<byte>.new(region.range.length);
		for (i < mounted.length) mounted[i] = region.range[i];

		recorder.clear();
		var ok = wal.append(OFFSET, VALUE, 8u8);
		ok = ok && wal.commit() == 1u64;
		trace = recorder.snapshot("dual_wal_commit");
		ok = ok && trace.validate().ok();
		region.destroy();
		return ok;
	}

	def survivesProperty() -> PersistentImageProperty {
		return PersistentWalRecoveryProperty.new(LOG_OFFSET, LOG_SIZE, OFFSET, 8, VALUE, true)
			.property("acknowledged transaction survives recovery");
	}

	def noInventedStateProperty() -> PersistentImageProperty {
		return PersistentWalRecoveryProperty.new(LOG_OFFSET, LOG_SIZE, OFFSET, 8, VALUE, false)
			.property("recovery never invents an uncommitted value");
	}

	def countOf(text: string, needle: string) -> int {
		if (needle.length == 0 || needle.length > text.length) return 0;
		var found = 0;
		for (i < text.length - needle.length + 1) {
			var hit = true;
			for (j < needle.length) if (text[i + j] != needle[j]) hit = false;
			if (hit) found++;
		}
		return found;
	}
}

// The end-to-end path: enumerate the image a crash right after the commit
// boundary leaves, mount it, and let the production WAL recover it. The
// after-image was never applied before the crash, so only replay can restore it.
def test_recovery_recovers_acknowledged_commit_image(tc: PersistentRecoveryTester) {
	if (!tc.recordCommit()) {
		tc.t.fail("could not record a production WAL commit");
		return;
	}
	def image = PersistentImages.lazyCrash(tc.trace, tc.mounted, tc.trace.length());
	// The crash caught the record, not the data: offset 200 is untouched.
	tc.t.assert_eq(0u64, image.read(tc.OFFSET, 8));

	def run = PersistentRecoveries.runDualWal(image, tc.LOG_OFFSET, tc.LOG_SIZE);
	if (run == null) {
		tc.t.fail("could not map a region for the durable image");
		return;
	}
	tc.t.assertz(true, run.recovery == DualWalRecovery.REPLAYED);
	tc.t.assertz(false, run.requiresRecovery);
	tc.t.assert_eq(tc.VALUE, run.recovered.read(tc.OFFSET, 8));
	tc.t.assert_eq(2u64, run.nextTxnSeq);
	tc.t.assert_eq(1u64, run.dataDurableSeq);
}

// The commit point, checked against production recovery rather than asserted:
// once the boundary has returned, every image the model permits must recover
// the acknowledged after-image.
def test_recovery_commit_boundary_survives_every_schedule(tc: PersistentRecoveryTester) {
	if (!tc.recordCommit()) {
		tc.t.fail("could not record a production WAL commit");
		return;
	}
	def result = PersistentExplorer.checkImages(tc.trace, tc.mounted, tc.trace.length(), 0,
		tc.survivesProperty());
	if (!result.ok()) tc.t.fail(result.toArtifact());
	tc.t.assertz(true, result.exhaustive());
	// Every line the record touched was flushed and fenced, so the boundary
	// leaves exactly one image -- that is what makes it a commit point.
	tc.t.asserti(1, result.exploration.imageCount());
	tc.t.asserti(1, result.imagesChecked);
}

// The other half of the contract, over every crash cut: an unacknowledged
// transaction may be absent or may replay, but a partially written record must
// never recover as a value that was never committed.
//
// A real commit writes a record byte by byte across three cache lines, so the
// mid-record cuts permit far more images than a unit test should mount. This
// run is therefore deliberately bounded, and the bound is asserted rather than
// hidden: the result reports itself as not exhaustive, so it is evidence over
// the images it checked and nothing more. Milestone 8's separate tier is where
// the unbounded sweep belongs.
def test_recovery_torn_record_images_never_invent_state(tc: PersistentRecoveryTester) {
	if (!tc.recordCommit()) {
		tc.t.fail("could not record a production WAL commit");
		return;
	}
	def result = PersistentExplorer.checkAllCuts(tc.trace, tc.mounted, 24,
		tc.noInventedStateProperty());
	if (!result.ok()) tc.t.fail(result.toArtifact());
	tc.t.assertz(true, result.truncated);
	tc.t.assertz(false, result.exhaustive());
	// Every cut contributed at least one image, and the mid-record cuts
	// contributed many more than one.
	tc.t.assertz(true, result.imagesChecked > tc.trace.length());
}

// Recovery must be replayable: mounting the bytes recovery produced and
// recovering again changes nothing. A second crash during recovery therefore
// costs correctness nothing.
def test_recovery_recovery_is_idempotent(tc: PersistentRecoveryTester) {
	if (!tc.recordCommit()) {
		tc.t.fail("could not record a production WAL commit");
		return;
	}
	def first = PersistentRecoveries.runDualWal(
		PersistentImages.lazyCrash(tc.trace, tc.mounted, tc.trace.length()),
		tc.LOG_OFFSET, tc.LOG_SIZE);
	if (first == null) {
		tc.t.fail("could not map a region for the durable image");
		return;
	}
	def second = PersistentRecoveries.runDualWal(first.recovered, tc.LOG_OFFSET, tc.LOG_SIZE);
	tc.t.assert_eq(tc.VALUE, second.recovered.read(tc.OFFSET, 8));
	tc.t.assert_eq(first.nextTxnSeq, second.nextTxnSeq);
	tc.t.assertz(false, second.requiresRecovery);
	// The record is still on-region, so the replay happens again and lands on
	// the same bytes.
	tc.t.assertz(true, first.recovered.sameBytes(second.recovered));
}

// A property that does not hold produces a usable artifact: the durable bytes
// that broke it, the crash cut that produced them, and what recovery reported.
// Requiring survival before the commit boundary is exactly such a property.
def test_recovery_unmet_property_yields_image_counterexample(tc: PersistentRecoveryTester) {
	if (!tc.recordCommit()) {
		tc.t.fail("could not record a production WAL commit");
		return;
	}
	def result = PersistentExplorer.checkImages(tc.trace, tc.mounted, 1, 0, tc.survivesProperty());
	tc.t.assertz(false, result.ok());
	tc.t.assertz(false, result.exhaustive());

	def cx = result.counterexample;
	tc.t.assert_string("dual_wal_commit", cx.scenario);
	tc.t.asserti(1, cx.crashAfter);
	tc.t.assert_eq(0u64, cx.durableImage().read(tc.OFFSET, 8));

	def artifact = cx.toArtifact();
	tc.t.asserti(1, tc.countOf(artifact, "durable-image: bytes=4096 digest=0x"));
	tc.t.asserti(1, tc.countOf(artifact, "durable-window: offset=200 length=16"));
	tc.t.asserti(1, tc.countOf(artifact, "acknowledged after-image absent after recovery"));
	tc.t.asserti(1, tc.countOf(artifact, "--- pmem-trace dual_wal_commit"));
}


// Recovery is itself a persistent scenario: mounted through a recording PMEM
// region, its stores, cache-line writebacks and fences are captured in one
// trace. That trace, started from the image recovery was handed, is what a
// second crash is explored over.
def test_recovery_recovery_records_its_own_trace(tc: PersistentRecoveryTester) {
	if (!tc.recordCommit()) {
		tc.t.fail("could not record a production WAL commit");
		return;
	}
	def image = PersistentImages.lazyCrash(tc.trace, tc.mounted, tc.trace.length());
	def recording = PersistentRecoveries.recordDualWalRecovery(image, tc.LOG_OFFSET, tc.LOG_SIZE,
		"dual_wal_recovery");
	if (recording == null) {
		tc.t.fail("could not map a region for the durable image");
		return;
	}

	tc.t.assertz(true, recording.run.recovery == DualWalRecovery.REPLAYED);
	tc.t.assert_eq(tc.VALUE, recording.run.recovered.read(tc.OFFSET, 8));

	def trace = recording.trace;
	tc.t.assertz(true, trace.validate().ok());
	tc.t.assert_eq(tc.REGION_BYTES, trace.regionBytes);
	// Replay stores the after-image and publishes it with one boundary.
	tc.t.assertz(true, trace.count(PersistentEventKind.STORE) > 0);
	tc.t.assertz(true, trace.count(PersistentEventKind.SFENCE) > 0);
	// The after-image's line is among the lines replay touched.
	def line = tc.OFFSET - tc.OFFSET % 64u64;
	var touched = false;
	def lines = trace.touchedLines();
	for (i < lines.length) if (lines[i] == line) touched = true;
	tc.t.assertz(true, touched);

	// A run that recorded nothing would make the second-crash exploration
	// vacuous, so the trace must actually contain the replay.
	tc.t.assertz(true, trace.length() > 1);
}

// The bounded two-crash profile: crash once at the commit boundary, then crash
// again anywhere during recovery. Every image that second crash can leave must
// still recover the acknowledged after-image -- recovery never scrubbed the
// record, and replay is idempotent, so a remount reaches the same state.
def test_recovery_crash_during_recovery_still_recovers(tc: PersistentRecoveryTester) {
	if (!tc.recordCommit()) {
		tc.t.fail("could not record a production WAL commit");
		return;
	}
	def image = PersistentImages.lazyCrash(tc.trace, tc.mounted, tc.trace.length());
	def result = PersistentRecoveries.checkCrashDuringRecovery(image, tc.LOG_OFFSET, tc.LOG_SIZE,
		16, tc.survivesProperty());
	if (result == null) {
		tc.t.fail("could not map a region for the durable image");
		return;
	}
	if (!result.ok()) tc.t.fail(result.toArtifact());
	// Replay writes one after-image and publishes it, so the second-crash state
	// space is small enough to sweep exhaustively -- unlike the mid-record cuts
	// of a commit.
	tc.t.assertz(true, result.exhaustive());
	tc.t.assertz(true, result.imagesChecked > 1);
}


// A recovery that cannot persist what it replayed must latch rather than claim
// a durability it did not reach -- and must leave the record intact, so a later
// mount still restores the acknowledged after-image.
def test_recovery_failed_replay_persist_latches_and_reopens(tc: PersistentRecoveryTester) {
	if (!tc.recordCommit()) {
		tc.t.fail("could not record a production WAL commit");
		return;
	}
	def image = PersistentImages.lazyCrash(tc.trace, tc.mounted, tc.trace.length());

	def failed = PersistentRecoveries.runDualWalWithFailure(image, tc.LOG_OFFSET, tc.LOG_SIZE, 1);
	tc.t.assertz(true, failed.recovery == DualWalRecovery.PERSIST_FAILED);
	tc.t.assertz(true, failed.requiresRecovery);

	// The same instance is unusable, but the durable bytes are not: a fresh
	// mount replays the record the failed attempt did not destroy.
	def reopened = PersistentRecoveries.runDualWal(failed.recovered, tc.LOG_OFFSET, tc.LOG_SIZE);
	tc.t.assertz(true, reopened.recovery == DualWalRecovery.REPLAYED);
	tc.t.assertz(false, reopened.requiresRecovery);
	tc.t.assert_eq(tc.VALUE, reopened.recovered.read(tc.OFFSET, 8));
	tc.t.assert_eq(2u64, reopened.nextTxnSeq);

	// An injection that never fires leaves recovery ordinary.
	def clean = PersistentRecoveries.runDualWalWithFailure(image, tc.LOG_OFFSET, tc.LOG_SIZE, 0);
	tc.t.assertz(true, clean.recovery == DualWalRecovery.REPLAYED);
	tc.t.assertz(false, clean.requiresRecovery);
}

// The same, over every image the commit can leave: whatever a failed recovery
// persist leaves behind must never recover as a value that was never committed,
// and a latch must always come with the failure that caused it.
def test_recovery_failed_replay_persist_never_loses_a_record(tc: PersistentRecoveryTester) {
	if (!tc.recordCommit()) {
		tc.t.fail("could not record a production WAL commit");
		return;
	}
	def property = PersistentRecoveryFailureProperty.new(tc.LOG_OFFSET, tc.LOG_SIZE,
		tc.OFFSET, 8, tc.VALUE, false, 1)
		.property("a failed recovery persist never loses or invents a record");

	def result = PersistentExplorer.checkAllCuts(tc.trace, tc.mounted, 12, property);
	if (!result.ok()) tc.t.fail(result.toArtifact());
	tc.t.assertz(true, result.truncated);

	// At the commit boundary the transaction is acknowledged, so the stronger
	// half of the contract holds there and that cut is exhaustive.
	def acknowledged = PersistentRecoveryFailureProperty.new(tc.LOG_OFFSET, tc.LOG_SIZE,
		tc.OFFSET, 8, tc.VALUE, true, 1)
		.property("a failed recovery persist keeps an acknowledged transaction");
	def atBoundary = PersistentExplorer.checkImages(tc.trace, tc.mounted, tc.trace.length(), 0,
		acknowledged);
	if (!atBoundary.ok()) tc.t.fail(atBoundary.toArtifact());
	tc.t.assertz(true, atBoundary.exhaustive());
}
